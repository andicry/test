		--// Rows are dimmed until they matter, so the selected one reads instantly.
		local DIM = 0.45
		local HOVER = 0.15

		function Listbox:GetVisibleValues()
			local Filter = tostring(Listbox.Filter or ""):lower()
			local Visible = {}

			for _, Value in next, Listbox.Values do
				if Filter == "" or string.find(tostring(Value):lower(), Filter, 1, true) then
					table.insert(Visible, Value)
				end
			end

			return Visible
		end

		function Listbox:IsSelected(Value)
			if Listbox.Multi then
				return Listbox.Value[Value] == true
			end

			return Listbox.Value == Value
		end

		function Listbox:GetActiveValues()
			if Listbox.Multi then
				local Count = 0

				for _, Bool in next, Listbox.Value do
					if Bool then
						Count = Count + 1
					end
				end

				return Count
			end

			return Listbox.Value and 1 or 0
		end

		function Listbox:BuildList()
			local Rows = Listbox.Rows

			table.clear(Rows)

			for _, Element in next, Scrolling:GetChildren() do
				if (not Element:IsA("UIListLayout")) and (not Element:IsA("UIPadding")) then
					Element:Destroy()
				end
			end

			local Visible = Listbox:GetVisibleValues()

			if #Visible == 0 then
				local EmptyLabel = Library:CreateLabel({
					Size = UDim2.new(1, -6, 0, RowHeight),
					TextSize = 12,
					Text = Info.EmptyText or "No results",
					TextXAlignment = Enum.TextXAlignment.Center,
					ZIndex = 8,
					Parent = Scrolling,
				})

				Library:SetTextFade(EmptyLabel, 0.6)

				Scrolling.CanvasSize = UDim2.fromOffset(0, RowHeight + (ListPadding * 2))

				return
			end

			for _, Value in next, Visible do
				local Row = {}

				local RowLabel = Library:CreateLabel({
					Size = UDim2.new(1, -6, 0, RowHeight),
					TextSize = 12,
					Text = tostring(Value),
					TextXAlignment = Enum.TextXAlignment.Center,
					ZIndex = 8,
					Parent = Scrolling,
				})

				local Hovered = false

				function Row:Update()
					local Selected = Listbox:IsSelected(Value)
					local Marked = Listbox.Highlighted[Value] == true

					--// Accent means highlighted. A list with nothing highlighted has no other
					--// use for the accent colour, so the clicked row keeps it there and plain
					--// listboxes carry on looking exactly the way they always did. Once
					--// something is highlighted, accent is the highlight and the clicked row
					--// says so by being the bright one instead.
					local Accent = Marked or (Selected and next(Listbox.Highlighted) == nil)

					RowLabel.TextColor3 = Accent and Library.AccentColor or Library.FontColor
					Library.RegistryMap[RowLabel].Properties.TextColor3 = Accent and "AccentColor" or "FontColor"

					Library:SetTextFade(RowLabel, (Selected or Marked) and 0 or (Hovered and HOVER or DIM))
				end

				RowLabel.InputBegan:Connect(function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseMovement then
						Hovered = true
						Row:Update()

						return
					end

					if not Library:IsPrimaryInput(Input) then
						return
					end

					local Try = not Listbox:IsSelected(Value)

					--// Refuse to empty a single-select list unless AllowNull says otherwise.
					if (not Try) and (not AllowNull) and Listbox:GetActiveValues() == 1 then
						return
					end

					if Listbox.Multi then
						Listbox.Value[Value] = Try or nil
					else
						Listbox.Value = Try and Value or nil
					end

					for _, OtherRow in next, Rows do
						OtherRow:Update()
					end

					Library:SafeCallback(Listbox.Callback, Listbox.Value)
					Library:SafeCallback(Listbox.Changed, Listbox.Value)
				end)

				RowLabel.InputEnded:Connect(function(Input)
					if Input.UserInputType == Enum.UserInputType.MouseMovement then
						Hovered = false
						Row:Update()
					end
				end)

				Row:Update()

				table.insert(Rows, Row)
			end

			Scrolling.CanvasSize = UDim2.fromOffset(0, (#Visible * RowHeight) + (ListPadding * 2))
		end

		--// Takes a plain list of values, or a map of value to true. Rows are recoloured in
		--// place, so calling this while the list is open does not scroll it back to the top.
		function Listbox:SetHighlighted(Values)
			table.clear(Listbox.Highlighted)

			for Key, Value in next, (Values or {}) do
				if Value == true then
					Listbox.Highlighted[Key] = true
				elseif type(Key) == "number" then
					Listbox.Highlighted[Value] = true
				end
			end

			for _, Row in next, Listbox.Rows do
				Row:Update()
			end
		end

		function Listbox:SetValues(NewValues)
			if NewValues then
				Listbox.Values = NewValues
			end

			--// A highlight for a value that no longer exists would come back to life the
			--// moment that value did, so drop it with the list it belonged to
			for Value in next, Listbox.Highlighted do
				if not table.find(Listbox.Values, Value) then
					Listbox.Highlighted[Value] = nil
				end
			end

			--// Drop selections that are not in the new list, otherwise a player who left
			--// stays selected forever with no row to unselect them from.
			if Listbox.Multi then
				for Value in next, Listbox.Value do
					if not table.find(Listbox.Values, Value) then
						Listbox.Value[Value] = nil
					end
				end
			elseif Listbox.Value and not table.find(Listbox.Values, Listbox.Value) then
				Listbox.Value = nil
			end

			Listbox:BuildList()
		end

		function Listbox:SetValue(Value)
			if Listbox.Multi then
				Listbox.Value = {}

				for _, Name in next, (Value or {}) do
					Listbox.Value[Name] = true
				end
			else
				Listbox.Value = Value
			end

			Listbox:BuildList()

			Library:SafeCallback(Listbox.Callback, Listbox.Value)
			Library:SafeCallback(Listbox.Changed, Listbox.Value)
		end

		function Listbox:ClearSearch()
			if Listbox.SearchBox then
				Listbox.SearchBox.Text = ""
			end

			Listbox.Filter = ""
			Listbox:BuildList()
		end

		function Listbox:OnChanged(Func)
			Listbox.Changed = Func
			Func(Listbox.Value)
		end

		Listbox:BuildList()

		Groupbox:AddBlank(5)
		Groupbox:Resize()

		if Idx then
			Options[Idx] = Listbox
		end

		return Listbox
	end

