			Copy and paste colour is right click only, so on touch a press that stays put for a third
			of a second reaches it instead. The tap above has already opened the picker by the time the
			hold completes, so the picker is closed again first and the menu takes its place, which is
			the same end state a right click lands on.
		]]
		if Library.IsMobile then
			DisplayFrame.InputBegan:Connect(function(Input)
				if Input.UserInputType ~= Enum.UserInputType.Touch then
					return
				end

				local StartX, StartY = Library:GetInputPosition(Input)
				local Held = true

				local Ended
				Ended = Input:GetPropertyChangedSignal("UserInputState"):Connect(function()
					if
						Input.UserInputState == Enum.UserInputState.End
						or Input.UserInputState == Enum.UserInputState.Cancel
					then
						Held = false
						Ended:Disconnect()
					end
				end)

				task.delay(0.3, function()
					if Ended.Connected then
						Ended:Disconnect()
					end

					if not Held then
						return
					end

					local NowX, NowY = Library:GetInputPosition(Input)

					if math.abs(NowX - StartX) > 6 or math.abs(NowY - StartY) > 6 then
						return
					end

					ColorPicker:Hide()
					ContextMenu:Show()
				end)
			end)
		end

		if TransparencyBoxInner then
			TransparencyBoxInner.InputBegan:Connect(function(Input)
				if Library:IsPrimaryInput(Input) then
					Library:BindDrag(Input, function(PointerX)
						local MinX = TransparencyBoxInner.AbsolutePosition.X
						local MaxX = MinX + TransparencyBoxInner.AbsoluteSize.X
						local MouseX = math.clamp(PointerX, MinX, MaxX)

