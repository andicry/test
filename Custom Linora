--[[
	The font is cached on disk now. It was pulled off the network on every single run, and that
	download is what the load delay was: it is fetched once and then left alone, so every run
	after the first is entirely local. Everything here is wrapped, so a dead network costs you
	the custom font and nothing else instead of stopping the library dead.

	The Scrollbar.png fetch that used to sit here is gone with it. Every scrolling frame in the
	library runs at ScrollBarThickness 0, so nothing was ever drawing that image.
]]
if not (isfile and isfile("Tahoma.ttf")) then
	pcall(function()
		writefile("Tahoma.ttf", game:HttpGet("https://github.com/sametexe001/luas/raw/refs/heads/main/fonts/windows-xp-tahoma.ttf"))
	end)
end

--[[
	The json is rewritten every run even though the ttf is not, because getcustomasset hands back
	a fresh content id each session and a stale one sitting in the file draws nothing at all.
]]
pcall(function()
	writefile("Tahoma.font", game:GetService("HttpService"):JSONEncode({
		name = "Tahoma",
		faces = {
			{
				name = "Regular",
				weight = 400,
				style = "normal",
				assetId = getcustomasset("Tahoma.ttf"),
			},
		},
	}))
end)

