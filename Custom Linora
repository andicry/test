		Area.Position = UDim2.new(0, Margin, 0.5, 0)
		Layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
		Layout.VerticalAlignment = Enum.VerticalAlignment.Center
	elseif Name == "middleright" or Name == "centerright" then
		Area.AnchorPoint = Vector2.new(1, 0.5)
		Area.Position = UDim2.new(1, -Margin, 0.5, 0)
		Layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
		Layout.VerticalAlignment = Enum.VerticalAlignment.Center
	elseif Name == "bottomleft" then
		Area.AnchorPoint = Vector2.new(0, 1)
		Area.Position = UDim2.new(0, Margin, 1, -40)
		Layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
