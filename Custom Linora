--[[
	Pointer position for a drag, in the same space as AbsolutePosition.

	Input.Position on a mouse or touch press already has the GUI inset taken off, so it lines
	up with AbsolutePosition as it stands. GetMouseLocation does not, so the fallback takes the
	inset off itself before handing the value over.
]]
function Library:GetInputPosition(Input)
	if Input and Input.Position then
		return Input.Position.X, Input.Position.Y
	end

	local Pos = InputService:GetMouseLocation() - GuiService:GetGuiInset()

	return Pos.X, Pos.Y
end

--// Mouse and touch both open drags, and everything downstream treats the two the same.
function Library:IsPrimaryInput(Input)
	return Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch
end

--[[
	Runs a drag off input events rather than polling the mouse.

	The escape menu takes mouse capture off the game, and for as long as it is open
	IsMouseButtonPressed answers false. Every drag in here used to be a loop sitting on that
	call, so with the menu up a slider took neither a drag nor even a plain click, because the
	value was only ever written from inside the loop. Toggles and dropdowns kept working the
	whole time precisely because they are one InputBegan handler with no loop behind them.

	InputChanged keeps firing with the menu up and the InputObject keeps reporting its own
	state, so drags ride on those two signals instead. Apply runs once up front, which is what
	makes a single click land, then again on every pointer move until the button comes back up.
]]
function Library:BindDrag(Input, Apply, Finish)
	Apply(Library:GetInputPosition(Input))

	local Dragging = true
	local MoveConnection
	local StateConnection

	local function Stop()
		if not Dragging then
			return
		end

		Dragging = false

		if MoveConnection then
			MoveConnection:Disconnect()
		end

		if StateConnection then
			StateConnection:Disconnect()
		end

		if Finish then
			Finish()
		end
	end

	StateConnection = Input:GetPropertyChangedSignal("UserInputState"):Connect(function()
		if
			Input.UserInputState == Enum.UserInputState.End
			or Input.UserInputState == Enum.UserInputState.Cancel
		then
			Stop()
		end
	end)

	MoveConnection = InputService.InputChanged:Connect(function(Changed)
		if not Dragging then
			return
		end

		--// A mouse drag is followed through MouseMovement, a touch drag through the touch itself.
		local IsMouseMove = Input.UserInputType == Enum.UserInputType.MouseButton1
			and Changed.UserInputType == Enum.UserInputType.MouseMovement
		local IsTouchMove = Input.UserInputType == Enum.UserInputType.Touch
			and Changed.UserInputType == Enum.UserInputType.Touch

		if not IsMouseMove and not IsTouchMove then
			return
		end

		Apply(Library:GetInputPosition(Changed))
	end)

	--// A click short enough to have ended already never fires the change signal, so that one
	--// case is checked by hand instead of leaving the two connections behind.
	if
		Input.UserInputState == Enum.UserInputState.End
		or Input.UserInputState == Enum.UserInputState.Cancel
	then
		Stop()
	end

	return Stop
end

