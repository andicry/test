--// Watermark builder. `Items` picks which segments show, in this order:
--// Title, User, FPS, Ms, Date, Time. Refreshed once a second by the loop below.
Library.WatermarkTitle = "Custom Linora"
Library.WatermarkItems = { Title = true, Time = true }

--[[
	Held as a name keyed set. A multi dropdown hands its callback a map of name to bool while a
	script calling this by hand naturally passes a plain list, and the old code assumed the list,
	so every pick from the Watermark Info dropdown came out empty and the bar fell back to just
	the title. Both shapes get folded into the same set here instead of being guessed at on read.
]]
function Library:SetWatermarkItems(Items)
	local Wanted = {}

	if type(Items) == "table" then
		for Key, Value in next, Items do
			if type(Key) == "string" then
				if Value then
					Wanted[Key] = true
				end
			elseif type(Value) == "string" then
				Wanted[Value] = true
			end
		end
	end

	Library.WatermarkItems = Wanted
	Library:UpdateWatermark()
end

function Library:UpdateWatermark()
	if not Library.Watermark then
		return
	end

	local Wanted = Library.WatermarkItems or {}
	local Segments = {}

	if Wanted.Title then
		table.insert(Segments, Library.WatermarkTitle)
	end

	if Wanted.User then
		table.insert(Segments, LocalPlayer.Name)
	end

	if Wanted.FPS then
		table.insert(Segments, string.format("%d fps", Library.WatermarkFPS or 0))
	end

	if Wanted.Ms then
		local Ping = 0
		pcall(function()
			Ping = math.floor(
				game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValueString():match("%d+") or 0
			)
		end)
		table.insert(Segments, string.format("%d ms", Ping))
	end

	if Wanted.Date then
		table.insert(Segments, os.date("%d/%m/%Y"))
	end

	if Wanted.Time then
		table.insert(Segments, os.date("%H:%M:%S"))
	end

	local Text = table.concat(Segments, " | ")

	if Text == "" then
		Text = Library.WatermarkTitle
	end

	local X, Y = Library:GetTextBounds(Text, Library.FontFace, 12)
	Library.Watermark.Size = UDim2.new(0, X + 15, 0, (Y * 1.5) + 3)
	Library.WatermarkText.Text = Text
end

