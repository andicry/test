				ColorSequenceKeypoint.new(1, Color3.fromRGB(185, 185, 185)),
			}),
		})

		Library:AddToRegistry(SliderInner, {
			BackgroundColor3 = "MainColor",
			BorderColor3 = "OutlineColor",
		})

		local Fill = Library:Create("Frame", {
			BackgroundColor3 = Library.AccentColor,
			BorderColor3 = Library.AccentColorDark,
			Size = UDim2.new(0, 0, 1, 0),
			ZIndex = 7,
			Parent = SliderInner,
		})

		local Gradient = Library:Create("UIGradient", {
			Rotation = 90,
			Parent = Fill,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(185, 185, 185)),
			}),
		})

		Library:AddToRegistry(Fill, {
			BackgroundColor3 = "AccentColor",
			BorderColor3 = "AccentColorDark",
		})

		local HideBorderRight = Library:Create("Frame", {
			BackgroundColor3 = Library.AccentColor,
			BorderSizePixel = 0,
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.new(0, 1, 1, 0),
			ZIndex = 8,
			Parent = Fill,
		})

		Library:AddToRegistry(HideBorderRight, {
			BackgroundColor3 = "AccentColor",
		})

		local DisplayLabel = Library:CreateLabel({
			Size = UDim2.new(1, 0, 1, 0),
			TextSize = 12,
			Text = "Infinite",
			ZIndex = 9,
			Parent = SliderInner,
		})

		Library:OnHighlight(SliderOuter, SliderOuter, { BorderColor3 = "AccentColor" }, { BorderColor3 = "Black" })

		if type(Info.Tooltip) == "string" then
			Library:AddToolTip(Info.Tooltip, SliderOuter)
		end

		function Slider:UpdateColors()
			Fill.BackgroundColor3 = Library.AccentColor
			Fill.BorderColor3 = Library.AccentColorDark
		end

		--[[
			The bar spans a whole column, so its width is read off the frame rather than assumed.
			A drag maps the pointer across that same width, so the two have to agree. AbsoluteSize
			is zero until the frame has been laid out, and the default stands until then.
		]]
		function Slider:RefreshMaxSize()
			if SliderInner.AbsoluteSize.X > 0 then
				Slider.MaxSize = SliderInner.AbsoluteSize.X
			end
		end

		function Slider:Display()
			local Suffix = Info.Suffix or ""

			if Info.Compact then
				DisplayLabel.Text = Info.Text .. ": " .. Slider.Value .. Suffix
			elseif Info.HideMax then
				DisplayLabel.Text = string.format("%s", Slider.Value .. Suffix)
			else
				DisplayLabel.Text = string.format("%s/%s", Slider.Value .. Suffix, Slider.Max .. Suffix)
			end

			Slider:RefreshMaxSize()

			local X = math.ceil(Library:MapValue(Slider.Value, Slider.Min, Slider.Max, 0, Slider.MaxSize))
			Fill.Size = UDim2.new(0, X, 1, 0)

			HideBorderRight.Visible = not (X == Slider.MaxSize or X == 0)
		end

		function Slider:OnChanged(Func)
			Slider.Changed = Func
			Func(Slider.Value)
		end

		local function Round(Value)
			if Slider.Rounding == 0 then
				return math.floor(Value)
			end

			return tonumber(string.format("%." .. Slider.Rounding .. "f", Value))
		end

		function Slider:GetValueFromXOffset(X)
			return Round(Library:MapValue(X, 0, Slider.MaxSize, Slider.Min, Slider.Max))
		end

		function Slider:SetValue(Str)
			local Num = tonumber(Str)

			if not Num then
				return
			end

			Num = math.clamp(Num, Slider.Min, Slider.Max)

			Slider.Value = Num
			Slider:Display()

			Library:SafeCallback(Slider.Callback, Slider.Value)
			Library:SafeCallback(Slider.Changed, Slider.Value)
		end

		function Slider:SetProperty(Property, Value)
			Slider[Property] = Value
			Slider:Display()
		end

		SliderInner.InputBegan:Connect(function(Input)
			if Library:IsPrimaryInput(Input) and not Library:MouseIsOverOpenedFrame(Input) then
				Library:BindDrag(Input, function(PointerX)
					Slider:RefreshMaxSize()

					local nX = math.clamp(PointerX - SliderInner.AbsolutePosition.X, 0, Slider.MaxSize)
					local nValue = Slider:GetValueFromXOffset(nX)
					local OldValue = Slider.Value

					Slider.Value = nValue
					Slider:Display()

					if nValue ~= OldValue then
						Library:SafeCallback(Slider.Callback, Slider.Value)
						Library:SafeCallback(Slider.Changed, Slider.Value)
					end
				end, function()
					Library:AttemptSave()
				end)
			end
		end)

		Slider:Display()
		Groupbox:AddBlank(Info.BlankSize or 6)
		Groupbox:Resize()

		Options[Idx] = Slider

		return Slider
	end

	--[[
		A row of points on a grid, each dragged up or down, with the line between them drawn
		as a run of small squares.

		Only Y moves. X is pinned to the grid column the point was created on, so the whole
		curve is one number per point and a config can hold it as a plain array. Dragging goes
		through BindDrag for the same reason every other drag in here does - a polling loop on
		IsMouseButtonPressed takes neither a drag nor a click while the escape menu is open.
	]]
	function Funcs:AddCurve(Idx, Info)
		Info = Info or {}

		local PointCount = math.max(2, Info.Points or 9)
		local Divisions = PointCount - 1
		local Thickness = math.max(1, Info.Thickness or 1)

		local Curve = {
			Value = {},
			Points = {},
			Lines = {},
			PointCount = PointCount,
			Height = Info.Height or 150,
			Type = "Curve",
			Callback = Info.Callback or function(Value) end,
		}

		local Groupbox = self
		local Container = Groupbox.Container

		if Info.Text then
			Library:CreateLabel({
				Size = UDim2.new(1, 0, 0, 15),
				TextSize = 12,
				Text = Info.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 5,
				Parent = Container,
			})

			Groupbox:AddBlank(1)
		end

		local CurveOuter = Library:Create("Frame", {
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderColor3 = Color3.new(0, 0, 0),
			Size = UDim2.new(1, -4, 0, Curve.Height),
			ZIndex = 5,
			Parent = Container,
		})

		local CurveInner = Library:Create("Frame", {
			BackgroundColor3 = Library.MainColor,
			BorderColor3 = Library.OutlineColor,
			BorderMode = Enum.BorderMode.Inset,
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = 6,
			Parent = CurveOuter,
		})

		Library:AddToRegistry(CurveOuter, {
			BorderColor3 = "Black",
		})

		Library:AddToRegistry(CurveInner, {
			BackgroundColor3 = "MainColor",
			BorderColor3 = "OutlineColor",
		})

		Library:Create("UIGradient", {
			Rotation = 90,
			Parent = CurveInner,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(235, 235, 235)),
			}),
		})

		--// Inset instead of clipped, so the points sitting on the far left and right edges are
		--// drawn whole rather than sliced in half by the border.
		local Canvas = Library:Create("Frame", {
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 6, 0, 6),
			Size = UDim2.new(1, -12, 1, -12),
			ZIndex = 7,
			Parent = CurveInner,
		})

		for i = 1, Divisions - 1 do
			local Column = Library:Create("Frame", {
				BackgroundColor3 = Library.OutlineColor,
				BorderSizePixel = 0,
				Position = UDim2.new(i / Divisions, 0, 0, 0),
				Size = UDim2.new(0, 1, 1, 0),
				ZIndex = 7,
				Parent = Canvas,
			})

			local Row = Library:Create("Frame", {
				BackgroundColor3 = Library.OutlineColor,
				BorderSizePixel = 0,
				Position = UDim2.new(0, 0, i / Divisions, 0),
				Size = UDim2.new(1, 0, 0, 1),
				ZIndex = 7,
				Parent = Canvas,
			})

			Library:AddToRegistry(Column, {
				BackgroundColor3 = "OutlineColor",
			})

			Library:AddToRegistry(Row, {
				BackgroundColor3 = "OutlineColor",
			})
		end

		--[[
			One thin frame per segment, rotated to the angle between its two points, which is the
			same way an FOV circle is drawn. It reads as a single continuous stroke instead of a
			run of dots, and consecutive segments share an endpoint so the joints close up.

			The pool is fixed, so a drag only ever moves and re-rotates what already exists.
		]]
		for i = 1, Divisions do
			local Line = Library:Create("Frame", {
				BackgroundColor3 = Library.AccentColor,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(1, Thickness),
				Visible = false,
				ZIndex = 8,
				Parent = Canvas,
			})

			Library:AddToRegistry(Line, {
				BackgroundColor3 = "AccentColor",
			})

			Curve.Lines[i] = Line
		end

		for i = 1, PointCount do
			local X = (i - 1) / Divisions
			local Y = 0.5

			if type(Info.Default) == "table" then
				local Given = Info.Default[i]

				if type(Given) == "table" then
					Given = Given.Y
				end

				if type(Given) == "number" then
					Y = math.clamp(Given, 0, 1)
				end
			end

			local PointFrame = Library:Create("Frame", {
				BackgroundColor3 = Library.AccentColor,
				BorderColor3 = Color3.new(0, 0, 0),
				BorderSizePixel = 1,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(X, 0, Y, 0),
				Size = UDim2.fromOffset(8, 8),
				ZIndex = 9,
				Parent = Canvas,
			})

			Library:AddToRegistry(PointFrame, {
				BackgroundColor3 = "AccentColor",
			})

			Curve.Points[i] = { Frame = PointFrame, Index = i, X = X, Y = Y }
			Curve.Value[i] = Y
		end

		Library:OnHighlight(CurveOuter, CurveOuter, { BorderColor3 = "AccentColor" }, { BorderColor3 = "Black" })

		if type(Info.Tooltip) == "string" then
			Library:AddToolTip(Info.Tooltip, CurveOuter)
		end

		function Curve:Redraw()
			local Size = Canvas.AbsoluteSize

			--// A rotated frame has to be sized in pixels, so there is nothing to lay out until
			--// the canvas has a real size. On a tab that has not been opened yet it is still
			--// zero, which is what the AbsoluteSize signal further down is for.
			if Size.X <= 0 or Size.Y <= 0 then
				return
			end

			for i = 1, Divisions do
				local From = Curve.Points[i]
				local To = Curve.Points[i + 1]
				local Line = Curve.Lines[i]

				local X1, Y1 = From.X * Size.X, From.Y * Size.Y
				local X2, Y2 = To.X * Size.X, To.Y * Size.Y
				local dX, dY = X2 - X1, Y2 - Y1
				local Length = math.sqrt(dX * dX + dY * dY)

				Line.Position = UDim2.fromOffset(math.floor((X1 + X2) * 0.5 + 0.5), math.floor((Y1 + Y2) * 0.5 + 0.5))
				Line.Size = UDim2.fromOffset(math.max(1, math.ceil(Length)), Thickness)
				Line.Rotation = math.deg(math.atan2(dY, dX))
				Line.Visible = true
			end
		end

		function Curve:GetPoints()
			local Points = {}

			for i = 1, PointCount do
				local Point = Curve.Points[i]

				Points[i] = { Index = i, X = Point.X, Y = Point.Y }
			end

			return Points
		end

		function Curve:OnChanged(Func)
			Curve.Changed = Func
			Func(Curve.Value)
		end

		--// Takes a plain array of Y values, or the { X = , Y = } rows GetPoints hands back, so
		--// a config written from either shape loads.
		function Curve:SetValue(Value)
			if type(Value) ~= "table" then
				return
			end

			for i = 1, PointCount do
				local Point = Curve.Points[i]
				local New = Value[i]

				if type(New) == "table" then
					New = New.Y
				end

				if type(New) == "number" then
					Point.Y = math.clamp(New, 0, 1)
					Curve.Value[i] = Point.Y
					Point.Frame.Position = UDim2.new(Point.X, 0, Point.Y, 0)
				end
			end

			Curve:Redraw()

			Library:SafeCallback(Curve.Callback, Curve.Value)
			Library:SafeCallback(Curve.Changed, Curve.Value)
		end

		function Curve:SetCurvePoints(Value)
			Curve:SetValue(Value)
		end

		--[[
			A press anywhere on the canvas grabs the point nearest the pointer by column and
			drags that one, so a plain click on a point lands on it and a sweep across the box
			pulls each column to the cursor in turn.
		]]
		Canvas.InputBegan:Connect(function(Input)
			if not Library:IsPrimaryInput(Input) or Library:MouseIsOverOpenedFrame(Input) then
				return
			end

			local StartX = Library:GetInputPosition(Input)
			local Width = Canvas.AbsoluteSize.X
			local Point = Curve.Points[1]

			if Width > 0 then
				local nX = (StartX - Canvas.AbsolutePosition.X) / Width
				local Closest = math.huge

				for i = 1, PointCount do
					local Distance = math.abs(Curve.Points[i].X - nX)

					if Distance < Closest then
						Closest = Distance
						Point = Curve.Points[i]
					end
				end
			end

			Library:BindDrag(Input, function(PointerX, PointerY)
				local Height = Canvas.AbsoluteSize.Y

				if Height <= 0 then
					return
				end

				local nY = math.clamp((PointerY - Canvas.AbsolutePosition.Y) / Height, 0, 1)
				local OldY = Point.Y

				Point.Y = nY
				Curve.Value[Point.Index] = nY
				Point.Frame.Position = UDim2.new(Point.X, 0, nY, 0)

				Curve:Redraw()

				if nY ~= OldY then
					Library:SafeCallback(Curve.Callback, Curve.Value)
					Library:SafeCallback(Curve.Changed, Curve.Value)
				end
			end, function()
				Library:AttemptSave()
			end)
		end)

		Canvas:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			Curve:Redraw()
		end)

		Curve:Redraw()

		Groupbox:AddBlank(Info.BlankSize or 6)
		Groupbox:Resize()

		if Idx then
			Options[Idx] = Curve
		end

		return Curve
	end

	--[[
		A dark panel holding one image, scaled to fit rather than stretched. A skin render is
		what it was built for.

		Info.Image goes through Library:ResolveImage, so an asset id number, an rbxassetid
		string, bare digits or an http URL all work. OutlineColorIdx takes a theme key, so the
		border can follow the accent colour instead of sitting on the default outline grey.
	]]
	function Funcs:AddImage(Idx, Info)
		Info = Info or {}

		local Image = {
			Value = Info.Image,
			Height = Info.Height or 150,
			Type = "Image",
		}

		local Groupbox = self
		local Container = Groupbox.Container
		local OutlineIdx = Info.OutlineColorIdx or "OutlineColor"

		if Info.Text then
			Library:CreateLabel({
				Size = UDim2.new(1, 0, 0, 15),
