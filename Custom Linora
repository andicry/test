				Text = Info.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 5,
				Parent = Container,
			})

			Groupbox:AddBlank(1)
		end

		local ImageOuter = Library:Create("Frame", {
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderColor3 = Color3.new(0, 0, 0),
			Size = UDim2.new(1, -4, 0, Image.Height),
			ZIndex = 5,
			Parent = Container,
		})

		local ImageInner = Library:Create("Frame", {
			BackgroundColor3 = Library.BackgroundColor,
			BorderColor3 = Library[OutlineIdx] or Library.OutlineColor,
			BorderMode = Enum.BorderMode.Inset,
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = 6,
			Parent = ImageOuter,
		})

		Library:AddToRegistry(ImageOuter, {
			BorderColor3 = "Black",
		})

		Library:AddToRegistry(ImageInner, {
			BackgroundColor3 = "BackgroundColor",
			BorderColor3 = OutlineIdx,
		})

		local Render = Library:Create("ImageLabel", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 6, 0, 6),
			Size = UDim2.new(1, -12, 1, -12),
			ScaleType = Info.ScaleType or Enum.ScaleType.Fit,
			ImageTransparency = Info.Transparency or 0,
			Image = Library:ResolveImage(Info.Image) or "",
			ZIndex = 7,
			Parent = ImageInner,
		})

		if type(Info.Tooltip) == "string" then
			Library:AddToolTip(Info.Tooltip, ImageOuter)
		end

		--// Nil or an id that will not resolve empties the panel rather than leaving the last
		--// skin on screen, which would read as the wrong one being selected
		function Image:SetImage(Src)
			Image.Value = Src
			Render.Image = Library:ResolveImage(Src) or ""
		end

		function Image:SetTransparency(Value)
			Render.ImageTransparency = Value or 0
		end

		--// Resize only counts visible children, so hiding the panel closes the gap it left
		function Image:SetVisible(Bool)
			ImageOuter.Visible = not not Bool

			Groupbox:Resize()
		end

		Groupbox:AddBlank(Info.BlankSize or 6)
		Groupbox:Resize()

		if Idx then
			Options[Idx] = Image
		end

		return Image
	end

	function Funcs:AddDropdown(Idx, Info)
