--// Grabs every transparency property under Root so the fade anims can drive them
--// back to the exact values the theme gave them.
local function CollectFadeTargets(Root)
	local Targets = {}

	local function Add(Inst)
		if Inst:IsA("GuiObject") then
			table.insert(Targets, { Inst, "BackgroundTransparency", Inst.BackgroundTransparency })
		end

		if Inst:IsA("TextLabel") or Inst:IsA("TextButton") or Inst:IsA("TextBox") then
			table.insert(Targets, { Inst, "TextTransparency", Inst.TextTransparency })
			table.insert(Targets, { Inst, "TextStrokeTransparency", Inst.TextStrokeTransparency })
		end

		if Inst:IsA("ImageLabel") or Inst:IsA("ImageButton") then
			table.insert(Targets, { Inst, "ImageTransparency", Inst.ImageTransparency })
		end
	end

	Add(Root)

	for _, Desc in next, Root:GetDescendants() do
		Add(Desc)
	end

	return Targets
end

--// Alpha 1 = fully visible, 0 = fully transparent.
local function ApplyFade(Targets, Alpha)
	for _, Target in next, Targets do
		local Inst, Prop, Base = Target[1], Target[2], Target[3]

		if Inst.Parent then
			Inst[Prop] = 1 - ((1 - Base) * Alpha)
		end
	end
end

function Library:Notify(Text, Time)
	local XSize, YSize = Library:GetTextBounds(Text, Library.FontFace, 12)

	YSize = YSize + 7

	local AnimTime = Library.NotificationAnimTime or 0.35
	local InAnim = Library:GetNotificationAnim(Library.NotificationInAnim)
	local OutAnim = Library:GetNotificationAnim(Library.NotificationOutAnim)

	--// The list layout owns the holder's position, so the anim moves the box inside it.
	local NotifyHolder = Library:Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(0, XSize + 8 + 4, 0, YSize),
		ZIndex = 100,
		Parent = Library.NotificationArea,
	})

	local NotifyOuter = Library:Create("Frame", {
		BorderColor3 = Color3.new(0, 0, 0),
		Position = InAnim.From,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 100,
		Parent = NotifyHolder,
	})

	Library:CreateGlow(NotifyOuter, {
		Size = 24,
		ZIndex = 99,
	})

	local NotifyInner = Library:Create("Frame", {
		BackgroundColor3 = Library.MainColor,
		BorderColor3 = Library.OutlineColor,
		BorderMode = Enum.BorderMode.Inset,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 101,
		Parent = NotifyOuter,
	})

	Library:AddToRegistry(NotifyInner, {
		BackgroundColor3 = "MainColor",
		BorderColor3 = "OutlineColor",
	}, true)

	local InnerFrame = Library:Create("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Position = UDim2.new(0, 1, 0, 1),
		Size = UDim2.new(1, -2, 1, -2),
		ZIndex = 102,
		Parent = NotifyInner,
	})

	local Gradient = Library:Create("UIGradient", {
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Library:GetDarkerColor(Library.MainColor)),
			ColorSequenceKeypoint.new(1, Library.MainColor),
		}),
		Rotation = 90,
		Parent = InnerFrame,
	})

	Library:AddToRegistry(Gradient, {
		Color = function()
			return ColorSequence.new({
				ColorSequenceKeypoint.new(0, Library:GetDarkerColor(Library.MainColor)),
				ColorSequenceKeypoint.new(1, Library.MainColor),
			})
		end,
	})

	local NotifyLabel = Library:CreateLabel({
		Position = UDim2.new(0, 4, 0, 0),
		Size = UDim2.new(1, -4, 1, 0),
		Text = Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 12,
		ZIndex = 103,
		Parent = InnerFrame,
	})

	local FadeTargets = CollectFadeTargets(NotifyOuter)

	local function Slide(Goal, Style, Direction)
		local Tween = TweenService:Create(
			NotifyOuter,
			TweenInfo.new(AnimTime, Style, Direction),
			{ Position = Goal }
		)

		Tween:Play()

		return Tween
	end

	local function Fade(From, To)
		ApplyFade(FadeTargets, From)

		task.spawn(function()
			local Start = os.clock()

			while NotifyOuter.Parent do
				local Alpha = math.clamp((os.clock() - Start) / AnimTime, 0, 1)

				ApplyFade(FadeTargets, From + ((To - From) * Alpha))

				if Alpha >= 1 then
					break
				end

				RenderStepped:Wait()
			end
		end)
	end

	if InAnim.Fade then
		Fade(0, 1)
	end

	Slide(UDim2.new(0, 0, 0, 0), InAnim.Style, Enum.EasingDirection.Out)

	task.spawn(function()
		task.wait(Time or 5)

		if not NotifyOuter.Parent then
			return
		end

		if OutAnim.Fade then
			Fade(1, 0)
		end

		--// Back easing overshoots on the way out too, which is what sells the bounce.
		Slide(
			OutAnim.To,
			OutAnim.Style,
			OutAnim.Style == Enum.EasingStyle.Back and Enum.EasingDirection.In or Enum.EasingDirection.Out
		)

		task.wait(AnimTime)

		NotifyHolder:Destroy()
	end)
end

function Library:CreateWindow(...)
	local Arguments = { ... }
	local Config = { AnchorPoint = Vector2.zero }

	if type(...) == "table" then
		Config = ...
	else
		Config.Title = Arguments[1]
		Config.AutoShow = Arguments[2] or false
	end

	if type(Config.Title) ~= "string" then
		Config.Title = "No title"
	end
	--[[
		The tab row is always one connected strip, so whatever a script asks for here is dropped.
		Plenty of scripts were written against other Linora forks and pass TabPadding = 8 out of
		habit, and honouring that is what put the seams between the tabs. The field is still read
		so those scripts keep loading, it just cannot pull the row apart any more.
	]]
	Config.TabPadding = 0
	if type(Config.MenuFadeTime) ~= "number" then
		Config.MenuFadeTime = 0.2
	end

	if typeof(Config.Position) ~= "UDim2" then
		Config.Position = UDim2.fromOffset(175, 50)
	end
	local MobileAutoHeight = false

	if typeof(Config.Size) ~= "UDim2" then
		--[[
			600 of height is taller than a phone screen, so the desktop default would run the window
			off the bottom with no way to reach the lower tabs. On mobile the height follows the
			viewport instead and keeps a little room at the edges, and the camera is read defensively
			because it can still be nil in the first frames of a join.
		]]
		if Library.IsMobile then
			local Camera = workspace.CurrentCamera
			local ViewportY = Camera and Camera.ViewportSize.Y or 600

			Config.Size = UDim2.fromOffset(550, math.clamp(ViewportY - 35, 200, 600))
			MobileAutoHeight = true
		else
			Config.Size = UDim2.fromOffset(550, 600)
		end
	end

	if Config.Center then
		Config.AnchorPoint = Vector2.new(0.5, 0.5)
		Config.Position = UDim2.fromScale(0.5, 0.5)
	end

	local Window = {
		Tabs = {},
	}

	local Outer = Library:Create("Frame", {
		AnchorPoint = Config.AnchorPoint,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Position = Config.Position,
		Size = Config.Size,
		Visible = false,
		ZIndex = 1,
		Parent = ScreenGui,
	})

	Library:MakeDraggable(Outer, 25, true)

	--[[
		Rotating a phone swaps the viewport dimensions, so a window sized for portrait would hang off
		the bottom in landscape with the lower tabs out of reach. Only the height this library picked
		itself follows the viewport, so a script that asked for an explicit size still gets it, and
		only the height moves because the two columns are scaled and reflow on their own.
	]]
	if Library.IsMobile and MobileAutoHeight then
		local Camera = workspace.CurrentCamera

		if Camera then
			Library:GiveSignal(Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
				Config.Size =
					UDim2.fromOffset(Config.Size.X.Offset, math.clamp(Camera.ViewportSize.Y - 35, 200, 600))

				Outer.Size = Config.Size
			end))
		end
	end

	--// 24 of bleed keeps the falloff crossing the window edge. The slice border bands always draw
	--// at their natural 21px whatever the frame size, so a bigger bleed pushes the whole gradient
	--// clear of the frame and the glow reads as a separate rectangle floating around the window.
	local Glow = Library:CreateGlow(Outer, {
		Size = 24,
		ZIndex = 0,
	})

	Library.Glow = Glow

	local Inner = Library:Create("Frame", {
		BackgroundColor3 = Library.MainColor,
		BorderColor3 = Library.AccentColor,
		BorderMode = Enum.BorderMode.Inset,
		Position = UDim2.new(0, 1, 0, 1),
		Size = UDim2.new(1, -2, 1, -2),
		ZIndex = 1,
		Parent = Outer,
	})

	Library:AddToRegistry(Inner, {
		BackgroundColor3 = "MainColor",
		BorderColor3 = "AccentColor",
	})

	--[[
		Title sits centred in the bar, game name goes on the far right in the accent colour. The
		title measures itself against its own glyphs rather than filling the bar, because the name
		animation is a gradient and a gradient spans whatever it is parented to. On a full width
		label the band would spend most of its travel crossing empty bar either side of the text.

		Only the X axis is centred. This label's parent is the window frame rather than a bar of
		its own, so centring on Y as well lands the name halfway down the window behind the
		groupboxes instead of in the strip along the top.
	]]
	local WindowLabel = Library:CreateLabel({
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(0, 0, 0, 25),
		Text = Config.Title or "",
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 1,
		Parent = Inner,
	})

	Library.WindowTitleLabel = WindowLabel
	Library:SetAnimateTitle(Library.AnimateTitle)

	local GameNameLabel = Library:CreateLabel({
		Position = UDim2.new(1, -7, 0, 0),
		Size = UDim2.new(0, 0, 0, 25),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 1,
		Parent = Inner,
	})

	--// CreateLabel signs every label up for FontColor, so move this one over to the accent
	Library:RemoveFromRegistry(GameNameLabel)
	GameNameLabel.TextColor3 = Library.AccentColor
	Library:AddToRegistry(GameNameLabel, {
		TextColor3 = "AccentColor",
	})

	--[[
		GetProductInfo is an http round trip and it yields, so it runs on its own thread and the
		label fills itself in whenever the answer lands. The window is on screen well before that
		and never waits on it, and a lookup that fails just leaves the label empty.
	]]
	task.spawn(function()
		local Ok, Info = pcall(function()
			return MarketplaceService:GetProductInfo(game.PlaceId)
		end)

		if Ok and type(Info) == "table" and type(Info.Name) == "string" then
			GameNameLabel.Text = Info.Name
		end
	end)

	local MainSectionOuter = Library:Create("Frame", {
		BackgroundColor3 = Library.BackgroundColor,
		BorderColor3 = Library.OutlineColor,
		Position = UDim2.new(0, 8, 0, 25),
		Size = UDim2.new(1, -16, 1, -33),
		ZIndex = 1,
		Parent = Inner,
	})

	Library:AddToRegistry(MainSectionOuter, {
		BackgroundColor3 = "BackgroundColor",
		BorderColor3 = "OutlineColor",
	})

	local MainSectionInner = Library:Create("Frame", {
		BackgroundColor3 = Library.BackgroundColor,
		BorderColor3 = Color3.new(0, 0, 0),
		BorderMode = Enum.BorderMode.Inset,
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 1,
		Parent = MainSectionOuter,
	})

	Library:AddToRegistry(MainSectionInner, {
		BackgroundColor3 = "BackgroundColor",
	})

	local TabArea = Library:Create("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 8, 0, 8),
		Size = UDim2.new(1, -16, 0, 21),
		ZIndex = 1,
		Parent = MainSectionInner,
	})

	local TabListLayout = Library:Create("UIListLayout", {
		Padding = UDim.new(0, Config.TabPadding),
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = TabArea,
	})

	--// Tab widths are worked out in whole pixels instead of handing the row over to
	--// UIFlexAlignment.Fill. Flex splits the leftover space into fractions and those
	--// fractions land on screen as random 1px seams, which is why the tabs sometimes
	--// stopped looking connected. Every tab starts at the width its own text needs and
	--// whatever is left over gets shared out a pixel at a time, so the row adds up to
	--// exactly TabArea's width every single run. No gaps, no dead space at the end.
	local TabButtons = {}

	local function ResizeTabs()
		local Count = #TabButtons

		if Count == 0 then
			return
		end

		local Row = TabArea.AbsoluteSize.X

		--// AddTab usually runs before the window has ever been laid out, and AbsoluteSize
		--// is still 0 that early, so work the width out from the frame chain instead. The
		--// AbsoluteSize signal below puts it right the moment the real size lands.
		if Row <= 0 then
			Row = Outer.AbsoluteSize.X

			if Row <= 0 then
				Row = Config.Size.X.Offset
			end

			--// Inner takes 2, MainSectionOuter takes 16, TabArea takes another 16
			Row = Row - 34
		end

		local Space = Row - (Config.TabPadding * (Count - 1))

		--// Not even a pixel each, leave the tabs alone rather than collapse them
		if Space < Count then
			return
		end

		--// SetLayoutOrder can shuffle the row after the fact, so hand the spare pixels out
		--// in the order the tabs are actually drawn in. Index breaks the tie because
		--// table.sort is not stable and every tab sits at LayoutOrder 0 by default.
		table.sort(TabButtons, function(A, B)
			if A.Button.LayoutOrder == B.Button.LayoutOrder then
				return A.Index < B.Index
			end

			return A.Button.LayoutOrder < B.Button.LayoutOrder
		end)

		local Used = 0

		for _, Entry in next, TabButtons do
			Used = Used + Entry.MinWidth
		end

		--// Share goes negative when the names are too wide to fit, which trims every tab
		--// evenly instead of letting the last one hang off the edge of the window
		local Leftover = Space - Used
		local Share = math.floor(Leftover / Count)
		local Remainder = Leftover - (Share * Count)

		for Idx, Entry in ipairs(TabButtons) do
			local Width = Entry.MinWidth + Share + (Idx <= Remainder and 1 or 0)

			Entry.Button.Size = UDim2.new(0, Width, 1, 0)
		end
	end

	--// Refit on resize so a different window size never leaves the row short or overhanging
	TabArea:GetPropertyChangedSignal("AbsoluteSize"):Connect(ResizeTabs)

	local TabContainer = Library:Create("Frame", {
		BackgroundColor3 = Library.MainColor,
		BorderColor3 = Library.OutlineColor,
		Position = UDim2.new(0, 8, 0, 30),
		Size = UDim2.new(1, -16, 1, -38),
		ZIndex = 2,
		Parent = MainSectionInner,
	})

	Library:AddToRegistry(TabContainer, {
		BackgroundColor3 = "MainColor",
		BorderColor3 = "OutlineColor",
	})

	function Window:SetWindowTitle(Title)
		WindowLabel.Text = Title

		--// The label resizes around the new name, so the band is rebuilt to match its new width
		if Library.AnimateTitle then
			Library:SetAnimateTitle(true)
		end
	end

	function Window:AddTab(Name)
		local Tab = {
			Groupboxes = {},
			Tabboxes = {},
		}

		local TabButtonWidth = Library:GetTextBounds(Name, Library.FontFace, 16)

		--[[
			No border on a tab. The outline grey was drawing a ring around every single tab, so a
			row of them read as a row of separate boxes instead of one connected strip. The tab you
			are on is still obvious without it, because it fills with MainColor and gets the accent
			line across the top.
		]]
		local TabButton = Library:Create("Frame", {
			BackgroundColor3 = Library.BackgroundColor,
			BorderSizePixel = 0,
			Size = UDim2.new(0, TabButtonWidth + 8 + 4, 1, 0),
			ZIndex = 1,
			Parent = TabArea,
		})

		--// The width the label needs plus its side padding. ResizeTabs treats this as the
		--// floor for this tab and shares the rest of the row out from there.
		table.insert(TabButtons, {
			Button = TabButton,
			Index = #TabButtons + 1,
			MinWidth = math.ceil(TabButtonWidth) + 8 + 4,
		})

		local Gradient = Library:Create("UIGradient", {
			Rotation = -90,
			Parent = TabButton,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(185, 185, 185)),
			}),
		})

		Library:AddToRegistry(TabButton, {
			BackgroundColor3 = "BackgroundColor",
		})

		local TabButtonLabel = Library:CreateLabel({
			Position = UDim2.new(0, 0, 0, 0),
			Size = UDim2.new(1, 0, 1, -1),
			Text = Name,
			ZIndex = 1,
			Parent = TabButton,
		})

		local ColorLine = Library:Create("Frame", {
			BackgroundColor3 = Library.AccentColor,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 1),
			ZIndex = 2,
			Parent = TabButton,
			Visible = false
		})

		Library:AddToRegistry(ColorLine, {
			BackgroundColor3 = "AccentColor",
		})

		local Blocker = Library:Create("Frame", {
			BackgroundColor3 = Library.MainColor,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundTransparency = 1,
			ZIndex = 3,
			Parent = TabButton,
		})

		Library:AddToRegistry(Blocker, {
			BackgroundColor3 = "MainColor",
		})

		local TabFrame = Library:Create("Frame", {
			Name = "TabFrame",
			BackgroundTransparency = 1,
			Position = UDim2.new(0, 0, 0, 0),
			Size = UDim2.new(1, 0, 1, 0),
			Visible = false,
			ZIndex = 2,
			Parent = TabContainer,
		})

		local Gradient = Library:Create("UIGradient", {
			Rotation = -90,
			Parent = TabFrame,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(185, 185, 185)),
			}),
		})

		--[[
			Both sides fill the tab frame instead of carrying a fixed pixel height.

			They used to be 509px tall no matter how big the window was, so a column with more
			groupboxes than that would hang straight out of the bottom of the window with no way
			to reach what was cut off. Sizing to (1, -14) keeps them inside the frame at every
			window size and lets the scrolling frame do what it was already there to do.
		]]
		local LeftSide = Library:Create("ScrollingFrame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 8 - 1, 0, 8 - 1),
			Size = UDim2.new(0.5, -12 + 2, 1, -14),
			CanvasSize = UDim2.new(0, 0, 0, 0),
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarThickness = 0,
			ZIndex = 2,
			Parent = TabFrame,
		})

		local RightSide = Library:Create("ScrollingFrame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.new(0.5, 4 + 1, 0, 8 - 1),
			Size = UDim2.new(0.5, -12 + 2, 1, -14),
			CanvasSize = UDim2.new(0, 0, 0, 0),
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarThickness = 0,
			ZIndex = 2,
			Parent = TabFrame,
		})


		--// Two columns, left and right. Groupboxes stack down whichever side they were
		--// added to and the side scrolls on its own once it runs out of room.
		--// Side: 1 = left, 2 = right
		local function GetSide(Side)
			return Side == 1 and LeftSide or RightSide
		end

		Library:Create("UIListLayout", {
			Padding = UDim.new(0, 8),
			FillDirection = Enum.FillDirection.Vertical,
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Parent = LeftSide,
		})

		Library:Create("UIListLayout", {
			Padding = UDim.new(0, 8),
			FillDirection = Enum.FillDirection.Vertical,
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Parent = RightSide,
		})

		--[[
			Keep the canvas the same height as the stack of groupboxes.

			The bar itself stays hidden - ScrollBarThickness is 0 everywhere in this library on
			purpose, since a visible bar down the side of a column looks bad. A ScrollingFrame
			with no bar still scrolls on the wheel, so the canvas height is the only thing that
			has to be right for a long column to be reachable.
		]]
		local function RefreshSide(Side)
			Side.CanvasSize = UDim2.fromOffset(0, Side.UIListLayout.AbsoluteContentSize.Y)
		end

		for _, Side in next, { LeftSide, RightSide } do
			Side:WaitForChild("UIListLayout")

			Side.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
				RefreshSide(Side)
			end)

			Side:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
				RefreshSide(Side)
			end)

			RefreshSide(Side)
		end

		function Tab:ShowTab()
			for _, Tab in next, Window.Tabs do
				Tab:HideTab()
			end

			Blocker.BackgroundTransparency = 0
			TabButton.BackgroundColor3 = Library.MainColor
			ColorLine.Visible = true
			Library.RegistryMap[TabButton].Properties.BackgroundColor3 = "MainColor"

			TabFrame.Visible = true
		end

		function Tab:HideTab()
			Blocker.BackgroundTransparency = 1
			TabButton.BackgroundColor3 = Library.BackgroundColor
			ColorLine.Visible = false
			Library.RegistryMap[TabButton].Properties.BackgroundColor3 = "BackgroundColor"
			TabFrame.Visible = false
		end

		function Tab:SetLayoutOrder(Position)
			TabButton.LayoutOrder = Position
			TabListLayout:ApplyLayout()

			--// The spare pixels follow the drawing order, so they move with the tab
			ResizeTabs()
		end

		function Tab:AddGroupbox(Info)
			local Groupbox = {}

			local BoxOuter = Library:Create("Frame", {
				BackgroundColor3 = Library.BackgroundColor,
				BorderColor3 = Library.OutlineColor,
				BorderMode = Enum.BorderMode.Inset,
				Size = UDim2.new(1, 0, 0, 507 + 2),
				ZIndex = 2,
				Parent = GetSide(Info.Side),
			})

			Library:AddToRegistry(BoxOuter, {
				BackgroundColor3 = "BackgroundColor",
				BorderColor3 = "OutlineColor",
			})

			local BoxInner = Library:Create("Frame", {
				BackgroundColor3 = Library.BackgroundColor,
				BorderColor3 = Color3.new(0, 0, 0),
				-- BorderMode = Enum.BorderMode.Inset;
				Size = UDim2.new(1, -2, 1, -2),
				Position = UDim2.new(0, 1, 0, 1),
				ZIndex = 4,
				Parent = BoxOuter,
			})

			Library:AddToRegistry(BoxInner, {
				BackgroundColor3 = "BackgroundColor",
			})

			local Highlight = Library:Create("Frame", {
				BackgroundColor3 = Library.AccentColor,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 2),
				ZIndex = 5,
				Parent = BoxInner,
			})

			Library:AddToRegistry(Highlight, {
				BackgroundColor3 = "AccentColor",
			})

			local GroupboxLabel = Library:CreateLabel({
				Size = UDim2.new(1, 0, 0, 18),
				Position = UDim2.new(0, 4, 0, 2),
				TextSize = 12,
				Text = Info.Name,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 5,
				Parent = BoxInner,
			})

			local Container = Library:Create("Frame", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 4, 0, 20),
				Size = UDim2.new(1, -4, 1, -20),
				ZIndex = 1,
				Parent = BoxInner,
			})

			Library:Create("UIListLayout", {
				FillDirection = Enum.FillDirection.Vertical,
				SortOrder = Enum.SortOrder.LayoutOrder,
				Parent = Container,
			})

			function Groupbox:Resize()
				local Size = 0

				for _, Element in next, Groupbox.Container:GetChildren() do
					if (not Element:IsA("UIListLayout")) and Element.Visible then
						Size = Size + Element.Size.Y.Offset
					end
				end

				BoxOuter.Size = UDim2.new(1, 0, 0, 20 + Size + 2 + 2)
			end

			Groupbox.Container = Container
			setmetatable(Groupbox, BaseGroupbox)

			Groupbox:AddBlank(3)
			Groupbox:Resize()

			Tab.Groupboxes[Info.Name] = Groupbox

			return Groupbox
		end

		function Tab:AddScrollbox(Info)
			local Scrollbox = {}

			local FixedHeight = Info.Height or 200

			local BoxOuter = Library:Create("Frame", {
				BackgroundColor3 = Library.BackgroundColor,
				BorderColor3 = Library.OutlineColor,
				BorderMode = Enum.BorderMode.Inset,
				Size = UDim2.new(1, 0, 0, FixedHeight + 2),
				ZIndex = 2,
				Parent = GetSide(Info.Side),
			})

			Library:AddToRegistry(BoxOuter, {
