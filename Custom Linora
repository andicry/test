--[[
	Measures the keybind list and resizes its frame around it. Lives here rather than inside a
	keypicker because the list also has to be sized when there is not a single keypicker around,
	and because every picker was running the same measurement against the same children anyway.
]]
function Library:UpdateKeybindFrame()
	if not Library.KeybindFrame or not Library.KeybindContainer then
		return
	end

	local YSize = 0
	local XSize = 0
	local Count = 0

	for _, Label in next, Library.KeybindContainer:GetChildren() do
		if Label:IsA("TextLabel") and Label ~= Library.KeybindEmptyLabel and Label.Visible then
			Count = Count + 1
			YSize = YSize + 18

			if Label.TextBounds.X > XSize then
				XSize = Label.TextBounds.X
			end
		end
	end

	--// Nothing bound, so the placeholder takes the row instead of leaving a bare strip
	if Library.KeybindEmptyLabel then
		Library.KeybindEmptyLabel.Visible = Count == 0

		if Count == 0 then
			YSize = 18
		end
	end

	Library.KeybindFrame.Size = UDim2.new(0, math.max(XSize + 10, 210), 0, YSize + 25)
end

