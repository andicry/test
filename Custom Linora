do
	--[[
		Weather is drawn inside the menu, not into the world. Every flake is a plain frame on a full
		screen layer sitting behind the window, which is why the amount is a count of particles and
		not an emission rate, and why 120 of them is the whole budget.

		All of it is gated on the menu being open. The layer lives in the ScreenGui, so leaving it
		running while the window is hidden would rain over a screen with no UI on it.
	]]
	local WeatherLayer = Library:Create("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 0,
		Parent = ScreenGui,
	})

	Library.WeatherLayer = WeatherLayer

	function Library:ClearWeatherParticles()
		for Idx = #Library.WeatherParticles, 1, -1 do
			local Particle = table.remove(Library.WeatherParticles, Idx)

			if Particle.Instance then
				Particle.Instance:Destroy()
			end
		end
	end

	--// Rain is a fast straight streak, snow is a slow square that drifts sideways
	local function StyleParticle(Particle, IsRain)
		Particle.Instance.BackgroundColor3 = IsRain and Color3.fromRGB(120, 170, 255)
			or Color3.fromRGB(255, 255, 255)
		Particle.Instance.Size = IsRain and UDim2.fromOffset(2, 14) or UDim2.fromOffset(4, 4)

		if IsRain then
			Particle.Speed = math.max(Particle.Speed, 0.9)
			Particle.Drift = 0
		else
			Particle.Speed = math.min(Particle.Speed, 0.34)
		end
	end

	function Library:RefreshWeatherEffect()
		local Enabled = Library.Toggled and Library.WeatherEffect ~= "Off" and Library.WeatherAmount > 0

		WeatherLayer.Visible = Enabled

		if not Enabled then
			Library:ClearWeatherParticles()
			return
		end

		local IsRain = Library.WeatherEffect == "Rain"
		local TargetCount = math.clamp(math.floor(Library.WeatherAmount), 0, 120)

		while #Library.WeatherParticles > TargetCount do
			local Particle = table.remove(Library.WeatherParticles)

			if Particle and Particle.Instance then
				Particle.Instance:Destroy()
			end
		end

		--[[
			Y starts negative so a fresh particle is already above the top edge and falls in rather
			than popping into the middle of the screen, and X is random so the pool does not come
			down as a single column.
		]]
		while #Library.WeatherParticles < TargetCount do
			Library.WeatherParticles[#Library.WeatherParticles + 1] = {
				Instance = Library:Create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					BackgroundColor3 = Color3.new(1, 1, 1),
					BorderSizePixel = 0,
					Size = UDim2.fromOffset(4, 4),
					ZIndex = 0,
					Parent = WeatherLayer,
				}),
				X = math.random(),
				Y = -math.random(),
				Speed = IsRain and (0.9 + math.random() * 1.1) or (0.12 + math.random() * 0.22),
				Drift = IsRain and 0 or ((math.random() - 0.5) * 0.03),
			}
		end

		--// Switching between rain and snow restyles what is already falling instead of rebuilding
		for _, Particle in next, Library.WeatherParticles do
			StyleParticle(Particle, IsRain)
		end
	end

	--// "Off" | "Rain" | "Snow"
	function Library:SetWeatherEffect(Effect)
		if Effect ~= "Rain" and Effect ~= "Snow" then
			Effect = "Off"
		end

		Library.WeatherEffect = Effect
		Library:RefreshWeatherEffect()
	end

	--// Particle count, 0 to 120. 0 clears the effect without forgetting which one is picked.
	function Library:SetWeatherAmount(Amount)
		Library.WeatherAmount = math.clamp(math.floor(tonumber(Amount) or 0), 0, 120)
		Library:RefreshWeatherEffect()
	end

	--// Invisible layer means the menu is shut, and then this costs one boolean read per frame
	Library:GiveSignal(RenderStepped:Connect(function(Delta)
		if not WeatherLayer.Visible then
			return
		end

		for _, Particle in next, Library.WeatherParticles do
			Particle.Y = Particle.Y + (Particle.Speed * Delta)
			Particle.X = Particle.X + (Particle.Drift * Delta)

			--// Off the bottom, or drifted out either side, and it goes back up a fresh column
			if Particle.Y > 1.1 or Particle.X < -0.1 or Particle.X > 1.1 then
				Particle.X = math.random()
				Particle.Y = -0.05 - math.random() * 0.3
			end

			Particle.Instance.Position = UDim2.new(Particle.X, 0, Particle.Y, 0)
		end
	end))
end

--// Toggles the library's built-in Drawing cursor. The system cursor comes back
--// automatically when this is off or the menu is closed.
Library.AnimateTitle = false

--[[
	Runs a soft accent band along the window name, left to right, on a two second loop. It is a
	UIGradient rather than a colour tween because a gradient on a TextLabel tints the glyphs it
	crosses and leaves the rest of the name alone, which is the part that reads as an animation
	sweeping through rather than the whole title changing colour at once.

	The band is registered against the theme so picking a new accent recolours it in place, and
	the gradient is torn down when the toggle goes off so the name is plain white again.
]]
function Library:SetAnimateTitle(Bool)
	Library.AnimateTitle = Bool and true or false

	local Label = Library.WindowTitleLabel

	if Library.TitleGradient then
		Library:RemoveFromRegistry(Library.TitleGradient)
		Library.TitleGradient:Destroy()
		Library.TitleGradient = nil
	end

	--// Bumping this is what retires the loop belonging to the previous gradient
	Library.TitleAnimGeneration = (Library.TitleAnimGeneration or 0) + 1

	if not Library.AnimateTitle or not Label or not Label.Parent then
		return
	end

	--// Half the width of the band, so the accent covers a little under a third of the name
	local Half = 0.3

	local function Sequence()
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0, Library.FontColor),
			ColorSequenceKeypoint.new(0.5 - Half, Library.FontColor),
			ColorSequenceKeypoint.new(0.5, Library.AccentColor),
			ColorSequenceKeypoint.new(0.5 + Half, Library.FontColor),
			ColorSequenceKeypoint.new(1, Library.FontColor),
		})
	end

	local Gradient = Instance.new("UIGradient")
	Gradient.Color = Sequence()
	Gradient.Parent = Label

	Library.TitleGradient = Gradient

	--// A function entry means the registry rebuilds the sequence itself on a theme change
	Library:AddToRegistry(Gradient, {
		Color = Sequence,
	})

	local Mine = Library.TitleAnimGeneration
	local Start = os.clock()

	task.spawn(function()
		while Library.TitleAnimGeneration == Mine and Gradient.Parent do
			--// Offset walks -1 to 1 so the band enters off one edge and leaves by the other
			Gradient.Offset = Vector2.new((((os.clock() - Start) / 2) % 2) - 1, 0)

			RenderStepped:Wait()
		end
	end)
end

