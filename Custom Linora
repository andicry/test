--[[
	Speed Graph

	A draggable HUD box plotting horizontal speed over time.

	The line is a fixed pool of thin rotated frames, so a redraw only moves what already
	exists. The original version built a Drawing object per segment and threw all of them away
	every frame, which is both the choppiness and the reason it could never sit inside its own
	border - Drawing renders in screen space and ignores ClipsDescendants.
]]
function Library:CreateSpeedGraph(Config)
	Config = Config or {}

	local SpeedGraph = {
		Visible = true,
		SpeedHistory = {},
		Lines = {},
		MaxHistory = math.max(2, Config.MaxHistory or 150),
		MaxSpeed = math.max(1, Config.MaxSpeed or 200),
		MinScale = math.max(1, Config.MinScale or 20),
		AutoScale = Config.AutoScale ~= false,
		Interval = Config.Interval or 0.05,
		Thickness = Config.Thickness or 1,
		LineColorIdx = Config.LineColorIdx or "FontColor",
		Clock = 0,
	}

	SpeedGraph.Scale = SpeedGraph.MinScale

	local GraphOuter = Library:Create("Frame", {
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Position = Config.Position or UDim2.fromOffset(50, 50),
		Size = Config.Size or UDim2.fromOffset(300, 200),
		ZIndex = 50,
		Parent = ScreenGui,
	})

	local GraphInner = Library:Create("Frame", {
		BackgroundColor3 = Library.MainColor,
		BorderColor3 = Library.AccentColor,
		BorderMode = Enum.BorderMode.Inset,
		Position = UDim2.new(0, 1, 0, 1),
		Size = UDim2.new(1, -2, 1, -2),
		ZIndex = 51,
		Parent = GraphOuter,
	})

	Library:AddToRegistry(GraphInner, {
		BackgroundColor3 = "MainColor",
		BorderColor3 = "AccentColor",
	})

	Library:CreateLabel({
		Position = UDim2.new(0, 7, 0, 0),
		Size = UDim2.new(1, -14, 0, 20),
		TextSize = 14,
		Text = Config.Title or "Speed Graph",
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 52,
		Parent = GraphInner,
	})

	local VelocityLabel = Library:CreateLabel({
		Position = UDim2.new(1, -107, 0, 0),
		Size = UDim2.new(0, 100, 0, 20),
		TextSize = 14,
		Text = "Velocity: 0.0",
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 52,
		Parent = GraphInner,
	})

	local GraphFrame = Library:Create("Frame", {
		BackgroundColor3 = Library.BackgroundColor,
		BorderColor3 = Library.OutlineColor,
		Position = UDim2.new(0, 8, 0, 25),
		Size = UDim2.new(1, -16, 1, -33),
		ClipsDescendants = true,
		ZIndex = 51,
		Parent = GraphInner,
	})

	local GraphContent = Library:Create("Frame", {
		BackgroundColor3 = Library.BackgroundColor,
		BorderColor3 = Color3.new(0, 0, 0),
		BorderMode = Enum.BorderMode.Inset,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 51,
		Parent = GraphFrame,
	})

	Library:AddToRegistry(GraphFrame, {
		BackgroundColor3 = "BackgroundColor",
		BorderColor3 = "OutlineColor",
	})

	Library:AddToRegistry(GraphContent, {
		BackgroundColor3 = "BackgroundColor",
		BorderColor3 = "Black",
	})

	local function BuildPool()
		for Idx = #SpeedGraph.Lines, 1, -1 do
			SpeedGraph.Lines[Idx]:Destroy()
			SpeedGraph.Lines[Idx] = nil
		end

		for i = 1, SpeedGraph.MaxHistory - 1 do
			local Line = Library:Create("Frame", {
				BackgroundColor3 = Library[SpeedGraph.LineColorIdx],
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(1, SpeedGraph.Thickness),
				Visible = false,
				ZIndex = 52,
				Parent = GraphContent,
			})

			Library:AddToRegistry(Line, {
				BackgroundColor3 = SpeedGraph.LineColorIdx,
			})

			SpeedGraph.Lines[i] = Line
		end
	end

	local function HideLines()
		for i = 1, #SpeedGraph.Lines do
			SpeedGraph.Lines[i].Visible = false
		end
	end

	local function Redraw()
		local Count = #SpeedGraph.SpeedHistory
		local Size = GraphContent.AbsoluteSize

		if Count < 2 or Size.X <= 0 or Size.Y <= 0 then
			HideLines()

			return
		end

		local Scale = SpeedGraph.MaxSpeed

		if SpeedGraph.AutoScale then
			local Peak = SpeedGraph.MinScale

			for i = 1, Count do
				if SpeedGraph.SpeedHistory[i] > Peak then
					Peak = SpeedGraph.SpeedHistory[i]
				end
			end

			--// Eased, so the whole plot does not jump every time a new peak lands
			SpeedGraph.Scale = SpeedGraph.Scale + (Peak - SpeedGraph.Scale) * 0.15
			Scale = math.max(SpeedGraph.Scale, 1)
		end

		--// Newest sample pinned to the right edge, so a graph that has not filled up yet
		--// grows inward instead of sitting squashed against the left border
		local Step = Size.X / (SpeedGraph.MaxHistory - 1)
		local Offset = Size.X - (Count - 1) * Step

		local function PointAt(i)
			local Height = math.clamp(SpeedGraph.SpeedHistory[i] / Scale, 0, 1)

			return Offset + (i - 1) * Step, Size.Y - Height * Size.Y
		end

		for i = 1, #SpeedGraph.Lines do
			local Line = SpeedGraph.Lines[i]

			if i < Count then
				local X1, Y1 = PointAt(i)
				local X2, Y2 = PointAt(i + 1)
				local dX, dY = X2 - X1, Y2 - Y1
				local Length = math.sqrt(dX * dX + dY * dY)

				Line.Position = UDim2.fromOffset(math.floor((X1 + X2) * 0.5 + 0.5), math.floor((Y1 + Y2) * 0.5 + 0.5))
				Line.Size = UDim2.fromOffset(math.max(1, math.ceil(Length)), SpeedGraph.Thickness)
				Line.Rotation = math.deg(math.atan2(dY, dX))
				Line.Visible = true
			else
				Line.Visible = false
			end
		end
	end

	function SpeedGraph:UpdateSpeed(Delta)
		if not SpeedGraph.Visible then
			return
		end

		local Character = LocalPlayer.Character
		local Root = Character and Character:FindFirstChild("HumanoidRootPart")

		if not Root then
			return
		end

		local Velocity = Root.AssemblyLinearVelocity
		local Speed = math.sqrt(Velocity.X * Velocity.X + Velocity.Z * Velocity.Z)

		VelocityLabel.Text = string.format("Velocity: %.1f", Speed)

		--// Sampled off a clock rather than once per frame, so how much history the box shows
		--// stays the same whether the game is running at 30 or 240
		SpeedGraph.Clock = SpeedGraph.Clock + (Delta or 0)

		if SpeedGraph.Clock < SpeedGraph.Interval then
			return
		end

		SpeedGraph.Clock = 0

		table.insert(SpeedGraph.SpeedHistory, Speed)

		while #SpeedGraph.SpeedHistory > SpeedGraph.MaxHistory do
			table.remove(SpeedGraph.SpeedHistory, 1)
		end

		Redraw()
	end

	function SpeedGraph:SetVisible(Bool)
		SpeedGraph.Visible = not not Bool
		GraphOuter.Visible = SpeedGraph.Visible

		if not SpeedGraph.Visible then
			table.clear(SpeedGraph.SpeedHistory)

			SpeedGraph.Scale = SpeedGraph.MinScale
			VelocityLabel.Text = "Velocity: 0.0"

			HideLines()
		end
	end

	--// Rebuilds the pool, otherwise a raised max history has nowhere to draw the extra
	--// segments and the graph stops growing past its old length
	function SpeedGraph:SetMaxHistory(Value)
		SpeedGraph.MaxHistory = math.max(2, Value or 150)

		while #SpeedGraph.SpeedHistory > SpeedGraph.MaxHistory do
			table.remove(SpeedGraph.SpeedHistory, 1)
		end

		BuildPool()
		Redraw()
	end

	--// Only used while auto scale is off, so setting one does not quietly undo the other
	function SpeedGraph:SetMaxSpeed(Value)
		SpeedGraph.MaxSpeed = math.max(1, Value or 200)

		Redraw()
	end

	function SpeedGraph:SetAutoScale(Bool)
		SpeedGraph.AutoScale = not not Bool

		Redraw()
	end

	function SpeedGraph:SetInterval(Value)
		SpeedGraph.Interval = math.max(0, Value or 0.05)
	end

	function SpeedGraph:Destroy()
		for Idx = #Library.SpeedGraphInstances, 1, -1 do
			if Library.SpeedGraphInstances[Idx] == SpeedGraph then
				table.remove(Library.SpeedGraphInstances, Idx)
			end
		end

		GraphOuter:Destroy()
	end

	GraphContent:GetPropertyChangedSignal("AbsoluteSize"):Connect(Redraw)

	Library:GiveSignal(RenderStepped:Connect(function(Delta)
		if not GraphOuter.Visible then
			return
		end

		SpeedGraph:UpdateSpeed(Delta)
	end))

	Library:MakeDraggable(GraphOuter, 25)

	BuildPool()

	SpeedGraph.Frame = GraphOuter

	table.insert(Library.SpeedGraphInstances, SpeedGraph)

	return SpeedGraph
end

getgenv().Library = Library
return Library
