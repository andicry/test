--[[
	Turns whatever an image field holds into something an ImageLabel will take.

	Asset ids show up as numbers, as rbxassetid strings, or as bare digits depending on which
	config wrote them, and some hand over a plain http URL instead, which ImageLabel cannot load
	at all. A URL is fetched once and written to disk, because getcustomasset needs a real file,
	and the result is remembered so the same skin does not re-download every time it is picked.
]]
local ImageCache = {}

function Library:ResolveImage(Src)
	if type(Src) == "number" then
		return "rbxassetid://" .. Src
	end

	if type(Src) ~= "string" or Src == "" then
		return nil
	end

	--// rbxassetid:// and rbxthumb:// are already what we want
	if Src:match("^rbx") then
		return Src
	end

	if Src:match("^%d+$") then
		return "rbxassetid://" .. Src
	end

	if not Src:match("^https?://") then
		return nil
	end

	if ImageCache[Src] then
		return ImageCache[Src]
	end

	pcall(function()
		if not isfolder("LinoraAssets") then
			makefolder("LinoraAssets")
		end

		--// Named off the URL so the cache survives a rejoin, trimmed because a long query
		--// string makes a filename the filesystem will not take
		local File = "LinoraAssets/" .. Src:gsub("[^%w]", ""):sub(-40) .. ".png"

		if not isfile(File) then
			local Data = game:HttpGet(Src)

			if type(Data) == "string" and #Data > 100 then
				writefile(File, Data)
			end
		end

		if isfile(File) then
			ImageCache[Src] = getcustomasset(File)
		end
	end)

	return ImageCache[Src]
end

--// Fades a label made by CreateLabel. ApplyTextStroke parents a real UIStroke, so the
--// stroke has to fade along with the text or a dimmed row keeps a solid black outline
--// around ghost grey letters.
function Library:SetTextFade(Inst, Transparency)
	Inst.TextTransparency = Transparency

	local Stroke = Inst:FindFirstChildOfClass("UIStroke")

	if Stroke then
		Stroke.Transparency = Transparency
	end
end

