		local Longest = 0

		for _, Option in next, Options do
			local Size = TextService:GetTextSize(tostring(Option), 12, FONT.Medium, Vector2.new(400, 20)).X

			if Size > Longest then
				Longest = Size
			end
		end

		Button.Size = UDim2.new(0, math.clamp(Longest + 44, 104, 260), 0, 26)
	end

