function WindowMethods:AddTab(Spec)
	local Owner = self
	local Tab = {
		Id = Spec.Id,
		Label = Spec.Label,
		Icon = Spec.Icon,
		Sections = {},
	}

	local View = MakeView(self, "tab-" .. Spec.Id)
	Tab.View = View
	Tab.Scroll = View.Scroll
	Tab.Content = View.Content

	self.Views["tab-" .. Spec.Id] = View
	self.ViewsById["tab-" .. Spec.Id] = View

	table.insert(self.TabOrder, Tab)

	Tab.NavItem = MakeNavItem(self, {
		Id = Spec.Id,
		Label = Spec.Label,
		Icon = Spec.Icon,
		Order = #self.TabOrder,
	})

	table.insert(self.NavItems, Tab.NavItem)

	local Counter = 0

	function Tab:AddSection(SectionSpec)
		Counter = Counter + 1

		local Spec = {}

		for Key, Value in next, SectionSpec do
			Spec[Key] = Value
		end

		Spec.Parent = View.Content

		local Section = Owner:BuildSection(Spec, Spec.Id or Tab.Id, Counter)
		table.insert(self.Sections, Section)

		return Section
	end

	Tab.Spec = Spec

	return Tab
end

