	if Ok and Anim then
		Anim:Play()
		return Anim
	end
end

local function Lerp(A, B, T)
	return A + (B - A) * T
end

local function Mix(A, B, T)
	return Color3.new(Lerp(A.R, B.R, T), Lerp(A.G, B.G, T), Lerp(A.B, B.B, T))
end

local function HexToColor(Hex)
	if typeof(Hex) == "Color3" then
		return Hex
	end

	local S = tostring(Hex or ""):gsub("#", "")
	if #S == 3 then
		S = S:sub(1, 1):rep(2) .. S:sub(2, 2):rep(2) .. S:sub(3, 3):rep(2)
	end

	S = S:gsub("[^%x]", ""):sub(1, 6)
	while #S < 6 do
		S = S .. "0"
	end

	return Color3.fromRGB(tonumber(S:sub(1, 2), 16) or 0, tonumber(S:sub(3, 4), 16) or 0, tonumber(S:sub(5, 6), 16) or 0)
end

local function ColorToHex(Color)
	return string.format(
		"%02X%02X%02X",
		math.floor(Color.R * 255 + 0.5),
		math.floor(Color.G * 255 + 0.5),
		math.floor(Color.B * 255 + 0.5)
	)
end

local function RgbToHsv(Color)
	local R, G, B = Color.R, Color.G, Color.B
	local Max, Min = math.max(R, G, B), math.min(R, G, B)
	local Delta = Max - Min
	local H = 0

	if Delta > 0 then
		if Max == R then
			H = 60 * (((G - B) / Delta) % 6)
		elseif Max == G then
			H = 60 * ((B - R) / Delta + 2)
		else
			H = 60 * ((R - G) / Delta + 4)
		end
	end

	if H < 0 then
		H = H + 360
	end

	return H, (Max > 0 and Delta / Max or 0), Max
end

local function HsvToRgb(H, S, V)
	H = ((H % 360) + 360) % 360

	local Chroma = V * S
	local X = Chroma * (1 - math.abs((H / 60) % 2 - 1))
	local M = V - Chroma
	local R, G, B = 0, 0, 0

	if H < 60 then
		R, G = Chroma, X
	elseif H < 120 then
		R, G = X, Chroma
	elseif H < 180 then
		G, B = Chroma, X
	elseif H < 240 then
		G, B = X, Chroma
	elseif H < 300 then
		R, B = X, Chroma
	else
		R, B = Chroma, X
	end

	return Color3.new(R + M, G + M, B + M)
end

local function Gradient(Parent, Colors, Rotation)
	local Seq = {}

	for Index, Color in next, Colors do
		table.insert(Seq, ColorSequenceKeypoint.new((Index - 1) / math.max(1, #Colors - 1), Color))
	end

	return New("UIGradient", {
		Color = ColorSequence.new(Seq),
		Rotation = Rotation or 0,
		Parent = Parent,
	})
end

local function FadeGradient(Parent, From, To, Rotation, Color)
	return New("UIGradient", {
		Color = ColorSequence.new(Color or C.White),
