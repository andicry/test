	Button.MouseEnter:Connect(function()
		Tween(Button, 0.16, { BackgroundColor3 = Color3.fromRGB(32, 32, 37) })
		Tween(Border, 0.16, { Transparency = LINE2 })
		Tween(Label, 0.16, { TextColor3 = Color3.fromRGB(228, 228, 236) })
	end)

