local function MakeIndent(Parent, Depth)
	local Wrap = New("Frame", {
		Name = "Indent",
		Parent = Parent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	})

	local Rows = New("Frame", {
		Name = "Rows",
		Parent = Wrap,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, Depth > 0 and 24 or 0, 0, 0),
		Size = UDim2.new(1, Depth > 0 and -24 or 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	})

	List(Rows, 0, 0)

	if Depth > 0 then
		local Guide = New("Frame", {
			Name = "Guide",
			Parent = Wrap,
			BackgroundColor3 = C.White,
			BackgroundTransparency = LINE2,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 7, 0, 3),
			Size = UDim2.new(0, 1, 0, 0),
			ZIndex = 4,
		})

		Rows:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			local Height = math.max(0, Rows.AbsoluteSize.Y - 6)
			Guide.Size = UDim2.new(0, 1, 0, Height)
		end)

		local Fade = New("UIGradient", {
			Parent = Guide,
			Rotation = 90,
			Color = ColorSequence.new(C.White),
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.1, LINE2),
				NumberSequenceKeypoint.new(0.9, LINE2),
				NumberSequenceKeypoint.new(1, 1),
			}),
		})
	end

	return Rows
end

local function MakeGroup(Parent, Open)
	local Group = New("Frame", {
		Name = "Group",
		Parent = Parent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		ClipsDescendants = true,
	})

	local Inner = New("Frame", {
		Name = "Inner",
		Parent = Group,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	})

	List(Inner, 0, 0)

	local Api = {
		Frame = Group,
		Inner = Inner,
		Open = Open ~= false,
	}

	Inner:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if Api.Open and Group.Parent then
			Group.Size = UDim2.new(1, 0, 0, Inner.AbsoluteSize.Y)
		end
	end)

	function Api:SetOpen(Value, Animate)
		self.Open = Value and true or false

		task.spawn(function()
			RunService.Heartbeat:Wait()

			local Height = self.Open and Inner.AbsoluteSize.Y or 0

			if Animate then
				Tween(Group, 0.24, { Size = UDim2.new(1, 0, 0, Height) })
			else
				Group.Size = UDim2.new(1, 0, 0, Height)
			end
		end)
	end

	function Api:SetDimmed(Value)
		Tween(Group, 0.22, { GroupTransparency = Value and 0.5 or 0 })
	end

	return Api
end

