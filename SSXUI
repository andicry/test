	})

	local Value = New("TextLabel", {
		Name = "Value",
		Parent = Line,
		BackgroundTransparency = 1,
		Font = FONT.Mono,
		Text = "0",
		TextColor3 = C.Text3,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Right,
		Position = UDim2.new(1, 0, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.new(0, 40, 1, 0),
	})

	local Track = New("Frame", {
		Name = "Track",
		Parent = Line,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 100, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.new(1, -148, 0, 14),
		Active = true,
	})

	local Rail = New("Frame", {
		Name = "Rail",
		Parent = Track,
		BackgroundColor3 = C.Track,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 6, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.new(1, -12, 0, 4),
	})

	Corner(Rail, 99)

	local Fill = New("Frame", {
		Name = "Fill",
		Parent = Track,
		BackgroundColor3 = C.White,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 6, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.new(0, 0, 0, 4),
	})

	Corner(Fill, 99)

	local Thumb = New("Frame", {
		Name = "Thumb",
		Parent = Track,
		BackgroundColor3 = Color3.fromRGB(210, 210, 216),
		BorderSizePixel = 0,
		Position = UDim2.new(0, 6, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.new(0, 13, 0, 8),
	})

	Corner(Thumb, 4)

	local Min = Node.Min or 0
	local Max = Node.Max or 100
	local Step = Node.Step or 1
	local Decimals = Node.Decimals or 2
	local Current = tonumber(Node.Default) or Min

	if Node.Disabled then
		Track.Active = false
		Row.GroupTransparency = 0.55
	end

	local function Format(Number)
		local Rounded = tonumber(string.format("%." .. Decimals .. "f", Number)) or Number

		if Rounded == math.floor(Rounded) then
			return tostring(math.floor(Rounded))
		end

		return (tostring(Rounded):gsub("0+$", ""):gsub("%.$", ""))
	end

	local function Paint()
		local Span = math.max(Max - Min, 0.0001)
		local Alpha = math.clamp((Current - Min) / Span, 0, 1)
		local RailWidth = math.max(1, Track.AbsoluteSize.X - 12)

		Fill.Size = UDim2.new(0, RailWidth * Alpha, 0, 4)
		Thumb.Position = UDim2.new(0, 6 + RailWidth * Alpha, 0.5, 0)
		Value.Text = Format(Current)
	end

	local function Commit(New, Silent)
		New = math.clamp(New, Min, Max)
		New = math.clamp(math.floor(New / Step + 0.5) * Step, Min, Max)
		New = tonumber(string.format("%.4f", New)) or New

		if New == Current then
			return
		end

		Current = New
		Paint()

		if Node.Key then
			Node.Flags[Node.Key] = Current
		end

		if not Silent and Node.Callback then
			Node.Callback(Current)
		end
	end

	Paint()
	Track:GetPropertyChangedSignal("AbsoluteSize"):Connect(Paint)

	Track.MouseEnter:Connect(function()
		Tween(Rail, 0.18, { BackgroundColor3 = C.TrackHover })
		Tween(Thumb, 0.18, { BackgroundColor3 = C.White })
		Tween(Value, 0.18, { TextColor3 = C.Text2 })
	end)

	Track.MouseLeave:Connect(function()
		Tween(Rail, 0.18, { BackgroundColor3 = C.Track })
		Tween(Thumb, 0.18, { BackgroundColor3 = Color3.fromRGB(210, 210, 216) })
		Tween(Value, 0.18, { TextColor3 = C.Text3 })
	end)

	BindDrag(Track, function(X)
		if Node.Disabled then
			return
		end

		local Span = math.max(Max - Min, 0.0001)
		local RailWidth = math.max(1, Track.AbsoluteSize.X - 12)
		local Offset = (X * Track.AbsoluteSize.X - 6) / RailWidth

		Commit(Min + math.clamp(Offset, 0, 1) * Span)
	end, function()
		if Node.Key then
			Node.Save()
		end
	end)

	local Api = {}

	function Api:SetValue(Value, Silent)
		Commit(Value, Silent ~= false)
		Paint()
	end

	function Api:GetValue()
		return Current
	end

	Api.Object = Track

	return Api
end

