local function KeyLabel(Key)
	if typeof(Key) == "string" then
		return Key
	end

	if not Key then
		return "Unbound"
	end

	local Name = Key.Name

	if KEY_LABELS[Name] then
		return KEY_LABELS[Name]
	end

	local Numpad = Name:match("^Keypad(%a+)$")

	if Numpad and #Numpad == 1 then
		return "Num " .. Numpad
	end

	return Name
end

local function KeyFromLabel(Label)
	if Label == "Unbound" or Label == "" or Label == nil then
		return nil
	end

	for Name, Value in next, KEY_LABELS do
		if Value == Label then
			local Ok, Code = pcall(function()
				return Enum.KeyCode[Name]
			end)

			if Ok then
				return Code
			end
		end
	end

	local Ok, Code = pcall(function()
		return Enum.KeyCode[Label]
	end)

	return Ok and Code or nil
end

local function BindDrag(Target, OnMove, OnEnd)
	local Active = false

	local function Fire(Input)
		local Rel = Input.Position - Target.AbsolutePosition

		OnMove(
			math.clamp(Rel.X / math.max(1, Target.AbsoluteSize.X), 0, 1),
			math.clamp(Rel.Y / math.max(1, Target.AbsoluteSize.Y), 0, 1)
		)
	end

	Target.InputBegan:Connect(function(Input)
		if
			Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch
		then
			Active = true
			Fire(Input)
		end
	end)

	UserInputService.InputChanged:Connect(function(Input)
		if not Active then
			return
		end

		if
			Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch
		then
			Fire(Input)
		end
	end)

	UserInputService.InputEnded:Connect(function(Input)
		if not Active then
			return
		end

		if
			Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch
		then
			Active = false

			if OnEnd then
				OnEnd()
			end
		end
	end)
end

local function MakeDraggable(Frame, Handle, GetScale)
	local Dragging, DragStart, StartPos

	Handle.InputBegan:Connect(function(Input)
		if
			Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch
		then
			Dragging = true
			DragStart = Input.Position
			StartPos = Frame.Position

			Input.Changed:Connect(function()
				if Input.UserInputState == Enum.UserInputState.End then
					Dragging = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(Input)
		if not Dragging then
			return
		end

		if
			Input.UserInputType == Enum.UserInputType.MouseMovement
			or Input.UserInputType == Enum.UserInputType.Touch
		then
			local Scale = GetScale and GetScale() or 1
			local Delta = (Input.Position - DragStart) / Scale

			Frame.Position = UDim2.new(
				StartPos.X.Scale,
				StartPos.X.Offset + Delta.X,
				StartPos.Y.Scale,
				StartPos.Y.Offset + Delta.Y
			)
		end
	end)
end

local ActivePopup = nil

local function ClosePopup()
	local Popup = ActivePopup

	if not Popup then
		return
	end

	ActivePopup = nil

	if Popup.OnClose then
		pcall(Popup.OnClose)
	end

	if Popup.Anchor and Popup.AnchorRestore then
		pcall(function()
			Popup.AnchorRestore()
		end)
	end

	local Frame = Popup.Frame
	local Blocker = Popup.Blocker

	Tween(Frame, 0.14, { GroupTransparency = 1 })

	task.delay(0.15, function()
		if Frame then
			Frame:Destroy()
		end

		if Blocker then
			Blocker:Destroy()
		end
	end)
end

local function ShowPopup(Layer, Anchor, Frame, Options)
	ClosePopup()

	local O = Options or {}
	local Blocker = New("TextButton", {
		Name = "PopupBlocker",
		Parent = Layer,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = Layer.ZIndex + 1,
		Visible = true,
	})

	Frame.ZIndex = Layer.ZIndex + 2
	Frame.Parent = Layer
	Frame.GroupTransparency = 1

	local AnchorPos = Anchor.AbsolutePosition - Layer.AbsolutePosition
	local Width = Frame.AbsoluteSize.X
	local Height = Frame.AbsoluteSize.Y
	local LayerSize = Layer.AbsoluteSize

	local Left = AnchorPos.X

	if O.Align == "Right" then
		Left = Left + Anchor.AbsoluteSize.X - Width
	end

	Left = math.clamp(Left, 8, math.max(8, LayerSize.X - Width - 8))

	local Top = AnchorPos.Y + Anchor.AbsoluteSize.Y + 6
	local Up = false

	if Top + Height > LayerSize.Y - 8 then
		local Above = AnchorPos.Y - Height - 6

		if Above > 8 then
			Top = Above
			Up = true
		else
			Top = math.max(8, LayerSize.Y - Height - 8)
		end
	end

	Frame.Position = UDim2.new(0, Left, 0, Top)
	Frame.AnchorPoint = Up and Vector2.new(0, 1) or Vector2.new(0, 0)

	if Up then
		Frame.Position = UDim2.new(0, Left, 0, Top + Height)
	end

	Frame.GroupTransparency = 0.35
	Tween(Frame, 0.18, { GroupTransparency = 0 })

	Blocker.MouseButton1Click:Connect(function()
		ClosePopup()
	end)

	ActivePopup = {
		Frame = Frame,
		Blocker = Blocker,
		Anchor = Anchor,
		OnClose = O.OnClose,
	}

	return Frame
end

UserInputService.InputBegan:Connect(function(Input)
	if not ActivePopup then
		return
	end

	if Input.KeyCode == Enum.KeyCode.Escape then
		ClosePopup()
	end
end)

