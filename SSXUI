	})

	local Label = New("TextLabel", {
		Name = "Label",
		Parent = Line,
		BackgroundTransparency = 1,
		Font = FONT.Medium,
		Text = Cap(Node.Label),
		TextColor3 = Color3.fromRGB(207, 207, 217),
