local function MakeButton(Parent, Text, IconName, Ghost, Order)
	local Button = New("TextButton", {
		Name = "Button",
		Parent = Parent,
		BackgroundColor3 = Ghost and C.Panel2 or C.Panel2,
		BackgroundTransparency = Ghost and 1 or 0,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Size = UDim2.new(0, 0, 0, 30),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = Order or 0,
	})

	Corner(Button, 9)

	if not Ghost then
		Stroke(Button, 1, C.White, LINE)
	end

	Pad(Button, 0, 13, 0, 13)

	local Row = New("Frame", {
		Name = "Row",
		Parent = Button,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
	})

	New("UIListLayout", {
		Parent = Row,
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 7),
	})

	local IconImage = nil

	if IconName then
		IconImage = Icon(Row, IconName, 13, C.Text4, 0, 0)
	end

	local Label = New("TextLabel", {
		Name = "Label",
		Parent = Row,
		BackgroundTransparency = 1,
		Font = FONT.Medium,
		Text = Text or "Button",
		TextColor3 = C.Text2,
		TextSize = 12,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		LayoutOrder = 1,
	})

	Button.MouseEnter:Connect(function()
		if not Ghost then
			Tween(Button, 0.16, { BackgroundColor3 = Color3.fromRGB(32, 32, 37) })

			if ButtonBorder then
				Tween(ButtonBorder, 0.16, { Transparency = LINE2 })
			end
		else
			Tween(Button, 0.16, { BackgroundColor3 = C.White, BackgroundTransparency = 0.95 })
		end

		Tween(Label, 0.16, { TextColor3 = C.White })

		if IconImage then
			Tween(IconImage, 0.16, { ImageColor3 = C.Text2 })
		end
	end)

	Button.MouseLeave:Connect(function()
		if not Ghost then
			Tween(Button, 0.16, { BackgroundColor3 = C.Panel2 })

			if ButtonBorder then
				Tween(ButtonBorder, 0.16, { Transparency = LINE })
			end
		else
			Tween(Button, 0.16, { BackgroundTransparency = 1 })
		end

		Tween(Label, 0.16, { TextColor3 = C.Text2 })

		if IconImage then
			Tween(IconImage, 0.16, { ImageColor3 = C.Text4 })
		end
	end)

	return Button, Label
end

