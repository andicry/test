			LayoutOrder = 2,
		})

		List(Rows, 0, 0)

		Section.Rows = Rows
		Section.RowsContainer = Rows

		if Spec.toggle then
			local Switch = MakeSwitch(HeadRight, ToggleValue, function(Value)
				self.Flags[ToggleKey] = Value
				self:Save()
			end, 0)

			self.Controls[ToggleKey] = Switch
		end
	end

	if Spec.toggle then
		self.Flags[ToggleKey] = ToggleValue
	end

	if Spec.bind then
		self.Controls[Spec.bind] = self.Controls[Spec.bind] or {}
	end

	Section.Spec = Spec
	Section.ToggleKey = ToggleKey
	Section.Index = Index
	Section.RowsContainer = Section.Rows

