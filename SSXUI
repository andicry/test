					Name = "Name",
					Parent = Row,
					BackgroundTransparency = 1,
					Font = FONT.Medium,
					Text = Config.Name,
					TextColor3 = Color3.fromRGB(210, 210, 220),
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					Position = UDim2.new(0, 18, 0, 0),
					Size = UDim2.new(0.5, 0, 1, 0),
				})

				New("TextLabel", {
					Name = "Tag",
					Parent = Row,
					BackgroundTransparency = 1,
					Font = FONT.Mono,
					Text = Config.Tag,
					TextColor3 = C.Text4,
					TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
					Position = UDim2.new(0, 118, 0, 0),
					Size = UDim2.new(0, 90, 1, 0),
				})

				local Actions = New("Frame", {
					Name = "Actions",
					Parent = Row,
					BackgroundTransparency = 1,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, 0, 0.5, 0),
					Size = UDim2.new(0, 0, 1, 0),
					AutomaticSize = Enum.AutomaticSize.X,
				})

				New("UIListLayout", {
					Parent = Actions,
					FillDirection = Enum.FillDirection.Horizontal,
					VerticalAlignment = Enum.VerticalAlignment.Center,
					SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, 4),
				})

				local Load = MakeButton(Actions, "Load", "check", true, 0)
				Load.Size = UDim2.new(0, 0, 0, 28)

				Load.MouseButton1Click:Connect(function()
					for _, Other in next, Owner.Configs do
						Other.Active = false
					end

					Config.Active = true
					Owner:Save()
					Owner:LoadConfig(Config.Name)
					Rebuild()

					if OnChange then
						OnChange()
					end

					Owner:Notify("Loaded " .. Config.Name, 1.9)
				end)

				local Share = MakeButton(Actions, "Share", "share", true, 1)
				Share.Size = UDim2.new(0, 0, 0, 28)

				Share.MouseButton1Click:Connect(function()
					CopyToClipboard("https://ssx.lol/c/" .. Config.Name:lower():gsub("[^%a%d]", ""), "Share link copied")
				end)

				Row.MouseEnter:Connect(function()
					Tween(Row, 0.16, { BackgroundTransparency = 0.965 })
					Tween(Border, 0.16, { Transparency = LINE })
				end)

				Row.MouseLeave:Connect(function()
					Tween(Row, 0.16, { BackgroundTransparency = 0.986 })
					Tween(Border, 0.16, { Transparency = 1 })
				end)
			end
		end

		local Import = MakeButton(Head, "Import", "down", false, 0)
		Import.MouseButton1Click:Connect(function()
			Owner:OpenImport()
		end)

		local New_ = MakeButton(Head, "New Config", "plus", false, 1)
		New_.MouseButton1Click:Connect(function()
			local Count = #Owner.Configs + 1

			table.insert(Owner.Configs, {
				Name = "Config " .. Count,
				Tag = "custom",
				Active = false,
			})

			Owner:Save()
			Rebuild()
			Owner:Notify("Created Config " .. Count, 1.9)
		end)

		Rebuild()

		Panel.RefreshConfigs = Rebuild
		Owner.RefreshConfigs = Rebuild

		return ListHolder
	end

	return Panel
end

function WindowMethods:OpenImport()
	self.Modal.Visible = true
	Tween(self.Modal, 0.2, { GroupTransparency = 0 })
	task.delay(0.12, function()
		self.ImportBox:CaptureFocus()
	end)
end

function WindowMethods:CloseImport()
	Tween(self.Modal, 0.2, { GroupTransparency = 1 })
	task.delay(0.22, function()
		self.Modal.Visible = false
	end)

	self.ImportBox.Text = ""
end

function WindowMethods:LoadSchema(Tabs)
	for _, Spec in next, Tabs do
		local Tab = self:AddTab({
			Id = Spec.id or Spec.Id,
			Label = Spec.label or Spec.Label,
			Icon = Spec.icon or Spec.Icon,
		})

		for _, SectionSpec in next, (Spec.sections or Spec.Sections or {}) do
			local Fields = {}

			for Key, Value in next, SectionSpec do
				if Key ~= "children" and Key ~= "Children" then
					Fields[Key] = Value
				end
			end

			local Section = Tab:AddSection(Fields)

			RenderNodes(
				self,
				Section.RowsContainer or Section.Rows,
				SectionSpec.children or SectionSpec.Children or {},
				0,
				Section
			)
		end
	end
end

function WindowMethods:ConfigPath(Name)
	return self.Folder .. "/" .. Name .. ".json"
end

function WindowMethods:Save()
	if self.SaveTimer then
		task.cancel(self.SaveTimer)
	end

	self.SaveTimer = task.delay(0.25, function()
		self.SaveTimer = nil

		EnsureFolder(self.Folder)

		WriteJSON(self.Folder .. "/autoload.json", {
			Theme = self.ThemeId,
			Game = self.GameId,
			Flags = self.Flags,
		})
	end)
end

function WindowMethods:ListConfigs()
	local Names = {}

	for _, Config in next, self.Configs do
		table.insert(Names, Config.Name)
	end

	return Names
end

function WindowMethods:SaveConfig(Name)
	EnsureFolder(self.Folder)

	local Ok = WriteJSON(self:ConfigPath(Name), {
		Theme = self.ThemeId,
		Game = self.GameId,
		Flags = self.Flags,
	})

	if Ok then
		self:Notify("Saved " .. Name, 1.9)
	else
		self:Notify("Could not write " .. Name, 1.9)
	end

	return Ok
end

function WindowMethods:LoadConfig(Name)
	local Data = ReadJSON(self:ConfigPath(Name), nil)

	if not Data then
		return false
	end

	if Data.Theme then
		self:SetTheme(Data.Theme)
	end

	if Data.Game then
		self:SetGame(Data.Game)
	end

	if Data.Flags then
		for Key, Value in next, Data.Flags do
			self:SetFlag(Key, Value, true)
		end
	end

	return true
end

function WindowMethods:DeleteConfig(Name)
	if FileSupported() and typeof(delfile) == "function" then
		local Ok = pcall(function()
			delfile(self:ConfigPath(Name))
		end)

		if not Ok then
			return false
		end
	end

	for Index, Config in next, self.Configs do
		if Config.Name == Name then
			table.remove(self.Configs, Index)
			break
		end
	end

	self:Save()

	if self.RefreshConfigs then
		self.RefreshConfigs()
	end

	return true
end

function WindowMethods:ShowGameGrid()
	if ActivePopup and ActivePopup.Anchor == self.SiteButton then
		ClosePopup()
		return
	end

	local Rows = math.ceil(#self.Games / 2)

	local Popup = New("Frame", {
		Name = "GameGrid",
		BackgroundColor3 = C.Popup,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 376, 0, 8 + 23 + Rows * 34 + math.max(0, Rows - 1) * 3 + 8),
	})

	Corner(Popup, 11)
	Stroke(Popup, 1, C.White, LINE2)

	local Head = New("TextLabel", {
		Name = "Head",
		Parent = Popup,
		BackgroundTransparency = 1,
		Font = FONT.Bold,
		Text = "GAME",
		TextColor3 = C.Text4,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		Position = UDim2.new(0, 9, 0, 7),
		Size = UDim2.new(1, -18, 0, 16),
	})

	local Grid = New("Frame", {
		Name = "Grid",
		Parent = Popup,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(0, 8, 0, 31),
		Size = UDim2.new(1, -16, 1, -39),
	})

	New("UIGridLayout", {
		Parent = Grid,
		CellSize = UDim2.new(0.5, -2, 0, 34),
		CellPadding = UDim2.new(0, 3, 0, 3),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})

	for Index, Game in next, self.Games do
		local Item = New("TextButton", {
			Name = Game.Id,
			Parent = Grid,
			BackgroundColor3 = C.White,
			BackgroundTransparency = Game.Id == self.GameId and 0.925 or 1,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = Index,
		})

		Corner(Item, 8)
		Pad(Item, 0, 8, 0, 8)

		local Inner = New("Frame", {
			Name = "Inner",
			Parent = Item,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, 0),
		})

		New("UIListLayout", {
			Parent = Inner,
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 9),
		})

		local Chip = New("Frame", {
			Name = "Chip",
			Parent = Inner,
			BackgroundColor3 = HexToColor(Game.Colors[1]),
			BorderSizePixel = 0,
			Size = UDim2.new(0, 18, 0, 18),
			LayoutOrder = 0,
		})

		Corner(Chip, 6)
		Gradient(Chip, { HexToColor(Game.Colors[1]), HexToColor(Game.Colors[2]) }, 45)

		New("TextLabel", {
			Name = "Letter",
			Parent = Chip,
			BackgroundTransparency = 1,
			Font = FONT.Bold,
			Text = Game.Letter,
			TextColor3 = C.White,
			TextSize = 9,
			Size = UDim2.new(1, 0, 1, 0),
		})

		local Name = New("TextLabel", {
			Name = "Name",
			Parent = Inner,
			BackgroundTransparency = 1,
			Font = FONT.Medium,
			Text = Game.Name,
			TextColor3 = Game.Id == self.GameId and C.White or C.Text2,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Size = UDim2.new(1, -60, 1, 0),
			LayoutOrder = 1,
		})

		local Dots = New("Frame", {
			Name = "Dots",
			Parent = Inner,
			BackgroundTransparency = 1,
			Size = UDim2.new(0, 16, 0, 6),
			LayoutOrder = 2,
		})

		New("UIListLayout", {
			Parent = Dots,
			FillDirection = Enum.FillDirection.Horizontal,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 3),
		})

		for ColorIndex, Hex in next, Game.Colors do
			local Dot = New("Frame", {
				Name = "Dot",
				Parent = Dots,
				BackgroundColor3 = HexToColor(Hex),
				BorderSizePixel = 0,
				Size = UDim2.new(0, 4, 0, 4),
				LayoutOrder = ColorIndex,
			})

			Corner(Dot, 99)
		end

		Item.MouseEnter:Connect(function()
			if Game.Id ~= self.GameId then
				Tween(Item, 0.14, { BackgroundTransparency = 0.945 })
				Tween(Name, 0.14, { TextColor3 = C.Text })
			end
		end)

		Item.MouseLeave:Connect(function()
			if Game.Id ~= self.GameId then
				Tween(Item, 0.14, { BackgroundTransparency = 1 })
				Tween(Name, 0.14, { TextColor3 = C.Text2 })
			end
		end)

		Item.MouseButton1Click:Connect(function()
			self:SetGame(Game.Id)

			for _, Other in next, Grid:GetChildren() do
				if Other:IsA("GuiObject") and Other.Name ~= "UIGridLayout" then
					local IsCurrent = Other.Name == Game.Id

					Tween(Other, 0.14, { BackgroundTransparency = IsCurrent and 0.925 or 1 })

					local OtherInner = Other:FindFirstChild("Inner")
					local OtherName = OtherInner and OtherInner:FindFirstChild("Name")

					if OtherName then
						Tween(OtherName, 0.14, { TextColor3 = IsCurrent and C.White or C.Text2 })
					end
				end
			end

			ClosePopup()
			self:Notify("Game: " .. Game.Name, 1.9)
		end)
	end

	ShowPopup(self.Layer, self.SiteButton, Popup, {})

	return Popup
end

function WindowMethods:SetFlag(Key, Value, Silent)
	self.Flags[Key] = Value

	local Control = self.Controls[Key]

	if Control and Control.SetValue then
		pcall(function()
			Control:SetValue(Value)
		end)
	end

	if not Silent then
		self:Save()
	end
end

function WindowMethods:GetFlag(Key)
	return self.Flags[Key]
end

function WindowMethods:Destroy()
	ClosePopup()
	self.Root:Destroy()

	if ToastStack and ToastStack.Parent then
		ToastStack:Destroy()
		ToastStack = nil
	end
end

function WindowMethods:Boot()
	self.AccentColors = nil
	self:SetTheme(self.ThemeId)
	self:SetGame(self.GameId)

	self.HomePosition = self.Wrap.Position

	if self.Flags["menu.bind"] then
		self:SetToggleKey(self.Flags["menu.bind"])
	end

	MakeDraggable(self.Wrap, self.Titlebar, function()
		return self.ScaleObject.Scale
	end)

	self.Wrap:GetPropertyChangedSignal("Position"):Connect(function()
		self:SyncHandle()
	end)

	self.Wrap:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:SyncHandle()
	end)

	BindDrag(self.Scrollbar, function(X)
		local View = self.ActiveView

		if not View or not View.Scroll then
			return
		end

		local Scroll = View.Scroll
		local KnobWidth = self.Knob.AbsoluteSize.X
		local Progress = math.clamp((X * 52 - KnobWidth / 2) / math.max(1, 52 - KnobWidth), 0, 1)
		local Max = math.max(0, Scroll.AbsoluteCanvasSize.Y - Scroll.AbsoluteWindowSize.Y)

		Scroll.CanvasPosition = Vector2.new(Scroll.CanvasPosition.X, Progress * Max)
	end, function()
		self:UpdateScrollbar()
	end)

	self.Scrollbar.MouseEnter:Connect(function()
		self.Scrollbar.BackgroundTransparency = 0.87
		self.Knob.BackgroundTransparency = 0.38
	end)

	self.Scrollbar.MouseLeave:Connect(function()
		self:UpdateScrollbar()
	end)

	self.Reopen.MouseButton1Click:Connect(function()
		self:SetVisible(true)
	end)

	self.Close.MouseButton1Click:Connect(function()
		self:SetVisible(false)
	end)

	self.SiteButton.MouseButton1Click:Connect(function()
		self:ShowGameGrid()
	end)

	UserInputService.InputBegan:Connect(function(Input, Processed)
		if Processed or SSX.IsRecording() then
			return
		end

		if Input.KeyCode == self.ToggleKey then
			self:Toggle()
		end
	end)

	self.DefaultView = "tab-" .. (self.TabOrder[1] and self.TabOrder[1].Id or "")

	self:Show(self.DefaultView)

	task.defer(function()
		self:UpdateScrollbar()
	end)

	return self
end

SSX.Games = DEFAULT_GAMES

return SSX
