local function Notify(Text, Duration, Accent)
	local Gui = ToastRoot()
	local Holder = Gui:FindFirstChild("Stack")

	local Toast = New("Frame", {
		Name = "Toast",
		Parent = Holder,
		BackgroundColor3 = C.Popup,
		BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 0, 32),
		GroupTransparency = 1,
		ClipsDescendants = true,
	})

	Corner(Toast, 9)
	Stroke(Toast, 1, C.White, LINE2)
	Pad(Toast, 0, 13, 0, 13)
	List(Toast, 8, 0, Enum.FillDirection.Horizontal)

	local Dot = New("Frame", {
		Name = "Dot",
		Parent = Toast,
		BackgroundColor3 = Accent or Color3.fromRGB(91, 141, 239),
		BorderSizePixel = 0,
		Size = UDim2.new(0, 5, 0, 5),
		LayoutOrder = 0,
	})

	Corner(Dot, 4)

	local Label = New("TextLabel", {
		Name = "Text",
		Parent = Toast,
		BackgroundTransparency = 1,
		Font = FONT.Medium,
		Text = tostring(Text),
		TextColor3 = C.Text2,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		LayoutOrder = 1,
	})

	New("UISizeConstraint", {
		Parent = Label,
		MaxSize = Vector2.new(420, math.huge),
	})

	local Padding = Toast:FindFirstChildOfClass("UIPadding")

	if Padding then
		Padding.PaddingTop = UDim.new(0, 8)
		Padding.PaddingBottom = UDim.new(0, 8)
	end

	Tween(Toast, 0.26, { GroupTransparency = 0 })

	task.delay(Duration or 1.9, function()
		if not Toast.Parent then
			return
		end

		Tween(Toast, 0.22, { GroupTransparency = 1 })

		task.delay(0.24, function()
			Toast:Destroy()
		end)
	end)

	return Toast
end

SSX.Notify = Notify

local function CopyToClipboard(Text, Label)
	local Ok = pcall(function()
		if setclipboard then
			setclipboard(Text)
		else
			error("no clipboard")
		end
	end)

	Notify(Ok and (Label or "Copied to clipboard") or "Copy failed", 1.9)

	return Ok
