		Connections = {}
	end

	local Api = {}

	local function Paint(Value, IsRecording)
		Label.Text = Value

		if IsRecording then
			Label.TextColor3 = C.Amber

			if MouseIcon then
				MouseIcon.ImageColor3 = C.Amber
			end

			if Border then
				Tween(Border, 0.16, { Color = C.Amber, Transparency = 0.68 })
			end
		else
			Label.TextColor3 = Value == "Unbound" and C.Text3 or C.Text2

			if MouseIcon then
				MouseIcon.ImageColor3 = C.Text4
			end

			if Border then
				Tween(Border, 0.16, { Color = C.White, Transparency = LINE })
			end
		end
	end

	local function Commit(Value)
		if Recording then
			RecordingCount = math.max(0, RecordingCount - 1)
		end

		Recording = false
		Disconnect()
		Paint(Value, false)

		if Node.Key then
			Node.Flags[Node.Key] = Value
		end

		if Node.Save then
			Node.Save()
		end

		if Node.Callback then
			Node.Callback(Value)
		end
	end

	local function Stop()
		if Recording then
			RecordingCount = math.max(0, RecordingCount - 1)
		end

		Recording = false
		Disconnect()
		Paint(Node.Key and Node.Flags[Node.Key] or "Unbound", false)
	end

	local function Begin()
		if Recording then
			return
		end

		Recording = true
		RecordingCount = RecordingCount + 1
		Paint("Press A Key", true)

		table.insert(
			Connections,
			UserInputService.InputBegan:Connect(function(Input)
				if Input.UserInputType == Enum.UserInputType.Keyboard then
					if Input.KeyCode == Enum.KeyCode.Escape then
						Stop()
						return
					end

					if Input.KeyCode == Enum.KeyCode.Backspace or Input.KeyCode == Enum.KeyCode.Delete then
						Commit("Unbound")
						return
					end

					if
						Input.KeyCode == Enum.KeyCode.LeftShift
						or Input.KeyCode == Enum.KeyCode.RightShift
						or Input.KeyCode == Enum.KeyCode.LeftControl
						or Input.KeyCode == Enum.KeyCode.RightControl
						or Input.KeyCode == Enum.KeyCode.LeftAlt
						or Input.KeyCode == Enum.KeyCode.RightAlt
					then
						return
					end

					Commit(KeyLabel(Input.KeyCode))
				elseif Input.UserInputType == Enum.UserInputType.MouseButton1 then
					SuppressClick = true
					Commit("Mouse 1")

					task.delay(0.1, function()
						SuppressClick = false
					end)
				elseif Input.UserInputType == Enum.UserInputType.MouseButton2 then
					SuppressClick = true
					Commit("Mouse 2")

					task.delay(0.1, function()
						SuppressClick = false
					end)
				elseif Input.UserInputType == Enum.UserInputType.MouseButton3 then
					SuppressClick = true
					Commit("Mouse 3")

					task.delay(0.1, function()
						SuppressClick = false
					end)
				end
			end)
		)
	end

	Button.MouseEnter:Connect(function()
		if not Recording then
			Tween(Button, 0.16, { BackgroundColor3 = Small and C.White or Color3.fromRGB(32, 32, 37), BackgroundTransparency = Small and 0.95 or 0 })
			Tween(Label, 0.16, { TextColor3 = C.Text2 })

			if Border then
				Tween(Border, 0.16, { Transparency = LINE2 })
			end
		end
	end)

	Button.MouseLeave:Connect(function()
		if not Recording then
			local Bound = (Node.Key and Node.Flags[Node.Key]) or "Unbound"

			Tween(Button, 0.16, { BackgroundColor3 = C.Panel2, BackgroundTransparency = Small and 1 or 0 })
			Tween(Label, 0.16, { TextColor3 = Bound == "Unbound" and C.Text3 or C.Text2 })

			if Border then
				Tween(Border, 0.16, { Transparency = LINE })
			end
		end
	end)

	Button.MouseButton1Click:Connect(function()
		if SuppressClick then
			return
		end

		if Recording then
			Stop()
		else
			Begin()
		end
	end)

	Button.MouseButton2Click:Connect(function()
		Commit("Unbound")
	end)

	Paint(Node.Default or "Unbound", false)

	function Api:SetValue(Value, Silent)
		Paint(Value, false)

		if Node.Key then
			Node.Flags[Node.Key] = Value
		end

		if not Silent and Node.Callback then
			Node.Callback(Value)
		end
	end

	function Api:GetValue()
		return Label.Text
	end

	Api.Object = Button

	return Api
end

