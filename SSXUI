function WindowMethods:GetTheme(Id)
	for _, Theme in next, self.Themes do
		if Theme.Id == Id then
			return Theme
		end
	end

	return self.Themes[1]
end

function WindowMethods:GetGame(Id)
	for _, Game in next, self.Games do
		if Game.Id == Id then
			return Game
		end
	end

	return self.Games[1]
end

function WindowMethods:Accent(Object, Property, Slot)
	table.insert(self.Accents, {
		Object = Object,
		Property = Property or "BackgroundColor3",
		Slot = Slot or 1,
	})

	if self.AccentColors then
		local Color = HexToColor(self.AccentColors[Slot or 1])

		pcall(function()
			Object[Property or "BackgroundColor3"] = Color
		end)
	end

	return Object
end

function WindowMethods:SetTheme(Id)
	self.ThemeId = Id

	local Theme = self:GetTheme(Id)
	local Colors = {
		HexToColor(Theme.Colors[1]),
		HexToColor(Theme.Colors[2]),
		HexToColor(Theme.Colors[3]),
	}

	self.AccentColors = Colors
	self.AccentColor = Colors[1]

	for _, Entry in next, self.Accents do
		if Entry.Object and Entry.Object.Parent then
			pcall(function()
				Entry.Object[Entry.Property] = Colors[Entry.Slot]
			end)
		end
	end

	if self.LogoGradient then
		self.LogoGradient.Color = ColorSequence.new(Colors[1], Colors[2])
	end

	if self.ReopenGradient then
		self.ReopenGradient.Color = ColorSequence.new(Colors[1], Colors[2])
	end

	if self.AvaGradient then
		self.AvaGradient.Color = ColorSequence.new(Colors[1], Colors[2])
	end

	if self.GlowA then
		self.GlowA.ImageColor3 = Colors[1]
	end

	if self.GlowB then
		self.GlowB.ImageColor3 = Colors[2]
	end

	if self.GlowC then
		self.GlowC.ImageColor3 = Colors[3]
	end

	local Letter = Theme.Name:sub(1, 1):upper()

	if self.LogoText then
		self.LogoText.Text = Letter
	end

	if self.ReopenLetter then
		self.ReopenLetter.Text = Letter
	end

	for _, Row in next, self.ThemeRows or {} do
		Row.Paint(Id)
	end

	if self.Save then
		self:Save()
	end
end

function WindowMethods:SetGame(Id)
	self.GameId = Id

	local Game = self:GetGame(Id)

	if self.SiteLabel then
		self.SiteLabel.Text = Game.Name
	end

	if self.AvaGradient then
		self.AvaGradient.Color = ColorSequence.new(HexToColor(Game.Colors[1]), HexToColor(Game.Colors[2]))
	end

	if self.Save then
		self:Save()
	end
end

function WindowMethods:Notify(Text, Duration)
	return Notify(Text, Duration, self.AccentColor)
end

function WindowMethods:SyncHandle()
	local Position = self.Wrap.AbsolutePosition
	local Size = self.Wrap.AbsoluteSize

	self.Handle.Position = UDim2.new(0, Position.X + Size.X / 2, 0, Position.Y + Size.Y + 9)
end

function WindowMethods:UpdateScrollbar()
	self:SyncHandle()

	local View = self.ActiveView

	if not View or not View.Scroll or not View.Scroll.Parent then
		return
	end

	local Scroll = View.Scroll
	local Canvas = Scroll.AbsoluteCanvasSize.Y
	local WindowHeight = Scroll.AbsoluteWindowSize.Y
	local Max = math.max(0, Canvas - WindowHeight)
	local Ratio = Canvas > WindowHeight + 1 and WindowHeight / Canvas or 1
	local KnobWidth = math.clamp(52 * Ratio, 8, 52)

	self.Knob.Size = UDim2.new(0, KnobWidth, 1, 0)

	local Travel = math.max(0, 52 - KnobWidth)
	local Progress = Max > 0 and (Scroll.CanvasPosition.Y / Max) or 0

	self.Knob.Position = UDim2.new(0, Progress * Travel, 0, 0)
	self.Scrollbar.BackgroundTransparency = Max > 0 and 0.925 or 0.968
	self.Knob.BackgroundTransparency = Max > 0 and 0.66 or 0.82
end

function WindowMethods:SetVisible(State)
	self.Open = State and true or false

	if self.Open then
		self.Wrap.Visible = true
		self.Handle.Visible = true
		Tween(self.Wrap, 0.3, { GroupTransparency = 0 })
		Tween(self.Wrap, 0.3, { Position = self.RestorePosition or self.HomePosition })
		Tween(self.Handle, 0.28, { GroupTransparency = 0 })
		self.Reopen.Visible = false
		self.Reopen.GroupTransparency = 1
		task.delay(0.3, function()
			if self.Open then
				self:UpdateScrollbar()
			end
		end)
	else
		ClosePopup()
		self.RestorePosition = self.Wrap.Position
		Tween(self.Wrap, 0.26, { GroupTransparency = 1 })
		Tween(self.Wrap, 0.26, { Position = self.RestorePosition + UDim2.new(0, 0, 0, 10) })
		Tween(self.Handle, 0.24, { GroupTransparency = 1 })
		self.Reopen.Visible = true
		Tween(self.Reopen, 0.3, { GroupTransparency = 0 })

		task.delay(0.28, function()
			if not self.Open then
				self.Wrap.Visible = false
				self.Handle.Visible = false
			end
		end)
	end
end

function WindowMethods:Toggle()
	self:SetVisible(not self.Open)
end

function WindowMethods:SetToggleKey(Key)
	if typeof(Key) == "string" then
		Key = KeyFromLabel(Key)
	end

	if Key then
		self.ToggleKey = Key
	end
end

function WindowMethods:Show(ViewId)
	if not ViewId or not self.Views[ViewId] then
		ViewId = self.DefaultView or ("tab-" .. (self.TabOrder[1] and self.TabOrder[1].Id or ""))
	end

	if not ViewId or not self.Views[ViewId] then
		return
	end

	for Id, View in next, self.Views do
		local On = Id == ViewId

		if View.Scroll.Visible ~= On then
			View.Scroll.Visible = On

			if On then
				View.Scroll.GroupTransparency = 1
				Tween(View.Scroll, 0.22, { GroupTransparency = 0 })
			end
		end
	end

	self.ActiveViewId = ViewId
	self.ActiveView = self.Views[ViewId]

	for _, Item in next, self.NavItems or {} do
		Item.Paint(Item.Id == ViewId)
	end

	for _, Item in next, self.FootItems or {} do
		Item.Paint(Item.Id == ViewId)
	end

	if ViewId:sub(1, 4) == "tab-" then
		self.ActiveTab = ViewId:sub(5)
	end

	self:UpdateScrollbar()
end

