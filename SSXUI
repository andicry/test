				Tween(OptionButton, 0.13, { BackgroundTransparency = 0.945 })
				Tween(Text, 0.13, { TextColor3 = C.Text })
			end)

			OptionButton.MouseLeave:Connect(function()
				Tween(OptionButton, 0.13, { BackgroundTransparency = 1 })
				Tween(Text, 0.13, { TextColor3 = Option == Current and C.White or C.Text2 })
			end)

			OptionButton.MouseButton1Click:Connect(function()
				Apply(Option)
				ClosePopup()
			end)
		end

		ShowPopup(Node.Layer, Button, Popup, {})
	end)

	function Api:SetValue(Value, Silent)
		Apply(Value, Silent ~= false)
	end

	function Api:GetValue()
		return Current
	end

	function Api:SetOptions(Values)
		Options = Values
		SizeButton()
	end

	Api.Object = Button

	return Api
