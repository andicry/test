local function RenderNodes(Win, Parent, Nodes, Depth, Section)
	local Container = MakeIndent(Parent, Depth)
	local Order = 0

	local function Next(Index)
		Order = Order + 1
		return Order * 10 + (Index or 0)
	end

	for Index, Node in next, Nodes do
		local Order = Next(Index)

		if Node.t == "slider" then
			local Slider = MakeSlider(Container, {
				Label = Node.label,
				Min = Node.min,
				Max = Node.max,
				Step = Node.step,
				Default = Node.v,
				Key = Node.k,
				Flags = Win.Flags,
				Layer = Win.Layer,
				Disabled = Node.dis,
				Order = Order,
				Save = function()
					Win:Save()
				end,
				Callback = Node.Callback,
			})

			if Node.k then
				if Win.Flags[Node.k] == nil then
					Win.Flags[Node.k] = Node.v
				end
				Win.Controls[Node.k] = Slider
			end
		elseif Node.t == "color" then
			local Row, Left, Right = MakeRowShell(Container, 28, Order)
			MakeLabelText(Left, Cap(Node.label), 12, C.Label, FONT.Medium, 0)

			local Picker = MakeColor(Right, {
				Default = Node.v,
				Key = Node.k,
				Alpha = Node.a,
				Flags = Win.Flags,
				Layer = Win.Layer,
				Order = 0,
				Callback = Node.Callback,
			})

			if Node.k then
				if Win.Flags[Node.k] == nil then
					Win.Flags[Node.k] = Node.v
				end
				Win.Controls[Node.k] = Picker
			end

			if Node.dis then
				Row.GroupTransparency = 0.55
			end
		elseif Node.t == "check" then
			local Wrapper = New("Frame", {
				Name = "CheckRow",
				Parent = Container,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = Order,
			})

			List(Wrapper, 0, 0)

			local Row, Left, Right = MakeRowShell(Wrapper, 26, 0, true)

			local Group = nil

			local Check = MakeCheck(Row, Node.v, Node.round, function(Value)
				Win.Flags[Node.k] = Value

				if Group then
					Group:SetDimmed(not Value)
				end

				if Node.Callback then
					Node.Callback(Value)
				end

				Win:Save()
			end, 0)

			Check.Object.Position = UDim2.new(0, 0, 0.5, 0)
			Check.Object.AnchorPoint = Vector2.new(0, 0.5)

			Left.Position = UDim2.new(0, 25, 0.5, 0)

			local Label = MakeLabelText(Left, Cap(Node.label), 12, C.Label, FONT.Medium, 0)

			if Node.desc then
				MakeLabelText(Left, Node.desc, 11, C.Text4, FONT.Regular, 1)
			end

			if Node.k then
				if Win.Flags[Node.k] == nil then
					Win.Flags[Node.k] = Node.v and true or false
				end
				Win.Controls[Node.k] = Check
			end

			Row.MouseEnter:Connect(function()
				Tween(Label, 0.16, { TextColor3 = C.White })
			end)

			Row.MouseLeave:Connect(function()
				Tween(Label, 0.16, { TextColor3 = C.Label })
			end)

			Row.MouseButton1Click:Connect(function()
				Check:SetValue(not Check:GetValue(), true)
			end)

			if Node.children and #Node.children > 0 then
				Group = MakeGroup(Wrapper, Node.open ~= false)
				Group.Frame.LayoutOrder = 1

				local Chevron = MakeChevron(Right, Node.open ~= false, function()
					Group:SetOpen(not Group.Open, true)
					Chevron:SetOpen(Group.Open)
				end, 0)

				RenderNodes(Win, Group.Inner, Node.children, Depth + 1, Section)
				Group:SetOpen(Node.open ~= false, false)

				if Node.v == false then
					Group:SetDimmed(true)
				end
			end

			if Node.dis then
				Wrapper.GroupTransparency = 0.55
			end
		elseif Node.t == "row" then
			local Row, Left, Right = MakeRowShell(Container, 28, Order)

			MakeLabelText(Left, Cap(Node.label), 12, C.Label, FONT.Medium, 0)

			if Node.desc then
				MakeLabelText(Left, Node.desc, 11, C.Text4, FONT.Regular, 1)
			end

			for ControlIndex, Control in next, (Node.ctl or {}) do
				if Control.t == "select" then
					local Select = MakeSelect(Right, {
						Default = Control.v,
						Options = Control.opts,
						Key = Control.k,
						Flags = Win.Flags,
						Layer = Win.Layer,
						Order = ControlIndex,
						Callback = Control.Callback,
					})

					if Control.k then
						if Win.Flags[Control.k] == nil then
							Win.Flags[Control.k] = Control.v
						end
						Win.Controls[Control.k] = Select
					end
				elseif Control.t == "keybind" then
					local Bind = MakeKeybind(Right, {
						Default = Control.v,
						Key = Control.k,
						Flags = Win.Flags,
						Layer = Win.Layer,
						Order = ControlIndex,
						Save = function()
							Win:Save()
						end,
						Callback = Control.Callback,
					})

					if Control.k then
						if Win.Flags[Control.k] == nil then
							Win.Flags[Control.k] = Control.v
						end
						Win.Controls[Control.k] = Bind
					end
				elseif Control.t == "color" then
					local Picker = MakeColor(Right, {
						Default = Control.v,
						Key = Control.k,
						Alpha = Control.a,
						Flags = Win.Flags,
						Layer = Win.Layer,
						Order = ControlIndex,
						Callback = Control.Callback,
					})

					if Control.k then
						if Win.Flags[Control.k] == nil then
							Win.Flags[Control.k] = Control.v
						end
						Win.Controls[Control.k] = Picker
					end
				elseif Control.t == "switch" then
					local Switch = MakeSwitch(Right, Control.v, Control.Callback, ControlIndex)

					if Control.k then
						if Win.Flags[Control.k] == nil then
							Win.Flags[Control.k] = Control.v
						end
						Win.Controls[Control.k] = Switch
					end
				elseif Control.t == "button" then
					local Button = MakeButton(Right, Control.v, Control.icon, false, ControlIndex)
					Button.MouseButton1Click:Connect(function()
						if Control.Callback then
							Control.Callback()
						end
					end)
				end
			end

			if Node.dis then
				Row.GroupTransparency = 0.55
			end
		elseif Node.t == "button" then
			local Row = New("Frame", {
				Name = "ButtonRow",
				Parent = Container,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 34),
				LayoutOrder = Order,
			})

			local Button = MakeButton(Row, Node.label, Node.icon, false, 0)
			Button.AnchorPoint = Vector2.new(0, 0.5)
			Button.Position = UDim2.new(0, 0, 0.5, 0)

			Button.MouseButton1Click:Connect(function()
				if Node.Callback then
					Node.Callback()
				end
			end)
		elseif Node.t == "label" then
			local Row = New("Frame", {
				Name = "LabelRow",
				Parent = Container,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 24),
				LayoutOrder = Order,
			})

			local Label = New("TextLabel", {
				Name = "Label",
				Parent = Row,
				BackgroundTransparency = 1,
				Font = FONT.Regular,
				Text = Node.label or "",
				TextColor3 = C.Text3,
				TextSize = 12,
				TextWrapped = Node.wrap or false,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				Size = UDim2.new(1, 0, 1, 0),
			})

			if Node.wrap then
				Row.Size = UDim2.new(1, 0, 0, 0)
				Row.AutomaticSize = Enum.AutomaticSize.Y
				Label.AutomaticSize = Enum.AutomaticSize.Y
				Label.Size = UDim2.new(1, 0, 0, 0)
			end
		elseif Node.t == "divider" then
			local Row = New("Frame", {
				Name = "DividerRow",
				Parent = Container,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, 0, 0, 11),
				LayoutOrder = Order,
			})

			local Line = New("Frame", {
				Name = "Line",
				Parent = Row,
				BackgroundColor3 = C.White,
				BackgroundTransparency = LINE,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 0, 0.5, 0),
				Size = UDim2.new(1, 0, 0, 1),
			})
		end
	end

	return Container
end

function WindowMethods:BuildSection(Spec, TabId, Index)
	local Owner = self
	local Section = {
		self = self,
		Spec = Spec,
		Nodes = {},
	}

	local Frame = New("Frame", {
		Name = "Section_" .. tostring(Spec.title or Index),
		Parent = Spec.Parent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = Index,
	})

	Section.Frame = Frame

	local Rule = New("Frame", {
		Name = "Rule",
		Parent = Frame,
		BackgroundColor3 = C.White,
		BackgroundTransparency = LINE,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
		LayoutOrder = 0,
		Visible = Index > 1,
	})

	local Head = New("Frame", {
		Name = "Head",
		Parent = Frame,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 32),
		LayoutOrder = 1,
	})

	New("UIPadding", {
		Parent = Head,
		PaddingTop = UDim.new(0, Index > 1 and 4 or 0),
	})

	local HeadLeft = New("Frame", {
		Name = "Left",
		Parent = Head,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 2),
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
	})

	New("UIListLayout", {
		Parent = HeadLeft,
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 9),
	})

	local HeadRight = New("Frame", {
		Name = "Right",
		Parent = Head,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 2),
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = Enum.AutomaticSize.X,
	})

	New("UIListLayout", {
		Parent = HeadRight,
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
	})

	local HeadIcon = Icon(HeadLeft, Spec.icon, 14, C.Text3, 0, 0)

	local Title = New("TextLabel", {
		Name = "Title",
		Parent = HeadLeft,
		BackgroundTransparency = 1,
		Font = FONT.Bold,
		Text = Cap(Spec.title),
		TextColor3 = Color3.fromRGB(220, 220, 228),
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		LayoutOrder = 1,
	})

	local ToggleKey = Spec.toggle and (TabId .. "." .. Index .. ".on") or nil
	local ToggleValue = Spec.toggle and (Spec.on ~= false) or nil

	if Spec.toggle and self.Flags[ToggleKey] ~= nil then
		ToggleValue = self.Flags[ToggleKey]
	end

	if Spec.pill then
		local Pill = New("Frame", {
			Name = "Pill",
			Parent = HeadLeft,
			BackgroundColor3 = C.Panel2,
			BorderSizePixel = 0,
			Size = UDim2.new(0, 0, 0, 19),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = 2,
		})

		Corner(Pill, 6)

		if Spec.bind then
			Stroke(Pill, 1, C.White, LINE)
			Pad(Pill, 0, 0, 0, 0)

			MakeKeybind(Pill, {
				Default = Spec.pill,
				Key = Spec.bind,
				Flags = self.Flags,
				Layer = self.Layer,
				Small = true,
				NoIcon = true,
				Order = 0,
				Save = function()
					self:Save()
				end,
			})

			self.Flags[Spec.bind] = Spec.pill
		else
			Stroke(Pill, 1, C.White, LINE)
			Pad(Pill, 0, 7, 0, 7)

			New("TextLabel", {
				Name = "Text",
				Parent = Pill,
				BackgroundTransparency = 1,
				Font = FONT.Medium,
				Text = Cap(Spec.pill),
				TextColor3 = C.Text3,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
				AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.new(0, 0, 1, 0),
			})
		end
	end

	if Spec.desc then
		MakeLabelText(HeadLeft, Spec.desc, 11, C.Text4, FONT.Regular, 3)
	end

	local Group = nil

	if Spec.children and #Spec.children > 0 then
		local Open = Spec.open ~= false

		Group = MakeGroup(Frame, Open)
		Group.Frame.LayoutOrder = 2

		local Chevron = MakeChevron(HeadRight, Open, function()
			Group:SetOpen(not Group.Open, true)
			Chevron:SetOpen(Group.Open)
		end, 0)

		if Spec.toggle then
			local Switch = MakeSwitch(HeadRight, ToggleValue, function(Value)
				self.Flags[ToggleKey] = Value
				self:Save()
			end, 1)

			if ToggleValue then
				Title.TextColor3 = C.Text
				HeadIcon.ImageColor3 = C.Text2
			end

			local Api = {}

			function Api:SetValue(Value)
				Switch:SetValue(Value, true)
			end

			function Api:GetValue()
				return Switch:GetValue()
			end

			self.Controls[ToggleKey] = Api
		end

		Section.Rows = Group.Inner
		Section.RowsContainer = Group.Inner
		Section.Group = Group
		RenderNodes(self, Group.Inner, Spec.children, 0, Section)
		Group:SetOpen(Open, false)
	else
		local Rows = New("Frame", {
			Name = "Rows",
			Parent = Frame,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 0),
