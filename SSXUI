local function New(Class, Props, Children)
	local Inst = Instance.new(Class)

	if Props then
		for Key, Value in next, Props do
			if Key ~= "Parent" then
				Inst[Key] = Value
			end
		end
	end

	if Children then
		for _, Child in next, Children do
			Child.Parent = Inst
		end
	end

	if Props and Props.Parent then
		Inst.Parent = Props.Parent
	end

	return Inst
end

