-- the rest of the ui. Lives on its own rail tab, saves scripts to Oxy/luau
-- and only runs while the window is open. The LUAU toggle in the interface
-- section enables or disables the whole feature.
local luauFolderReady = false

local function ensureLuauFolder()
    if luauFolderReady then
        return true
    end

    if type(isfolder) ~= "function" or type(makefolder) ~= "function" then
        return false, "folder functions are unavailable"
    end

    local ok, err = pcall(function()
        if not isfolder("Oxy") then
            makefolder("Oxy")
        end

        if not isfolder("Oxy/luau") then
            makefolder("Oxy/luau")
        end
    end)

    if not ok then
        return false, tostring(err)
    end

    luauFolderReady = true
    return true
end

