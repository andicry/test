    make("UIPadding", {
        PaddingLeft = UDim.new(0, 7),
        PaddingRight = UDim.new(0, 7),
    }, watermarkContent)

    make("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 5),
    }, watermarkContent)

    local watermarkLogo = icon(
        watermarkContent,
        "moon",
        UDim2.fromOffset(0, 0),
        10,
        self.Theme.Accent,
        72
    )

    watermarkLogo.LayoutOrder = 1
    watermarkLogo.Visible = watermarkLogo.Image ~= ""

    observeAccent(watermarkLogo, function(color)
        watermarkLogo.ImageColor3 = color
    end)

    connect(watermarkLogo:GetPropertyChangedSignal("Image"), function()
        watermarkLogo.Visible = watermarkLogo.Image ~= ""
    end)

    local watermarkText = text(watermarkContent, "", {
        Size = UDim2.fromOffset(0, 22),
        AutomaticSize = Enum.AutomaticSize.X,
        TextSize = 10,
        TextWrapped = false,
        TextTruncate = Enum.TextTruncate.None,
        LayoutOrder = 2,
        ZIndex = 72,
    })

    -- only the right-anchored position has to follow the frame; a dragged
    -- watermark keeps the spot the user put it in
    connect(watermark.Frame:GetPropertyChangedSignal("AbsoluteSize"), function()
        if watermark.Frame.Position.X.Scale == 1 then
            watermark.Frame.Position = UDim2.new(
                1,
                -math.floor(watermark.Frame.AbsoluteSize.X + 8),
                0,
                watermark.Frame.Position.Y.Offset
            )
        end
    end)

    local watermarkItems = { "Title", "Time" }
    local watermarkOrder = { "Title", "User", "FPS", "Ms", "Date", "Time" }
    local watermarkValid = {}
    local watermarkFps = 0
    local watermarkMs = 0

    for _, item in ipairs(watermarkOrder) do
        watermarkValid[item] = true
    end

    local function watermarkSegment(item)
        if item == "Title" then
            return window and window.Title or "Oxy"
        end

        if item == "User" then
            local player = Players.LocalPlayer

            return (window and window.User)
                or (player and player.Name)
                or "user"
        end

        if item == "FPS" then
            return tostring(math.floor(watermarkFps + 0.5)) .. " fps"
        end

        if item == "Ms" then
            return tostring(math.floor(watermarkMs + 0.5)) .. " ms"
        end

        if item == "Date" then
            return os.date("%d/%m/%Y")
        end

        if item == "Time" then
            return os.date("%H:%M:%S")
        end

        return nil
    end

    local function updateWatermarkText()
        local segments = {}

        for _, item in ipairs(watermarkItems) do
            local segment = watermarkSegment(item)

            if segment then
                table.insert(segments, segment)
            end
        end

        watermarkText.Text = table.concat(segments, "  |  ")
    end

    local function normalizeWatermarkItems(value)
        local picked = {}

        local function keep(item)
            if type(item) == "string"
                and watermarkValid[item]
                and not picked[item] then
                picked[item] = true
            end
        end

        if type(value) == "table" and #value > 0 then
            for _, item in ipairs(value) do
                keep(item)
            end
        elseif type(value) == "table" then
            for item, on in pairs(value) do
                if on then
                    keep(item)
                end
            end
        end

        local list = {}

        for _, item in ipairs(watermarkOrder) do
            if picked[item] then
                table.insert(list, item)
            end
        end

        if #list == 0 then
            list = { "Title", "Time" }
        end

        return list
    end

    function watermark.SetWatermarkItems(value)
        watermarkItems = normalizeWatermarkItems(value)
        updateWatermarkText()
    end

    -- the watermark starts with the library brand mark; pass an image
    -- (rbxassetid:// or any url) to swap it, or nil to go back to the mark
    function watermark.SetLogo(image)
        if type(image) == "string" and image ~= "" then
            watermarkLogo.Image = image
            return
        end

        paintIcon(watermarkLogo, "moon")
    end

    updateWatermarkText()

    local watermarkAccum = 0
    local watermarkFrames = 0

    connect(RunService.RenderStepped, function(delta)
        watermarkFrames += 1
        watermarkAccum += delta

        if watermarkAccum < 0.5 then
            return
        end

        if watermarkAccum > 0 then
            watermarkFps = watermarkFrames / watermarkAccum
        end

        watermarkFrames = 0
        watermarkAccum = 0

        local ok, ping = pcall(function()
            return Players.LocalPlayer:GetNetworkPing() * 1000
        end)

        if ok and type(ping) == "number" then
            watermarkMs = ping
        end

        if window and watermark.Frame.Visible then
            updateWatermarkText()
        end
    end)

    local keybinds = makeHud(
        gui,
        "Keybinds",
        UDim2.fromOffset(10, 100),
        UDim2.fromOffset(140, 21)
    )

    local keybindTitle = text(keybinds.Frame, "keybinds", {
        Position = UDim2.fromOffset(6, 1),
        Size = UDim2.new(1, -12, 0, 13),
        TextSize = 10,
        ZIndex = 72,
    })

    local keybindList = frame(keybinds.Frame, {
        Position = UDim2.fromOffset(6, 14),
        Size = UDim2.new(1, -12, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        ZIndex = 72,
    })

    local keybindLayout = make("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 1),
    }, keybindList)

    connect(keybindLayout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
        keybinds.Frame.Size = UDim2.fromOffset(
            140,
            math.max(21, keybindLayout.AbsoluteContentSize.Y + 18)
        )
    end)

    local blur = make("BlurEffect", {
        Name = "OxyBlur",
        Enabled = false,
        Size = 0,
    }, Lighting)

    local railSide = "Left"

    local function dockRail()
        if not alive then
            return
        end

        if railSide == "Right" then
            railOuter.Position = UDim2.new(1, 3, 0, 0)
        else
            railOuter.Position = UDim2.new(0, -152, 0, 0)
        end

        railOuter.Size = UDim2.new(0, 149, 1, 0)
    end

    window = {
        Gui = gui,
        Root = root,
        Body = body,
        Scale = scale,
        Rail = rail,
        RailBody = railBody,
        RailPanel = railOuter,
        RailScale = railScale,
        Main = main,
        Header = header,
        Brand = brand,
        Navigation = navigation,
        PageHost = pageHost,
        Breadcrumb = breadcrumb,
        Overlay = overlay,
        Tooltip = tooltip,
        TooltipText = tooltipText,
        Notifications = notifications,
        Background = background,
        Backdrop = backdrop,
        Snow = snow,
        Blur = blur,
        Watermark = watermark,
        Keybinds = keybinds,
        KeybindList = keybindList,
        Title = tostring(spec.Title or "Oxy"),
        User = tostring(spec.User or "OxyUser"),
        Tabs = {},
        ActiveTab = nil,
        Visible = true,
        Side = "Left",
        NavOrder = 0,
        LastGroup = nil,
        VisibilitySerial = 0,
        BackdropEnabled = false,
        SnowEnabled = false,
        BlurAmount = 0,
    }

    local flakes = {}

    for index = 1, 24 do
        local flake = frame(snow, {
            Size = UDim2.fromOffset(2, 2),
            BackgroundColor3 = Color3.fromRGB(230, 230, 230),
            BackgroundTransparency = 0.3,
            ZIndex = 3,
        })

        table.insert(flakes, {
            Object = flake,
            X = math.random(),
            Y = math.random(),
            Speed = math.random(2, 6) / 100,
        })
    end

    local dragging
    local resizing
    local railDragging

    connect(RunService.RenderStepped, function(delta)
        if not alive then
            return
        end

        if not railDragging then
            dockRail()
        end

        if snow.Visible then
            for _, flake in ipairs(flakes) do
                flake.Y = (flake.Y + delta * flake.Speed) % 1
                flake.Object.Position = UDim2.fromScale(flake.X, flake.Y)
            end
        end

        if tooltip.Visible then
            if not tooltipTarget
                or not tooltipTarget.Parent
                or not window.Visible then
                hideTooltip()
                return
            end

            local mouse = UserInputService:GetMouseLocation()
            local currentView = viewport()

            local x = math.clamp(
                mouse.X + 8,
                0,
                math.max(0, currentView.X - tooltip.AbsoluteSize.X)
            )

            local y = mouse.Y + 18

            if y + tooltip.AbsoluteSize.Y > currentView.Y then
                y = mouse.Y - tooltip.AbsoluteSize.Y - 8
            end

            y = math.clamp(
                y,
                0,
                math.max(0, currentView.Y - tooltip.AbsoluteSize.Y)
            )

            tooltip.Position = UDim2.fromOffset(x, y)
        end
    end)

    function window:SetSide(side)
        side = string.lower(tostring(side or "Left"))

        if side ~= "left" and side ~= "right" then
            return false
        end

        railSide = side == "right" and "Right" or "Left"
        self.Side = railSide
        dockRail()

        closePopover()
        hideTooltip()
        return true
    end

    function window:GetRailSide()
        return railSide
    end

    function window:Toggle(value)
        if value == nil then
            value = not self.Visible
        else
            value = value == true
        end

        if self.Visible == value then
            return
        end

        self.Visible = value
        self.VisibilitySerial += 1

        local serial = self.VisibilitySerial

        closePopover()
        hideTooltip()

        self.Backdrop.Visible = self.BackdropEnabled and value
        self.Snow.Visible = self.SnowEnabled and value
        self.Blur.Enabled = value and self.BlurAmount > 0

        if value then
            self.Root.Visible = true
            self.RailPanel.Visible = true

            animate(self.Scale, 0.16, {
                Scale = 1,
            })

            animate(self.RailScale, 0.16, {
                Scale = 1,
            })
        else
            animate(self.Scale, 0.14, {
                Scale = 0.94,
            }, Enum.EasingDirection.In)

            animate(self.RailScale, 0.14, {
                Scale = 0.94,
            }, Enum.EasingDirection.In)

            task.delay(0.15, function()
                if alive
                    and self.VisibilitySerial == serial
                    and not self.Visible then
                    self.Root.Visible = false
                    self.RailPanel.Visible = false
                end
            end)
        end
    end

    function window:SetBackground(value, transparency)
        if value == nil or value == "" then
            self.Background.Image = ""
            self.Background.ImageTransparency = 1
            return true
        end

        local asset, mode = resolveImage(value, "background")

        if asset == "" then
            return false, "image could not be loaded"
        end

        self.Background.Image = asset
        self.Background.ImageTransparency = math.clamp(
            tonumber(transparency) or 0.85,
            0,
            1
        )

        return true, mode
    end

    function Library:SetBackground(value, transparency)
        if not window then
            return false, "window not created"
        end

        return window:SetBackground(value, transparency)
    end

    function Library:SetWatermarkItems(value)
        if not window then
            return false, "window not created"
        end

        window.Watermark.SetWatermarkItems(value)

        return true
    end

    function Library:SetBackdrop(value)
        if not window then
            return
        end

        window.BackdropEnabled = value == true
        window.Backdrop.Visible = window.BackdropEnabled and window.Visible
    end

    function Library:SetSnow(value)
        if not window then
            return
        end

        window.SnowEnabled = value == true
        window.Snow.Visible = window.SnowEnabled and window.Visible
    end

    function Library:SetBlur(value)
        if not window then
            return
        end

        window.BlurAmount = math.clamp(tonumber(value) or 0, 0, 24)
        window.Blur.Size = window.BlurAmount
        window.Blur.Enabled = window.Visible and window.BlurAmount > 0
    end

    local function clampCenter(value, half, total)
        if total <= half * 2 then
            -- the reported viewport is smaller than the window (scaled guis,
            -- shifted runtimes): keep the dragged position instead of yanking
            -- the window toward the top
            return value
        end

        return math.clamp(value, half, total - half)
    end

    -- AbsolutePosition is reported in screen space, but Position offsets are
    -- relative to the ScreenGui's own top-left. With IgnoreGuiInset the gui is
    -- shifted up by the topbar inset, so mixing the two spaces used to snap the
    -- window up by that inset the moment it was grabbed.
    local function toParentSpace(absolute)
        local origin = gui.AbsolutePosition
        return Vector2.new(absolute.X - origin.X, absolute.Y - origin.Y)
    end

    local function beginDrag(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        closePopover()
        hideTooltip()

        -- freeze the window exactly where it is: the drag delta is measured
        -- from the rendered top-left corner (converted into parent space so a
        -- shifted gui origin can never teleport the window on press)
        local topLeft = toParentSpace(root.AbsolutePosition)

        dragging = {
            Input = input.UserInputType == Enum.UserInputType.Touch and input or nil,
            Start = input.Position,
            Origin = topLeft,
        }
    end

    connect(header.InputBegan, beginDrag)

    connect(brand.InputBegan, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        closePopover()
        hideTooltip()

        railDragging = {
            Input = input.UserInputType == Enum.UserInputType.Touch and input or nil,
            Start = input.Position,
            Origin = railOuter.Position.X.Scale >= 1
                and root.AbsoluteSize.X + railOuter.Position.X.Offset
                or railOuter.Position.X.Offset,
        }
    end)

    local resize = hit(root, {
        Name = "ResizeHitTarget",
        Position = UDim2.new(1, -18, 1, -18),
        Size = UDim2.fromOffset(18, 18),
        ZIndex = 90,
    })

    connect(resize.InputBegan, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        closePopover()

        resizing = {
            Input = input.UserInputType == Enum.UserInputType.Touch and input or nil,
            Start = input.Position,
            Size = root.AbsoluteSize,
        }
    end)

    connect(UserInputService.InputChanged, function(input)
        if dragging
            and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input == dragging.Input) then

            local delta = input.Position - dragging.Start
            local currentView = viewport()
            local halfW = root.AbsoluteSize.X / 2
            local halfH = root.AbsoluteSize.Y / 2

            -- the center the window would land at, anchored to where the
            -- window actually is on screen right now (never recomputed from
            -- a scaled position, so the drag stays smooth from any grab spot)
            local center = dragging.Origin
                + Vector2.new(halfW, halfH)
                + Vector2.new(delta.X, delta.Y)

            root.Position = UDim2.fromOffset(
                clampCenter(center.X, halfW, currentView.X),
                clampCenter(center.Y, halfH, currentView.Y)
            )

            dockRail()
        end

        if railDragging
            and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input == railDragging.Input) then

            local delta = input.Position - railDragging.Start
            local rootWidth = root.AbsoluteSize.X
            local railWidth = railOuter.AbsoluteSize.X

            -- the clamp has to include the docked positions themselves: the
            -- right dock sits at rootWidth + 3, so the old rootWidth - 60 limit
            -- yanked the rail ~60px to the left the instant it was grabbed
            railOuter.Position = UDim2.fromOffset(
                math.clamp(
                    railDragging.Origin + delta.X,
                    -(railWidth + 3),
                    rootWidth + 3
                ),
                0
            )
        end

        if resizing
            and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input == resizing.Input) then

            local delta = input.Position - resizing.Start
            local currentView = viewport()
            local position = toParentSpace(root.AbsolutePosition)

            local maxWidth = math.max(400, currentView.X - position.X)
            local maxHeight = math.max(280, currentView.Y - position.Y)

            root.Size = UDim2.fromOffset(
                math.clamp(resizing.Size.X + delta.X, 400, maxWidth),
                math.clamp(resizing.Size.Y + delta.Y, 280, maxHeight)
            )

            dockRail()
        end
    end)

    connect(UserInputService.InputEnded, function(input)
        if dragging
            and (input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch
                or input == dragging.Input) then
            dragging = nil
        end

        if railDragging
            and (input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch
                or input == railDragging.Input) then

            local railCenter = railOuter.AbsolutePosition.X
                + railOuter.AbsoluteSize.X / 2
            local rootCenter = root.AbsolutePosition.X
                + root.AbsoluteSize.X / 2

            railSide = railCenter > rootCenter and "Right" or "Left"
            railDragging = nil
            dockRail()
        end

        if resizing
            and (input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch
                or input == resizing.Input) then
            resizing = nil
        end
    end)

    connect(UserInputService.InputBegan, function(input, processed)
        if capture then
            return
        end

        if input.KeyCode == Enum.KeyCode.Escape then
            closePopover()
            hideTooltip()
            return
        end

        if processed or UserInputService:GetFocusedTextBox() then
            return
        end

        if input.KeyCode == Library.MenuKey then
            window:Toggle()
        end
    end)

    window:SetSide(spec.Side or "Left")

    return window
end

function Library:Notify(spec)
    if not alive or self.NotificationsDisabled or not window then
        return
    end

    if type(spec) == "string" then
        spec = {
            Content = spec,
        }
    end

    spec = spec or {}

    local holder = window.Notifications
    local count = 0

    for _, child in ipairs(holder:GetChildren()) do
        if child:IsA("GuiObject") then
            count += 1
        end
    end

    if count >= 5 then
        for _, child in ipairs(holder:GetChildren()) do
            if child:IsA("GuiObject") then
                child:Destroy()
                break
            end
        end
    end

    local content = tostring(spec.Content or "")

    -- a toast may grow as wide as the message needs, only the screen edge
    -- limits it. TextService measures the fallback font, while the glyphs are
    -- drawn with the loaded font face, so the rendered TextBounds are the only
    -- accurate source: the box starts collapsed and hugs them a frame later
    local maxWidth = tonumber(spec.MaxWidth)
        or math.max(240, viewport().X - 40)
    local paddingX = 16 -- 9px left of the text, 7px right of it
    local available = maxWidth - paddingX

    local note = frame(holder, {
        Name = "Notification",
        Size = UDim2.fromOffset(math.min(available, 240), 0),
        BackgroundColor3 = Color3.fromRGB(24, 22, 25),
        ClipsDescendants = true,
        ZIndex = 151,
    })

    gradient(
        note,
        Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(170, 170, 170)
    )

    local accent = spec.Type == "error"
        and self.Theme.Risky
        or self.Theme.Accent

    line(
        note,
        UDim2.fromOffset(0, 0),
        UDim2.new(0, 2, 1, 0),
        accent,
        152
    )

    local label = text(note, content, {
        Position = UDim2.fromOffset(9, 4),
        Size = UDim2.new(1, -paddingX, 1, -8),
        TextWrapped = false,
        TextTruncate = Enum.TextTruncate.None,
        TextSize = 10,
        ZIndex = 153,
    })

    local dismiss = hit(note, {
        Size = UDim2.fromScale(1, 1),
        ZIndex = 154,
    })

    local closed = false
    local noteWidth = math.min(available, 240)

    local function fit()
        if closed or not note.Parent then
            return
        end

        local bounds = label.TextBounds

        if bounds.X <= 0 then
            return
        end

        local textWidth = math.ceil(bounds.X)

        if textWidth > available then
            -- wider than the screen allows: wrap instead of clipping
            if not label.TextWrapped then
                label.TextWrapped = true
                note.Size = UDim2.fromOffset(maxWidth, 0)
                return
            end

            noteWidth = maxWidth
        else
            noteWidth = textWidth + paddingX
        end

        animate(note, 0.16, {
            Size = UDim2.fromOffset(
                noteWidth,
                math.max(10, math.ceil(bounds.Y)) + 8
            ),
        })
    end

    local function close()
        if closed then
            return
        end

        closed = true

        -- shrink to the toast's own width: scaling to 1,0 would blow it up to
        -- the full width of the (now screen wide) notification holder
        animate(note, 0.14, {
            Size = UDim2.fromOffset(noteWidth, 0),
        }, Enum.EasingDirection.In)

        task.delay(0.15, function()
            if note.Parent then
                note:Destroy()
            end
        end)
    end

    connect(dismiss.Activated, close)

    task.delay(tonumber(spec.Duration) or 3, function()
        if alive then
            close()
        end
    end)

    -- TextBounds settles once the font face has loaded: fitting on every
    -- change keeps the toast exactly as wide as the message even when the
    -- first frame was still measured with the fallback glyphs
    connect(label:GetPropertyChangedSignal("TextBounds"), fit)
    task.defer(fit)
end

local function escapeRichText(value)
    return tostring(value)
        :gsub("&", "&amp;")
        :gsub("<", "&lt;")
        :gsub(">", "&gt;")
end

local function selectTab(win, tab)
    if not tab or tab.Window ~= win then
        return
    end

    if win.ActiveTab == tab then
        -- re-selecting the active tab snaps the page back to the top: the
        -- scroll drifts while a tab is being filled with controls, so menus
        -- that call SelectTab when they finish building start at the top
        tab.Page.CanvasPosition = Vector2.zero
        return
    end

    closePopover()
    hideTooltip()

    local previous = win.ActiveTab
    win.ActiveTab = tab

    for _, entry in ipairs(win.Tabs) do
        local active = entry == tab

        entry.Row.BackgroundTransparency = active and 0 or 1
        entry.Indicator.Visible = active
        entry.Label.TextColor3 = active
            and Library.Theme.Text
            or Library.Theme.TextInactive

        if entry.Icon then
            entry.Icon.ImageColor3 = active
                and Library.Theme.Accent
                or Library.Theme.TextInactive
        end

        entry.Page.Visible = active
    end

    local group = escapeRichText(tab.Group)
    local name = escapeRichText(tab.Title)

    win.Breadcrumb.Text = string.format(
        '<font color="#777277">%s /</font> <font color="#dedade">%s</font>',
        group,
        name
    )

    if previous then
        local direction = tab.Order > previous.Order and 1 or -1

        tab.Page.Position = UDim2.fromOffset(direction * 5, 0)

        animate(tab.Page, 0.15, {
            Position = UDim2.fromOffset(0, 0),
        })
    end
end

local function addGroupHeading(win, group)
    win.NavOrder += 1

    local row = frame(win.Navigation, {
        LayoutOrder = win.NavOrder,
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundTransparency = 1,
        ZIndex = 15,
    })

    text(row, group, {
        Position = UDim2.fromOffset(10, 2),
        Size = UDim2.new(1, -20, 1, -2),
        TextColor3 = Library.Theme.TextInactive,
        TextSize = 10,
        ZIndex = 16,
    })

    return row
end

local function makeColumn(page, side)
    local column = frame(page, {
        Name = side,
        Position = side == "Left"
            and UDim2.fromOffset(10, 12)
            or UDim2.new(0.5, 5, 0, 12),
