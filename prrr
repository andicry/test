-- resolve an image source: URL (downloaded via getcustomasset), asset id
-- (number or rbxassetid://...), rbx* content string — or nil (lucide name)
local assetsFolder = baseFolder .. '/Assets'
pcall(function() if not isfolder(assetsFolder) then makefolder(assetsFolder) end end)
local function resolveImage(src)
	if type(src) == "number" then return "rbxassetid://" .. src end
	if type(src) ~= "string" then return nil end
	if src:match("^rbx") then return src end                    -- rbxassetid:// / rbxthumb://
	if src:match("^%d+$") then return "rbxassetid://" .. src end
	if src:match("^https?://") then
		local img
		pcall(function()
			local fname = assetsFolder .. '/' .. src:gsub("[^%w]", ""):sub(-40) .. ".png"
			if not isfile(fname) then
				local data = game:HttpGet(src)
				if type(data) == "string" and #data > 100 then writefile(fname, data) end
			end
			if isfile(fname) then img = getcustomasset(fname) end
		end)
		return img
	end
	return nil -- treat as a lucide icon name
end

