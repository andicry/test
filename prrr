local NotifyColors = {
	normal  = nil, -- follows the (possibly animating) accent color live
	warning = Color3.fromRGB(235, 190, 60),
	error   = Color3.fromRGB(225, 60, 60),
	risky   = Color3.fromRGB(235, 130, 40),
}
local notifOrder = 0
local function notify(message, dur, ntype)
	dur = dur or 3
	ntype = NotifyColors[ntype] and ntype or "normal"
	notifOrder += 1
	local n = Instance.new("Frame")
	n.Size = UDim2.fromOffset(0, 22)
	n.AutomaticSize = Enum.AutomaticSize.X
	n.BackgroundColor3 = T.strip
	n.BackgroundTransparency = 1
	n.BorderSizePixel = 0
	n.LayoutOrder = notifOrder
	n.Parent = notifyHolder
	local nStroke = stroke(n, Color3.fromRGB(4, 4, 4))
	nStroke.Transparency = 1
	local topLine = Instance.new("Frame") -- animated slide line
	topLine.Size = UDim2.new(1, 0, 0, 2)
	topLine.BackgroundColor3 = NotifyColors[ntype] or T.accent
	topLine.BackgroundTransparency = 1
	topLine.BorderSizePixel = 0
	topLine.Parent = n
	if ntype == "normal" then -- track the live accent (incl. animations)
		task.spawn(function()
			while topLine.Parent do
				topLine.BackgroundColor3 = T.accent
				task.wait(1 / 20)
			end
		end)
	end
	local t = txt(n, message, 14, T.text)
	t.TextTransparency = 1
	t.Size = UDim2.fromOffset(0, 22)
	t.AutomaticSize = Enum.AutomaticSize.X
	t.Position = UDim2.fromOffset(8, 0)
	local padR = Instance.new("UIPadding")
	padR.PaddingRight = UDim.new(0, 16)
	padR.Parent = n

	local fadeIn, fadeOut = 0.35, 0.35
	local tiIn  = TweenInfo.new(fadeIn,  Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tiOut = TweenInfo.new(fadeOut, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

	-- fade in
	TweenService:Create(n, tiIn, { BackgroundTransparency = 0 }):Play()
	TweenService:Create(nStroke, tiIn, { Transparency = 0 }):Play()
	TweenService:Create(topLine, tiIn, { BackgroundTransparency = 0 }):Play()
	TweenService:Create(t, tiIn, { TextTransparency = 0 }):Play()

	-- line slides from full width down to nothing over the duration
	task.delay(fadeIn, function()
		if n.Parent then
			TweenService:Create(topLine, TweenInfo.new(dur, Enum.EasingStyle.Linear),
				{ Size = UDim2.new(0, 0, 0, 2) }):Play()
		end
	end)

	-- fade out then remove
	task.delay(fadeIn + dur, function()
		if not n.Parent then return end
		TweenService:Create(n, tiOut, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(nStroke, tiOut, { Transparency = 1 }):Play()
		TweenService:Create(topLine, tiOut, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(t, tiOut, { TextTransparency = 1 }):Play()
		task.delay(fadeOut, function() if n.Parent then n:Destroy() end end)
	end)
end

--========================================================================
-- Color ANIMATIONS engine — drives every swatch whose picker Mode isn't
-- Solid: Rainbow / Fading / Strobe / Tween (with easing), using the two
-- Animation colors and Speed % from the picker
--========================================================================
task.spawn(function()
	while true do
		task.wait(1 / 30)
		for _, flag in ipairs(AnimColorFlags) do
			local mode = Flags[flag .. "_mode"]
			if mode and mode ~= "Solid" then
				local speed = (Flags[flag .. "_speed"] or 50) / 50 -- 50% = 1x
				local c1 = Flags[flag .. "_anim1"] or Color3.fromRGB(255, 0, 0)
				local c2 = Flags[flag .. "_anim2"] or Color3.fromRGB(235, 235, 235)
				local t = os.clock() * speed
				local c
				if mode == "Rainbow" then
					c = Color3.fromHSV((t * 0.25) % 1, 1, 1)
				elseif mode == "Fading" then
					c = c1:Lerp(c2, (math.sin(t * math.pi) + 1) / 2)
				elseif mode == "Strobe" then
					c = (math.floor(t * 2) % 2 == 0) and c1 or c2
				elseif mode == "Tween" then
					local p = t % 2
					local alpha = p < 1 and p or 2 - p -- ping-pong
					local okS, style = pcall(function() return Enum.EasingStyle[Flags[flag .. "_ease_style"] or "Quad"] end)
					local okD, dir = pcall(function() return Enum.EasingDirection[Flags[flag .. "_ease_dir"] or "InOut"] end)
					if okS and okD then alpha = TweenService:GetValue(alpha, style, dir) end
					c = c1:Lerp(c2, alpha)
				end
				if c then
					Flags[flag] = c
					if FlagSetters[flag] then FlagSetters[flag](c) end
				end
			end
		end
	end
end)

