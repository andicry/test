        BorderSizePixel = 0,
        ZIndex = 70,
    })

    animatedAccentLine(
        body,
        UDim2.fromOffset(0, 0),
        UDim2.new(1, 0, 0, 1),
        71
    )

    line(
        body,
        UDim2.new(0, 0, 1, -1),
        UDim2.new(1, 0, 0, 1),
        Color3.fromRGB(50, 46, 50),
        71
    )

    local hud = {
        Frame = body,
    }

    local hudDrag

    connect(body.InputBegan, function(input)
        if not window or not window.Visible then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        closePopover()
        hideTooltip()

        local currentView = viewport()
        local current = body.Position

        hudDrag = {
            Input = input.UserInputType == Enum.UserInputType.Touch and input or nil,
            Start = input.Position,
            Offset = Vector2.new(
                current.X.Scale * currentView.X + current.X.Offset
                    - input.Position.X,
                current.Y.Scale * currentView.Y + current.Y.Offset
                    - input.Position.Y
            ),
        }
    end)

    connect(UserInputService.InputChanged, function(input)
        if not hudDrag
            or not window
            or not window.Visible
            or (input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input ~= hudDrag.Input) then
            return
        end

        local currentView = viewport()

        body.Position = UDim2.fromOffset(
            math.clamp(
                input.Position.X + hudDrag.Offset.X,
                0,
                math.max(0, currentView.X - body.AbsoluteSize.X)
            ),
            math.clamp(
                input.Position.Y + hudDrag.Offset.Y,
                0,
                math.max(0, currentView.Y - body.AbsoluteSize.Y)
            )
        )
    end)

    connect(UserInputService.InputEnded, function(input)
        if hudDrag
            and (input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch
                or input == hudDrag.Input) then
            hudDrag = nil
        end
    end)

    function hud:SetVisible(value)
        self.Frame.Visible = value == true
    end

    return hud
end

-- PolSec keeps the redeemed key and the runtime of the protected script in
-- globals (script_key, PolSec_Time_Left, ...). Read them defensively: they may
-- be values or functions depending on the build, and they simply do not exist
-- when the ui is run straight from a file.
local function readPolSecGlobal(name)
    local ok, value = pcall(function()
        return getfenv(0)[name]
    end)

    if not ok or value == nil then
        local okEnv, env = pcall(function()
            return type(getgenv) == "function" and getgenv() or nil
        end)

        if okEnv and type(env) == "table" then
            value = env[name]
        end
    end

    if type(value) == "function" then
        local okCall, result = pcall(value)

        return okCall and result or nil
    end

    return value
end

local function sessionLabel()
    local key = readPolSecGlobal("script_key")

    if type(key) ~= "string" or key == "" then
        return nil
    end

    local timeLeft = readPolSecGlobal("PolSec_Time_Left")

    if timeLeft == nil or timeLeft == "" then
        timeLeft = "lifetime"
    end

    timeLeft = tostring(timeLeft)
    timeLeft = timeLeft:gsub("%s+", " ")

    -- keep the footer readable: 8 characters are plenty to recognise a key
    local shortKey = #key > 10 and (key:sub(1, 8) .. "..") or key

    return timeLeft .. " | " .. shortKey
end

