Flags.motion_mode = "lines"
Flags.motion_scale = 1

local MG_SAMPLES = 52
local mgHistory, mgBars = {}, {}
for i = 1, MG_SAMPLES do
	mgHistory[i] = 0
	local b = Instance.new("Frame")
	b.BackgroundColor3 = T.accent
	b.BorderSizePixel = 0
	b.Parent = mgBody
	mgBars[i] = b
	table.insert(AccentUsers, function() b.BackgroundColor3 = T.accent end)
