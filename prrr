task.spawn(function()
	while true do
		task.wait(1 / 20)
		if motionGraph.Visible then
			-- sample current speed (ratio of walkspeed, scaled)
			local speed = 0
			local ch = player.Character
			local root = ch and ch:FindFirstChild("HumanoidRootPart")
			local humObj = ch and ch:FindFirstChildOfClass("Humanoid")
			if root and humObj then
				local vel = root.AssemblyLinearVelocity
				speed = Vector2.new(vel.X, vel.Z).Magnitude / math.max(humObj.WalkSpeed, 1)
			end
			speed = math.clamp(speed * (Flags.motion_scale or 1), 0, 1)
			table.remove(mgHistory, 1)
			table.insert(mgHistory, speed)

			local mode = Flags.motion_mode or "lines"
			local W, H = mgBody.AbsoluteSize.X, mgBody.AbsoluteSize.Y
			local slotW = W / MG_SAMPLES
			for i, b in ipairs(mgBars) do
				local v = mgHistory[i]
				local x = (i - 1) * slotW
				if mode ~= "waves" then -- undo wave segment transforms
					b.Rotation = 0
					b.AnchorPoint = Vector2.new(0, 0)
				end
				if mode == "lines" then
					-- filled bars from the bottom (empty when idle)
					local hgt = math.floor(v * (H - 2))
					b.Visible = hgt > 0
					b.Size = UDim2.fromOffset(math.ceil(slotW), hgt)
					b.Position = UDim2.new(0, x, 1, -hgt)
				elseif mode == "dots" then
					-- a dot at the value height (flat row of dots when idle)
					b.Visible = true
					b.Size = UDim2.fromOffset(2, 2)
					b.Position = UDim2.new(0, x, 1, -2 - math.floor(v * (H - 4)))
				else -- waves: a proper connected line — each bar is a thin
					-- ROTATED segment joining the previous point to this one
					b.Visible = true
					local prev = mgHistory[i - 1] or v
					local x1, y1 = (i - 1.5) * slotW, H - 2 - prev * (H - 4)
					local x2, y2 = (i - 0.5) * slotW, H - 2 - v * (H - 4)
					local dx, dy = x2 - x1, y2 - y1
					b.AnchorPoint = Vector2.new(0.5, 0.5)
					b.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy) + 1, 2)
					b.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
					b.Rotation = math.deg(math.atan2(dy, dx))
				end
			end
		end
	end
end)

