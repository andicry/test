    local function syncEditorFromSource()
        local lineCount = 1

        for _ in editor.Text:gmatch("\n") do
            lineCount += 1
        end

        -- an empty editor keeps the gutter blank, like a normal executor
        if editor.Text ~= "" then
            local numbers = table.create(lineCount)

            for index = 1, lineCount do
                numbers[index] = tostring(index)
            end

            gutter.Text = table.concat(numbers, "\n")
        else
            gutter.Text = ""
        end

        local boundsOk, bounds = pcall(function()
            return editor.TextBounds
        end)

        local textHeight = boundsOk and bounds and bounds.Y or 0
        local height = math.max(editorScroll.AbsoluteSize.Y - 8, textHeight + 12)

        if math.abs(editor.Size.Y.Offset - height) >= 1 then
            editor.Size = UDim2.new(1, -48, 0, height)
            gutter.Size = UDim2.fromOffset(32, height)
        end

        local cursor = tonumber(editor.CursorPosition) or 1
        local before = editor.Text:sub(
            1,
            math.clamp(cursor - 1, 0, #editor.Text)
        )
        local currentLine = 1

        for _ in before:gmatch("\n") do
            currentLine += 1
        end

        local lastNewline = before:match(".*()\n") or 0
        local column = #before - lastNewline + 1

        cursorLabel.Text = ("Ln %d, Col %d"):format(currentLine, column)
        infoLabel.Text = ("%d %s    Lua    Spaces: 4    UTF-8"):format(
            lineCount,
            lineCount == 1 and "Line" or "Lines"
        )

        if activeScript and not switchingSource then
            activeScript.Source = editor.Text
        end
    end

