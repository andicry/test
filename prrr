local function attachTabMethods(win)
    function win:SelectTab(tab)
        selectTab(self, tab)
    end

    function win:SetTabVisible(tab, value)
        if not tab or tab.Window ~= self then
            return false
        end

        local show = value ~= false

        tab.Row.Visible = show
        tab.Page.Visible = show and self.ActiveTab == tab

        if not show and self.ActiveTab == tab then
            local fallback = nil

            for _, entry in ipairs(self.Tabs) do
                if entry ~= tab and entry.Row.Visible then
                    fallback = entry
                    break
                end
            end

            if fallback then
                selectTab(self, fallback)
            end
        end

        return true
    end

    function win:CreateLuau()
        return buildLuauEditor(self)
    end

    function win:Tab(spec)
        spec = spec or {}

        local name = tostring(spec.Title or spec.Name or "tab")
        local group = tostring(spec.Group or "other")

        if group ~= self.LastGroup then
            addGroupHeading(self, group)
            self.LastGroup = group
        end

        self.NavOrder += 1

        local row = frame(self.Navigation, {
            LayoutOrder = self.NavOrder,
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundColor3 = Color3.fromRGB(34, 31, 34),
            BackgroundTransparency = 1,
            ZIndex = 15,
        })

        gradient(
            row,
            Color3.fromRGB(255, 255, 255),
            Color3.fromRGB(175, 175, 175)
        )

        local indicator = frame(row, {
            Position = UDim2.fromOffset(0, 0),
            Size = UDim2.new(0, 3, 1, 0),
            BackgroundColor3 = Library.Theme.Accent,
            Visible = false,
            ZIndex = 16,
        })

        bindTheme(indicator, "BackgroundColor3", "Accent")

        local tabIcon

        if spec.Icon then
            tabIcon = icon(
                row,
                spec.Icon,
                UDim2.fromOffset(10, 6),
                12,
                Library.Theme.TextInactive,
                17
            )
        end

        local labelObject = text(row, name, {
            Position = UDim2.fromOffset(spec.Icon and 29 or 12, 0),
            Size = UDim2.new(1, spec.Icon and -34 or -17, 1, 0),
            TextColor3 = Library.Theme.TextInactive,
            TextSize = 10,
            ZIndex = 17,
        })

        local click = hit(row, {
            Size = UDim2.fromScale(1, 1),
            ZIndex = 18,
        })

        local page = make("ScrollingFrame", {
            Name = name .. "Page",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            CanvasSize = UDim2.fromOffset(0, 0),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Library.Theme.Accent,
            Visible = false,
            ZIndex = 15,
        }, self.PageHost)

        local left, leftLayout = makeColumn(page, "Left")
        local right, rightLayout = makeColumn(page, "Right")

        local function updateCanvas()
            page.CanvasSize = UDim2.fromOffset(
                0,
                math.max(
                    leftLayout.AbsoluteContentSize.Y,
                    rightLayout.AbsoluteContentSize.Y
                ) + 24
            )
        end

        connect(
            leftLayout:GetPropertyChangedSignal("AbsoluteContentSize"),
            updateCanvas
        )

        connect(
            rightLayout:GetPropertyChangedSignal("AbsoluteContentSize"),
            updateCanvas
        )

        local tab = {
            Window = self,
            Title = name,
            Group = group,
            Order = #self.Tabs + 1,
            Row = row,
            Label = labelObject,
            Icon = tabIcon,
            Indicator = indicator,
            Page = page,
            Left = left,
            Right = right,
            SectionOrder = 0,
        }

        table.insert(self.Tabs, tab)

        if tabIcon then
            -- the rail icon tracks the accent theme AND the active tab, so a
            -- picked accent recolors it immediately instead of waiting for
            -- the next tab switch
            observeAccent(tabIcon, function(color)
                tabIcon.ImageColor3 = self.ActiveTab == tab
                    and color
                    or Library.Theme.TextInactive
            end)
        end

        connect(click.MouseEnter, function()
            if self.ActiveTab ~= tab then
                animate(row, 0.1, {
                    BackgroundTransparency = 0.45,
                })
            end
        end)

        connect(click.MouseLeave, function()
            if self.ActiveTab ~= tab then
                animate(row, 0.1, {
                    BackgroundTransparency = 1,
                })
            end
        end)

        connect(click.Activated, function()
            selectTab(self, tab)
        end)

        if not self.ActiveTab then
            selectTab(self, tab)
        end

        return tab
    end
end

