end

local function observeAccent(object, apply)
    table.insert(accentObservers, {
        Object = object,
        Apply = apply,
    })

    apply(Library.Theme.Accent)
end

local function runAccentObservers(color)
    for _, observer in ipairs(accentObservers) do
        if observer.Object and observer.Object.Parent then
            pcall(observer.Apply, color)
        end
    end
end

-- Shared 1px accent line with the sweeping gradient animation used on
-- section headers, the watermark and the keybind list.
local function animatedAccentLine(parent, position, size, z)
    local accent = frame(parent, {
        Name = "AnimatedAccent",
        Position = position,
        Size = size,
        BackgroundColor3 = Library.Theme.Accent,
        ZIndex = z or 20,
    })

    bindTheme(accent, "BackgroundColor3", "Accent")

    local accentGradient = make("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(115, 115, 115)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(115, 115, 115)),
        }),
        Offset = Vector2.new(-1, 0),
    }, accent)

    task.spawn(function()
        while alive and accentGradient.Parent do
            accentGradient.Offset = Vector2.new(-1, 0)

            local movement = TweenService:Create(
                accentGradient,
                TweenInfo.new(3, Enum.EasingStyle.Linear),
                { Offset = Vector2.new(1, 0) }
            )

            movement:Play()
            movement.Completed:Wait()
        end
    end)

    return accent
end

