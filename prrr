    -- run -----------------------------------------------------------------------
    local function runScript()
        if not enabled then
            return false
        end

        if not (window and window.Visible) then
            return false
        end

        if not activeScript then
            return false
        end

        if type(loadstring) ~= "function" then
            writeOutput("loadstring is unavailable in this environment", "Error")
            return false
        end

        local name = activeScript.Name
        local started = os.clock()
        local ok, callback, compileError = pcall(loadstring, editor.Text)

        if not ok or not callback then
            writeOutput(compileError or callback or "compilation failed", "Error")
            selectOutput("Output")
            return false
        end

        if type(setfenv) == "function" and type(getfenv) == "function" then
            local environment = setmetatable({
                print = function(...)
                    local packed = table.pack(...)
                    local parts = {}

                    for index = 1, packed.n do
                        parts[index] = tostring(packed[index])
                    end

                    writeOutput(table.concat(parts, "\t"))
                end,
                warn = function(...)
                    local packed = table.pack(...)
                    local parts = {}

                    for index = 1, packed.n do
                        parts[index] = tostring(packed[index])
                    end

                    writeOutput(table.concat(parts, "\t"), "Error")
                end,
            }, {
                __index = getfenv(callback),
            })

            if not pcall(setfenv, callback, environment) then
                writeOutput("output capture is unavailable", "Status")
            end
        end

        selectOutput("Output")

        task.spawn(function()
            local results = table.pack(pcall(callback))

            if not results[1] then
                writeOutput(results[2], "Error")
                return
            end

            for index = 2, results.n do
                writeOutput(results[index])
            end

            writeOutput(
                ("ran %s in %.1f ms"):format(name, (os.clock() - started) * 1000),
                "Status"
            )
        end)

        return true
    end

    -- files ---------------------------------------------------------------------
    local function scriptFilePath(name)
        return "Oxy/luau/" .. name
    end

    local function validScriptName(name)
        if name == ""
            or name:find('[/\\:*?"<>|]')
            or name == "."
            or name == ".." then
            return nil
        end

        if not name:lower():match("%.lua$") then
            name ..= ".lua"
        end

        return name
    end

    local function listScriptFiles()
        local ready = ensureLuauFolder()

        if not ready then
            return {}
        end

        if type(listfiles) ~= "function" then
            return {}
        end

        local ok, files = pcall(listfiles, "Oxy/luau")

        if not ok or type(files) ~= "table" then
            return {}
        end

        local names = {}

        for _, path in ipairs(files) do
            local normalized = tostring(path):gsub("\\", "/")
            local name = normalized:match("([^/]+)$")

            if name and name:lower():match("%.lua$") then
                local checkOk, isFile = pcall(isfile, scriptFilePath(name))

                if not checkOk or isFile then
                    table.insert(names, name)
                end
            end
        end

        table.sort(names, function(a, b)
            return a:lower() < b:lower()
        end)

        return names
    end

    local function saveScriptAs(rawName)
        if not enabled then
            return false, "luau is disabled"
        end

        if not (window and window.Visible) then
            return false, "the ui must be open"
        end

        if not activeScript then
            return false, "no script"
        end

        local name = validScriptName(
            (tostring(rawName or activeScript.Name)):match("^%s*(.-)%s*$")
        )

        if not name then
            writeOutput("enter a valid script name", "Error")
            return false, "invalid name"
        end

        local ready, folderError = ensureLuauFolder()

        if not ready then
            writeOutput(folderError or "could not create the Oxy/luau folder", "Error")
            return false, folderError
        end

        if type(writefile) ~= "function" then
            writeOutput("file saving is unavailable", "Error")
            return false, "no writefile"
        end

        local path = scriptFilePath(name)
        local ok, err = pcall(writefile, path, editor.Text)

        if not ok then
            writeOutput(tostring(err), "Error")
            return false, err
        end

        activeScript.Name = name
        activeScript.Path = path
        activeScript.Source = editor.Text
        refreshScriptTabs()
        writeOutput("saved " .. path, "Status")

        return true, path
    end

    local function saveCurrentScript()
        if activeScript and activeScript.Path then
            if type(writefile) ~= "function" then
                writeOutput("file saving is unavailable", "Error")
                return false, "no writefile"
            end

            local ok, err = pcall(writefile, activeScript.Path, editor.Text)

            if ok then
                activeScript.Source = editor.Text
                writeOutput("saved " .. activeScript.Path, "Status")
                return true, activeScript.Path
            end

            writeOutput(tostring(err), "Error")
            return false, err
        end

        return saveScriptAs(activeScript and activeScript.Name or nil)
    end

