local FONT_URL = "https://github.com/i77lhm/storage/raw/refs/heads/main/fonts/%s.ttf"
local FontCache = {}

local function loadFont(name)
	if FontCache[name] then return FontCache[name] end
	local font
	pcall(function()
		local ttfPath = fontsFolder .. '/' .. name .. '.ttf'
		if not isfile(ttfPath) then
			local data = game:HttpGet(FONT_URL:format(name:gsub(" ", "%%20")))
			if type(data) == 'string' and #data > 100 then writefile(ttfPath, data) end
		end
		if isfile(ttfPath) then
			local fontFile = fontsFolder .. '/' .. name .. '.font'
			if isfile(fontFile) then delfile(fontFile) end
			writefile(fontFile, HttpService:JSONEncode({
				name = "symbol_" .. name,
				faces = {{ name = "Normal", weight = 400, style = "Normal", assetId = getcustomasset(ttfPath) }},
			}))
			font = Font.new(getcustomasset(fontFile), Enum.FontWeight.Regular, Enum.FontStyle.Normal)
		end
	end)
	FontCache[name] = font
	return font
end

