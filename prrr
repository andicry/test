        end

        if type(readfile) ~= "function" then
            writeOutput("file reading is unavailable", "Error")
            return false, "no readfile"
        end

        local path = scriptFilePath(name)
        local ok, source = pcall(readfile, path)

        if not ok or type(source) ~= "string" then
            writeOutput(tostring(source or "could not open script"), "Error")
            return false, source
        end

        for _, entry in ipairs(editorTabs) do
            if entry.Path == path then
                selectScriptTab(entry)
                return true, path
            end
        end

        createScriptTab(name, source, path)
        writeOutput("opened " .. path, "Status")

        return true, path
