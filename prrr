local function setControlValue(control, value, silent)
    local previous = control.Value
    local normalized = control.Normalize and control.Normalize(value) or value

    if normalized == nil then
        return false
    end

    control.Value = normalized

    if control.Flag then
        Library.Flags[control.Flag] = normalized
    end

    if control.Update then
        control:Update(normalized)
    end

    if not silent and not sameValue(previous, normalized) then
        safeCallback(control.Callback, normalized)
    end

    return true
end

local function registerControl(control, spec, default)
    control.Flag = spec.Flag
    control.Callback = spec.Callback
    control.Value = nil

    function control:Get()
        -- only real arrays get copied; hash-only tables such as Color3 (in
        -- runtimes where it is table-backed) pass through untouched so their
        -- methods keep working
        if type(self.Value) == "table" and #self.Value > 0 then
            return copyArray(self.Value)
        end

        return self.Value
    end

    function control:Set(value, silent)
        return setControlValue(self, value, silent)
    end

    if spec.Flag then
        Library.Bound[spec.Flag] = control
    end

    control:Set(default, true)

    return control
end

