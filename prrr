--========================================================================
-- Search bar: LIVE filter — each key typed hides every element whose
-- label doesn't start-match/contain the query; empty text restores all
--========================================================================
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	local q = searchBox.Text:lower()
	for _, s in ipairs(Searchables) do
		if s.holder.Parent then
			if q == "" then
				s.holder.Visible = true
			else
				s.holder.Visible = s.label:lower():find(q, 1, true) ~= nil
			end
		end
	end
end)

--========================================================================
