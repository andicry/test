local function ensureFolder(path)
    if type(isfolder) ~= "function"
        or type(makefolder) ~= "function" then
        return false
    end

    local ok, exists = pcall(isfolder, path)

    if not ok then
        return false
    end

    if not exists then
        local made = pcall(makefolder, path)

        if not made then
            return false
        end
    end

    local checked, result = pcall(isfolder, path)
    return checked and result == true
end

local function ensureFolders()
    return ensureFolder("Oxy")
        and ensureFolder("Oxy/assets")
        and ensureFolder("Oxy/fonts")
        and ensureFolder("Oxy/configs")
        and ensureFolder("Oxy/themes")
end

local function validName(name)
    return type(name) == "string"
        and #name > 0
        and #name <= 48
        and name:match("^[%w_%- ]+$") ~= nil
end

local function copyArray(values)
    local result = {}

    for index, value in ipairs(values or {}) do
        result[index] = value
    end

    return result
end

local function sameValue(a, b)
    if type(a) ~= "table" or type(b) ~= "table" then
        return a == b
    end

    -- empty hash tables (stubbed Color3 values in test runtimes) compare by
    -- identity/equality, not element-wise
    if #a == 0 or #b == 0 then
        return a == b
    end

    if #a ~= #b then
        return false
    end

    for index, value in ipairs(a) do
        if value ~= b[index] then
            return false
        end
    end

    return true
end

local function safeCallback(callback, ...)
    if type(callback) ~= "function" then
        return
    end

    local ok, err = pcall(callback, ...)

    if not ok then
        warn("Oxy callback:", err)
    end
end

