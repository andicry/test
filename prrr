local function espConfig(values)
    local config = {}

    for key, value in pairs(ESP_CONFIG_DEFAULTS) do
        config[key] = value
    end

    for key, value in pairs(values or {}) do
        config[key] = value
    end

    return config
end

local function espLabel(parent, z)
    return text(parent, "", {
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.fromOffset(0, 0),
        TextSize = 12,
        TextColor3 = Color3.new(1, 1, 1),
        TextStrokeColor3 = Color3.new(0, 0, 0),
        TextStrokeTransparency = 0,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.None,
        Visible = false,
        ZIndex = z or 6,
    })
end

local function espBorder(parent, z)
    return {
        Top = frame(parent, { BackgroundTransparency = 0, ZIndex = z }),
        Bottom = frame(parent, { BackgroundTransparency = 0, ZIndex = z }),
        Left = frame(parent, { BackgroundTransparency = 0, ZIndex = z }),
        Right = frame(parent, { BackgroundTransparency = 0, ZIndex = z }),
    }
end

local function espBar(parent, baseZ)
    baseZ = baseZ or 3

    local outline = frame(parent, { ZIndex = baseZ })
    local background = frame(outline, { ZIndex = baseZ + 1 })
    local fill = frame(background, { ZIndex = baseZ + 2 })

    return {
        Outline = outline,
        Background = background,
        Fill = fill,
        Number = espLabel(parent, baseZ + 3),
        Value = nil,
    }
end

local function espRect(object, x, y, width, height, color, transparency)
    -- a rect that is being drawn is by definition visible: without this the
    -- corners stayed hidden after the box style was switched away and back
    object.Visible = width > 0 and height > 0
    object.Position = UDim2.fromOffset(x, y)
    object.Size = UDim2.fromOffset(math.max(0, width), math.max(0, height))
    object.BackgroundColor3 = color
    object.BackgroundTransparency = transparency or 0
end

local function espBorderVisible(border, visible)
    border.Top.Visible = visible
    border.Bottom.Visible = visible
    border.Left.Visible = visible
    border.Right.Visible = visible
end

local function espBorderRect(
    border,
    x,
    y,
    width,
    height,
    thickness,
    color,
    transparency
)
    thickness = math.min(thickness, width / 2, height / 2)

    if thickness <= 0 then
        return
    end

    espRect(border.Top, x, y, width, thickness, color, transparency)
    espRect(
        border.Bottom,
        x,
        y + height - thickness,
        width,
        thickness,
        color,
        transparency
    )

    espRect(
        border.Left,
        x,
        y + thickness,
        thickness,
        height - thickness * 2,
        color,
        transparency
    )

    espRect(
        border.Right,
        x + width - thickness,
        y + thickness,
        thickness,
        height - thickness * 2,
        color,
        transparency
    )
end

-- four corner brackets: each corner is one horizontal + one vertical bar whose
-- length is a fraction of the matching side, with an optional outline drawn
-- behind both bars
local function espCornerRect(
    corners,
    outlines,
    x,
    y,
    width,
    height,
    thickness,
    cornerX,
    cornerY,
    color,
    transparency,
    outlineSize,
    outlineColor
)
    local maxX = math.max(thickness, width / 2 - outlineSize)
    local maxY = math.max(thickness, height / 2 - outlineSize)

    local lengthX = math.clamp(width * cornerX, thickness, maxX)
    local lengthY = math.clamp(height * cornerY, thickness, maxY)

    if lengthX <= 0 or lengthY <= 0 then
        for index = 1, 8 do
            corners[index].Visible = false
            outlines[index].Visible = false
        end

        return
    end

    local function bar(index, bx, by, bw, bh)
        if outlineSize > 0 then
            espRect(
                outlines[index],
                bx - outlineSize,
                by - outlineSize,
                bw + outlineSize * 2,
                bh + outlineSize * 2,
                outlineColor,
                transparency
            )
        else
            outlines[index].Visible = false
        end

        espRect(corners[index], bx, by, bw, bh, color, transparency)
    end

    -- top left
    bar(1, x, y, lengthX, thickness)
    bar(2, x, y, thickness, lengthY)

    -- top right
    bar(3, x + width - lengthX, y, lengthX, thickness)
    bar(4, x + width - thickness, y, thickness, lengthY)

    -- bottom left
    bar(5, x, y + height - thickness, lengthX, thickness)
    bar(6, x, y + height - lengthY, thickness, lengthY)

    -- bottom right
    bar(7, x + width - lengthX, y + height - thickness, lengthX, thickness)
    bar(8, x + width - thickness, y + height - lengthY, thickness, lengthY)
end

local function espSetLabel(label, value, config, x, y, width, height, alignment, color)
    label.Visible = true
    label.Position = UDim2.fromOffset(x, y)
    label.Size = UDim2.fromOffset(width, height)
    label.Text = value
    label.TextSize = config.TextSize
    label.TextColor3 = color or config.TextColor
    label.TextStrokeColor3 = config.TextOutlineColor
    label.TextStrokeTransparency = math.clamp(
        config.TextOutlineTransparency,
        0,
        1
    )
    label.TextXAlignment = alignment or Enum.TextXAlignment.Center
end

-- baseZ lets the preview lift the whole overlay above its viewport frame;
-- z-index is global, so relative values alone would sink it behind the avatar
local function createESPObject(parent, baseZ)
    baseZ = baseZ or 1

    local container = frame(parent, {
        Name = "ESPObject",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = baseZ,
    })

    local corners = {}
    local cornerOutline = {}

    for index = 1, 8 do
        cornerOutline[index] = frame(container, { ZIndex = baseZ + 1 })
        corners[index] = frame(container, { ZIndex = baseZ + 2 })
    end

    local object = {
        Container = container,
        Outer = espBorder(container, baseZ + 1),
        Main = espBorder(container, baseZ + 2),
        Inner = espBorder(container, baseZ + 3),
        Corners = corners,
        CornerOutline = cornerOutline,
        Name = espLabel(container, baseZ + 6),
        Weapon = espLabel(container, baseZ + 6),
        Distance = espLabel(container, baseZ + 6),
        Health = espBar(container, baseZ),
        Armor = espBar(container, baseZ),
        Flags = {},
    }

    for index = 1, 8 do
        object.Flags[index] = espLabel(container, baseZ + 6)
    end

    return object
end

local function espHide(object)
    object.Container.Visible = false
end

-- state.Left/Top/Right/Bottom are raw projected bounds; padding is applied
-- here so the live esp and the preview always agree
local function espRender(object, state, config, dt)
    if not state then
        espHide(object)
        return
    end

    dt = dt or 0

    local left = math.floor(state.Left - math.max(0, config.PaddingX) + 0.5)
    local top = math.floor(state.Top - math.max(0, config.PaddingY) + 0.5)
    local right = math.floor(state.Right + math.max(0, config.PaddingX) + 0.5)
    local bottom = math.floor(state.Bottom + math.max(0, config.PaddingY) + 0.5)

    local width = right - left
    local height = bottom - top
    local thickness = math.max(1, math.floor(config.BoxThickness + 0.5))
    local outline = math.max(0, math.floor(config.OutlineThickness + 0.5))

    if width < thickness * 2 or height < thickness * 2 then
        espHide(object)
        return
    end

    object.Container.Visible = true

    local boxVisible = config.Box == true
    local boxOuter = boxVisible and outline or 0
    local cornerMode = boxVisible and config.BoxStyle == "Corners"

    local flatMode = boxVisible and not cornerMode

    espBorderVisible(object.Main, flatMode)
    espBorderVisible(object.Outer, flatMode and outline > 0)
    espBorderVisible(object.Inner, flatMode and outline > 0)

    if cornerMode then
        espCornerRect(
            object.Corners,
            object.CornerOutline,
            left,
            top,
            width,
            height,
            thickness,
            config.CornerX or 0.25,
            config.CornerY or 0.25,
            config.BoxColor,
            math.clamp(config.BoxTransparency, 0, 1),
            outline,
            config.OutlineColor
        )
    else
        for index = 1, 8 do
            object.Corners[index].Visible = false
            object.CornerOutline[index].Visible = false
        end
    end

    if flatMode then
        espBorderRect(
            object.Main,
            left,
            top,
            width,
            height,
            thickness,
            config.BoxColor,
            math.clamp(config.BoxTransparency, 0, 1)
        )

        if outline > 0 then
            espBorderRect(
                object.Outer,
                left - outline,
                top - outline,
                width + outline * 2,
                height + outline * 2,
                outline,
                config.OutlineColor,
                0
            )

            local innerWidth = width - thickness * 2
            local innerHeight = height - thickness * 2

            if innerWidth > 0 and innerHeight > 0 then
                espBorderRect(
                    object.Inner,
                    left + thickness,
                    top + thickness,
                    innerWidth,
                    innerHeight,
                    outline,
                    config.OutlineColor,
                    0
                )
            else
                espBorderVisible(object.Inner, false)
            end
        end
    end

    local textHeight = math.max(1, config.TextSize) + 3
    local textPadding = math.max(0, config.TextPadding)
    local barOutline = math.max(0, math.floor(config.BarOutlineThickness + 0.5))

    if config.Name and state.Name and state.Name ~= "" then
        espSetLabel(
            object.Name,
            state.Name,
            config,
            left - 60,
            top - boxOuter - textPadding - textHeight,
            width + 120,
            textHeight,
            nil,
            config.NameColor
        )
    else
        object.Name.Visible = false
    end

    local healthPosition = config.Health and (config.HealthPosition or "Left") or "Off"

    if healthPosition == "Left" or healthPosition == "Right" then
        local ratio = math.clamp(state.Health or 0, 0, 1)

        if object.Health.Value == nil then
            object.Health.Value = ratio
        else
            local alpha = 1 - math.exp(-math.max(0, config.BarSmoothness) * dt)
            object.Health.Value = object.Health.Value
                + (ratio - object.Health.Value) * alpha
        end

        local value = object.Health.Value
        local barWidth = math.max(1, math.floor(config.HealthWidth + 0.5))
        local outerWidth = barWidth + barOutline * 2
        local padding = math.max(0, config.HealthPadding)
        local isRight = healthPosition == "Right"

        local x = isRight
            and (right + boxOuter + padding)
            or (left - boxOuter - padding - outerWidth)

        object.Health.Outline.Visible = true

        espRect(
            object.Health.Outline,
            x,
            top - barOutline,
            outerWidth,
            height + barOutline * 2,
            config.BarOutlineColor
        )

        espRect(
            object.Health.Background,
            barOutline,
            barOutline,
            barWidth,
            height,
            config.BarBackgroundColor
        )

        if isRight then
            object.Health.Fill.AnchorPoint = Vector2.new(1, 1)
            object.Health.Fill.Position = UDim2.fromScale(1, 1)
        else
            object.Health.Fill.AnchorPoint = Vector2.new(0, 1)
            object.Health.Fill.Position = UDim2.fromScale(0, 1)
        end

        object.Health.Fill.Size = UDim2.fromScale(1, value)
        object.Health.Fill.BackgroundColor3 = config.HealthColor

        if config.HealthNumber and value < 0.9999 then
            local numberY = math.clamp(
                top + height * (1 - value) - textHeight / 2,
                top,
                math.max(top, bottom - textHeight)
            )

            local numberX = isRight and (x + outerWidth + 2) or (x - 34)

            espSetLabel(
                object.Health.Number,
                tostring(math.floor(value * 100)),
                config,
                numberX,
                numberY,
                32,
                textHeight,
                isRight and Enum.TextXAlignment.Left
                    or Enum.TextXAlignment.Right
            )
        else
            object.Health.Number.Visible = false
        end
    else
        object.Health.Outline.Visible = false
        object.Health.Number.Visible = false
        object.Health.Value = nil
    end

    local armorOffset = 0

    if config.Armor and state.Armor then
        local ratio = math.clamp(state.Armor, 0, 1)

        if object.Armor.Value == nil then
            object.Armor.Value = ratio
        else
            local alpha = 1 - math.exp(-math.max(0, config.BarSmoothness) * dt)
            object.Armor.Value = object.Armor.Value
                + (ratio - object.Armor.Value) * alpha
        end

        local value = object.Armor.Value
        local barWidth = math.max(1, math.floor(config.ArmorWidth + 0.5))
        local padding = math.max(0, config.ArmorPadding)
        local outerHeight = barWidth + barOutline * 2
        local y = bottom + boxOuter + padding

        object.Armor.Outline.Visible = true

        espRect(
            object.Armor.Outline,
            left - barOutline,
            y,
            width + barOutline * 2,
            outerHeight,
            config.BarOutlineColor
        )

        espRect(
            object.Armor.Background,
            barOutline,
            barOutline,
            width,
            barWidth,
            config.BarBackgroundColor
        )

        object.Armor.Fill.AnchorPoint = Vector2.zero
        object.Armor.Fill.Position = UDim2.fromScale(0, 0)
        object.Armor.Fill.Size = UDim2.fromScale(value, 1)
        object.Armor.Fill.BackgroundColor3 = config.ArmorColor

        armorOffset = padding + outerHeight

        if config.ArmorNumber and value < 0.9999 then
            local numberX = math.clamp(
                left + width * value - 16,
                left,
                math.max(left, right - 32)
            )

            espSetLabel(
                object.Armor.Number,
                tostring(math.floor(value * 100)),
                config,
                numberX,
                y + outerHeight + 1,
                32,
                textHeight
            )

            armorOffset = armorOffset + textHeight + 1
        else
            object.Armor.Number.Visible = false
        end
    else
        object.Armor.Outline.Visible = false
        object.Armor.Number.Visible = false
        object.Armor.Value = nil
    end

    local bottomTextY = bottom + boxOuter + armorOffset + textPadding

    if config.Weapon and state.Weapon and state.Weapon ~= "" then
        espSetLabel(
            object.Weapon,
            state.Weapon,
            config,
            left - 60,
            bottomTextY,
            width + 120,
            textHeight,
            nil,
            config.WeaponColor
        )

        bottomTextY = bottomTextY + textHeight
    else
        object.Weapon.Visible = false
    end

    if config.Distance and state.Distance then
        espSetLabel(
            object.Distance,
            tostring(math.floor(state.Distance + 0.5)) .. " studs",
            config,
            left - 60,
            bottomTextY,
            width + 120,
            textHeight,
            nil,
            config.DistanceColor
        )
    else
        object.Distance.Visible = false
    end

    -- flags stack down the right edge, one per line, and step out of the way
    -- when the health bar is drawn on that side
    local flags = state.Flags or {}
    local flagHeight = math.max(1, config.TextSize) + 1
    local flagX = right + boxOuter + math.max(0, config.FlagPadding)

    if healthPosition == "Right" then
        flagX = flagX
            + (math.max(1, math.floor(config.HealthWidth + 0.5))
                + barOutline * 2)
            + math.max(0, config.HealthPadding)
    end

    for index, label in ipairs(object.Flags) do
        local value = config.Flags and flags[index]

        if value then
            label.Visible = true
            label.Position = UDim2.fromOffset(
                flagX,
                top - boxOuter + (index - 1) * flagHeight
            )
            label.Size = UDim2.fromOffset(130, flagHeight)
            label.Text = value
            label.TextSize = math.max(8, config.TextSize - 1)
            label.TextColor3 = config.FlagColor or config.TextColor
            label.TextStrokeColor3 = config.TextOutlineColor
            label.TextStrokeTransparency = math.clamp(
                config.TextOutlineTransparency,
                0,
                1
            )
            label.TextXAlignment = Enum.TextXAlignment.Left
        else
            label.Visible = false
        end
    end
end

-- The projection has to match the engine exactly. Deriving the focal from
-- FieldOfView only holds when the camera uses a vertical fov: games that set
-- FieldOfViewMode to MaxAxis/Diagonal (or an unusual aspect) end up with a
-- slightly different scale, which shows up as boxes drifting down as players
-- get further away. Measuring two known points through the camera gives the
-- real centre and focal for whatever mode the game is using.
local function espProjection(camera, viewportSize)
    local fallbackFocal = viewportSize.Y
        / (2 * math.tan(math.rad(camera.FieldOfView) / 2))

    -- WorldToViewportPoint always projects through the *current* camera, so it
    -- only tells the truth for the live esp: the preview renders through its
    -- own camera inside a ViewportFrame and has to use the plain formula
    if camera ~= workspace.CurrentCamera then
        return viewportSize.X / 2, viewportSize.Y / 2, fallbackFocal
    end

    local frame = camera.CFrame

    local center = camera:WorldToViewportPoint(
        (frame * CFrame.new(0, 0, -10)).Position
    )
    local above = camera:WorldToViewportPoint(
        (frame * CFrame.new(0, 1, -10)).Position
    )

    local focal = math.abs(above.Y - center.Y) * 10

    if focal < 1 then
        return viewportSize.X / 2, viewportSize.Y / 2, fallbackFocal
    end

    return center.X, center.Y, focal
end

-- Projects every corner of every body part: a camera space aabb divided by the
-- near plane overshoots badly on close ups, which used to clip the preview
local function espProjectBounds(camera, parts, viewportSize)
    local inverse = camera.CFrame:Inverse()
    local centerX, centerY, focal = espProjection(camera, viewportSize)

    local left, top, right, bottom
    local initialized = false

    for _, part in ipairs(parts) do
        if part.Parent then
            local relative = inverse * part.CFrame
            local half = part.Size * 0.5

            for sx = -1, 1, 2 do
                for sy = -1, 1, 2 do
                    for sz = -1, 1, 2 do
                        local point = relative
                            * Vector3.new(
                                sx * half.X,
                                sy * half.Y,
                                sz * half.Z
                            )

                        local depth = -point.Z

                        if depth > 0.05 then
                            local x = centerX + (point.X / depth) * focal
                            local y = centerY - (point.Y / depth) * focal

                            if initialized then
                                left = math.min(left, x)
                                right = math.max(right, x)
                                top = math.min(top, y)
                                bottom = math.max(bottom, y)
                            else
                                initialized = true
                                left, right = x, x
                                top, bottom = y, y
                            end
                        end
                    end
                end
            end
        end
    end

    if not initialized then
        return nil
    end

    return left, top, right, bottom
end

local function espReadNumber(character, humanoid, name)
    local value = character:GetAttribute(name)

    if type(value) == "number" then
        return value
    end

    if humanoid then
        value = humanoid:GetAttribute(name)

        if type(value) == "number" then
            return value
        end
    end

    local child = character:FindFirstChild(name)
        or (humanoid and humanoid:FindFirstChild(name))

    if child and (child:IsA("NumberValue") or child:IsA("IntValue")) then
        return child.Value
    end

    return nil
end

local function espCompact(value)
    if value >= 1e9 then
        return string.format("%.1fb", value / 1e9)
    elseif value >= 1e6 then
        return string.format("%.1fm", value / 1e6)
    elseif value >= 1e4 then
        return string.format("%.1fk", value / 1e3)
    end

    return tostring(math.floor(value))
end

local function espPlayerFlags(ESP, character, humanoid, config)
    local flags = {}

    if not config.Flags then
        return flags
    end

    local state = humanoid and humanoid:GetState()
    local jumping = state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.Freefall
    local moving = humanoid and humanoid.MoveDirection.Magnitude > 0.05

    if jumping and moving and config.FlagWalkingJumping then
        table.insert(flags, "walking & jumping")
    elseif jumping and config.FlagJumping then
        table.insert(flags, "jumping")
    elseif moving and config.FlagWalking then
        table.insert(flags, "walking")
    elseif config.FlagIdle then
        table.insert(flags, "idle")
    end

    if config.FlagMoney then
        local money = espReadNumber(character, humanoid, "Cash")
            or espReadNumber(character, humanoid, "Money")

        if money then
            table.insert(flags, "$" .. espCompact(money))
        end
    end

    if config.FlagScoped then
        local scoped = character:GetAttribute("Scoped")
            or character:GetAttribute("Aiming")
            or (humanoid and humanoid:GetAttribute("Scoped"))

        if scoped then
            table.insert(flags, "scoped")
        end
    end

    if config.FlagArmor then
        local armor = ESP:GetArmor(character, humanoid)

        if armor then
            table.insert(flags, "armor " .. tostring(math.floor(armor)))
        end
    end

    return flags
end

local function createESP(spec)
    spec = spec or {}

    local ESP = {
        Config = espConfig(spec.Config),
        Objects = {},
        Connections = {},
        Alive = true,
        FontFace = nil,
    }

    -- the script gets re-executed all the time while a menu is being tweaked,
    -- and a previous run keeps its own overlay alive: those boxes freeze at the
    -- last position they saw and look like they belong to the wrong player, so
    -- stop the old instance before drawing a new one
    if type(getgenv().OxyDestroyESP) == "function" then
        pcall(getgenv().OxyDestroyESP)
        getgenv().OxyDestroyESP = nil
    end

    local function clearOldGui(parent)
        if not parent then
            return
        end

        for _, child in ipairs(parent:GetChildren()) do
            if child.Name == "OxyESP" then
                child:Destroy()
            end
        end
    end

    clearOldGui(player:FindFirstChild("PlayerGui"))

    do
        local ok, hui = pcall(function()
            return type(gethui) == "function" and gethui() or nil
        end)

        if ok then
            clearOldGui(hui)
        end
    end

    local espGui = make("ScreenGui", {
        Name = "OxyESP",
        ResetOnSpawn = false,
        -- true: gui space then starts at the very top of the screen, which is
        -- where camera.ViewportSize coordinates start (with the inset ignored
        -- the gui shrinks by the topbar and every box lands 58px off)
        IgnoreGuiInset = true,
        DisplayOrder = 100,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
    }, player:WaitForChild("PlayerGui"))

    ESP.Gui = espGui

    -- canvas pinned to the camera viewport: gui space and camera space differ
    -- by the topbar inset, and this makes (0,0) of the canvas == (0,0) of
    -- camera.ViewportSize no matter how the runtime reports the gui origin
    local canvas = frame(espGui, {
        Name = "Canvas",
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.fromOffset(1920, 1080),
        BackgroundTransparency = 1,
        ZIndex = 1,
    })

    ESP.Canvas = canvas

    local function track(connection)
        table.insert(ESP.Connections, connection)
        return connection
    end

    function ESP:GetArmor(character, humanoid)
        local armor = espReadNumber(character, humanoid, "Armor")

        if armor == nil then
            return nil
        end

        local maximum = espReadNumber(character, humanoid, "MaxArmor")
            or self.Config.DefaultMaxArmor

        return armor, maximum
    end

    local function refreshParts(object)
        table.clear(object.Parts)

        local character = object.Character

        if not character then
            return
        end

        object.Humanoid = character:FindFirstChildOfClass("Humanoid")

        for _, child in ipairs(character:GetChildren()) do
            if ESP_BODY_PARTS[child.Name] and child:IsA("BasePart") then
                table.insert(object.Parts, child)
            end
        end
    end

    local function disconnectCharacter(object)
        for _, connection in ipairs(object.CharacterConnections) do
            connection:Disconnect()
        end

        table.clear(object.CharacterConnections)
        table.clear(object.Parts)

        object.Character = nil
        object.Humanoid = nil
    end

    local function bindCharacter(object, character)
        disconnectCharacter(object)

        if not character then
            return
        end

        object.Character = character
        refreshParts(object)

        track(character.ChildAdded:Connect(function(child)
            if child:IsA("Humanoid")
                or (ESP_BODY_PARTS[child.Name] and child:IsA("BasePart")) then
                refreshParts(object)
            end
        end))

        track(character.ChildRemoved:Connect(function(child)
            if child:IsA("Humanoid")
                or (ESP_BODY_PARTS[child.Name] and child:IsA("BasePart")) then
                refreshParts(object)
            end
        end))
    end

    local function createObject(target)
        if target == player or ESP.Objects[target] then
            return
        end

        local renderer = createESPObject(canvas)
        renderer.Container.Name = target.Name

        local object = {
            Player = target,
            Renderer = renderer,
            Parts = {},
            CharacterConnections = {},
            PlayerConnections = {},
        }

        ESP.Objects[target] = object

        table.insert(object.PlayerConnections, target.CharacterAdded:Connect(function(character)
            bindCharacter(object, character)
        end))

        table.insert(object.PlayerConnections, target.CharacterRemoving:Connect(function(character)
            if object.Character == character then
                disconnectCharacter(object)
            end
        end))

        if target.Character then
            bindCharacter(object, target.Character)
        end
    end

    local function removeObject(target)
        local object = ESP.Objects[target]

        if not object then
            return
        end

        disconnectCharacter(object)

        for _, connection in ipairs(object.PlayerConnections) do
            connection:Disconnect()
        end

        object.Renderer.Container:Destroy()
        ESP.Objects[target] = nil
    end

    local function update(dt)
        local camera = workspace.CurrentCamera
        local config = ESP.Config

        if not camera then
            for _, object in pairs(ESP.Objects) do
                espHide(object.Renderer)
            end

            return
        end

        local viewportSize = camera.ViewportSize

        -- the gui ignores the inset, so gui (0,0) already is the top left of
        -- the screen and matches camera.ViewportSize coordinates. Offsetting
        -- by AbsolutePosition (which several executors report inset adjusted)
        -- pushed every box 58px below the player it belongs to.
        canvas.Position = UDim2.fromOffset(0, 0)
        canvas.Size = UDim2.fromOffset(viewportSize.X, viewportSize.Y)

        for target, object in pairs(ESP.Objects) do
            local character = object.Character
            local humanoid = object.Humanoid

            if not config.Enabled
                or not character
                or not character:IsDescendantOf(workspace)
                or not humanoid
                or humanoid.Parent ~= character then

                espHide(object.Renderer)
            else
                local left, top, right, bottom = espProjectBounds(
                    camera,
                    object.Parts,
                    viewportSize
                )

                if not left
                    or right < 0
                    or left > viewportSize.X
                    or bottom < 0
                    or top > viewportSize.Y then

                    espHide(object.Renderer)
                else
                    local health = humanoid.MaxHealth > 0
                        and humanoid.Health / humanoid.MaxHealth
                        or 0

                    local armor, maximum = ESP:GetArmor(character, humanoid)
                    local root = character:FindFirstChild("HumanoidRootPart")
                    local reference = root and root:IsA("BasePart")
                        and root
                        or object.Parts[1]

                    local distance = reference
                        and (reference.Position - camera.CFrame.Position).Magnitude
                        or nil

                    local tool = character:FindFirstChildOfClass("Tool")

                    espRender(object.Renderer, {
                        Left = left,
                        Top = top,
                        Right = right,
                        Bottom = bottom,
                        Name = target.DisplayName ~= ""
                            and target.DisplayName
                            or target.Name,
                        Health = health,
                        Armor = armor and maximum and maximum > 0
                            and armor / maximum
                            or nil,
                        Weapon = tool and tool.Name or nil,
                        Distance = distance,
                        Flags = espPlayerFlags(
                            ESP,
                            character,
                            humanoid,
                            config
                        ),
                    }, config, dt)
                end
            end
        end
    end

    for _, target in ipairs(Players:GetPlayers()) do
        createObject(target)
    end

    track(Players.PlayerAdded:Connect(createObject))
    track(Players.PlayerRemoving:Connect(removeObject))

    local elapsed = 0

    track(RunService.RenderStepped:Connect(function(delta)
        if not ESP.Alive or not alive then
            return
        end

        elapsed = elapsed + delta

        local hz = math.clamp(tonumber(ESP.Config.Hz) or 75, 1, 240)
        local interval = 1 / hz

        if elapsed < interval then
            return
        end

        local step = elapsed
        elapsed = elapsed % interval

        update(step)
    end))

    function ESP:Destroy()
        if not self.Alive then
            return
        end

        self.Alive = false

        for _, connection in ipairs(self.Connections) do
            connection:Disconnect()
        end

        table.clear(self.Connections)

        local targets = {}

        for target in pairs(self.Objects) do
            table.insert(targets, target)
        end

        for _, target in ipairs(targets) do
            removeObject(target)
        end

        espGui:Destroy()

        if Library.ESP == self then
            Library.ESP = nil
        end
    end

    return ESP
end

function Library:GetESP(spec)
    if not self.ESP then
        self.ESP = createESP(spec)

        -- so a later run of the library can shut this one down instead of
        -- leaving a frozen overlay on screen
        getgenv().OxyDestroyESP = function()
            if self.ESP then
                self.ESP:Destroy()
            end
        end
    end

    return self.ESP
end

-- In-tab ESP preview: renders the local avatar in a ViewportFrame and feeds the
-- shared renderer with synthetic state, so every option is visible here first.
local function createESPPreview(section, spec)
    spec = spec or {}

    local esp = Library:GetESP()
    local config = esp.Config

    if type(spec.Config) == "table" then
        for key, value in pairs(spec.Config) do
            config[key] = value
        end
    end

    local height = math.max(120, tonumber(spec.Height) or 250)
    local row = section:Row(height)

    local interior = frame(row, {
        Name = "PreviewInterior",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Library.Theme.Element,
        ClipsDescendants = true,
        ZIndex = 19,
    })

    local interiorStroke = make("UIStroke", {
        Color = Library.Theme.Inline,
        Thickness = 1,
    }, interior)

    table.insert(themeBindings, {
        Object = interiorStroke,
        Property = "Color",
        Key = "Inline",
    })

    local viewportFrame = make("ViewportFrame", {
        Name = "Avatar",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Ambient = Color3.fromRGB(170, 170, 180),
        LightColor = Color3.fromRGB(255, 255, 255),
        LightDirection = Vector3.new(-1, -1, -1),
        ZIndex = 19,
    }, interior)

    local world = make("WorldModel", {}, viewportFrame)

    local camera = make("Camera", {
        Name = "PreviewCamera",
        FieldOfView = 35,
    }, viewportFrame)

    viewportFrame.CurrentCamera = camera

    local overlay = frame(interior, {
        Name = "Overlay",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 20,
    })

    local renderer = createESPObject(overlay, 21)

    local model
    local bodyParts = {}
    local modelCenter = Vector3.zero
    local baseDistance = 12
    local rotation = 0
    local animationTime = 0
    local elapsed = 0
    local destroyed = false
    local hovering = false

    local previewConnections = {}

    local function track(connection)
        table.insert(previewConnections, connection)
        return connection
    end

    local preview = {
        Section = section,
        Frame = interior,
        Viewport = viewportFrame,
        Overlay = overlay,
        Renderer = renderer,
        Config = config,
        Zoom = 1,
        Alive = true,
    }

    local function rebuildAvatar(character)
        if model then
            model:Destroy()
            model = nil
        end

        table.clear(bodyParts)

        if not character or not character.Parent then
            return
        end

        local oldArchivable = character.Archivable
        character.Archivable = true

        local ok, clone = pcall(function()
            return character:Clone()
        end)

        character.Archivable = oldArchivable

        if not ok or not clone then
            return
        end

        for _, descendant in ipairs(clone:GetDescendants()) do
            if descendant:IsA("Script")
                or descendant:IsA("LocalScript")
                or descendant:IsA("Tool") then
                descendant:Destroy()
            elseif descendant:IsA("BasePart") then
                descendant.Anchored = true
                descendant.CanCollide = false
                descendant.CanTouch = false
                descendant.CanQuery = false
                descendant.LocalTransparencyModifier = 0
            elseif descendant:IsA("Humanoid") then
                descendant.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
            elseif descendant:IsA("BillboardGui")
                or descendant:IsA("SurfaceGui") then
                descendant:Destroy()
            end
        end

        clone:PivotTo(CFrame.new())

        for _, child in ipairs(clone:GetChildren()) do
            if ESP_BODY_PARTS[child.Name] and child:IsA("BasePart") then
                table.insert(bodyParts, child)
            end
        end

        if #bodyParts == 0 then
            clone:Destroy()
            return
        end

        local minX, maxX = math.huge, -math.huge
        local minY, maxY = math.huge, -math.huge
        local minZ, maxZ = math.huge, -math.huge
        local pivot = clone:GetPivot()

        for _, part in ipairs(bodyParts) do
            local relative = pivot:ToObjectSpace(part.CFrame)
            local half = part.Size * 0.5

            local extentX = math.abs(relative.RightVector.X) * half.X
                + math.abs(relative.UpVector.X) * half.Y
                + math.abs(relative.LookVector.X) * half.Z

            local extentY = math.abs(relative.RightVector.Y) * half.X
                + math.abs(relative.UpVector.Y) * half.Y
                + math.abs(relative.LookVector.Y) * half.Z

            local extentZ = math.abs(relative.RightVector.Z) * half.X
                + math.abs(relative.UpVector.Z) * half.Y
                + math.abs(relative.LookVector.Z) * half.Z

            minX = math.min(minX, relative.Position.X - extentX)
            maxX = math.max(maxX, relative.Position.X + extentX)
            minY = math.min(minY, relative.Position.Y - extentY)
            maxY = math.max(maxY, relative.Position.Y + extentY)
            minZ = math.min(minZ, relative.Position.Z - extentZ)
            maxZ = math.max(maxZ, relative.Position.Z + extentZ)
        end

        local centerX = (minX + maxX) / 2
        local centerY = (minY + maxY) / 2
        local centerZ = (minZ + maxZ) / 2
        local modelHeight = math.max(1, maxY - minY)
        local maxWidth = 0

        for _, part in ipairs(bodyParts) do
            maxWidth = math.max(maxWidth, part.Size.X, part.Size.Z)
        end

        modelCenter = Vector3.new(centerX, centerY, centerZ)
        baseDistance = math.max(8, modelHeight * 2.3, maxWidth * 3)

        clone.Name = "PreviewAvatar"
        clone.Parent = world
        model = clone
        rotation = 0
    end

    -- synthetic state so the preview shows every element at once
    local function previewFlags(time)
        local flags = {}

        if not config.Flags then
            return flags
        end

        local phase = math.floor(time / 2.5) % 3

        if phase == 0 and config.FlagIdle then
            table.insert(flags, "idle")
        elseif phase == 1 and config.FlagWalking then
            table.insert(flags, "walking")
        elseif phase == 2 and config.FlagJumping then
            table.insert(flags, "jumping")
        end

        if config.FlagMoney then
            table.insert(flags, "$1.2k")
        end

        if config.FlagScoped then
            table.insert(flags, "scoped")
        end

        if config.FlagArmor then
            table.insert(flags, "armor 72")
        end

        return flags
    end

    local function pingPong(time, duration)
        duration = math.max(0.1, tonumber(duration) or 1)
        local phase = (time % duration) / duration
        return 1 - math.abs(phase * 2 - 1)
    end

    local function render()
        if not model then
            espHide(renderer)
            return
        end

        local size = viewportFrame.AbsoluteSize

        if size.X <= 0 or size.Y <= 0 then
            espHide(renderer)
            return
        end

        local left, top, right, bottom = espProjectBounds(
            camera,
            bodyParts,
            size
        )

        if not left then
            espHide(renderer)
            return
        end

        espRender(renderer, {
            Left = left,
            Top = top,
            Right = right,
            Bottom = bottom,
            Name = player.DisplayName ~= ""
                and player.DisplayName
                or player.Name,
            Health = 0.35 + 0.65 * pingPong(animationTime, 6),
            Armor = 0.25 + 0.75 * pingPong(animationTime, 8),
            Weapon = spec.Weapon or "weapon",
            Distance = 6 + 90 * pingPong(animationTime, 10),
            Flags = previewFlags(animationTime),
            Viewport = size,
        }, config, 1 / 60)
    end

    function preview:SetOption(key, value)
        if key == nil then
            return
        end

        config[key] = value
    end

    function preview:GetOption(key)
        return config[key]
    end

    function preview:SetConfig(values)
        if type(values) ~= "table" then
            return
        end

        for key, value in pairs(values) do
            config[key] = value
        end
    end

    function preview:SetZoom(value)
        self.Zoom = math.clamp(tonumber(value) or 1, 0.55, 2.5)
    end

    function preview:Refresh()
        rebuildAvatar(player.Character)
    end

    function preview:Destroy()
        if not self.Alive then
            return
        end

        self.Alive = false
        destroyed = true

        for _, connection in ipairs(previewConnections) do
            connection:Disconnect()
        end

        table.clear(previewConnections)

        if interior.Parent then
            interior:Destroy()
        end

        section.Preview = nil
    end

    rebuildAvatar(player.Character)

    track(player.CharacterAdded:Connect(function(character)
        task.spawn(function()
            character:WaitForChild("Humanoid", 10)
            character:WaitForChild("Head", 10)

            if preview.Alive and player.Character == character then
                rebuildAvatar(character)
            end
        end)
    end))

    -- wheel over the preview zooms the avatar instead of scrolling the tab
    track(interior.MouseEnter:Connect(function()
        hovering = true

        if section.Tab and section.Tab.Page then
            section.Tab.Page.ScrollingEnabled = false
        end
    end))

    track(interior.MouseLeave:Connect(function()
        hovering = false

        if section.Tab and section.Tab.Page then
            section.Tab.Page.ScrollingEnabled = true
        end
    end))

    track(UserInputService.InputChanged:Connect(function(input)
        if not hovering
            or not preview.Alive
            or input.UserInputType ~= Enum.UserInputType.MouseWheel then
            return
        end

        preview:SetZoom(preview.Zoom - input.Position.Z * 0.12)
    end))

    track(RunService.RenderStepped:Connect(function(delta)
        if destroyed or not preview.Alive or not alive then
            return
        end

        if section.Tab and section.Tab.Page and not section.Tab.Page.Visible then
            return
        end

        if section.Tab and section.Tab.Window and not section.Tab.Window.Visible then
            return
        end

        animationTime = animationTime + delta

        if model then
            rotation = (rotation + 35 * delta) % 360

            model:PivotTo(
                CFrame.new(modelCenter)
                    * CFrame.Angles(0, math.rad(rotation), 0)
                    * CFrame.new(-modelCenter)
            )

            local distance = baseDistance / math.max(0.2, preview.Zoom)
                * 1.26

            camera.CFrame = CFrame.lookAt(
                modelCenter + Vector3.new(distance * 0.28, 0, distance),
                modelCenter
            )
        end

        elapsed = elapsed + delta

        local interval = 1 / math.clamp(tonumber(config.Hz) or 60, 1, 240)

        if elapsed >= interval then
            elapsed = elapsed % interval
            render()
        end
    end))

    section.Preview = preview

    return preview
end

