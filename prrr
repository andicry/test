local function makeSection(tab, spec)
    spec = spec or {}

    local name = tostring(spec.Name or spec.Title or "section")
    local side = string.lower(tostring(spec.Side or "Left"))
    local column = side == "right" and tab.Right or tab.Left

    tab.SectionOrder += 1

    local sectionFrame = frame(column, {
        Name = name .. "Section",
        LayoutOrder = tab.SectionOrder,
        Size = UDim2.new(1, 0, 0, 22),
        BackgroundColor3 = Library.Theme.Section,
        ClipsDescendants = false,
        ZIndex = 17,
    })

    bindTheme(sectionFrame, "BackgroundColor3", "Section")

    gradient(
        sectionFrame,
        Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(205, 205, 205)
    )

    local sectionHeader = frame(sectionFrame, {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundColor3 = Color3.fromRGB(23, 22, 23),
        ZIndex = 18,
    })

    gradient(
        sectionHeader,
        Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(165, 165, 165)
    )

    local accent = animatedAccentLine(
        sectionHeader,
        UDim2.fromOffset(0, 0),
        UDim2.new(1, 0, 0, 1),
        20
    )

    local titleOffset = 7

    if spec.Icon then
        icon(
            sectionHeader,
            spec.Icon,
            UDim2.fromOffset(6, 5),
            10,
            Library.Theme.TextInactive,
            21
        )

        titleOffset = 21
    end

    text(sectionHeader, name, {
        Position = UDim2.fromOffset(titleOffset, 1),
        Size = UDim2.new(1, -titleOffset - 20, 1, -1),
        TextSize = 10,
        ZIndex = 21,
    })

    local content = frame(sectionFrame, {
        Name = "Content",
        Position = UDim2.fromOffset(8, 24),
        Size = UDim2.new(1, -16, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        ZIndex = 18,
    })

    local layout = make("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 2),
    }, content)

    make("UIPadding", {
        PaddingBottom = UDim.new(0, 7),
    }, content)

    local section = {
        Tab = tab,
        Frame = sectionFrame,
        Header = sectionHeader,
        Content = content,
        Layout = layout,
        Order = 0,
        Collapsed = false,
    }

    local function updateHeight()
        if section.Collapsed then
            return
        end

        sectionFrame.Size = UDim2.new(
            1,
            0,
            0,
            24 + layout.AbsoluteContentSize.Y
        )
    end

    connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"), updateHeight)

    function section:Row(height)
        self.Order += 1

        return frame(self.Content, {
            LayoutOrder = self.Order,
            Size = UDim2.new(1, 0, 0, height or 17),
            BackgroundTransparency = 1,
            ZIndex = 19,
        })
    end

    function section:Collapse(value)
        if value == nil then
            value = not self.Collapsed
        end

        self.Collapsed = value == true

        if self.Collapsed then
            self.Content.Visible = false
        end

        local target = self.Collapsed
            and 20
            or 24 + self.Layout.AbsoluteContentSize.Y

        animate(self.Frame, 0.15, {
            Size = UDim2.new(1, 0, 0, target),
        })

        if not self.Collapsed then
            task.delay(0.16, function()
                if alive and not self.Collapsed then
                    self.Content.Visible = true
                end
            end)
        end
    end

    local headerClick = hit(sectionHeader, {
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 22,
    })

    connect(headerClick.Activated, function()
        section:Collapse()
    end)

    return section
end

