local function httpGetBody(url)
    local ok, result = pcall(game.HttpGet, game, url)

    if ok and type(result) == "string" then
        return result
    end

    local requestFn = http_request or request or (syn and syn.request)

    if type(requestFn) ~= "function" then
        return nil
    end

    local ok2, response = pcall(requestFn, {
        Url = url,
        Method = "GET",
    })

    if not ok2 then
        return nil
    end

    if type(response) == "table" and type(response.body) == "string" then
        return response.body
    end

    if type(response) == "string" then
        return response
    end

    return nil
end

local function resolveImage(value, name)
    if type(value) ~= "string" or value == "" then
        return ""
    end

    if value:match("^%d+$") then
        return "rbxassetid://" .. value
    end

    if value:match("^rbxassetid://%d+$")
        or value:match("^rbxasset://")
        or value:match("^rbxthumb://") then
        return value
    end

    if not value:match("^https?://") then
        return ""
    end

    -- Full image URLs: download once, register as a custom asset. When the
    -- environment can't fetch or register files, pass the URL through raw so
    -- runtimes that resolve image URLs directly can still show it. The second
    -- return tells the caller which path succeeded so it can warn the user
    -- when only the fallback worked.
    if type(writefile) == "function"
        and type(getcustomasset) == "function"
        and ensureFolders() then
        local bytes = httpGetBody(value)

        if bytes and #bytes >= 64 then
            local extension

            if bytes:sub(1, 8) == "\137PNG\r\n\26\n" then
                extension = ".png"
            elseif bytes:sub(1, 3) == "\255\216\255" then
                extension = ".jpg"
            elseif bytes:sub(1, 4) == "RIFF"
                and bytes:sub(9, 12) == "WEBP" then
                -- most image hosts serve webp these days, and getcustomasset
                -- reads it fine: without this the raw url was passed to an
                -- ImageLabel, which silently renders nothing
                extension = ".webp"
            elseif bytes:sub(1, 6) == "GIF87a"
                or bytes:sub(1, 6) == "GIF89a" then
                extension = ".gif"
            end

            if extension then
                local path = "Oxy/assets/" .. name .. extension
                local wrote = pcall(writefile, path, bytes)

                if wrote then
                    local registered, asset = pcall(getcustomasset, path)

                    if registered and type(asset) == "string" then
                        return asset, "custom"
                    end
                end
            end
        end
    end

    return value, "direct"
end

local function serialize(value)
    local kind = typeof(value)

    if kind == "Color3" then
        return {
            Type = "Color3",
            Value = value:ToHex(),
        }
    end

    if kind == "EnumItem" then
        return {
            Type = "Enum",
            EnumType = tostring(value.EnumType),
            Value = value.Name,
        }
    end

    if type(value) == "table" then
        local result = {}

        for index, item in ipairs(value) do
            result[index] = serialize(item)
        end

        return result
    end

    if type(value) == "string"
        or type(value) == "number"
        or type(value) == "boolean" then
        return value
    end

    return nil
end

local function deserialize(value)
    if type(value) ~= "table" then
        return value
    end

    if value.Type == "Color3" then
        local hex = value.Value

        if type(hex) ~= "string" or not hex:match("^%x%x%x%x%x%x$") then
            return nil
        end

        return Color3.fromRGB(
            tonumber(hex:sub(1, 2), 16),
            tonumber(hex:sub(3, 4), 16),
            tonumber(hex:sub(5, 6), 16)
        )
    end

    if value.Type == "Enum" then
        local ok, result = pcall(function()
            if value.EnumType == "Enum.UserInputType" then
                return Enum.UserInputType[value.Value]
            end

            return Enum.KeyCode[value.Value]
        end)

        return ok and result or nil
    end

    local result = {}

    for index, item in ipairs(value) do
        result[index] = deserialize(item)
    end

    return result
end

local function saveFile(path, value)
    if type(writefile) ~= "function" or not ensureFolders() then
        return false, "file APIs unavailable"
    end

    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, value)

    if not ok then
        return false, tostring(encoded)
    end

    local wrote, err = pcall(writefile, path, encoded)

    if not wrote then
        return false, tostring(err)
    end

    return true
end

local function readFile(path)
    if type(readfile) ~= "function" or type(isfile) ~= "function" then
        return false, "file APIs unavailable"
    end

    local checked, exists = pcall(isfile, path)

    if not checked or not exists then
        return false, "file not found"
    end

    local ok, content = pcall(readfile, path)

    if not ok then
        return false, tostring(content)
    end

    local decoded, result = pcall(HttpService.JSONDecode, HttpService, content)

    if not decoded then
        return false, tostring(result)
    end

    return true, result
end

local function listFiles(folder, memory)
    local names = {}
    local seen = {}

    for name in pairs(memory) do
        seen[name] = true
        table.insert(names, name)
    end

    if type(listfiles) == "function" and ensureFolders() then
        local ok, files = pcall(listfiles, folder)

        if ok and type(files) == "table" then
            for _, path in ipairs(files) do
                local normalized = tostring(path):gsub("\\", "/")
                local name = normalized:match("([^/]+)%.json$")

                if name and not seen[name] then
                    seen[name] = true
                    table.insert(names, name)
                end
            end
        end
    end

    table.sort(names)
    return names
end

local function deleteFile(path)
    if type(delfile) ~= "function" or type(isfile) ~= "function" then
        return false, "file APIs unavailable"
    end

    local checked, exists = pcall(isfile, path)

    if not checked or not exists then
        return false, "file not found"
    end

    local ok, err = pcall(delfile, path)

    if not ok then
        return false, tostring(err)
    end

    return true
end

