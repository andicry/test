end

-- Loader ("Operation One" style): Information panel + load/exit.
-- Fully customizable via getgenv().symbol_loader = { ... } (all optional):
--   enabled     (false = never show)
--   title       (window title, default = UIConfig.name)
--   infoTitle   ("Information")
--   optionsTitle("Options")
--   welcome     ("Welcome <displayname>")
--   text        ("Loaded <name>")
--   version     ("Version 1.0")
--   image       (asset/rbxthumb url; default = your avatar headshot)
--   loadText    ("load")   exitText ("exit")
--   width/height (410 x 210)
-- Also skippable via the "skip loader" setting (persisted to a file).
local LC = (getgenv and getgenv().symbol_loader) or {}
LC.enabled      = LC.enabled ~= false
LC.title        = LC.title or UIConfig.name
LC.infoTitle    = LC.infoTitle or "Information"
LC.optionsTitle = LC.optionsTitle or "Options"
LC.welcome      = LC.welcome or ("Welcome " .. player.DisplayName)
LC.text         = LC.text or ("Loaded " .. UIConfig.name)
LC.version      = LC.version or "Version 1.0"
-- image accepts URLs, asset ids, or rbx content strings
LC.image        = resolveImage(LC.image or UIConfig.icon)
	or ("rbxthumb://type=AvatarHeadShot&id=" .. player.UserId .. "&w=150&h=150")
LC.loadText     = LC.loadText or "load"
LC.exitText     = LC.exitText or "exit"
LC.width        = LC.width or 410
LC.height       = LC.height or 210

local skipLoader = not LC.enabled
pcall(function() skipLoader = skipLoader or isfile(baseFolder .. '/skip_loader.txt') end)

if not skipLoader then
	main.Visible = false
	local loader = Instance.new("Frame")
	loader.Size = UDim2.fromOffset(LC.width, LC.height)
	loader.Position = UDim2.new(0.5, -LC.width / 2, 0.5, -LC.height / 2)
	loader.BackgroundColor3 = T.bg
	loader.BorderSizePixel = 0
	loader.ZIndex = 200
	loader.Parent = gui
	round(loader, 4)
	stroke(loader, Color3.fromRGB(4, 4, 4))
	makeDraggable(loader) -- moveable
	local title = txt(loader, "", 14, T.text, true)
	title.RichText = true
	-- default title uses the two-part brand (secondary in accent color)
	title.Text = (getgenv and getgenv().symbol_loader and getgenv().symbol_loader.title) and LC.title or brandRich()
	title.Size = UDim2.new(1, -16, 0, 22)
	title.Position = UDim2.fromOffset(10, 0)
	title.ZIndex = 201

	local info = Instance.new("Frame")
	info.Size = UDim2.new(1, -16, 0, 110)
	info.Position = UDim2.fromOffset(8, 26)
	info.BackgroundColor3 = T.section
	info.BorderSizePixel = 0
	info.ZIndex = 201
	info.Parent = loader
	stroke(info, Color3.fromRGB(4, 4, 4))
	local infoTitle = txt(info, LC.infoTitle, 14, T.text, true)
	infoTitle.Size = UDim2.new(1, -16, 0, 20)
	infoTitle.Position = UDim2.fromOffset(8, 0)
	infoTitle.ZIndex = 202
	hline(info, 20, T.line, 202)
	local infoImg = Instance.new("ImageLabel")
	infoImg.Size = UDim2.fromOffset(80, 80)
	infoImg.Position = UDim2.fromOffset(10, 26)
	infoImg.BackgroundColor3 = T.inset
	infoImg.BorderSizePixel = 0
	infoImg.ZIndex = 202
	infoImg.Parent = info
	pcall(function() infoImg.Image = LC.image end)
	local infoText = txt(info, LC.welcome .. "\n" .. LC.text .. "\n" .. LC.version, 13, T.text)
	infoText.Size = UDim2.new(1, -110, 0, 80)
	infoText.Position = UDim2.fromOffset(100, 26)
	infoText.TextYAlignment = Enum.TextYAlignment.Top
	infoText.ZIndex = 202

	local optFrame = Instance.new("Frame")
	optFrame.Size = UDim2.new(1, -16, 0, 60)
	optFrame.Position = UDim2.fromOffset(8, 142)
	optFrame.BackgroundColor3 = T.section
	optFrame.BorderSizePixel = 0
	optFrame.ZIndex = 201
	optFrame.Parent = loader
	stroke(optFrame, Color3.fromRGB(4, 4, 4))
	local optTitle = txt(optFrame, LC.optionsTitle, 14, T.text, true)
	optTitle.Size = UDim2.new(1, -16, 0, 20)
	optTitle.Position = UDim2.fromOffset(8, 0)
	optTitle.ZIndex = 202
	hline(optFrame, 20, T.line, 202)
	local function loaderBtn(text, x, cb)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0.5, -12, 0, 24)
		b.Position = UDim2.new(x, x == 0.5 and 4 or 8, 0, 28)
		b.Text = text
		b.TextSize = 14
		b.FontFace = VERDANA
		b.TextColor3 = T.text
		b.AutoButtonColor = false
		b.ZIndex = 202
		b.Parent = optFrame
		styleElement(b, true)
		b.MouseButton1Click:Connect(cb)
		return b
	end
	loaderBtn(LC.loadText, 0, function()
		loader:Destroy()
		main.Visible = true
		notify(UIConfig.name .. " loaded")
	end)
	loaderBtn(LC.exitText, 0.5, function() unloadAll() end)
