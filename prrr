-- fill + rounded knob. Click the value to type it.
local function buildSlider(parent, opts)
	local flag, min, max = opts.flag, opts.min or 0, opts.max or 1
	local step = opts.step or 0.1
	Flags[flag] = opts.default or min

	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, 30)
	holder.BackgroundTransparency = 1
	holder.ZIndex = (parent.ZIndex or 1) + 1
	holder.Parent = parent

	local lbl = txt(holder, opts.text, 14, T.dim)
	lbl.Size = UDim2.new(0.55, 0, 0, 15)

	-- typeable value (looks like plain text until you click into it)
	local valBox = Instance.new("TextBox")
	valBox.Size = UDim2.new(0.45, 0, 0, 15)
	valBox.Position = UDim2.fromScale(0.55, 0)
	valBox.BackgroundTransparency = 1
	valBox.Text = ""
	valBox.TextSize = 14
	valBox.FontFace = VERDANA
	valBox.TextColor3 = T.text
	valBox.TextXAlignment = Enum.TextXAlignment.Left
	valBox.ClearTextOnFocus = false
	valBox.ZIndex = holder.ZIndex
	valBox.Parent = holder

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, 0, 0, 8)
	track.Position = UDim2.fromOffset(0, 19)
	track.BackgroundColor3 = T.inset
	track.BorderSizePixel = 0
	track.ClipsDescendants = true
	track.ZIndex = holder.ZIndex
	track.Parent = holder
	round(track, 4)
	stroke(track, Color3.fromRGB(4, 4, 4))

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = T.accent
	fill.BorderSizePixel = 0
	fill.ZIndex = holder.ZIndex
	fill.Parent = track
	round(fill, 4)
	local fg = Instance.new("UIGradient")
	fg.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 170, 170))
	fg.Rotation = 90
	fg.Parent = fill
	table.insert(AccentUsers, function() fill.BackgroundColor3 = T.accent end)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.fromOffset(6, 12)
	knob.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
	knob.BorderSizePixel = 0
	knob.ZIndex = holder.ZIndex + 1
	knob.Parent = track
	round(knob, 3)
	stroke(knob, Color3.fromRGB(4, 4, 4))

	local value = Flags[flag]
	local function setValue(v, fire)
		v = math.clamp(math.round(v / step) * step, min, max)
		value = tonumber(string.format("%.3f", v))
		Flags[flag] = value
		local a = (value - min) / (max - min)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, -3, 0.5, -6)
		valBox.Text = fmtNum(value) .. (opts.suffix or "")
		if fire and opts.callback then opts.callback(value) end
	end
	FlagSetters[flag] = function(v) setValue(v, true) end
	setValue(value, false)

	valBox.Focused:Connect(function()
		valBox.Text = fmtNum(value) -- strip suffix for editing
	end)
	valBox.FocusLost:Connect(function()
		-- parens: gsub returns (string, count) and tonumber(s, n) errors
		local n = tonumber((valBox.Text:gsub("[^%d%.%-]", "")))
		if n then setValue(n, true) else setValue(value, false) end
	end)

	local sliding = false
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			sliding = true
			setValue(min + ((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X) * (max - min), true)
		end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then
			local a = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			setValue(min + a * (max - min), true)
		end
	end)
	if opts.tooltip then attachTooltip(holder, opts.tooltip) end
	table.insert(Searchables, { label = opts.text or "", holder = holder })
	return holder
end

-- Dropdown: opens directly below; single = chevron, multi = hamburger (≡)
-- selected option shown bold + accent (like "Solid" / "none" in reference)
local function buildDropdown(parent, opts)
	local flag, multi = opts.flag, opts.multi
	local value = opts.default or (multi and {} or opts.options[1])
	Flags[flag] = value

	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(opts.half and 0.5 or 1, opts.half and -3 or 0, 0, opts.label and 38 or 20)
	holder.BackgroundTransparency = 1
	holder.ZIndex = (parent.ZIndex or 1) + 1
	holder.Parent = parent

	local y = 0
	if opts.label then
		local l = txt(holder, opts.label, 14, T.dim)
		l.Size = UDim2.new(1, 0, 0, 12)
		y = 16
	end

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 20)
	btn.Position = UDim2.fromOffset(0, y)
	btn.BackgroundColor3 = T.element
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.ZIndex = holder.ZIndex
	btn.Parent = holder
	styleElement(btn, true)

	local btnLbl = txt(btn, "", 14, T.text)
	btnLbl.Size = UDim2.new(1, -24, 1, 0)
	btnLbl.Position = UDim2.fromOffset(6, 0)
	btnLbl.TextTruncate = Enum.TextTruncate.AtEnd
	local chev = icon(btn, multi and "menu" or "chevron-down", 12, T.dim)
	chev.AnchorPoint = Vector2.new(0.5, 0.5)
	chev.Position = UDim2.new(1, -11, 0.5, 0)

	local function displayText()
		if multi then return #value == 0 and "none" or table.concat(value, ", ") end
		return tostring(value)
	end
	btnLbl.Text = displayText()

	local function apply(v)
		value = v
		Flags[flag] = v
		btnLbl.Text = displayText()
		if opts.callback then opts.callback(v) end
	end
	FlagSetters[flag] = apply

	btn.MouseButton1Click:Connect(function()
		if togglePopupFor(btn) then return end -- re-click closes own list
		local lvl = popupLevelFor(btn)         -- nested when inside a gear popup
		local pop = popupBelow(btn, math.max(btn.AbsoluteSize.X, opts.popW or 0), lvl)
		local z = pop.ZIndex + 1
		if opts.header then
			local h = txt(pop, opts.header, 14, T.dim)
			h.Size = UDim2.new(1, 0, 0, 14)
			h.ZIndex = z
		end
		-- options live in an invisible scroller so long lists wheel-scroll
		local optHolder = Instance.new("ScrollingFrame")
		optHolder.Size = UDim2.new(1, 0, 0, math.min(#opts.options * 16, 190))
		optHolder.BackgroundTransparency = 1
		optHolder.BorderSizePixel = 0
		optHolder.ScrollBarThickness = 0
		optHolder.ScrollingDirection = Enum.ScrollingDirection.Y
		optHolder.AutomaticCanvasSize = Enum.AutomaticSize.Y
		optHolder.CanvasSize = UDim2.new()
		optHolder.ZIndex = z
		optHolder.Parent = pop
		local optList = Instance.new("UIListLayout")
		optList.SortOrder = Enum.SortOrder.LayoutOrder
		optList.Parent = optHolder
		for _, optName in ipairs(opts.options) do
			local o = Instance.new("TextButton")
			o.Size = UDim2.new(1, 0, 0, 16)
			o.BackgroundTransparency = 1
			o.Text = optName
			o.TextSize = 14
			o.FontFace = VERDANA
			o.TextXAlignment = Enum.TextXAlignment.Left
			o.ZIndex = z
			o.Parent = optHolder
			local function refresh()
				local sel = multi and (table.find(value, optName) ~= nil) or (value == optName)
				o.TextColor3 = sel and T.accent or T.dim
				o.FontFace = sel and VERDANA_BOLD or VERDANA
			end
			refresh()
			o.MouseButton1Click:Connect(function()
				if multi then
					local idx = table.find(value, optName)
					if idx then table.remove(value, idx) else table.insert(value, optName) end
					apply(value)
					refresh()
				else
					apply(optName)
					closePopupsFrom(lvl)
				end
			end)
		end
	end)
	if opts.tooltip then attachTooltip(holder, opts.tooltip) end
	table.insert(Searchables, { label = opts.label or "", holder = holder })
	return holder
end

local buildToggle -- fwd decl (chip MB2 menu uses it before its definition)

-- Keybind chip: "Toggle: NONE" (photo style) — usable inline on a toggle row
local function keyNameOf(input)
	if input.UserInputType == Enum.UserInputType.Keyboard then return input.KeyCode.Name
	elseif input.UserInputType == Enum.UserInputType.MouseButton2 then return "MB2"
	elseif input.UserInputType == Enum.UserInputType.MouseButton3 then return "MB3" end
end

local function attachKeybindChip(holder, opts)
	local flag = opts.flag
	local bound = opts.default or "NONE"
	Flags[flag] = bound

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(84, 16)
	btn.Position = UDim2.new(1, -(opts.rightPad or 0) - 84, 0, 1)
	btn.BackgroundColor3 = T.element
	btn.TextSize = 12
	btn.FontFace = VERDANA
	btn.TextColor3 = T.dim
	btn.AutoButtonColor = false
	btn.BorderSizePixel = 0
	btn.ZIndex = holder.ZIndex + 1
	btn.Parent = holder
	styleElement(btn, true)

	local listening = false
	local function refresh() btn.Text = listening and "Toggle: ..." or ("Toggle: " .. bound) end
	refresh()

	local entry = { name = opts.text or flag, key = bound, flag = flag, active = false }
	table.insert(Keybinds, entry)

	local function setBind(name)
		bound = name entry.key = name Flags[flag] = name refresh()
	end
	FlagSetters[flag] = setBind

	btn.MouseButton1Click:Connect(function() listening = true refresh() end)
	-- MB2 on the chip: mode (Toggle/Hold/Always), show in list, reset key
	Flags[flag .. "_mode"] = Flags[flag .. "_mode"] or "Toggle"
	Flags[flag .. "_show"] = Flags[flag .. "_show"] ~= false
	btn.MouseButton2Click:Connect(function()
		if togglePopupFor(btn) then return end
		local pop = popupAtMouse(180, popupLevelFor(btn), btn)
		buildDropdown(pop, { flag = flag .. "_mode", label = "mode",
			options = { "Toggle", "Hold", "Always" }, default = Flags[flag .. "_mode"] })
		buildToggle(pop, { flag = flag .. "_show", text = "show in list", default = Flags[flag .. "_show"] })
		local rk = Instance.new("TextButton")
		rk.Size = UDim2.new(1, 0, 0, 20)
		rk.Text = "reset key"
		rk.TextSize = 14
		rk.FontFace = VERDANA
		rk.TextColor3 = T.text
		rk.AutoButtonColor = false
		rk.ZIndex = pop.ZIndex + 1
		rk.Parent = pop
		styleElement(rk, true)
		rk.MouseButton1Click:Connect(function() setBind("NONE") end)
	end)
	UserInputService.InputBegan:Connect(function(input, gpe)
		if listening then
			if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
				listening = false setBind("NONE") return
			end
			local n = keyNameOf(input)
			if n then listening = false setBind(n) end
			return
		end
		if gpe then return end
		local n = keyNameOf(input)
		if n and n == bound then
			local mode = Flags[flag .. "_mode"] or "Toggle"
			if mode == "Hold" then entry.active = true
			elseif mode == "Toggle" then entry.active = not entry.active end
			if opts.onPressed then opts.onPressed() end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local n = keyNameOf(input)
		if n and n == bound and (Flags[flag .. "_mode"] or "Toggle") == "Hold" then
			entry.active = false
			if opts.onPressed then opts.onPressed() end -- hold releases the toggle
		end
	end)
	return btn
end

-- Standalone keybind row (Settings page "menu keybind")
local function buildKeybind(parent, opts)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, 20)
	holder.BackgroundTransparency = 1
	holder.ZIndex = (parent.ZIndex or 1) + 1
	holder.Parent = parent
	local l = txt(holder, opts.text, 14, T.dim)
	l.Size = UDim2.new(1, -90, 1, 0)
	attachKeybindChip(holder, opts)
	return holder
end

-- Color picker (reference style): Solid | Animations tabs.
-- Solid: SV box, hue bar, current-color bar, "R, G, B," + Copy + Paste, Reset
-- Animations: Mode, Speed %, two Colors, Easing Style/Direction (Tween only)
local buildSubTabs -- fwd decl (defined below, used by the picker)

local function buildColorPopup(pop, flag, callback, solidOnly)
	local defaultCol = Flags[flag] or Color3.fromRGB(255, 0, 0)
	local col = defaultCol
	local h, s, v = col:ToHSV()
	local z = pop.ZIndex + 1

	local function page()
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, 0)
		f.AutomaticSize = Enum.AutomaticSize.Y
		f.BackgroundTransparency = 1
		f.ZIndex = z
		f.Parent = pop
		local ll = Instance.new("UIListLayout")
		ll.SortOrder = Enum.SortOrder.LayoutOrder
		ll.Padding = UDim.new(0, 5)
		ll.Parent = f
		return f
	end
	local solidPage, animPage = page(), page()
	animPage.Visible = false
	if solidOnly then
		-- nested pickers (an animation's Color rows) are Solid only — you
		-- can't animate a color that's already part of an animation
		local hdr = txt(pop, "Solid", 14, T.accent2, true)
		hdr.Size = UDim2.new(1, 0, 0, 16)
		hdr.TextXAlignment = Enum.TextXAlignment.Center
		hdr.LayoutOrder = -1
		hdr.ZIndex = z
	else
		buildSubTabs(pop, { "Solid", "Animations" }, function(n)
			solidPage.Visible = n == "Solid"
			animPage.Visible = n == "Animations"
		end).LayoutOrder = -1
	end

	-- ===== Solid =====
	local sv = Instance.new("ImageButton")
	sv.Size = UDim2.new(1, 0, 0, 120)
	sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
	sv.AutoButtonColor = false
	sv.Image = ""
	sv.BorderSizePixel = 0
	sv.ZIndex = z
	sv.Parent = solidPage
	stroke(sv, Color3.fromRGB(4, 4, 4))
	local satGrad = Instance.new("Frame")
	satGrad.Size = UDim2.fromScale(1, 1)
	satGrad.BackgroundColor3 = Color3.new(1, 1, 1)
	satGrad.BorderSizePixel = 0
	satGrad.ZIndex = z
	satGrad.Parent = sv
	local sg = Instance.new("UIGradient")
	sg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	sg.Parent = satGrad
	local valGrad = Instance.new("Frame")
	valGrad.Size = UDim2.fromScale(1, 1)
	valGrad.BackgroundColor3 = Color3.new(0, 0, 0)
	valGrad.BorderSizePixel = 0
	valGrad.ZIndex = z + 1
	valGrad.Parent = sv
	local vg = Instance.new("UIGradient")
	vg.Rotation = 90
	vg.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	vg.Parent = valGrad
	local svCursor = Instance.new("Frame")
	svCursor.Size = UDim2.fromOffset(5, 5)
	svCursor.BackgroundColor3 = Color3.new(1, 1, 1)
	svCursor.BorderSizePixel = 0
	svCursor.ZIndex = z + 2
	svCursor.Parent = sv
	round(svCursor, 3)
	stroke(svCursor, Color3.new(0, 0, 0), 1)

	local hueBar = Instance.new("ImageButton")
	hueBar.Size = UDim2.new(1, 0, 0, 12)
	hueBar.AutoButtonColor = false
	hueBar.Image = ""
	hueBar.BackgroundColor3 = Color3.new(1, 1, 1)
	hueBar.BorderSizePixel = 0
	hueBar.ZIndex = z
	hueBar.Parent = solidPage
	stroke(hueBar, Color3.fromRGB(4, 4, 4))
	local hg = Instance.new("UIGradient")
	hg.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 0)),
		ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
		ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
		ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 255, 255)),
		ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
		ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
		ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 0)),
	})
	hg.Parent = hueBar
	local hueCursor = Instance.new("Frame")
	hueCursor.Size = UDim2.new(0, 3, 1, 2)
	hueCursor.Position = UDim2.new(h, -1, 0, -1)
	hueCursor.BackgroundColor3 = Color3.new(1, 1, 1)
	hueCursor.BorderSizePixel = 0
	hueCursor.ZIndex = z + 1
	hueCursor.Parent = hueBar
	stroke(hueCursor, Color3.new(0, 0, 0), 1)

	-- current color bar (below the hue bar, like the reference)
	local curBar = Instance.new("Frame")
	curBar.Size = UDim2.new(1, 0, 0, 14)
	curBar.BackgroundColor3 = col
	curBar.BorderSizePixel = 0
	curBar.ZIndex = z
	curBar.Parent = solidPage
	stroke(curBar, Color3.fromRGB(4, 4, 4))

	-- "255, 120, 160," | Copy | Paste
	local rgbRow = Instance.new("Frame")
	rgbRow.Size = UDim2.new(1, 0, 0, 20)
	rgbRow.BackgroundTransparency = 1
	rgbRow.ZIndex = z
	rgbRow.Parent = solidPage
	local rgbBox = Instance.new("TextBox")
	rgbBox.Size = UDim2.new(0.5, -4, 1, 0)
	rgbBox.Text = ""
	rgbBox.TextSize = 12
	rgbBox.FontFace = VERDANA
	rgbBox.TextColor3 = T.text
	rgbBox.TextXAlignment = Enum.TextXAlignment.Left
	rgbBox.ClearTextOnFocus = false
	rgbBox.ZIndex = z
	rgbBox.Parent = rgbRow
	styleElement(rgbBox)
	pad(rgbBox, 5, 0)
	local copyBtn = Instance.new("TextButton")
	copyBtn.Size = UDim2.new(0.25, -3, 1, 0)
	copyBtn.Position = UDim2.new(0.5, 2, 0, 0)
	copyBtn.Text = "Copy"
	copyBtn.TextSize = 12
	copyBtn.FontFace = VERDANA
	copyBtn.TextColor3 = T.text
	copyBtn.AutoButtonColor = false
	copyBtn.ZIndex = z
	copyBtn.Parent = rgbRow
	styleElement(copyBtn, true)
	local pasteBtn = Instance.new("TextButton")
	pasteBtn.Size = UDim2.new(0.25, -3, 1, 0)
	pasteBtn.Position = UDim2.new(0.75, 3, 0, 0)
	pasteBtn.Text = "Paste"
	pasteBtn.TextSize = 12
	pasteBtn.FontFace = VERDANA
	pasteBtn.TextColor3 = T.text
	pasteBtn.AutoButtonColor = false
	pasteBtn.ZIndex = z
	pasteBtn.Parent = rgbRow
	styleElement(pasteBtn, true)

	local resetBtn = Instance.new("TextButton")
	resetBtn.Size = UDim2.new(1, 0, 0, 20)
	resetBtn.Text = "Reset"
	resetBtn.TextSize = 12
	resetBtn.FontFace = VERDANA
	resetBtn.TextColor3 = T.text
	resetBtn.AutoButtonColor = false
	resetBtn.ZIndex = z
	resetBtn.Parent = solidPage
	styleElement(resetBtn, true)

	-- picker internals must never be recolored by the theme engine
	for _, o in ipairs({ sv, satGrad, valGrad, svCursor, hueBar, hueCursor, curBar }) do
		o:SetAttribute("ThemeExempt", true)
	end

	local function push()
		local c = Color3.fromHSV(h, s, v)
		col = c
		Flags[flag] = c
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svCursor.Position = UDim2.new(s, -2, 1 - v, -2)
		hueCursor.Position = UDim2.new(h, -1, 0, -1)
		curBar.BackgroundColor3 = c
		rgbBox.Text = ("%d, %d, %d,"):format(c.R * 255 + 0.5, c.G * 255 + 0.5, c.B * 255 + 0.5)
		if callback then callback(c) end
		-- ALSO fire the flag's setter so targets bound to the flag (accent,
		-- theme colors, esp colors...) actually change, not just the swatch
		if FlagSetters[flag] then FlagSetters[flag](c) end
	end
	push()

	-- mirror the flag's live color (animations included) on the Solid page
	-- every frame while the picker is open — bar, rgb text, and SV cursors
	local liveConn
	liveConn = RunService.RenderStepped:Connect(function()
		if not pop.Parent then liveConn:Disconnect() return end
		local c = Flags[flag]
		if typeof(c) == "Color3" and c ~= curBar.BackgroundColor3 then
			curBar.BackgroundColor3 = c
			local mode = Flags[flag .. "_mode"]
			if mode and mode ~= "Solid" then
				rgbBox.Text = ("%d, %d, %d,"):format(c.R * 255 + 0.5, c.G * 255 + 0.5, c.B * 255 + 0.5)
				local nh, ns, nv = c:ToHSV()
				svCursor.Position = UDim2.new(ns, -2, 1 - nv, -2)
				hueCursor.Position = UDim2.new(nh, -1, 0, -1)
				sv.BackgroundColor3 = Color3.fromHSV(nh, 1, 1)
			end
		end
	end)

	rgbBox.FocusLost:Connect(function()
		local r, g, b = rgbBox.Text:match("(%d+)%D+(%d+)%D+(%d+)")
		if r then
			local c = Color3.fromRGB(math.clamp(tonumber(r), 0, 255),
				math.clamp(tonumber(g), 0, 255), math.clamp(tonumber(b), 0, 255))
			h, s, v = c:ToHSV()
		end
		push()
	end)
	copyBtn.MouseButton1Click:Connect(function()
		pcall(function() setclipboard(("%d, %d, %d"):format(col.R * 255 + 0.5, col.G * 255 + 0.5, col.B * 255 + 0.5)) end)
	end)
	pasteBtn.MouseButton1Click:Connect(function()
		pcall(function()
			local r, g, b = tostring(getclipboard()):match("(%d+)%D+(%d+)%D+(%d+)")
			if r then
				h, s, v = Color3.fromRGB(math.clamp(tonumber(r), 0, 255),
					math.clamp(tonumber(g), 0, 255), math.clamp(tonumber(b), 0, 255)):ToHSV()
				push()
			end
		end)
	end)
	resetBtn.MouseButton1Click:Connect(function()
		h, s, v = defaultCol:ToHSV()
		push()
	end)

	-- ===== Animations =====
	-- per-mode settings (reference): Rainbow = Speed only; Fading/Strobe =
	-- Speed + two Colors; Tween = Speed + Colors + Easing Style/Direction
	local function refreshModeRows(mode)
		for _, o in ipairs(animPage:GetChildren()) do
			if o.Name == "TweenOnly" then o.Visible = mode == "Tween" end
			if o.Name == "ColorRow" then o.Visible = (mode == "Fading" or mode == "Strobe" or mode == "Tween") end
			if o.Name == "SpeedRow" then o.Visible = mode ~= "Solid" end
		end
	end
	buildDropdown(animPage, { flag = flag .. "_mode", label = "Mode",
		options = { "Rainbow", "Fading", "Strobe", "Tween", "Solid" }, default = Flags[flag .. "_mode"] or "Solid",
		callback = refreshModeRows })
	local speedRow = buildSlider(animPage, { flag = flag .. "_speed", text = "Speed", min = 1, max = 100, step = 1,
		default = Flags[flag .. "_speed"] or 50, suffix = "%" })
	speedRow.Name = "SpeedRow"

	local function colorRow(cflag, def)
		Flags[cflag] = Flags[cflag] or def
		local row = Instance.new("Frame")
		row.Name = "ColorRow"
		row.Size = UDim2.new(1, 0, 0, 16)
		row.BackgroundTransparency = 1
		row.ZIndex = z
		row.Parent = animPage
		local l = txt(row, "Color", 14, T.dim)
		l.Size = UDim2.new(1, -30, 1, 0)
		local sw = Instance.new("TextButton")
		sw:SetAttribute("ThemeExempt", true)
		sw.Size = UDim2.fromOffset(24, 11)
		sw.Position = UDim2.new(1, -24, 0, 2)
		sw.Text = ""
		sw.AutoButtonColor = false
		sw.BackgroundColor3 = Flags[cflag]
		sw.BorderSizePixel = 0
		sw.ZIndex = z
		sw.Parent = row
		round(sw, 3)
		stroke(sw, Color3.fromRGB(4, 4, 4))
		sw.MouseButton1Click:Connect(function()
			local lvl = popupLevelFor(sw)
			local sub = popupAtMouse(170, lvl, sw)
			buildColorPopup(sub, cflag, function(c) sw.BackgroundColor3 = c end, true) -- Solid only
		end)
		return row
	end
	colorRow(flag .. "_anim1", Color3.fromRGB(255, 0, 0))
	colorRow(flag .. "_anim2", Color3.fromRGB(235, 235, 235))

	local easeStyle = buildDropdown(animPage, { flag = flag .. "_ease_style", label = "Easing Style",
		options = { "Linear", "Sine", "Quad", "Cubic", "Quart", "Bounce", "Elastic" },
		default = Flags[flag .. "_ease_style"] or "Quad" })
	easeStyle.Name = "TweenOnly"
	local easeDir = buildDropdown(animPage, { flag = flag .. "_ease_dir", label = "Easing Direction",
		options = { "In", "Out", "InOut" }, default = Flags[flag .. "_ease_dir"] or "InOut" })
	easeDir.Name = "TweenOnly"
	refreshModeRows(Flags[flag .. "_mode"] or "Solid")

	-- drag (compare in the popup layer's raw-screen space)
	local svDrag, hueDrag = false, false
	sv.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then svDrag = true end end)
	hueBar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then hueDrag = true end end)
	UserInputService.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then svDrag, hueDrag = false, false end
	end)
	RunService.RenderStepped:Connect(function()
		if not (sv and sv.Parent) then return end
		local m = UserInputService:GetMouseLocation()
		if svDrag then
			local p = sv.AbsolutePosition - popupLayer.AbsolutePosition
			s = math.clamp((m.X - p.X) / sv.AbsoluteSize.X, 0, 1)
			v = 1 - math.clamp((m.Y - p.Y) / sv.AbsoluteSize.Y, 0, 1)
			push()
		elseif hueDrag then
			local p = hueBar.AbsolutePosition - popupLayer.AbsolutePosition
			h = math.clamp((m.X - p.X) / hueBar.AbsoluteSize.X, 0, 1)
			push()
		end
	end)
end

-- Toggle: filled checkbox, optional: gear popout, 1-2 color swatches
-- (pill shaped like reference), keybind chip ("Toggle: NONE")
function buildToggle(parent, opts)
	local flag = opts.flag
	local state = opts.default or false
	Flags[flag] = state

	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, 0, 0, 19)
	holder.BackgroundTransparency = 1
	holder.ZIndex = (parent.ZIndex or 1) + 1
	holder.Parent = parent

	local box = Instance.new("Frame")
	box.Size = UDim2.fromOffset(12, 12)
	box.Position = UDim2.fromOffset(0, 3)
	box.BorderSizePixel = 0
	box.ZIndex = holder.ZIndex
	box.Parent = holder
	round(box, 2)
	stroke(box, Color3.fromRGB(4, 4, 4))

	local l = txt(holder, opts.text, 14, T.dim)
	l.Position = UDim2.fromOffset(19, 0)
	l.Size = UDim2.new(1, -60, 1, 0)

	local function refresh()
		box.BackgroundColor3 = state and T.accent or T.element
		l.TextColor3 = state and T.text or T.dim
	end
	table.insert(AccentUsers, refresh)
	local function set(v, fire)
		state = v Flags[flag] = v refresh()
		if fire and opts.callback then opts.callback(v) end
	end
	FlagSetters[flag] = function(v) set(v, true) end
	set(state, false)

	local rightX = 0

	-- gear at far right (photo: gear sits rightmost)
	local gearAt
	if opts.gear then
		gearAt = rightX
		rightX += 18
	end

	-- color swatches: pill shaped, stacked right-to-left before the gear
	if opts.colors then
		for idx = #opts.colors, 1, -1 do
			local def = opts.colors[idx]
			local cflag = flag .. "_color" .. (idx > 1 and idx or "")
			Flags[cflag] = def
			table.insert(AnimColorFlags, cflag)
			local swatch = Instance.new("TextButton")
			swatch:SetAttribute("ThemeExempt", true)
			swatch.Size = UDim2.fromOffset(22, 10)
			swatch.Position = UDim2.new(1, -rightX - 22, 0, 4)
			swatch.Text = ""
			swatch.AutoButtonColor = false
			swatch.BackgroundColor3 = def
			swatch.BorderSizePixel = 0
			swatch.ZIndex = holder.ZIndex + 1
			swatch.Parent = holder
			round(swatch, 5)
			stroke(swatch, T.line2)
			FlagSetters[cflag] = function(c) swatch.BackgroundColor3 = c end
			swatch.MouseButton1Click:Connect(function()
				if togglePopupFor(swatch) then return end
				local pop = popupAtMouse(180, popupLevelFor(swatch), swatch)
				buildColorPopup(pop, cflag, function(c) swatch.BackgroundColor3 = c end)
			end)
			rightX += 27
		end
	end

	if opts.gear then
		local gearBtn = Instance.new("ImageButton")
		gearBtn.Size = UDim2.fromOffset(13, 13)
		gearBtn.Position = UDim2.new(1, -gearAt - 14, 0, 3)
		gearBtn.BackgroundTransparency = 1
		local gImg, gRS, gRO = getIcon("settings")
		gearBtn.Image = gImg or ""
		if gRS then gearBtn.ImageRectSize = gRS end
		if gRO then gearBtn.ImageRectOffset = gRO end
		gearBtn.ImageColor3 = T.dim
		gearBtn.ZIndex = holder.ZIndex + 1
		gearBtn.Parent = holder
		gearBtn.MouseEnter:Connect(function() gearBtn.ImageColor3 = T.text end)
		gearBtn.MouseLeave:Connect(function() gearBtn.ImageColor3 = T.dim end)
		gearBtn.MouseButton1Click:Connect(function()
			if togglePopupFor(gearBtn) then return end
			local pop = popupAtMouse(opts.gearWidth or 180, popupLevelFor(gearBtn), gearBtn)
			opts.gear(pop)
		end)
	end

	-- keybind chip inline ("Toggle: NONE" like reference Target Selection)
	if opts.keyFlag then
		attachKeybindChip(holder, {
			flag = opts.keyFlag, text = opts.text, rightPad = rightX + 4,
			onPressed = function() set(not state, true) end,
		})
		rightX += 92
	end

	local click = Instance.new("TextButton")
	click.Size = UDim2.new(1, -(rightX + 4), 1, 0)
	click.BackgroundTransparency = 1
	click.Text = ""
	click.ZIndex = holder.ZIndex
	click.Parent = holder
	click.MouseButton1Click:Connect(function() set(not state, true) end)

	if opts.tooltip then attachTooltip(holder, opts.tooltip) end
	table.insert(Searchables, { label = opts.text or "", holder = holder })
	return holder, function() return state end
end

