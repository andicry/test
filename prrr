    end

    return nil
end

function Library:Exit()
    if not alive then
        return
    end

    alive = false
    capture = nil
    closePopover()

    for _, properties in pairs(animations) do
        for _, animation in pairs(properties) do
            animation:Cancel()
        end
    end

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    table.clear(animations)
    table.clear(connections)

    if window then
        window.Blur:Destroy()
        window.Gui:Destroy()
    end
end

Library.Destroy = Library.Exit

return Library
