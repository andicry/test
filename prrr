-- throttled: dragging in a picker calls this every frame, and a full
-- gui walk per frame tanked the framerate — apply at most ~6x/sec
local themePending, themeBusy = {}, false
local applyThemeColorNow
local function applyThemeColor(name, c)
	themePending[name] = c
	if themeBusy then return end
	themeBusy = true
	task.spawn(function()
		while next(themePending) do
			local n, col = next(themePending)
			themePending[n] = nil
			applyThemeColorNow(n, col)
			task.wait(0.15)
		end
		themeBusy = false
	end)
end

function applyThemeColorNow(name, c)
	local old = ThemeVals[name]
	if not old or old == c then ThemeVals[name] = c return end
	for _, o in ipairs(gui:GetDescendants()) do
		pcall(function()
			-- color swatches / picker internals keep their own colors
			if o:GetAttribute("ThemeExempt") or (o.Parent and o.Parent:GetAttribute("ThemeExempt")) then return end
			if o:IsA("GuiObject") and o.BackgroundColor3 == old then o.BackgroundColor3 = c end
			if (o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")) and o.TextColor3 == old then o.TextColor3 = c end
			if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.ImageColor3 == old then o.ImageColor3 = c end
			if o:IsA("UIStroke") and o.Color == old then o.Color = c end
		end)
	end
	local tgt = ThemeTargets[name]
	if tgt then tgt[1][tgt[2]] = c end
	ThemeVals[name] = c
	if FlagSetters["theme_" .. name] then FlagSetters["theme_" .. name](c) end
end

local function saveTheme(tname)
	local out = {}
	for n, c in pairs(ThemeVals) do out[n] = { c.R, c.G, c.B } end
	writefile(themesFolder .. '/' .. tname .. '.json', HttpService:JSONEncode(out))
end
local function loadTheme(tname)
	local path = themesFolder .. '/' .. tname .. '.json'
	if not isfile(path) then return false end
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok then return false end
	for n, v in pairs(data) do
		if ThemeVals[n] then applyThemeColor(n, Color3.new(v[1], v[2], v[3])) end
	end
	return true
end
local function listFilesIn(folder, ext)
	local out = {}
	pcall(function()
		for _, f in ipairs(listfiles(folder)) do
			local n = f:match("([^/\\]+)%." .. ext .. "$")
			if n then table.insert(out, n) end
		end
	end)
	return out
end

