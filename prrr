                square.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                knobOuter.Position = UDim2.fromScale(s, 1 - v)
                hueKnob.Position = UDim2.fromScale(h, 0.5)
                preview.BackgroundColor3 = color

                if alphaKnob then
                    alphaKnob.Position = UDim2.fromScale(alpha, 0.5)
                end

                if not hex:IsFocused() then
                    hex.Text = "#" .. color:ToHex()
                end

                control:Set(color)
            end

            local function update(position)
                if dragging == "square" then
                    local size = square.AbsoluteSize

                    if size.X <= 0 or size.Y <= 0 then
                        return
                    end

                    s = math.clamp(
                        (position.X - square.AbsolutePosition.X) / size.X,
                        0,
                        1
                    )

                    v = 1 - math.clamp(
                        (position.Y - square.AbsolutePosition.Y) / size.Y,
                        0,
                        1
                    )
                elseif dragging == "hue" then
                    if hue.AbsoluteSize.X <= 0 then
                        return
                    end

                    h = math.clamp(
                        (position.X - hue.AbsolutePosition.X) / hue.AbsoluteSize.X,
                        0,
                        1
                    )
                elseif dragging == "alpha" and alphaBar then
                    if alphaBar.AbsoluteSize.X <= 0 then
                        return
                    end

                    alpha = math.clamp(
                        (position.X - alphaBar.AbsolutePosition.X)
                            / alphaBar.AbsoluteSize.X,
                        0,
                        1
                    )

                    safeCallback(spec.AlphaCallback, alpha)
                else
                    return
                end

                sampled = true
                repaint()
            end

            local function begin(which, input)
                if input.UserInputType ~= Enum.UserInputType.MouseButton1
                    and input.UserInputType ~= Enum.UserInputType.Touch then
                    return
                end

                dragging = which
                touch = input.UserInputType == Enum.UserInputType.Touch
                    and input
                    or nil
                sampled = false

                update(input.Position)
            end

            connect(squareHit.InputBegan, function(input)
                begin("square", input)
            end)

            connect(hueHit.InputBegan, function(input)
                begin("hue", input)
            end)

            if alphaHit then
                connect(alphaHit.InputBegan, function(input)
                    begin("alpha", input)
                end)
            end

            local moveConnection = connect(
                UserInputService.InputChanged,
                function(input)
                    if panel.Parent
                        and dragging
                        and (input.UserInputType == Enum.UserInputType.MouseMovement
                            or input == touch) then
                        update(input.Position)
                    end
                end
            )

            local endConnection = connect(
                UserInputService.InputEnded,
                function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input == touch then
                        -- a plain click (no mouse move) must still commit the
                        -- color under the cursor, but only when nothing valid
                        -- was sampled during the press: re-sampling after a
                        -- real drag would jump the knob to another coordinate
                        -- space
                        if dragging and not sampled then
                            local mouse = UserInputService:GetMouseLocation()

                            if mouse.X > 0 or mouse.Y > 0 then
                                update(Vector2.new(mouse.X, mouse.Y))
                            end
                        end

                        dragging = nil
                        touch = nil
                    end
                end
            )

            connect(panel.Destroying, function()
                moveConnection:Disconnect()
                endConnection:Disconnect()
            end)

            connect(hex.FocusLost, function(enterPressed)
                if not enterPressed then
                    hex.Text = "#" .. control:Get():ToHex()
                    return
                end

                local raw = hex.Text:gsub("#", "")

                if raw:match("^%x%x%x%x%x%x$") then
                    local color = Color3.fromRGB(
                        tonumber(raw:sub(1, 2), 16),
                        tonumber(raw:sub(3, 4), 16),
                        tonumber(raw:sub(5, 6), 16)
                    )

                    h, s, v = color:ToHSV()
                    repaint()
                end

                hex.Text = "#" .. control:Get():ToHex()
            end)

            repaint()
        end)

        return control
    end

    function section:SearchList(spec)
        spec = spec or {}

        local height = math.max(40, tonumber(spec.Height) or 120)
        local row = self:Row(height + 23)
        local items = copyArray(spec.Items or {})
        local selected

        local searchBody = inset(
            row,
            UDim2.fromOffset(3, 0),
            UDim2.new(1, -6, 0, 20),
            20
        )

        local search = fontTextBox(searchBody, {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ClearTextOnFocus = false,
            Text = "",
            PlaceholderText = "Search",
            PlaceholderColor3 = Library.Theme.TextInactive,
            TextColor3 = Library.Theme.Text,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 22,
        })

        make("UIPadding", {
            PaddingLeft = UDim.new(0, 7),
            PaddingRight = UDim.new(0, 7),
        }, search)

        local list = make("ScrollingFrame", {
            Position = UDim2.fromOffset(3, 23),
            Size = UDim2.new(1, -6, 0, height),
            BackgroundColor3 = Library.Theme.Element,
            BorderSizePixel = 0,
            CanvasSize = UDim2.fromOffset(0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Library.Theme.Accent,
            ZIndex = 20,
        }, row)

        make("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, list)

        local rows = {}

        local function repaint()
            local query = string.lower(search.Text)

            for _, entry in ipairs(rows) do
                local name = tostring(entry.Value)

                entry.Button.Visible = query == ""
                    or string.find(string.lower(name), query, 1, true) ~= nil

                entry.Button.BackgroundColor3 = entry.Value == selected
                    and Library.Theme.HoveredElement
                    or Library.Theme.Element
            end
        end

        local function rebuild()
            for _, entry in ipairs(rows) do
                entry.Button:Destroy()
            end

            table.clear(rows)

            for index, value in ipairs(items) do
                local item = hit(list, {
                    LayoutOrder = index,
                    Size = UDim2.new(1, 0, 0, 19),
                    BackgroundTransparency = 0,
                    BackgroundColor3 = Library.Theme.Element,
                    ZIndex = 21,
                })

                text(item, tostring(value), {
                    Position = UDim2.fromOffset(7, 0),
                    Size = UDim2.new(1, -14, 1, 0),
                    TextSize = 10,
                    ZIndex = 22,
                })

                table.insert(rows, {
                    Button = item,
                    Value = value,
                })

                connect(item.MouseEnter, function()
                    item.BackgroundColor3 = Library.Theme.HoveredElement
                end)

                connect(item.MouseLeave, function()
                    item.BackgroundColor3 = value == selected
                        and Library.Theme.HoveredElement
                        or Library.Theme.Element
                end)

                connect(item.Activated, function()
                    local changed = selected ~= value
                    selected = value
                    repaint()

                    if changed then
                        safeCallback(spec.Callback, value)
                    end
                end)
            end

            repaint()
        end

        connect(search:GetPropertyChangedSignal("Text"), repaint)

        local control = {}

        function control:Get()
            return selected
        end

        function control:Set(value, silent)
            local changed = selected ~= value
            selected = value
            repaint()

            if changed and not silent then
                safeCallback(spec.Callback, value)
            end
        end

        function control:Refresh(nextItems)
            items = copyArray(nextItems or {})
            rebuild()
        end

        rebuild()

        return control
    end

    function section:Keybind(spec)
        spec = spec or {}

        local row = self:Row(17)
        local right = 5
        local mode = spec.Mode == "Hold" and "Hold"
            or spec.Mode == "Always" and "Always"
            or "Toggle"
        local active = false

        controlLabel(row, controlName(spec, "keybind"), right + 70)

        local chip = inset(
            row,
            UDim2.new(1, -right - 62, 0, 0),
            UDim2.fromOffset(62, 17),
            20
        )

        local valueText = text(chip, "[ ... ]", {
            Position = UDim2.fromOffset(3, 0),
            Size = UDim2.new(1, -6, 1, 0),
            TextXAlignment = Enum.TextXAlignment.Center,
            TextColor3 = Library.Theme.TextInactive,
            TextSize = 10,
            ZIndex = 22,
        })

        local click = hit(chip, {
            Size = UDim2.fromScale(1, 1),
            ZIndex = 23,
        })

        local hudRow

        if spec.ShowInList and window then
            hudRow = text(window.KeybindList, "", {
                Size = UDim2.new(1, 0, 0, 14),
                TextSize = 10,
                ZIndex = 73,
            })
        end

        local control = {}

        local function syncHudColor()
            if hudRow then
                hudRow.TextColor3 = active
                    and Library.Theme.Accent
                    or Library.Theme.Text
            end
        end

        function control.Normalize(value)
            if typeof(value) ~= "EnumItem" then
                return nil
            end

            if value.EnumType == Enum.KeyCode
                or value.EnumType == Enum.UserInputType then
                return value
            end

            return nil
        end

        function control:Update(value)
            local unset = value == Enum.KeyCode.Unknown

            valueText.Text = unset and "[ ... ]"
                or "[ " .. value.Name .. " ]"

            if hudRow then
                hudRow.Text = unset
                    and "[ ... ] " .. controlName(spec, "keybind")
                    or "[" .. value.Name .. "] "
                        .. controlName(spec, "keybind")
                        .. " (" .. mode .. ")"
            end

            syncHudColor()

            if spec.Flag == "menu_key" then
                Library.MenuKey = unset
                    and Enum.KeyCode.Insert
                    or value
            end
        end

        function control:GetMode()
            return mode
        end

        registerControl(control, spec, spec.Default or Enum.KeyCode.Unknown)

        local function setMode(next)
            if next ~= "Hold" and next ~= "Toggle" and next ~= "Always" then
                return
            end

            if next == mode then
                return
            end

            if active then
                active = false
                safeCallback(spec.Callback, false)
            end

            mode = next

            if mode == "Always" then
                active = true
                safeCallback(spec.Callback, true)
            end

            syncHudColor()
        end

        local function openModePicker(clickPos)
            if spec.Disabled or capture == control then
                return
            end

            if popover then
                closePopover()
            end

            local modes = { "Hold", "Toggle", "Always" }
            local panel = openPopover(
                chip,
                96,
                #modes * 19,
                "KeybindMode",
                clickPos
            )

            if not panel then
                return
            end

            for index, entry in ipairs(modes) do
                local item = hit(panel, {
                    Position = UDim2.fromOffset(0, (index - 1) * 19),
                    Size = UDim2.new(1, 0, 0, 19),
                    BackgroundTransparency = 0,
                    BackgroundColor3 = entry == mode
                        and Color3.fromRGB(45, 41, 47)
                        or Library.Theme.Element,
                    Text = "",
                    ZIndex = 103,
                })

                local itemNotch = frame(item, {
                    Size = UDim2.new(0, 2, 1, 0),
                    BackgroundColor3 = Library.Theme.Accent,
                    Visible = entry == mode,
                    ZIndex = 106,
                })

                bindTheme(itemNotch, "BackgroundColor3", "Accent")

                text(item, string.lower(entry), {
                    Position = UDim2.fromOffset(9, 0),
                    Size = UDim2.new(1, -16, 1, 0),
                    TextSize = 10,
                    ZIndex = 104,
                })

                connect(item.MouseEnter, function()
                    item.BackgroundColor3 = Library.Theme.HoveredElement
                end)

                connect(item.MouseLeave, function()
                    item.BackgroundColor3 = entry == mode
                        and Color3.fromRGB(45, 41, 47)
                        or Library.Theme.Element
                end)

                connect(item.Activated, function()
                    setMode(entry)
                    closePopover()
                end)
            end
        end

        connect(click.Activated, function()
            if spec.Disabled then
                return
            end

            capture = control
            valueText.Text = "..."
        end)

        local lastModeClick

        connect(click.MouseButton2Down, function(inputObject)
            lastModeClick = inputObject and inputObject.Position or nil
        end)

        connect(click.MouseButton2Click, function()
            openModePicker(lastModeClick)
            lastModeClick = nil
        end)

        connect(UserInputService.InputBegan, function(input, processed)
            if capture == control then
                local value

                if input.KeyCode == Enum.KeyCode.Backspace then
                    value = Enum.KeyCode.Unknown
                elseif input.UserInputType == Enum.UserInputType.Keyboard then
                    value = input.KeyCode
                elseif input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.MouseButton2
                    or input.UserInputType == Enum.UserInputType.MouseButton3 then
                    if spec.Flag == "menu_key" then
                        return
                    end

                    value = input.UserInputType
                end

                if value then
                    capture = nil
                    control:Set(value)
                end

                return
            end

            if capture
                or processed
                or UserInputService:GetFocusedTextBox()
                or spec.Flag == "menu_key" then
                return
            end

            local bound = control:Get()

            if bound == Enum.KeyCode.Unknown then
                return
            end

            local matched = input.KeyCode == bound or input.UserInputType == bound

            if not matched then
                return
            end

            if mode == "Hold" then
                if not active then
                    active = true
                    safeCallback(spec.Callback, true)
                end
            elseif mode == "Toggle" then
                active = not active
                safeCallback(spec.Callback, active)
            end

            syncHudColor()
        end)

        connect(UserInputService.InputEnded, function(input)
            if mode ~= "Hold" or not active then
                return
            end

            local bound = control:Get()

            if input.KeyCode == bound or input.UserInputType == bound then
                active = false
                safeCallback(spec.Callback, false)
                syncHudColor()
            end
        end)

        return control
    end

    function section:ConfigList(spec)
        spec = spec or {}
        spec.Items = Library:GetConfigs()
        return self:SearchList(spec)
    end
end

function Library:GetConfigs()
    return listFiles("Oxy/configs", fileMemory.configs)
end

function Library:SaveConfig(name)
    if not validName(name) then
        return false, "invalid config name"
    end

    local data = {}

    for flag, value in pairs(self.Flags) do
        data[flag] = serialize(value)
    end

    fileMemory.configs[name] = data

    if type(writefile) ~= "function" or not ensureFolders() then
        return true
    end

    return saveFile("Oxy/configs/" .. name .. ".json", data)
end

function Library:LoadConfigFile(name)
    if not validName(name) then
        return false, "invalid config name"
    end

    local data = fileMemory.configs[name]

    if not data then
        local ok, result = readFile("Oxy/configs/" .. name .. ".json")

        if not ok then
            return false, result
        end

        data = result
    end

    if type(data) ~= "table" then
        return false, "invalid config contents"
    end

    for flag, encoded in pairs(data) do
        if self.Bound[flag] then
            local value = deserialize(encoded)

            if value ~= nil then
                self:SetFlag(flag, value)
            end
        end
    end

    return true
end

function Library:DeleteConfig(name)
    if not validName(name) then
        return false, "invalid config name"
    end

    local existed = fileMemory.configs[name] ~= nil
    fileMemory.configs[name] = nil

    if type(isfile) == "function" and type(delfile) == "function" then
        local path = "Oxy/configs/" .. name .. ".json"
        local ok, exists = pcall(isfile, path)

        if ok and exists then
            return deleteFile(path)
        end
    end

    if existed then
        return true
    end

    return false, "config not found"
end

function Library:SetAutoload(name)
    if name ~= nil and not validName(name) then
        return false, "invalid config name"
    end

    fileMemory.autoload = name

    if type(writefile) ~= "function" or not ensureFolders() then
        return true
    end

    return saveFile("Oxy/autoload.json", {
        Name = name or "",
    })
end

function Library:GetAutoload()
    if fileMemory.autoload then
        return fileMemory.autoload
    end

    local ok, data = readFile("Oxy/autoload.json")

    if ok and type(data) == "table"
        and type(data.Name) == "string"
        and data.Name ~= "" then
        return data.Name
    end

    return nil
end

