    function section:Slider(spec)
        spec = spec or {}

        local minimum = tonumber(spec.Min) or 0
        local maximum = tonumber(spec.Max) or 100

        if maximum < minimum then
            minimum, maximum = maximum, minimum
        end

        local step = math.abs(tonumber(spec.Step) or 1)

        if step == 0 then
            step = 1
        end

        local row = self:Row(31)

        text(row, controlName(spec, "slider"), {
            Position = UDim2.fromOffset(5, 0),
            Size = UDim2.new(0.6, -5, 0, 15),
            TextSize = 10,
            ZIndex = 21,
        })

        local valueText = text(row, "", {
            Position = UDim2.new(0.6, 0, 0, 0),
            Size = UDim2.new(0.4, -5, 0, 15),
            TextXAlignment = Enum.TextXAlignment.Right,
            TextColor3 = Library.Theme.TextInactive,
            TextSize = 10,
            ZIndex = 21,
        })

        local track = frame(row, {
            Position = UDim2.fromOffset(5, 21),
            Size = UDim2.new(1, -10, 0, 4),
            BackgroundColor3 = Color3.fromRGB(37, 34, 37),
            ZIndex = 21,
        })

        local fill = frame(track, {
            Size = UDim2.fromScale(0, 1),
            BackgroundColor3 = Library.Theme.Accent,
            ZIndex = 22,
        })

        bindTheme(fill, "BackgroundColor3", "Accent")

        gradient(
            fill,
            Color3.fromRGB(255, 255, 255),
            Color3.fromRGB(195, 195, 195)
        )

        local thumb = frame(track, {
            Position = UDim2.fromOffset(-3, -2),
            Size = UDim2.fromOffset(6, 8),
            BackgroundColor3 = Color3.fromRGB(228, 224, 228),
            ZIndex = 23,
        })

        local click = hit(row, {
            Position = UDim2.fromOffset(0, 15),
            Size = UDim2.new(1, 0, 0, 16),
            Selectable = true,
            ZIndex = 24,
        })

        local control = {}
        local dragging = false
        local touch

        function control.Normalize(value)
            value = tonumber(value)

            if not value then
                return nil
            end

            local rounded = minimum
                + math.floor((value - minimum) / step + 0.5) * step

            return math.clamp(rounded, minimum, maximum)
        end

        function control:Update(value)
            local ratio = maximum == minimum
                and 0
                or (value - minimum) / (maximum - minimum)

            animate(fill, 0.07, {
                Size = UDim2.fromScale(ratio, 1),
            })

            animate(thumb, 0.07, {
                Position = UDim2.new(ratio, -3, 0, -2),
            })

            valueText.Text = tostring(value) .. tostring(spec.Suffix or "")
        end

        registerControl(
            control,
            spec,
            tonumber(spec.Default) or minimum
        )

        local function update(position)
            local width = track.AbsoluteSize.X

            if width <= 0 then
                return
            end

            local ratio = math.clamp(
                (position.X - track.AbsolutePosition.X) / width,
                0,
                1
            )

            control:Set(minimum + ratio * (maximum - minimum))
        end

        connect(click.InputBegan, function(input)
            if spec.Disabled then
                return
            end

            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then

                dragging = true
                touch = input.UserInputType == Enum.UserInputType.Touch
                    and input
                    or nil

                update(input.Position)
            end
        end)

        connect(UserInputService.InputChanged, function(input)
            if dragging
                and (input.UserInputType == Enum.UserInputType.MouseMovement
                    or input == touch) then
                update(input.Position)
            end
        end)

        connect(UserInputService.InputEnded, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input == touch then
                dragging = false
                touch = nil
            end
        end)

        connect(click.InputBegan, function(input)
            if spec.Disabled then
                return
            end

            if input.KeyCode == Enum.KeyCode.Left
                or input.KeyCode == Enum.KeyCode.Down then
                control:Set(control:Get() - step)
            elseif input.KeyCode == Enum.KeyCode.Right
                or input.KeyCode == Enum.KeyCode.Up then
                control:Set(control:Get() + step)
            end
        end)

        return control
    end

    function section:Textbox(spec)
