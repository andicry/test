	ll.Parent = list
	pad(list, 8, 4)

	local selected = opts.default
	Flags[opts.flag] = selected
	local buttons = {}
	local function refresh()
		for name, b in pairs(buttons) do
			local sel = name == selected
			b.TextColor3 = sel and T.accent or T.dim -- synced w/ accent
			b.FontFace = sel and VERDANA_BOLD or VERDANA
		end
	end
	table.insert(AccentUsers, refresh) -- live repaint when accent changes
	for i, item in ipairs(opts.items) do
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, -12, 0, 17)
		b.BackgroundTransparency = 1
		b.Text = item
		b.TextSize = 14
		b.FontFace = VERDANA
		b.TextXAlignment = Enum.TextXAlignment.Left
		b.LayoutOrder = i
		b.ZIndex = list.ZIndex
		b.Parent = list
		buttons[item] = b
		b.MouseButton1Click:Connect(function()
			selected = item Flags[opts.flag] = item refresh()
			if opts.callback then opts.callback(item) end
		end)
	end
	FlagSetters[opts.flag] = function(v) selected = v refresh() end
	refresh()
	-- filter: only items STARTING with the query stay visible; "" restores
	local function setFilter(q)
		q = (q or ""):lower()
		for name, b in pairs(buttons) do
			b.Visible = q == "" or name:lower():sub(1, #q) == q
		end
	end
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	return holder, setFilter
end

