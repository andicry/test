local function ensureFontFolder()
    if type(isfolder) ~= "function" or type(makefolder) ~= "function" then
        return false
    end

    local checked = pcall(isfolder, FONT_ROOT)

    if not checked then
        return false
    end

    if not isfolder(FONT_ROOT) then
        pcall(makefolder, FONT_ROOT)
    end

    if not isfolder(FONT_FOLDER) then
        pcall(makefolder, FONT_FOLDER)
    end

    return isfolder(FONT_FOLDER)
end

local function registerFontFile(entry)
    if type(isfile) ~= "function"
        or type(writefile) ~= "function"
        or type(getcustomasset) ~= "function" then
        return nil
    end

    if not ensureFontFolder() then
        return nil
    end

    local ttfPath = FONT_FOLDER .. "/" .. entry.File
    local familyPath = FONT_FOLDER .. "/" .. entry.File .. ".font"

    if not isfile(ttfPath) then
        local ok, data = pcall(
            game.HttpGet,
            game,
            FONT_BASE .. entry.File:gsub(" ", "%%20")
        )

        if not ok or type(data) ~= "string" or #data < 1024 then
            return nil
        end

        local wrote = pcall(writefile, ttfPath, data)

        if not wrote then
            return nil
        end
    end

    local assetOk, ttfAsset = pcall(getcustomasset, ttfPath)

    if not assetOk or not ttfAsset then
        return nil
    end

    local checked, familyExists = pcall(isfile, familyPath)

    if checked and familyExists and type(delfile) == "function" then
        pcall(delfile, familyPath)
    end

    local encoded, descriptor = pcall(HttpService.JSONEncode, HttpService, {
        name = entry.Name,
        faces = {
            {
                name = "Normal",
                weight = 400,
                style = "Normal",
                assetId = ttfAsset,
            },
        },
    })

    if not encoded or type(descriptor) ~= "string" then
        return nil
    end

    local wrote = pcall(writefile, familyPath, descriptor)

    if not wrote then
        return nil
    end

    local familyOk, familyAsset = pcall(getcustomasset, familyPath)

    if not familyOk or not familyAsset then
        return nil
    end

    return familyAsset
end

local function loadFontFace(entry)
    local cached = Library.LoadedFonts[entry.Name]

    if cached ~= nil then
        return cached or nil
    end

    local asset = registerFontFile(entry)
    local face = nil

    if asset then
        local ok, result = pcall(
            Font.new,
            asset,
            Enum.FontWeight.Regular,
            Enum.FontStyle.Normal
        )

        if ok then
            face = result
        end
    end

    Library.LoadedFonts[entry.Name] = face or false

    return face
end

local metricLabel

local function getMetricLabel()
    if metricLabel and metricLabel.Parent then
        return metricLabel
    end

    local host = player:FindFirstChild("PlayerGui")

    if not host then
        return nil
    end

    local ok, hostGui = pcall(function()
        local gui = Instance.new("ScreenGui")
        gui.Name = "OxyFontMetrics"
        gui.ResetOnSpawn = false
        gui.DisplayOrder = -100
        gui.Parent = host
        return gui
    end)

    if not ok or not hostGui then
        return nil
    end

    metricLabel = Instance.new("TextLabel")
    metricLabel.Name = "FontMetric"
    metricLabel.BackgroundTransparency = 1
    metricLabel.Position = UDim2.fromOffset(-10000, -10000)
    metricLabel.Size = UDim2.fromOffset(8192, 8192)
    metricLabel.Text = ""
    metricLabel.TextTransparency = 1
    metricLabel.TextXAlignment = Enum.TextXAlignment.Left
    metricLabel.TextYAlignment = Enum.TextYAlignment.Top
    metricLabel.ZIndex = 0
    metricLabel.Parent = hostGui

    return metricLabel
end

local function calibrateFont(face)
    Library.FontScaleX = 1
    Library.FontScaleY = 1

    if not face then
        return
    end

    local ok, bounds = pcall(function()
        local label = getMetricLabel()

        if not label then
            return nil
        end

        pcall(function()
            label.FontFace = face
        end)

        label.TextSize = 14
        label.Text = FONT_REF

        if RunService.RenderStepped
            and type(RunService.IsClient) == "function"
            and RunService:IsClient()
            and type(RunService.RenderStepped.Wait) == "function" then
            RunService.RenderStepped:Wait()
        end

        local measured = label.TextBounds

        label.Text = ""

        return measured
    end)

    if not ok or not bounds then
        return
    end

    local baseOk, base = pcall(
        TextService.GetTextSize,
        TextService,
        FONT_REF,
        14,
        Library.Font,
        Vector2.new(8192, 8192)
    )

    if baseOk and bounds.X > 0 and base.X > 0 then
        Library.FontScaleX = bounds.X / base.X
    end

    if baseOk and bounds.Y > 0 and base.Y > 0 then
        Library.FontScaleY = bounds.Y / base.Y
    end
end

function Library:ApplyFont(inst)
    if Library.FontFace then
        inst.FontFace = Library.FontFace
    else
        inst.Font = Library.Font
    end
end

function Library:RegisterFontObject(inst)
    Library.FontObjects[inst] = true

    pcall(Library.ApplyFont, self, inst)
end

function Library:SetFont(name)
    local entry = self:GetFontEntry(name)

    if not entry then
        return false, "unknown font"
    end

    local face = nil

    if entry.File then
        face = loadFontFace(entry)

        if not face then
            return false, "font failed to load"
        end
    end

    Library.FontName = entry.Name
    Library.FontFace = face

    calibrateFont(face)

    for inst in pairs(Library.FontObjects) do
        if not pcall(Library.ApplyFont, self, inst) then
            Library.FontObjects[inst] = nil
        end
    end

    return true
end

local function loadIcons()
    local ok, result = pcall(function()
        local source = game:HttpGet("https://molto.pages.dev/source.lua")
        local loader = assert(loadstring(source))
        local module = loader()

        module.SetProvider(iconProvider)

        return module
    end)

    if not ok or not result then
        warn("Oxy: Molto could not be loaded; icon slots will remain empty")
        return
    end

    iconModule = result

    pcall(function()
        iconModule.PreloadAsync({
            "crosshair",
            "shield",
            "users",
            "globe",
            "settings",
            "folder",
            "circle-help",
            "check",
            "search",
            "keyboard",
            "moon",
            "x",
        })
    end)
end

local function getIcon(name)
    if not iconModule or type(name) ~= "string" then
        return nil
    end

    local key = iconProvider .. ":" .. name

    if iconCache[key] ~= nil then
        return iconCache[key] or nil
    end

    local ok, asset = pcall(function()
        if not iconModule.HasIcon(name, iconProvider) then
            return nil
        end

        return iconModule.GetAsset(name, iconProvider)
    end)

    if not ok or not asset then
        iconCache[key] = false
        return nil
    end

    iconCache[key] = asset
    return asset
end

local function paintIcon(object, name)
    local asset = getIcon(name)

    if not asset then
        object.Image = ""
        return false
    end

    if type(asset.Url) ~= "string" or asset.Url == "" then
        object.Image = ""
        return false
    end

    object.Image = asset.Url

    if asset.ImageRectOffset then
        object.ImageRectOffset = asset.ImageRectOffset
    end

    if asset.ImageRectSize then
        object.ImageRectSize = asset.ImageRectSize
    end

    return true
end

local function icon(parent, name, position, size, color, z)
    local object = make("ImageLabel", {
        Name = "Icon",
        Position = position,
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1,
        Image = "",
        ImageColor3 = color,
        ZIndex = z or 10,
    }, parent)

    table.insert(iconObjects, {
        Object = object,
        Name = name,
    })

    paintIcon(object, name)

    return object
end

function Library:SetProvider(id)
    if not iconModule then
        return false, "Molto unavailable"
    end

    local ok, err = pcall(function()
        iconModule.SetProvider(id)
    end)

    if not ok then
        return false, tostring(err)
    end

    iconProvider = id
    table.clear(iconCache)

    for _, entry in ipairs(iconObjects) do
        if entry.Object.Parent then
            paintIcon(entry.Object, entry.Name)
        end
    end

    return true
end

function Library:GetTheme()
    return table.clone(self.Theme)
end

function Library:SetTheme(key, value)
    if type(key) == "table" then
        for themeKey, color in pairs(key) do
            self:SetTheme(themeKey, color)
        end

        return true
    end

    if self.Theme[key] == nil or typeof(value) ~= "Color3" then
        return false
    end

    self.Theme[key] = value

    for _, binding in ipairs(themeBindings) do
        if binding.Key == key and binding.Object.Parent then
            binding.Object[binding.Property] = value
        end
    end

    if key == "Accent" then
        if not glowColorOverridden then
            setGlowColor(value)
        end

        runAccentObservers(value)
    end

    return true
end

function Library:SetGlowColor(color)
    if color == nil then
        glowColorOverridden = false
        setGlowColor(self.Theme.Accent)

        return true
    end

    if typeof(color) ~= "Color3" then
        return false, "Color3 expected"
    end

    glowColorOverridden = true
    setGlowColor(color)

    return true
end

function Library:SetFlag(flag, value, silent)
    local control = self.Bound[flag]

    if not control then
        return false
    end

    return control:Set(value, silent)
end

local function closePopover()
    if not popover then
        return
    end

    local old = popover
    popover = nil

    if old.Catcher then
        old.Catcher:Destroy()
    end

    if old.Shadow and old.Shadow.Parent then
        old.Shadow:Destroy()
    end

    if old.Panel and old.Panel.Parent then
        local panel = old.Panel
        local scale = old.Scale

        if scale then
            animate(scale, 0.12, { Scale = 0.96 }, Enum.EasingDirection.In)
        end

        task.delay(0.13, function()
            if panel.Parent then
                panel:Destroy()
            end
        end)
    end
end

local function hideTooltip()
    tooltipTarget = nil

    if window and window.Tooltip then
        window.Tooltip.Visible = false
    end
end


local function openPopover(anchor, width, height, kind, clickPos)
    closePopover()
    hideTooltip()

    if not window or not alive then
        return nil
    end

    local view = viewport()
    local anchorSize = anchor.AbsoluteSize

    -- AbsolutePosition is screen space while the panel lives inside the window,
    -- so convert through the gui origin: without this the panel sits one
    -- topbar inset away from the control that opened it
    local origin = window.Gui.AbsolutePosition
    local anchorBottom = anchor.AbsolutePosition.Y - origin.Y + anchorSize.Y
    local anchorX = anchor.AbsolutePosition.X - origin.X
    local gap = 1

    width = math.min(width, math.max(40, view.X - 8))

    local x = math.clamp(
        anchorX,
        4,
        math.max(4, view.X - width - 4)
    )

    local roomBelow = math.max(0, view.Y - (anchorBottom + gap) - 4)

    height = math.min(height, roomBelow)
    local y = anchorBottom + gap

    if height < 12 then
        return nil
    end

    local catcher = hit(window.Overlay, {
        Name = "OutsideClick",
        Size = UDim2.fromScale(1, 1),
        ZIndex = 100,
    })

    local shadow = make("ImageLabel", {
        Name = "PopoverShadow",
        Position = UDim2.fromOffset(x - 10, y - 4),
        Size = UDim2.fromOffset(width + 20, height + 14),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Image = "rbxassetid://18245826428",
        ImageColor3 = Color3.new(0, 0, 0),
        ImageTransparency = 0.45,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(Vector2.new(21, 21), Vector2.new(79, 79)),
        ZIndex = 100,
    }, window.Overlay)

    local panel = frame(window.Overlay, {
        Name = kind or "Popover",
        Position = UDim2.fromOffset(x, y),
        Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = Library.Theme.Element,
        ClipsDescendants = true,
        ZIndex = 101,
    })

    gradient(
        panel,
        Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(196, 196, 196)
    )

    line(
        panel,
        UDim2.fromOffset(0, 0),
        UDim2.new(1, 0, 0, 1),
        Color3.fromRGB(74, 69, 74),
        105
    )

    line(
        panel,
        UDim2.new(0, 0, 1, -1),
        UDim2.new(1, 0, 0, 1),
        Color3.fromRGB(7, 7, 8),
        105
    )

    line(
        panel,
        UDim2.fromOffset(0, 1),
        UDim2.new(0, 1, 1, -2),
        Color3.fromRGB(14, 13, 15),
        105
    )

    line(
        panel,
        UDim2.new(1, -1, 0, 1),
        UDim2.new(0, 1, 1, -2),
        Color3.fromRGB(14, 13, 15),
        105
    )

    local scale = make("UIScale", {
        Scale = 0.96,
    }, panel)

    animate(scale, 0.09, {
        Scale = 1,
    })

    popover = {
        Catcher = catcher,
        Panel = panel,
        Scale = scale,
        Shadow = shadow,
    }

    connect(catcher.Activated, closePopover)

    return panel, popover
end

local function inset(parent, position, size, z)
    local well = frame(parent, {
        Position = position,
        Size = size,
        BackgroundColor3 = Color3.fromRGB(19, 19, 20),
        ZIndex = z,
    })

    gradient(
        well,
        Color3.fromRGB(240, 240, 240),
        Color3.fromRGB(180, 180, 180)
    )

    line(
        well,
        UDim2.fromOffset(0, 0),
        UDim2.new(1, 0, 0, 1),
        Color3.fromRGB(6, 6, 7),
        z + 1
    )

    return well
end

local function addTooltip(parent, message)
    if type(message) ~= "string" or message == "" then
        return nil
    end

    local area = hit(parent, {
        Position = UDim2.new(1, -16, 0.5, -7),
        Size = UDim2.fromOffset(14, 14),
        ZIndex = 40,
    })

