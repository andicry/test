--========================================================================
-- Public library API — loadstring this file and build your own UI:
--   local lib = loadstring(game:HttpGet(url))()
--   local page = lib:AddTab("Combat", "crosshair")
--   local sec  = lib.Section(page, { title = "Main", x = 12, w = 232, h = 300, y = 10 })
--   lib.Toggle(sec, { flag = "my_toggle", text = "Enabled" })
--   if lib.Flags.my_toggle then ... end
--========================================================================
local Library = {
	Flags       = Flags,
	Setters     = FlagSetters,
	Theme       = T,
	Notify      = function(_, msg, dur, ntype) notify(msg, dur, ntype) end,
	AddTab      = function(_, name, iconName, sideEntries) return addTab(name, iconName, sideEntries) end,
	SelectPage  = function(_, name) selectPage(name) end,
	Section     = buildSection,
	SubFrame    = subFrame,
	SubTabs     = buildSubTabs,
	Toggle      = buildToggle,
	Slider      = buildSlider,
	Dropdown    = buildDropdown,
	DropdownRow = buildDropdownRow,
	Listbox     = buildListbox,
	Textbox     = buildTextbox,
	SearchRow   = buildSearchRow,
	Button      = buildActionButton,
	ButtonPair  = buildButtonPair,
	Keybind     = buildKeybind,
	Pages       = Pages,
	SaveConfig  = saveConfig,
	LoadConfig  = loadConfig,
	ToggleMenu  = toggleMenu,
	Unload      = unloadAll,
	SetFlag     = function(_, k, v)
		Flags[k] = v
		if FlagSetters[k] then pcall(FlagSetters[k], v) end
	end,
	Label       = function(parent, text, size, color, bold)
		local l = txt(parent, text, size or 14, color or T.dim, bold)
		l.Size = UDim2.new(1, 0, 0, (size or 14))
		return l
	end,
	-- dark display box (e.g. skin render preview); opts: h, outline, image
	Box         = function(parent, opts)
		opts = opts or {}
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, opts.h or 150)
		f.BackgroundColor3 = Color3.fromRGB(12, 12, 12)
		f.BorderSizePixel = 0
		f.ZIndex = (parent.ZIndex or 1) + 1
		f.Parent = parent
		stroke(f, opts.outline or Color3.fromRGB(4, 4, 4))
		local img = Instance.new("ImageLabel")
		img.Size = UDim2.new(1, -12, 1, -12)
		img.Position = UDim2.fromOffset(6, 6)
		img.BackgroundTransparency = 1
		img.Image = resolveImage(opts.image) or ""
		img.ZIndex = f.ZIndex
		img.Parent = f
		return f, img
	end,
	ResolveImage = resolveImage,
}
if getgenv then getgenv().symbollib = Library end
return Library
