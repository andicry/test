        UDim2.fromOffset(0, 22)
    )

    -- The watermark hugs its content: the brand mark and the text are laid out
    -- by a list and the frame grows with them, so no width has to be measured
    -- (the loaded font face does not match the fallback metrics TextService
    -- uses) and no empty space is left behind.
    watermark.Frame.AutomaticSize = Enum.AutomaticSize.X

    local watermarkContent = frame(watermark.Frame, {
        Name = "Content",
        Size = UDim2.fromOffset(0, 22),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        ZIndex = 72,
