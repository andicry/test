            PlaceholderColor3 = Library.Theme.TextInactive,
            TextColor3 = Library.Theme.Text,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 22,
        })

        make("UIPadding", {
            PaddingLeft = UDim.new(0, 7),
            PaddingRight = UDim.new(0, 8),
        }, box)

        local focusLine = line(
            body,
            UDim2.new(0, 0, 1, -1),
            UDim2.new(1, 0, 0, 1),
            Library.Theme.Accent,
            23
        )

        focusLine.BackgroundTransparency = 1

        local control = {}
        local committed = tostring(spec.Default or "")
        local reverting = false

        function control.Normalize(value)
            value = tostring(value or "")

            if spec.Numeric then
                value = value:gsub("%D", "")
            end

            return value
        end

        function control:Update(value)
            committed = value

            if box.Text ~= value then
                box.Text = value
            end
        end

        registerControl(control, spec, committed)

        connect(box.Focused, function()
            animate(focusLine, 0.1, {
                BackgroundTransparency = 0,
            })
        end)

        connect(box:GetPropertyChangedSignal("Text"), function()
            if spec.Numeric then
                local filtered = box.Text:gsub("%D", "")

                if filtered ~= box.Text then
                    box.Text = filtered
                end
            end
        end)

        connect(box.FocusLost, function(enterPressed)
            animate(focusLine, 0.1, {
                BackgroundTransparency = 1,
            })

            if reverting then
                reverting = false
                box.Text = committed
                return
            end

            if enterPressed then
                control:Set(box.Text)
            else
                box.Text = committed
            end
        end)

        connect(UserInputService.InputBegan, function(input)
            if input.KeyCode == Enum.KeyCode.Escape and box:IsFocused() then
                reverting = true
                box.Text = committed
                box:ReleaseFocus(false)
            end
        end)

        return control
    end

    function section:Dropdown(spec)
        spec = spec or {}

        local options = copyArray(spec.Options or spec.Items or {})
        local multi = spec.Multi == true
        local row = self:Row(19)

        local body = frame(row, {
            Position = UDim2.fromOffset(3, 0),
            Size = UDim2.new(1, spec.Tooltip and -24 or -6, 1, 0),
            BackgroundColor3 = Color3.fromRGB(17, 16, 18),
            ZIndex = 20,
        })

        gradient(
            body,
            Color3.fromRGB(255, 255, 255),
            Color3.fromRGB(150, 150, 150)
        )

        line(
            body,
            UDim2.fromOffset(0, 0),
            UDim2.new(1, 0, 0, 1),
            Color3.fromRGB(66, 61, 66),
            21
        )

        line(
            body,
            UDim2.new(0, 0, 1, -1),
            UDim2.new(1, 0, 0, 1),
            Color3.fromRGB(8, 8, 9),
            21
        )

        local notch = frame(body, {
            Size = UDim2.new(0, 2, 1, 0),
            BackgroundColor3 = Library.Theme.Accent,
            ZIndex = 21,
        })

        bindTheme(notch, "BackgroundColor3", "Accent")

        local title = text(body, controlName(spec, "dropdown"), {
            Position = UDim2.fromOffset(9, 0),
            Size = UDim2.new(0.42, -6, 1, 0),
            TextColor3 = Library.Theme.TextInactive,
            TextSize = 10,
            ZIndex = 22,
        })

        local valueWell = frame(body, {
            Position = UDim2.new(0.42, 3, 0, 2),
            Size = UDim2.new(0.58, -19, 1, -4),
            BackgroundColor3 = Color3.fromRGB(17, 16, 18),
            ZIndex = 22,
        })

        gradient(
            valueWell,
            Color3.fromRGB(255, 255, 255),
            Color3.fromRGB(150, 150, 150)
        )

        local valueText = text(valueWell, "", {
            Position = UDim2.fromOffset(5, 0),
            Size = UDim2.new(1, -9, 1, 0),
            TextXAlignment = Enum.TextXAlignment.Right,
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextSize = 10,
            ZIndex = 24,
        })

        local function pixelTriangle(parent, direction)
            local holder = frame(parent, {
                Size = UDim2.fromOffset(7, 4),
                BackgroundTransparency = 1,
                ZIndex = 24,
            })

            local widths

            if direction == "up" then
                widths = { 1, 3, 5, 7 }
            else
                widths = { 7, 5, 3, 1 }
            end

            for index, width in ipairs(widths) do
                frame(holder, {
                    Name = "Tri" .. index,
                    Position = UDim2.fromOffset((7 - width) // 2, index - 1),
                    Size = UDim2.fromOffset(width, 1),
                    BackgroundColor3 = Library.Theme.TextInactive,
                    BorderSizePixel = 0,
                    ZIndex = 25,
                })
            end

            return holder
        end

        local arrowDown = pixelTriangle(body, "down")
        local arrowUp = pixelTriangle(body, "up")

        arrowDown.Position = UDim2.new(1, -14, 0.5, -2)
        arrowUp.Position = UDim2.new(1, -14, 0.5, -2)
        arrowUp.Visible = false

        local click = hit(body, {
            Size = UDim2.fromScale(1, 1),
            ZIndex = 25,
        })

        local idleBody = Color3.fromRGB(17, 16, 18)

        local control = {}
        local activePanel
        local selectedIndex = 1

        local function contains(value)
            for _, option in ipairs(options) do
                if option == value then
                    return true
                end
            end

            return false
        end

        function control.Normalize(value)
            if multi then
                if type(value) ~= "table" then
                    return nil
                end

                local selected = {}

                for _, option in ipairs(options) do
                    for _, item in ipairs(value) do
                        if item == option then
                            table.insert(selected, option)
                            break
                        end
                    end
                end

                return selected
            end

            if contains(value) then
                return value
            end

            return nil
        end

        function control:Update(value)
            local filled

            if multi then
                filled = type(value) == "table" and #value > 0
            else
                filled = value ~= nil
            end

            valueText.Text = filled
                and (multi and table.concat(value, ", ") or tostring(value))
                or "..."

            valueText.TextColor3 = filled
                and Library.Theme.Accent
                or Library.Theme.TextInactive
        end

        local default = spec.Default

        if multi then
            default = type(default) == "table" and default or {}
        elseif default == nil then
            default = options[1]
        end

        registerControl(control, spec, default)

        observeAccent(valueText, function()
            control:Update(control:Get())
        end)

        function control:Refresh(nextOptions)
            options = copyArray(nextOptions)

            if multi then
                self:Set(self:Get(), true)
            elseif not contains(self:Get()) then
                if options[1] ~= nil then
                    self:Set(options[1], true)
                else
                    self.Value = nil
                    valueText.Text = "..."
                    valueText.TextColor3 = Library.Theme.TextInactive

                    if self.Flag then
                        Library.Flags[self.Flag] = nil
                    end
                end
            end
        end

        local function isSelected(option)
            local current = control:Get()

            if not multi then
                return current == option
            end

            for _, item in ipairs(current) do
                if item == option then
                    return true
                end
            end

            return false
        end

        local function choose(option)
            if multi then
                local current = control:Get()
                local nextValues = {}
                local found = false

                for _, item in ipairs(current) do
                    if item == option then
                        found = true
                    else
                        table.insert(nextValues, item)
                    end
                end

                if not found then
                    table.insert(nextValues, option)
                end

                control:Set(nextValues)
            else
                control:Set(option)
                closePopover()
            end
        end

        local function open(clickPos)
            if spec.Disabled then
                return
            end

            if popover then
                closePopover()
                return
            end

            local searchHeight = spec.Search and 22 or 0
            local desiredHeight = math.min(
                #options * 19 + searchHeight,
                170
            )

            desiredHeight = math.max(desiredHeight, 19 + searchHeight)

            local panel = openPopover(
                body,
                body.AbsoluteSize.X,
                desiredHeight,
                "Dropdown",
                clickPos
            )

            if not panel then
                return
            end

            activePanel = panel
            arrowDown.Visible = false
            arrowUp.Visible = true

            connect(panel.Destroying, function()
                if activePanel == panel then
                    activePanel = nil

                    if arrowDown.Parent then
                        arrowDown.Visible = true
                        arrowUp.Visible = false
                    end
                end
            end)

            local query = ""

            if spec.Search then
                local search = fontTextBox(panel, {
                    Position = UDim2.fromOffset(0, 0),
                    Size = UDim2.new(1, 0, 0, 22),
                    BackgroundColor3 = Color3.fromRGB(27, 25, 28),
                    BorderSizePixel = 0,
                    ClearTextOnFocus = false,
                    Text = "",
                    PlaceholderText = "Search",
                    PlaceholderColor3 = Library.Theme.TextInactive,
                    TextColor3 = Library.Theme.Text,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 103,
                })

                make("UIPadding", {
                    PaddingLeft = UDim.new(0, 7),
                    PaddingRight = UDim.new(0, 7),
                }, search)

                connect(search:GetPropertyChangedSignal("Text"), function()
                    query = string.lower(search.Text)
                end)
            end

            local list = make("ScrollingFrame", {
                Position = UDim2.fromOffset(0, searchHeight),
                Size = UDim2.new(1, 0, 1, -searchHeight),
                BackgroundColor3 = Library.Theme.Element,
                BorderSizePixel = 0,
                CanvasSize = UDim2.fromOffset(0, 0),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ScrollBarThickness = 3,
                ScrollBarImageColor3 = Library.Theme.Accent,
                ZIndex = 102,
            }, panel)

            make("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
            }, list)

            local rows = {}

            local function repaintItem(entry)
                local chosen = isSelected(entry.Option)

                entry.Button.BackgroundColor3 = entry.Hovered
                    and Library.Theme.HoveredElement
                    or chosen
                        and Color3.fromRGB(52, 45, 52)
                        or Library.Theme.Element
                entry.Notch.Visible = chosen
                entry.Label.TextColor3 = chosen
                    and Library.Theme.Accent
                    or Library.Theme.Text
            end

            for index, option in ipairs(options) do
                local item = hit(list, {
                    LayoutOrder = index,
                    Size = UDim2.new(1, 0, 0, 19),
                    BackgroundTransparency = 0,
                    BackgroundColor3 = Library.Theme.Element,
                    Text = "",
                    ZIndex = 103,
                })

                local itemNotch = frame(item, {
                    Size = UDim2.new(0, 2, 1, 0),
                    BackgroundColor3 = Library.Theme.Accent,
                    Visible = false,
                    ZIndex = 106,
                })

                bindTheme(itemNotch, "BackgroundColor3", "Accent")

                local itemLabel = text(item, tostring(option), {
                    Position = UDim2.fromOffset(9, 0),
                    Size = UDim2.new(1, -16, 1, 0),
                    TextSize = 10,
                    ZIndex = 104,
                })

                observeAccent(itemLabel, function(color)
                    if isSelected(option) then
                        itemLabel.TextColor3 = color
                    end
                end)

                frame(item, {
                    Name = "Divider",
                    Position = UDim2.new(0, 0, 1, -1),
                    Size = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Color3.fromRGB(26, 24, 27),
                    ZIndex = 105,
                })

                local entry = {
                    Button = item,
                    Notch = itemNotch,
                    Label = itemLabel,
                    Option = option,
                    Hovered = false,
                }

                rows[index] = entry

                connect(item.MouseEnter, function()
                    selectedIndex = index
                    entry.Hovered = true
                    repaintItem(entry)
                end)

                connect(item.MouseLeave, function()
                    entry.Hovered = false
                    repaintItem(entry)
                end)

                connect(item.Activated, function()
                    choose(option)
                    repaintItem(entry)
                end)

                repaintItem(entry)
            end

            if #options == 0 then
                text(panel, "...", {
                    Position = UDim2.fromOffset(0, searchHeight),
                    Size = UDim2.new(1, 0, 0, 19),
                    TextXAlignment = Enum.TextXAlignment.Center,
                    TextColor3 = Library.Theme.TextInactive,
                    TextSize = 10,
                    ZIndex = 103,
                })
            end

            if spec.Search then
                local search = panel:FindFirstChildWhichIsA("TextBox")

                if search then
                    connect(search:GetPropertyChangedSignal("Text"), function()
                        for _, entry in ipairs(rows) do
                            entry.Button.Visible = query == ""
                                or string.find(
                                    string.lower(tostring(entry.Option)),
                                    query,
                                    1,
                                    true
                                ) ~= nil
                        end
                    end)
                end
            end

            local keyConnection

            keyConnection = connect(UserInputService.InputBegan, function(input, processed)
                if not panel.Parent or popover == nil then
                    return
                end

                if UserInputService:GetFocusedTextBox() then
                    return
                end

                if input.KeyCode == Enum.KeyCode.Down then
                    selectedIndex = math.min(#options, selectedIndex + 1)
                elseif input.KeyCode == Enum.KeyCode.Up then
                    selectedIndex = math.max(1, selectedIndex - 1)
                elseif input.KeyCode == Enum.KeyCode.Return
                    or input.KeyCode == Enum.KeyCode.KeypadEnter then
                    local option = options[selectedIndex]

                    if option ~= nil then
                        choose(option)
                    end
                else
                    return
                end

                for index, entry in ipairs(rows) do
                    entry.Hovered = index == selectedIndex
                    repaintItem(entry)
                end
            end)

            connect(panel.Destroying, function()
                keyConnection:Disconnect()
            end)
        end

        connect(click.Activated, function(inputObject)
            open(inputObject and inputObject.Position or nil)
        end)

        connect(click.MouseEnter, function()
            animate(body, 0.1, {
                BackgroundColor3 = Library.Theme.HoveredElement,
            })

            animate(valueWell, 0.1, {
                BackgroundColor3 = Library.Theme.HoveredElement,
            })
        end)

        connect(click.MouseLeave, function()
            animate(body, 0.1, {
                BackgroundColor3 = idleBody,
            })

            animate(valueWell, 0.1, {
                BackgroundColor3 = idleBody,
            })
        end)

        return control
    end
end

