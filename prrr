-- Popup STACK: dropdowns opened from inside a gear popup spawn a level-2
-- popup instead of nuking the gear popup. Clicking outside everything (or
-- inside a lower level) closes the levels above it.
local popupStack = {} -- { {frame=..., level=..., anchor=...}, ... }

local function closePopupsFrom(level)
	for i = #popupStack, 1, -1 do
		local e = popupStack[i]
		if e.level >= level then
			e.frame:Destroy()
			table.remove(popupStack, i)
		end
	end
end
local function closePopup() closePopupsFrom(1) end
local function anyPopupOpen() return #popupStack > 0 end

-- level for a popup spawned FROM this gui object (nested if it's in a popup)
local function popupLevelFor(obj)
	for _, e in ipairs(popupStack) do
		if obj:IsDescendantOf(e.frame) then return e.level + 1 end
	end
	return 1
end
-- if this anchor already owns an open popup, close it and report true
local function togglePopupFor(anchor)
	for i, e in ipairs(popupStack) do
		if e.anchor == anchor then closePopupsFrom(e.level) return true end
	end
	return false
end

UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 and #popupStack > 0 then
		-- compare in the layer's raw-screen space (AbsolutePosition is
		-- inset-adjusted; the layer ignores the inset)
		local m = UserInputService:GetMouseLocation()
		local insideLevel
		for _, e in ipairs(popupStack) do
			local p = e.frame.AbsolutePosition - popupLayer.AbsolutePosition
			local s = e.frame.AbsoluteSize
			if m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y and m.Y <= p.Y + s.Y then
				insideLevel = math.max(insideLevel or 0, e.level)
			end
			-- clicking a popup's own anchor (the dropdown box / gear / swatch)
			-- must NOT close it here — the anchor's click handler toggles it,
			-- and closing first made every re-click reopen instead of close
			if e.anchor and e.anchor.Parent then
				local ap = e.anchor.AbsolutePosition - popupLayer.AbsolutePosition
				local as = e.anchor.AbsoluteSize
				if m.X >= ap.X and m.X <= ap.X + as.X and m.Y >= ap.Y and m.Y <= ap.Y + as.Y then
					return
				end
			end
		end
		if not insideLevel then
			task.defer(closePopup)
		else
			task.defer(function()
				-- keep the popup the click landed in (and its parents); a
				-- click there that spawns a child popup happens after this
				for i = #popupStack, 1, -1 do
					local e = popupStack[i]
					if e.level > insideLevel + 1 then
						e.frame:Destroy()
						table.remove(popupStack, i)
					end
				end
			end)
		end
	end
end)

local function newPopup(w, level, anchor)
	level = level or 1
	closePopupsFrom(level)
	local pop = Instance.new("Frame")
	pop.Size = UDim2.fromOffset(w, 10)
	pop.AutomaticSize = Enum.AutomaticSize.Y
	pop.BackgroundColor3 = T.element
	pop.BorderSizePixel = 0
	-- big z step per level so a nested list always covers the parent popup's
	-- own elements (which sit a few z above their popup frame)
	pop.ZIndex = 90 + level * 10
	pop.Parent = popupLayer
	round(pop, 3)
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(4, 4, 4)
	st.Thickness = 1
	st.Parent = pop
	local g = Instance.new("UIGradient") -- same texture as the elements
	g.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(178, 178, 178))
	g.Rotation = 90
	g.Parent = pop
	pad(pop, 8, 6, 8, 8)
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 5)
	list.Parent = pop
	table.insert(popupStack, { frame = pop, level = level, anchor = anchor })
	return pop
end
local function popupAtMouse(w, level, anchor)
	local pop = newPopup(w, level, anchor)
	local m = UserInputService:GetMouseLocation()
	pop.Position = UDim2.fromOffset(m.X, m.Y)
	return pop
end
local function popupBelow(anchor, w, level)
	local pop = newPopup(w or anchor.AbsoluteSize.X, level, anchor)
	-- convert into the layer's space. No gap — the list connects to the box.
	local p = anchor.AbsolutePosition - popupLayer.AbsolutePosition
	pop.Position = UDim2.fromOffset(p.X, p.Y + anchor.AbsoluteSize.Y)
	return pop
end

-- Tooltip: small label following the mouse while hovering an element
local tooltipFrame
local function attachTooltip(obj, text)
	if not text then return end
	local hovering = false
	obj.MouseEnter:Connect(function()
		hovering = true
		if tooltipFrame then tooltipFrame:Destroy() end
		local f = Instance.new("Frame")
		f.AutomaticSize = Enum.AutomaticSize.XY
		f.BackgroundColor3 = T.element
		f.BorderSizePixel = 0
		f.ZIndex = 120
		f.Parent = popupLayer
		round(f, 3)
		stroke(f, Color3.fromRGB(4, 4, 4))
		local l = txt(f, text, 12, T.text)
		l.AutomaticSize = Enum.AutomaticSize.XY
		l.ZIndex = 120
		pad(f, 6, 3)
		tooltipFrame = f
		task.spawn(function()
			while hovering and f.Parent do
				local m = UserInputService:GetMouseLocation()
				f.Position = UDim2.fromOffset(m.X + 14, m.Y + 10)
				task.wait()
			end
		end)
	end)
	obj.MouseLeave:Connect(function()
		hovering = false
		if tooltipFrame then tooltipFrame:Destroy() tooltipFrame = nil end
	end)
end

