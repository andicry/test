local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end

local function make(className, properties, parent)
    local object = Instance.new(className)

    if object:IsA("ScrollingFrame") then
        object.ScrollBarThickness = 0
    end

    for key, value in pairs(properties or {}) do
        object[key] = value
    end

    if object:IsA("ScrollingFrame") then
        object.ScrollBarThickness = 0
    end

    object.Parent = parent
    return object
end

local function animate(object, duration, properties, direction)
    if not alive or not object then
        return
    end

    if Library.AnimationsDisabled then
        for property, value in pairs(properties) do
            object[property] = value
        end

        return
    end

    local byProperty = animations[object]

    if not byProperty then
        byProperty = {}
        animations[object] = byProperty
    end

    for property in pairs(properties) do
        local old = byProperty[property]

        if old then
            old:Cancel()
        end
    end

    for property, value in pairs(properties) do
        local tween = TweenService:Create(
            object,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Quad,
                direction or Enum.EasingDirection.Out
            ),
            { [property] = value }
        )

        byProperty[property] = tween
        tween:Play()
    end
end

