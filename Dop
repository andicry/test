function Library:SaveTheme(name)
    name = cleanName(name)

    if not name or not writefile then
        return false, "Theme name or file API unavailable"
    end

    local ok, err = folders()

    if not ok then
        return false, tostring(err)
    end

    local data = {}

    for key, color in pairs(Theme) do
        data[key] = color:ToHex()
    end

    local success, result = pcall(function()
        writefile("Dopamine/themes/" .. name .. ".json", HttpService:JSONEncode(data))
    end)

    return success, success and nil or tostring(result)
end

function Library:LoadTheme(name)
    name = cleanName(name)

    if not name or not isfile or not readfile then
        return false, "Theme name or file API unavailable"
    end

    local path = "Dopamine/themes/" .. name .. ".json"

    if not isfile(path) then
        return false, "Theme not found"
    end

    local ok, result = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)

    if not ok or type(result) ~= "table" then
        return false, "Invalid theme"
    end

    for key, value in pairs(result) do
        if Theme[key] and type(value) == "string" then
            local success, color = pcall(Color3.fromHex, value)

            if success then
                Theme[key] = color
            end
        end
    end

    updateTheme()
    return true
end

function Library:GetThemes()
    if not listfiles then
        return {}
    end

    local ok = folders()

    if not ok then
        return {}
    end

    local success, files = pcall(listfiles, "Dopamine/themes")

    if not success then
