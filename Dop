function Library:Watermark(options)
    options = options or {}

    local outer, inner = panel(Gui, {
        Position = UDim2.fromOffset(50, 16),
        Size = UDim2.fromOffset(130, 39),
        BackgroundColor3 = Theme.Border
    })

    local mark = logo(inner)
    mark.Position = UDim2.fromOffset(10, 8)

    local caption = text(inner, "", {
        Position = UDim2.fromOffset(40, 0),
        Size = UDim2.new(1, -50, 1, 0),
        TextTruncate = Enum.TextTruncate.None
    })

    draggable(inner, outer)

    local items = {
        Title = true,
        Time = true
    }

    local fps = 0
    local frames = 0
    local elapsed = 0
    local refreshElapsed = 0

    local function update()
        local values = {}
        local player = Players.LocalPlayer

        if items.Title then
            table.insert(values, options.Name or "Dopamine")
        end

        if items.User then
            table.insert(values, player and player.Name or "Unknown")
        end

        if items.FPS then
            table.insert(values, tostring(fps) .. " FPS")
        end

        if items.Ms then
            local ping

            pcall(function()
                ping = math.floor(player:GetNetworkPing() * 1000 + 0.5)
            end)

            table.insert(values, ping and (tostring(ping) .. " ms") or "-- ms")
        end

        if items.Date then
            table.insert(values, os.date("%Y-%m-%d"))
        end

        if items.Time then
            table.insert(values, os.date("%H:%M:%S"))
        end

        caption.Text = #values > 0 and table.concat(values, " | ") or "..."

        local width = math.max(90, caption.TextBounds.X + 55)
        outer.Size = UDim2.fromOffset(width, 39)
    end

    connect(RunService.RenderStepped, function(delta)
        frames += 1
        elapsed += delta
        refreshElapsed += delta

        if elapsed >= 1 then
            fps = math.floor(frames / elapsed + 0.5)
            frames = 0
            elapsed = 0
        end

        if refreshElapsed >= 0.25 then
            refreshElapsed = 0
            update()
        end
    end)

    local object = {
        Instance = outer
    }

    function object:SetItems(values)
        table.clear(items)

        if type(values) == "table" then
            for key, value in pairs(values) do
                if type(key) == "number" then
                    items[tostring(value)] = true
                elseif value == true then
                    items[tostring(key)] = true
                end
            end
        end

        update()
    end

    function object:SetText(value)
        options.Name = tostring(value)
        update()
    end

    function object:SetVisible(value)
        outer.Visible = value == true
    end

    Library.WatermarkObject = object
    update()

    return object
end

