                })

                border(marker)

                local hueBar = new("TextButton", {
                    Position = UDim2.fromOffset(196, 10),
                    Size = UDim2.fromOffset(15, 160),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = ""
                }, menu.Inner)

                border(hueBar)

                new("UIGradient", {
                    Rotation = 90,
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
                        ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
                        ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
                        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
                        ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
                        ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0))
                    })
                }, hueBar)

                local hueMarker = frame(hueBar, {
                    AnchorPoint = Vector2.new(0, 0.5),
                    Size = UDim2.new(1, 0, 0, 2),
                    BackgroundColor3 = Color3.new(1, 1, 1)
                })

                local alphaBar = new("TextButton", {
                    Position = UDim2.fromOffset(10, 182),
                    Size = UDim2.fromOffset(201, 15),
                    BackgroundColor3 = Color3.fromRGB(180, 180, 180),
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = "",
                    ClipsDescendants = true
                }, menu.Inner)

                border(alphaBar)

                for x = 0, 24 do
                    for y = 0, 1 do
                        frame(alphaBar, {
                            Position = UDim2.fromOffset(x * 8, y * 8),
                            Size = UDim2.fromOffset(8, 8),
                            BackgroundColor3 = (x + y) % 2 == 0
                                and Color3.fromRGB(235, 235, 235)
                                or Color3.fromRGB(150, 150, 150)
                        })
                    end
                end

                local alphaColor = frame(alphaBar, {
                    Size = UDim2.fromScale(1, 1),
                    BackgroundColor3 = color,
                    ZIndex = 2
                })

                new("UIGradient", {
                    Transparency = NumberSequence.new(0, 1)
                }, alphaColor)

                local alphaMarker = frame(alphaBar, {
                    AnchorPoint = Vector2.new(0.5, 0),
                    Size = UDim2.new(0, 2, 1, 0),
                    BackgroundColor3 = Color3.new(0, 0, 0),
                    ZIndex = 3
                })

                local function update(silent)
                    color = Color3.fromHSV(hue, saturation, value)
                    preview.BackgroundColor3 = color
                    palette.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
                    alphaColor.BackgroundColor3 = color
                    marker.Position = UDim2.fromScale(saturation, 1 - value)
                    hueMarker.Position = UDim2.fromScale(0, hue)
                    alphaMarker.Position = UDim2.fromScale(alpha, 0)

                    if flag then
                        Library.Flags[flag] = {
                            Color = color:ToHex(),
                            Alpha = alpha
                        }
                    end

                    if not silent then
                        call(config.Callback, color, alpha)
                    end
                end

                local function set(nextColor, nextAlpha, silent)
                    if type(nextColor) == "table" then
                        nextAlpha = nextColor.Alpha
                        nextColor = nextColor.Color
                    end

                    if type(nextColor) == "string" then
                        local ok, result = pcall(Color3.fromHex, nextColor)

                        if not ok then
                            return
                        end

                        nextColor = result
                    end

                    if typeof(nextColor) ~= "Color3" then
                        return
                    end

                    hue, saturation, value = nextColor:ToHSV()
                    alpha = math.clamp(tonumber(nextAlpha) or 0, 0, 1)
                    update(silent)
                end

                local function slide(input)
                    if sliding == "palette" then
                        saturation = math.clamp(
                            (input.Position.X - palette.AbsolutePosition.X) / math.max(palette.AbsoluteSize.X, 1),
                            0,
                            1
                        )

                        value = 1 - math.clamp(
                            (input.Position.Y - palette.AbsolutePosition.Y) / math.max(palette.AbsoluteSize.Y, 1),
                            0,
                            1
                        )
                    elseif sliding == "hue" then
                        hue = math.clamp(
                            (input.Position.Y - hueBar.AbsolutePosition.Y) / math.max(hueBar.AbsoluteSize.Y, 1),
                            0,
                            0.999
                        )
                    elseif sliding == "alpha" then
                        alpha = math.clamp(
                            (input.Position.X - alphaBar.AbsolutePosition.X) / math.max(alphaBar.AbsoluteSize.X, 1),
                            0,
                            1
                        )
                    else
                        return
                    end

                    update()
                end

                for name, object in pairs({
                    palette = palette,
                    hue = hueBar,
                    alpha = alphaBar
                }) do
                    connect(object.InputBegan, function(input)
                        if isClick(input) then
                            sliding = name
                            slide(input)
                        end
                    end)
                end

                connect(UIS.InputChanged, function(input)
                    if sliding and isMove(input) then
                        slide(input)
                    end
                end)

                connect(UIS.InputEnded, function(input)
                    if isClick(input) then
                        sliding = nil
                    end
                end)

                connect(swatch.MouseButton1Click, function()
                    menu:SetOpen(not menu.Open)
                end)

                registerFlag(flag, {
                    Color = color:ToHex(),
                    Alpha = alpha
                }, function(nextValue)
                    set(nextValue)
                end)

                update(true)

                return {
                    Set = function(_, nextColor, nextAlpha, silent)
                        set(nextColor, nextAlpha, silent)
                    end,
                    Get = function()
                        return color, alpha
                    end
                }
            end

