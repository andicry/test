-- Per-element settings: a cog icon on `row` that opens a popup with rename and
-- (when `activate` is given) a keybind with Toggle/Hold/Always modes. Molto
-- supplies the cog glyph; a "·" fallback keeps the handle visible if the fetch
-- fails. `caption` is the TextLabel whose .Text rename updates.
local function cogSettings(row, caption, activate, options)
    options = options or {}
    local hasTooltip = options.tooltip == true
    local rightOffset = hasTooltip and -30 or -14
    local yScale, yOff = options.top and 0 or 0.5, options.top and 1 or -7

    local icon          -- forward declared; the popup anchors to it
    local settingsPopup
    local entry          -- { Key, Mode, Activate, State } once a key is bound
    local mode = "Toggle"
    local modes = { "Toggle", "Hold", "Always" }
    local capturing = false

    local function removeEntry()
        if not entry then
            return
        end
        for index, current in ipairs(Library.ElementKeybinds) do
            if current == entry then
                table.remove(Library.ElementKeybinds, index)
                break
            end
        end
        entry = nil
    end

    local function keyLabel()
        if entry and entry.Key and entry.Key ~= Enum.KeyCode.Unknown then
            return tostring(entry.Key.Name):gsub("^Enum%.KeyCode%.", "")
        end
        return "Press a key"
    end

    local function open()
        if settingsPopup then
            settingsPopup:SetOpen(not settingsPopup.Open)
            return
        end

        local hasKey = activate ~= nil
        local width = 226
        local height = hasKey and 176 or 96

        settingsPopup = popup(icon, width, height)
        local inner = settingsPopup.Inner

        new("UIPadding", {
            PaddingTop = UDim.new(0, 8),
            PaddingBottom = UDim.new(0, 8),
            PaddingLeft = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 8)
        }, inner)

        new("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 6)
        }, inner)

        local header = text(inner, "Element Settings", {
            Size = UDim2.new(1, 0, 0, 18),
            LayoutOrder = 1,
            TextXAlignment = Enum.TextXAlignment.Center
        })
        bindTheme(header, "TextColor3", "Accent")

        local function row(layoutOrder, label)
            local r = frame(inner, {
                Size = UDim2.new(1, 0, 0, 20),
                BackgroundTransparency = 1,
                LayoutOrder = layoutOrder
            })
            text(r, label, {
                Size = UDim2.new(0, 64, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Left
            })
            return r
        end

        -- Rename
        local renameRow = row(2, "Rename")
        local renameBox = new("TextBox", {
            Position = UDim2.fromOffset(68, 1),
            Size = UDim2.new(1, -68, 1, -2),
            BackgroundColor3 = Theme.Element,
            BorderSizePixel = 0,
            Text = caption and caption.Text or "",
            PlaceholderText = "Name...",
            ClearTextOnFocus = false,
            TextXAlignment = Enum.TextXAlignment.Left
        }, renameRow)
        bindTheme(renameBox, "BackgroundColor3", "Element")
        border(renameBox, "Border")

        connect(renameBox.FocusLost, function()
            if caption and renameBox.Text ~= "" then
                caption.Text = renameBox.Text
            else
                renameBox.Text = caption and caption.Text or ""
            end
        end)

        if hasKey then
            -- Keybind capture
            local keyRow = row(3, "Keybind")
            local keyBtn, keyFace = surface(keyRow, 18)
            keyBtn.Position = UDim2.fromOffset(68, 1)
            keyBtn.Size = UDim2.new(1, -68, 1, -2)
            keyBtn.LayoutOrder = 3
            local keyCaption = text(keyFace, keyLabel(), {
                Size = UDim2.fromScale(1, 1),
                TextXAlignment = Enum.TextXAlignment.Center
            })

            connect(keyBtn.MouseButton1Click, function()
                capturing = true
                Library.CapturingElementKey = true
                keyCaption.Text = "Press a key..."
            end)

            connect(UIS.InputBegan, function(input)
                if not capturing then
                    return
                end
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    local chosen = input.KeyCode
                    if chosen == Enum.KeyCode.Escape or chosen == Enum.KeyCode.Backspace then
                        chosen = Enum.KeyCode.Unknown
                    end
                    removeEntry()
                    if chosen ~= Enum.KeyCode.Unknown then
                        entry = { Key = chosen, Mode = mode, Activate = activate, State = false }
                        table.insert(Library.ElementKeybinds, entry)
                    end
                    capturing = false
                    Library.CapturingElementKey = false
                    keyCaption.Text = keyLabel()
                end
            end)

            -- Mode cycle
            local modeRow = row(4, "Mode")
            local modeBtn, modeFace = surface(modeRow, 18)
            modeBtn.Position = UDim2.fromOffset(68, 1)
            modeBtn.Size = UDim2.new(1, -68, 1, -2)
            modeBtn.LayoutOrder = 4
            local modeCaption = text(modeFace, mode, {
                Size = UDim2.fromScale(1, 1),
                TextXAlignment = Enum.TextXAlignment.Center
            })

            connect(modeBtn.MouseButton1Click, function()
                local index = 1
                for i, m in ipairs(modes) do
                    if m == mode then
                        index = i
                        break
                    end
                end
                mode = modes[(index % #modes) + 1]
                if entry then
                    entry.Mode = mode
                end
                modeCaption.Text = mode
            end)

            -- Clear
            local clearBtn, clearFace = surface(inner, 22)
            clearBtn.LayoutOrder = 5
            clearBtn.Size = UDim2.new(1, 0, 0, 22)
            text(clearFace, "Clear Keybind", {
                Size = UDim2.fromScale(1, 1),
                TextXAlignment = Enum.TextXAlignment.Center
            })

            connect(clearBtn.MouseButton1Click, function()
                removeEntry()
                capturing = false
                Library.CapturingElementKey = false
                keyCaption.Text = keyLabel()
            end)
        end

        -- Close
        local closeBtn, closeFace = surface(inner, 22)
        closeBtn.LayoutOrder = hasKey and 6 or 3
        closeBtn.Size = UDim2.new(1, 0, 0, 22)
        text(closeFace, "Close", {
            Size = UDim2.fromScale(1, 1),
            TextXAlignment = Enum.TextXAlignment.Center
        })

        connect(closeBtn.MouseButton1Click, function()
            settingsPopup:SetOpen(false)
        end)

        settingsPopup:SetOpen(true)
    end

    -- Inline gear fallback: a real cog shows even if Molto can't be fetched, so
    -- the handle never collapses to a plain dot.
    local cogFallback = "data:image/png;base64,"

    icon = new("ImageButton", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new(1, rightOffset, yScale, yOff),
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Image = cogFallback,
        ImageColor3 = Theme.Text,
        ImageTransparency = 0,
        ZIndex = 5
    }, row)
    bindTheme(icon, "ImageColor3", "Text")

    connect(icon.MouseButton1Click, open)
    connect(icon.MouseEnter, function()
        tween(icon, { ImageColor3 = Theme.Accent }, 0.1)
    end)
    connect(icon.MouseLeave, function()
        tween(icon, { ImageColor3 = Theme.Text }, 0.1)
    end)

    -- Prefer Molto's vector gear; the inline base64 gear above stays if it fails.
    if not setIcon(icon, "settings-32-filled", 14) then
        icon.Image = cogFallback
    end

    return icon
end

local function tooltip(anchor, message)
    if not message then
        return
    end

    -- (?) indicator: the tooltip only appears while hovering this icon, not the
    -- whole row. Active = false so clicks pass through to the control below.
    local icon = new("TextLabel", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new(1, -14, 0.5, -7),
        BackgroundTransparency = 1,
        Active = false,
        Text = "?",
        TextSize = 13,
        TextColor3 = Theme.TextInactive,
        TextStrokeColor3 = Color3.new(0, 0, 0),
        TextStrokeTransparency = 0.3,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center
    }, anchor)
    bindTheme(icon, "TextColor3", "TextInactive")

    local holder, inner = panel(PopupRoot, {
        Size = UDim2.fromOffset(180, 27),
        BackgroundColor3 = Theme.Border,
        Visible = false
    })

    local accent = frame(inner, {
        Size = UDim2.new(0, 1, 1, 0),
        BackgroundColor3 = Theme.Accent
    })

    bindTheme(accent, "BackgroundColor3", "Accent")

    local caption = text(inner, message, {
        Position = UDim2.fromOffset(8, 0),
        Size = UDim2.new(1, -14, 1, 0)
    })

    local token = 0

    connect(icon.MouseEnter, function()
        token += 1
        local current = token

        task.delay(0.45, function()
            if current ~= token or not icon.Parent then
                return
            end

            local pos = icon.AbsolutePosition
            local size = icon.AbsoluteSize
            local screen = PopupRoot.AbsoluteSize
            local inset = GuiService:GetGuiInset()

            holder.Position = UDim2.fromOffset(
                math.clamp(pos.X + inset.X + 10, 0, math.max(screen.X - 180, 0)),
                pos.Y + inset.Y + size.Y + 5
            )

            holder.Visible = true
            holder.Size = UDim2.fromOffset(180, 0)

            tween(holder, {
                Size = UDim2.fromOffset(180, 27)
            }, 0.12)
        end)
    end)

    connect(icon.MouseLeave, function()
        token += 1
        holder.Visible = false
    end)
end

function Library:CreateWindow(options)
    options = options or {}

    local outer, main = panel(Gui, {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(600, 500),
        BackgroundColor3 = Theme.Border,
        ClipsDescendants = true
    })

    -- Menu background image. Hidden by default; shown via window:SetBackground.
    -- Renders behind all content (ZIndex 0) and stretches to fill the window.
    local background = new("ImageLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Image = "",
        ScaleType = Enum.ScaleType.Stretch,
        ImageTransparency = 1,
        ZIndex = 0
    }, main)

    local scale = new("UIScale", {}, outer)
    local syncShadow  -- forward declared; defined once the shadow exists

    local function resize()
        local size = Gui.AbsoluteSize

        if size.X > 0 and size.Y > 0 then
            local baseW = math.max(outer.Size.X.Offset, 1)
            local baseH = math.max(outer.Size.Y.Offset, 1)
            scale.Scale = math.min(1, (size.X - 16) / baseW, (size.Y - 16) / baseH)
            scale.Scale = math.max(scale.Scale, 0.35)
        end

        if syncShadow then
            syncShadow()
        end
    end

    connect(Gui:GetPropertyChangedSignal("AbsoluteSize"), resize)

    -- Soft drop shadow behind the window for depth. Tracks outer's position,
    -- size and scale so it follows drags, resizes and the open/close tween.
    local shadowAsset = "data:image/png;base64,"

    local shadow = new("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = outer.Position,
        Size = UDim2.fromOffset(outer.Size.X.Offset + 28, outer.Size.Y.Offset + 28),
        BackgroundTransparency = 1,
        Image = shadowAsset,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(24, 24, 104, 104),
        ImageTransparency = 0.5,
        ZIndex = 0,
        Visible = outer.Visible
    }, Gui)

    local shadowScale = new("UIScale", {}, shadow)

    syncShadow = function()
        shadow.Position = outer.Position
        shadow.Size = UDim2.fromOffset(outer.Size.X.Offset + 28, outer.Size.Y.Offset + 28)
        shadowScale.Scale = scale.Scale
        shadow.Visible = outer.Visible
    end

    connect(outer:GetPropertyChangedSignal("Size"), syncShadow)
    connect(outer:GetPropertyChangedSignal("Position"), syncShadow)
    connect(outer:GetPropertyChangedSignal("Visible"), syncShadow)
    resize()

    local header = frame(main, {
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundTransparency = 1,
        Active = true
    })

    local logoValue = options.Logo
    local mark

    if logoValue ~= nil then
        if type(logoValue) == "number" then
            logoValue = "rbxassetid://" .. logoValue
        elseif type(logoValue) == "string" and tonumber(logoValue) ~= nil then
            logoValue = "rbxassetid://" .. logoValue
        end

        mark = new("ImageLabel", {
            Size = UDim2.fromOffset(20, 20),
            BackgroundTransparency = 1,
            Image = logoValue,
            BorderSizePixel = 0
        }, header)
    else
        mark = logo(header)
    end

    mark.Position = UDim2.fromOffset(9, 9)

    local title = text(header, options.Name or "Dopamine", {
        Position = UDim2.fromOffset(39, 0),
        Size = UDim2.new(1, -48, 1, 0)
    })

    draggable(header, outer)

    local resizer = frame(outer, {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, 0, 1, 0),
        Size = UDim2.fromOffset(18, 18),
        BackgroundTransparency = 1,
        Active = true,
        ZIndex = 50
    })

    local resizing = false
    local resizeOrigin = Vector2.new()

    connect(UIS.InputBegan, function(input)
        if isClick(input) and not resizing and outer.Visible and pointerOver(resizer, input.Position) then
            resizing = true
            resizeOrigin = outer.AbsolutePosition
        end
    end)

    connect(UIS.InputChanged, function(input)
        if resizing and isMove(input) then
            local current = scale.Scale

            if current > 0 then
                local screen = Gui.AbsoluteSize
                local inset = GuiService:GetGuiInset()
                local width = math.clamp(input.Position.X - resizeOrigin.X, 380, math.max(screen.X - inset.X - resizeOrigin.X, 380))
                local height = math.clamp(input.Position.Y - resizeOrigin.Y, 320, math.max(screen.Y - inset.Y - resizeOrigin.Y, 320))

                outer.Size = UDim2.fromOffset(width / current, height / current)
                outer.Position = UDim2.fromOffset(resizeOrigin.X + inset.X + width / 2, resizeOrigin.Y + inset.Y + height / 2)
            end
        end
    end)

    connect(UIS.InputEnded, function(input)
        if isClick(input) then
            resizing = false
        end
    end)

    local body, bodyInner = panel(main, {
        Position = UDim2.fromOffset(9, 41),
        Size = UDim2.new(1, -18, 1, -51),
        BackgroundColor3 = Theme.Border
    })

    local pages = frame(bodyInner, {
        Position = UDim2.fromOffset(7, 7),
        Size = UDim2.new(1, -14, 1, -48),
        BackgroundTransparency = 1,
        ClipsDescendants = true
    })

    local tabBar = frame(bodyInner, {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.fromScale(0, 1),
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = Theme.Border
    })

    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder
    }, tabBar)

    local window = {
        Instance = outer,
        Tabs = {},
        Current = nil,
        IsOpen = true,
        Transition = 0
    }

    function window:SetOpen(value)
        value = value == true

        if self.IsOpen == value then
            return
        end

        self.IsOpen = value
        self.Transition += 1
        local transition = self.Transition

        if Library.OpenPopup then
            local active = Library.OpenPopup
            active:SetOpen(false)

            if active.ParentPopup and active.ParentPopup.Open then
                active.ParentPopup:SetOpen(false)
            end
        end

        local viewport = Gui.AbsoluteSize
        local baseW = math.max(outer.Size.X.Offset, 1)
        local baseH = math.max(outer.Size.Y.Offset, 1)
        local targetScale = math.max(
            0.35,
            math.min(1, (viewport.X - 16) / baseW, (viewport.Y - 16) / baseH)
        )

        if value then
            outer.Visible = true
            scale.Scale = targetScale * 0.96

            tween(scale, {
                Scale = targetScale
            }, 0.2)
        else
            local animation = tween(scale, {
                Scale = targetScale * 0.96
            }, 0.16)

            task.spawn(function()
                if animation then
                    animation.Completed:Wait()
                end

                if self.Transition == transition and not self.IsOpen and outer.Parent then
                    outer.Visible = false
                    scale.Scale = targetScale
                end
            end)
        end
    end

    function window:SelectTab(tab)
        if self.Current == tab then
            return
        end

        if Library.OpenPopup then
            Library.OpenPopup:SetOpen(false)
        end

        local old = self.Current
        local oldIndex = old and old.Index or tab.Index
        local direction = tab.Index > oldIndex and 1 or -1
        self.Current = tab

        if old then
            old.Page.Visible = false
        end

        tab.Page.Position = UDim2.fromOffset(direction * 18, 0)
        tab.Page.Visible = true

        tween(tab.Page, {
            Position = UDim2.fromOffset(0, 0)
        }, 0.15)

        for _, item in ipairs(self.Tabs) do
            tween(item.Caption, {
                TextColor3 = item == tab and Theme.Accent or Theme.TextInactive
            }, 0.12)
        end
    end

    -- Set the menu background to an asset id (number/"123") or an image URL.
    -- Pass nil to clear. `transparency` (0..1) controls how strong the image is.
    function window:SetBackground(source, transparency)
        if source == nil then
            background.Image = ""
            background.ImageTransparency = 1
            body.BackgroundTransparency = 0
            bodyInner.BackgroundTransparency = 0
            tabBar.BackgroundTransparency = 0
            return
        end

        local asset = resolveAsset(source)

        if not asset then
            return false, "Could not load background asset"
        end

        background.Image = asset
        background.ImageTransparency = tonumber(transparency) or 0

        -- The body panel (border + interior) and tab bar are made transparent
        -- so the backdrop shows through; sections and tab buttons stay opaque
        -- and float on top of the image.
        body.BackgroundTransparency = 1
        bodyInner.BackgroundTransparency = 1
        tabBar.BackgroundTransparency = 1
    end

    function window:Tab(config)
        config = config or {}

        local button, face = surface(tabBar, 34)
        button.LayoutOrder = #self.Tabs + 1

        local caption = text(face, config.Name or "Tab", {
            Size = UDim2.fromScale(1, 1),
            TextXAlignment = Enum.TextXAlignment.Center
        })

        local page = frame(pages, {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Visible = false
        })

        local columns = {}

        for index = 1, 2 do
            local column = new("ScrollingFrame", {
                Position = index == 1 and UDim2.new(0, 0, 0, 0) or UDim2.new(0.5, 4, 0, 0),
                Size = UDim2.new(0.5, -4, 1, 0),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                CanvasSize = UDim2.new(),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                ScrollingDirection = Enum.ScrollingDirection.Y,
                ScrollBarThickness = 0,
                Active = true
            }, page)

            new("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 7)
            }, column)

            new("UIPadding", {
                PaddingTop = UDim.new(0, 10)
            }, column)

            columns[index] = column
        end

        local tab = {
            Index = #self.Tabs + 1,
            Button = button,
            Caption = caption,
            Page = page,
            Columns = columns,
            SectionCount = 0
        }

        table.insert(self.Tabs, tab)

        for _, item in ipairs(self.Tabs) do
            item.Button.Size = UDim2.new(1 / #self.Tabs, 0, 1, 0)
        end

        connect(button.MouseButton1Click, function()
            window:SelectTab(tab)
        end)

        function tab:Section(sectionOptions)
            sectionOptions = sectionOptions or {}
            self.SectionCount += 1

            local side = sectionOptions.Side or 1

            if type(side) == "string" then
                side = side:lower() == "right" and 2 or 1
            end

            side = side == 2 and 2 or 1

            local outerSection = frame(self.Columns[side], {
                Size = UDim2.new(1, -2, 0, 0),
                BackgroundColor3 = Theme.Border,
                LayoutOrder = self.SectionCount
            })

            bindTheme(outerSection, "BackgroundColor3", "Border")

            local sectionBody = frame(outerSection, {
                Position = UDim2.fromOffset(1, 1),
                Size = UDim2.new(1, -2, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Theme.Section
            })

            bindTheme(sectionBody, "BackgroundColor3", "Section")

            new("UIPadding", {
                PaddingTop = UDim.new(0, 9),
                PaddingBottom = UDim.new(0, 9),
                PaddingLeft = UDim.new(0, 9),
                PaddingRight = UDim.new(0, 9)
            }, sectionBody)

            local layout = new("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 7)
            }, sectionBody)

            connect(layout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
                outerSection.Size = UDim2.new(1, -2, 0, layout.AbsoluteContentSize.Y + 20)
            end)

            local headingText = text(outerSection, sectionOptions.Name or "Section", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0, 0),
                Size = UDim2.new(1, 0, 0, 20),
                TextXAlignment = Enum.TextXAlignment.Center
            })

            local section = {
                Container = sectionBody,
                Order = 0
            }

            local function order(object)
                section.Order += 1
                object.LayoutOrder = section.Order
            end

            function section:Label(config)
                config = config or {}

                local row = frame(sectionBody, {
                    Size = UDim2.new(1, 0, 0, config.Height or 16),
                    BackgroundTransparency = 1
                })

                order(row)

                local caption = text(row, config.Name or "Label", {
                    Size = UDim2.new(1, (config.Cog and (config.Tooltip and -34 or -18) or (config.Tooltip and -18 or 0)), 1, 0),
                    TextWrapped = config.Wrapped == true
                })

                tooltip(row, config.Tooltip)

                if config.Cog and type(config.Live) ~= "function" then
                    cogSettings(row, caption, nil, { tooltip = config.Tooltip ~= nil })
                end

                -- Live label: pass a function that returns a string/value and it
                -- is polled on a throttle to keep the label text up to date.
                if type(config.Live) == "function" then
                    local function apply()
                        local ok, result = pcall(config.Live)
                        if ok and result ~= nil then
                            caption.Text = tostring(result)
                        end
                    end

                    apply()

                    local elapsed = 0

                    connect(RunService.RenderStepped, function(delta)
                        elapsed += delta

                        if elapsed >= (config.Interval or 0.25) then
                            elapsed = 0
                            apply()
                        end
                    end)
                end

                return {
                    Instance = row,
                    SetText = function(_, value)
                        caption.Text = tostring(value)
                    end
                }
            end

            function section:Button(config)
                config = config or {}

                local buttonObject, face = surface(sectionBody, 28)
                order(buttonObject)

                local caption = text(face, config.Name or "Button", {
                    Size = UDim2.new(1, config.Cog and -24 or 0, 1, 0),
                    TextXAlignment = Enum.TextXAlignment.Center
                })

                tooltip(buttonObject, config.Tooltip)

                if config.Cog then
                    cogSettings(buttonObject, caption, function(state)
                        if state ~= false then
                            call(config.Callback)
                        end
                    end, { tooltip = config.Tooltip ~= nil })
                end

                connect(buttonObject.MouseButton1Click, function()
                    call(config.Callback)
                end)

                return {
                    Instance = buttonObject,
                    SetText = function(_, value)
                        caption.Text = tostring(value)
                    end,
                    Press = function()
                        call(config.Callback)
                    end
                }
            end

            function section:Toggle(config)
                config = config or {}

                local value = config.Default == true
                local flag = config.Flag

                local row = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 16),
                    BackgroundTransparency = 1,
                    AutoButtonColor = false,
                    Text = ""
                }, sectionBody)

                order(row)

                local box = frame(row, {
                    Position = UDim2.new(0, 0, 0.5, -7),
                    Size = UDim2.fromOffset(14, 14),
                    BackgroundColor3 = Theme.Border
                })

                bindTheme(box, "BackgroundColor3", "Border")

                local fill = frame(box, {
                    Position = UDim2.fromOffset(1, 1),
                    Size = UDim2.new(1, -2, 1, -2),
                    BackgroundColor3 = Color3.new(1, 1, 1)
                })

                local shade = gradient(fill, Theme.ElementTop, Theme.ElementBottom)

                local caption = text(row, config.Name or "Toggle", {
                    Position = UDim2.fromOffset(21, 0),
                    Size = UDim2.new(1, (config.Cog and (config.Tooltip and -52 or -36) or (config.Tooltip and -36 or -21)), 1, 0)
                })

                tooltip(row, config.Tooltip)

                local function applyShade()
                    shade.Color = value
                        and ColorSequence.new(Theme.Accent:Lerp(Color3.new(1, 1, 1), 0.2), Theme.Accent:Lerp(Color3.new(0, 0, 0), 0.25))
                        or ColorSequence.new(Theme.ElementTop, Theme.ElementBottom)
                end

                -- Advanced toggles reveal a block of dependent options below them
                -- when enabled. The dependents live in the same section body and
                -- are shown/hidden together with the toggle state.
                local dependents = {}

                local function applyDependents(state)
                    for _, control in ipairs(dependents) do
                        if control.Instance and control.Instance.Parent then
                            control.Instance.Visible = state
                        end
                    end
                end

                local function set(nextValue, silent)
                    if type(nextValue) ~= "boolean" then
                        return
                    end

                    value = nextValue

                    if flag then
                        Library.Flags[flag] = value
                    end

                    applyShade()
                    applyDependents(value)

                    tween(caption, {
                        TextColor3 = value and Theme.Text or Theme.TextInactive
                    }, 0.12)

                    if not silent then
                        call(config.Callback, value)
                    end
                end

                connect(row.MouseButton1Click, function()
                    set(not value)
                end)

                registerFlag(flag, value, function(nextValue)
                    set(nextValue)
                end)

                -- Re-bind the active/inactive gradient to the current Accent so
                -- changing the accent color updates an already-enabled toggle.
                bindThemeCallback(row, applyShade)

                set(value, true)

                if config.Cog then
                    cogSettings(row, caption, function(state)
                        set(state)
                    end, { tooltip = config.Tooltip ~= nil })
                end

                local result = {
                    Instance = row,
                    Set = function(_, nextValue, silent)
                        set(nextValue, silent)
                    end,
                    Get = function()
                        return value
                    end
                }

                if config.Advanced then
                    -- Proxy section builders (Slider, Dropdown, Toggle, ...) so
                    -- any control created through this object is revealed only
                    -- while the toggle is enabled.
                    setmetatable(result, {
                        __index = function(_, key)
                            local method = section[key]

                            if type(method) ~= "function" then
                                return nil
                            end

                            return function(_, opts)
                                local control = method(section, opts)

                                if control and control.Instance then
                                    table.insert(dependents, control)
                                    control.Instance.Visible = value
                                end

                                return control
                            end
                        end
                    })
                end

                return result
            end

            function section:Textbox(config)
                config = config or {}

                local value = tostring(config.Default or "")
                local flag = config.Flag
                local hasTitle = config.Name ~= nil

                local root = frame(sectionBody, {
                    Size = UDim2.new(1, 0, 0, hasTitle and 42 or 22),
                    BackgroundTransparency = 1
                })

                order(root)

                if hasTitle then
                    local caption = text(root, config.Name, {
                        Size = UDim2.new(1, config.Cog and -18 or 0, 0, 15)
                    })

                    if config.Cog then cogSettings(root, caption, nil, { top = true }) end
                end

                local box, face = surface(root, 22)
                box.Position = UDim2.fromOffset(0, hasTitle and 20 or 0)

                local input = new("TextBox", {
                    Position = UDim2.fromOffset(7, 0),
                    Size = UDim2.new(1, -14, 1, 0),
                    BackgroundTransparency = 1,
                    Text = value,
                    PlaceholderText = config.Placeholder or "",
                    PlaceholderColor3 = Theme.TextInactive,
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    TextStrokeTransparency = 0.3,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false
                }, face)

                bindTheme(input, "TextColor3", "Text")
                bindTheme(input, "PlaceholderColor3", "TextInactive")

                local function set(nextValue, silent)
                    value = tostring(nextValue or "")

                    if config.Numeric then
                        value = value:gsub("[^%d%.%-]", "")
                    end

                    if input.Text ~= value then
                        input.Text = value
                    end

                    if flag then
                        Library.Flags[flag] = value
                    end

                    if not silent then
                        call(config.Callback, value)
                    end
                end

                if config.Live then
                    connect(input:GetPropertyChangedSignal("Text"), function()
                        if input.Text ~= value then
                            set(input.Text)
                        end
                    end)
                else
                    connect(input.FocusLost, function()
                        set(input.Text)
                    end)
                end

                registerFlag(flag, value, function(nextValue)
                    set(nextValue)
                end)

                set(value, true)

                return {
                    Instance = root,
                    Input = input,
                    Set = function(_, nextValue, silent)
                        set(nextValue, silent)
                    end,
                    Get = function()
                        return config.Live and value or input.Text
                    end
                }
            end

            function section:Dropdown(config)
                config = config or {}

                local items = config.Items or {}
                local value = config.Default
                local flag = config.Flag
                local buttons = {}

                if type(value) == "number" then
                    value = items[value]
                end

                if value and not table.find(items, value) then
                    value = nil
                end

                local root = frame(sectionBody, {
                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundTransparency = 1
                })

                order(root)

                local caption = text(root, config.Name or "Dropdown", {
                    Size = UDim2.new(1, config.Cog and -18 or 0, 0, 15)
                })

                if config.Cog then cogSettings(root, caption, nil, { top = true }) end

                local buttonObject, face = surface(root, 22)
                buttonObject.Position = UDim2.fromOffset(0, 20)

                local selected = text(face, "...", {
                    Position = UDim2.fromOffset(7, 0),
                    Size = UDim2.new(1, -14, 1, 0)
                })

                local menu = popup(buttonObject, 250, 40)

                local scroll = new("ScrollingFrame", {
                    Position = UDim2.fromOffset(5, 5),
                    Size = UDim2.new(1, -10, 1, -10),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    CanvasSize = UDim2.new(),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ScrollingDirection = Enum.ScrollingDirection.Y,
                    ScrollBarThickness = 0,
                    Active = true
                }, menu.Inner)

                new("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Padding = UDim.new(0, 1)
                }, scroll)

                local function paint()
                    selected.Text = value and tostring(value) or "..."

                    for item, button in pairs(buttons) do
                        button.TextColor3 = item == value and Theme.Accent or Theme.Text

                        local indicator = button:FindFirstChild("SelectionIndicator")
                        if indicator then
                            indicator.Visible = item == value
                        end
                    end
                end

                local function set(nextValue, silent)
                    if nextValue ~= nil and not table.find(items, nextValue) then
                        return false
                    end

                    value = nextValue

                    if flag then
                        Library.Flags[flag] = value
                    end

                    paint()

                    if not silent then
                        call(config.Callback, value)
                    end

                    return true
                end

                local function refresh(nextItems)
                    items = nextItems or {}

                    for _, button in pairs(buttons) do
                        button:Destroy()
                    end

                    table.clear(buttons)

                    for _, child in ipairs(scroll:GetChildren()) do
                        if child:IsA("TextLabel") then
                            child:Destroy()
                        end
                    end

                    if #items == 0 then
                        text(scroll, "...", {
                            Size = UDim2.new(1, 0, 0, 18)
                        })
                    end

                    for index, item in ipairs(items) do
                        local option = new("TextButton", {
                            Size = UDim2.new(1, 0, 0, 18),
                            BackgroundTransparency = 1,
                            AutoButtonColor = false,
                            Text = tostring(item),
                            TextColor3 = Theme.Text,
                            TextSize = 12,
                            TextStrokeTransparency = 0.3,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            LayoutOrder = index
                        }, scroll)

                        local indicator = frame(option, {
                            Name = "SelectionIndicator",
                            Position = UDim2.fromOffset(-3, 2),
                            Size = UDim2.new(0, 1, 1, -4),
                            BackgroundColor3 = Theme.Accent,
                            Visible = false
                        })

                        bindTheme(indicator, "BackgroundColor3", "Accent")

                        buttons[item] = option

                        connect(option.MouseEnter, function()
                            option.TextColor3 = Theme.Accent
                        end)

                        connect(option.MouseLeave, paint)

                        connect(option.MouseButton1Click, function()
                            set(item)
                            menu:SetOpen(false)
                        end)
                    end

                    if value and not table.find(items, value) then
                        value = nil

                        if flag then
                            Library.Flags[flag] = nil
                        end
                    end

                    menu.Width = math.max(buttonObject.AbsoluteSize.X, 1)
                    menu.Height = math.min(math.max(#items, 1) * 19 + 12, 120)
                    paint()
                end

                connect(buttonObject.MouseButton1Click, function()
                    menu.Width = math.max(buttonObject.AbsoluteSize.X, 1)
                    menu.Height = math.min(math.max(#items, 1) * 19 + 12, 120)
                    menu:SetOpen(not menu.Open)
                end)

                refresh(items)

                registerFlag(flag, value, function(nextValue)
                    set(nextValue)
                end)

                set(value, true)

                -- Re-paint the selected option when the Accent changes so the
                -- highlighted item follows the new accent color live.
                bindThemeCallback(root, paint)

                return {
                    Instance = root,
                    Set = function(_, nextValue, silent)
                        return set(nextValue, silent)
                    end,
                    Get = function()
                        return value
                    end,
                    Refresh = function(_, nextItems)
                        refresh(nextItems)
                    end
                }
            end

