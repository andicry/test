                    -- A keybind flagged "menu_key" drives the window toggle key.
                    if config.Flag == "menu_key" and key ~= Enum.KeyCode.Unknown then
                        Library.MenuKey = key
                    end

                    if entry then
                        entry:SetText(displayKey() .. " - " .. tostring(config.Name or "Keybind") .. " - " .. mode)
                        entry:SetVisible(show and active)
                    end

                    if not silent then
                        call(config.Callback, active, key, mode)
                    end
                end

                local function resolveKey(value)
                    if typeof(value) == "EnumItem" then
                        return value
                    end

                    if type(value) ~= "string" then
                        return Enum.KeyCode.Unknown
                    end

                    local enumType, enumName = value:match("^Enum%.([%w_]+)%.([%w_]+)$")

                    if enumType == "KeyCode" then
                        return Enum.KeyCode[enumName] or Enum.KeyCode.Unknown
                    elseif enumType == "UserInputType" then
                        return Enum.UserInputType[enumName] or Enum.KeyCode.Unknown
                    end

                    return Enum.KeyCode[value] or Enum.KeyCode.Unknown
                end

                local function set(data, silent)
                    if type(data) == "table" then
                        key = resolveKey(data.Key)
                        mode = table.find(modes, data.Mode) and data.Mode or "Toggle"
                        show = data.Show ~= false
                    else
                        key = resolveKey(data)
                    end

                    active = mode == "Always"
                    update(silent)
                end

                for index, option in ipairs(modes) do
                    local button = new("TextButton", {
                        Position = UDim2.fromOffset(7, 5 + (index - 1) * 19),
                        Size = UDim2.new(1, -14, 0, 18),
                        BackgroundTransparency = 1,
                        AutoButtonColor = false,
                        Text = option,
                        TextColor3 = Theme.Text,
                        TextSize = 12,
                        TextStrokeTransparency = 0.3,
                        TextXAlignment = Enum.TextXAlignment.Left
                    }, modeMenu.Inner)

                    connect(button.MouseButton1Click, function()
                        mode = option
                        active = mode == "Always"
                        update()
                        modeMenu:SetOpen(false)
                    end)
                end

                connect(modeButton.MouseButton1Click, function()
                    modeMenu.Width = math.max(modeButton.AbsoluteSize.X, 100)
                    modeMenu:SetOpen(not modeMenu.Open)
                end)

                connect(showButton.MouseButton1Click, function()
                    show = not show
                    update(true)
                end)

                connect(keyButton.MouseButton1Click, function()
                    picking = true
                    update(true)
                end)

                connect(keyButton.MouseButton2Click, function()
                    menu:SetOpen(not menu.Open)
                end)

                connect(UIS.InputBegan, function(input, processed)
                    if picking then
                        local chosen

                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            chosen = input.KeyCode
                        elseif input.UserInputType == Enum.UserInputType.MouseButton1
                            or input.UserInputType == Enum.UserInputType.MouseButton2
                            or input.UserInputType == Enum.UserInputType.MouseButton3 then
                            chosen = input.UserInputType
                        end

                        if chosen then
                            if chosen == Enum.KeyCode.Escape or chosen == Enum.KeyCode.Backspace then
                                chosen = Enum.KeyCode.Unknown
                            end

                            key = chosen
                            picking = false
                            update(config.Flag ~= "menu_key")
                        end

                        return
                    end

                    if processed or UIS:GetFocusedTextBox() or key == Enum.KeyCode.Unknown then
                        return
                    end

                    if input.KeyCode == key or input.UserInputType == key then
                        if mode == "Toggle" then
                            active = not active
                        elseif mode == "Hold" then
                            active = true
                        else
                            active = true
                        end

                        update()
                    end
                end)

                connect(UIS.InputEnded, function(input)
                    if mode == "Hold" and (input.KeyCode == key or input.UserInputType == key) then
                        active = false
                        update()
                    end
                end)

                registerFlag(flag, {
                    Key = keyString(),
                    Mode = mode,
                    Show = show
                }, function(data)
                    set(data)
                end)

                update(true)

                return {
                    Set = function(_, data, silent)
                        set(data, silent)
                    end,
                    Get = function()
                        return key, mode, active
                    end
                }
            end

            function section:SearchList(config)
                config = config or {}

                local items = config.Items or {}
                local selected
                local rows = {}

                local search = section:Textbox({
                    Placeholder = "Search...",
                    Live = true
                })

                local list = new("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 0, config.Height or 190),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    CanvasSize = UDim2.new(),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ScrollingDirection = Enum.ScrollingDirection.Y,
                    ScrollBarThickness = 0,
                    Active = true
                }, sectionBody)

                order(list)
                bindTheme(list, "BackgroundColor3", "Element")
                border(list)

                new("UIPadding", {
                    PaddingTop = UDim.new(0, 5),
                    PaddingBottom = UDim.new(0, 5),
                    PaddingLeft = UDim.new(0, 8),
                    PaddingRight = UDim.new(0, 8)
                }, list)

                new("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Padding = UDim.new(0, 2)
                }, list)

                local function filter()
                    local query = search.Input.Text:lower()

                    for name, button in pairs(rows) do
                        button.Visible = query == "" or tostring(name):lower():find(query, 1, true) ~= nil
                    end
                end

                local function repaint()
                    for name, other in pairs(rows) do
                        other.TextColor3 = name == selected and Theme.Accent or Theme.Text

                        local indicator = other:FindFirstChild("SelectionIndicator")
                        if indicator then
                            indicator.Visible = name == selected
                        end
                    end
                end

                local function refresh(nextItems)
                    items = nextItems or {}

                    for _, button in pairs(rows) do
                        button:Destroy()
                    end

                    table.clear(rows)

                    for index, item in ipairs(items) do
                        local button = new("TextButton", {
                            Size = UDim2.new(1, 0, 0, 20),
                            BackgroundTransparency = 1,
                            AutoButtonColor = false,
                            Text = tostring(item),
                            TextColor3 = Theme.Text,
                            TextSize = 12,
                            TextStrokeTransparency = 0.3,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            LayoutOrder = index
                        }, list)

                        local indicator = frame(button, {
                            Name = "SelectionIndicator",
                            Position = UDim2.fromOffset(-5, 2),
                            Size = UDim2.new(0, 1, 1, -4),
                            BackgroundColor3 = Theme.Accent,
                            Visible = item == selected
                        })

                        bindTheme(indicator, "BackgroundColor3", "Accent")

                        rows[item] = button

                        connect(button.MouseButton1Click, function()
                            selected = item
                            repaint()
                            call(config.Callback, item)
                        end)
                    end

                    filter()
                end

                connect(search.Input:GetPropertyChangedSignal("Text"), filter)
                refresh(items)

                bindThemeCallback(list, repaint)

                return {
                    Refresh = function(_, nextItems)
                        refresh(nextItems)
                    end,
                    Get = function()
                        return selected
                    end,
                    Search = search
                }
            end

            function section:PlayerList(config)
                config = config or {}

                local selected
                local rows = {}
                local statuses = Library.PlayerStatuses

                local list = new("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 0, config.Height or 260),
                    BackgroundColor3 = Theme.Element,
                    BorderSizePixel = 0,
                    CanvasSize = UDim2.new(),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ScrollingDirection = Enum.ScrollingDirection.Y,
                    ScrollBarThickness = 0,
                    Active = true
                }, sectionBody)

                order(list)
                bindTheme(list, "BackgroundColor3", "Element")
                border(list)

                new("UIPadding", {
                    PaddingTop = UDim.new(0, 5),
                    PaddingBottom = UDim.new(0, 5),
                    PaddingLeft = UDim.new(0, 7),
                    PaddingRight = UDim.new(0, 7)
                }, list)

                new("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Padding = UDim.new(0, 2)
                }, list)

                local statusDropdown = section:Dropdown({
                    Name = "Player status",
                    Items = { "Neutral", "Priority", "Friendly" },
                    Default = "Neutral",
                    Callback = function(value)
                        if not selected then
                            return
                        end

                        statuses[selected.UserId] = value

                        local row = rows[selected.UserId]

                        if row then
                            row.Status.Text = value
                            row.Status.TextColor3 = value == "Priority"
                                and Color3.fromRGB(235, 65, 70)
                                or value == "Friendly"
                                and Color3.fromRGB(90, 220, 110)
                                or Theme.Text
                        end

                        call(config.Callback, selected, value)
                    end
                })

                local function refresh()
                    for _, row in pairs(rows) do
                        row.Frame:Destroy()
                    end

                    table.clear(rows)

                    local players = Players:GetPlayers()

                    table.sort(players, function(a, b)
                        if a == Players.LocalPlayer then
                            return true
                        end

                        if b == Players.LocalPlayer then
                            return false
                        end

                        return a.Name:lower() < b.Name:lower()
                    end)

                    for index, player in ipairs(players) do
                        local row = new("TextButton", {
                            Size = UDim2.new(1, 0, 0, 23),
                            BackgroundTransparency = 1,
                            AutoButtonColor = false,
                            Text = "",
                            LayoutOrder = index
                        }, list)

                        local selectionLine = frame(row, {
                            Name = "SelectionIndicator",
                            Position = UDim2.fromOffset(-5, 2),
                            Size = UDim2.new(0, 1, 1, -4),
                            BackgroundColor3 = Theme.Accent,
                            Visible = selected == player
                        })

                        bindTheme(selectionLine, "BackgroundColor3", "Accent")

                        local avatar = new("ImageLabel", {
                            Position = UDim2.fromOffset(0, 2),
                            Size = UDim2.fromOffset(19, 19),
                            BackgroundTransparency = 1,
                            Image = ""
                        }, row)

                        local name = text(row, player.DisplayName .. " (@" .. player.Name .. ")", {
                            Position = UDim2.fromOffset(26, 0),
                            Size = UDim2.new(1, -100, 1, 0)
                        })

                        local statusValue = statuses[player.UserId] or "Neutral"

                        local status = text(row, statusValue, {
                            AnchorPoint = Vector2.new(1, 0),
                            Position = UDim2.fromScale(1, 0),
                            Size = UDim2.fromOffset(72, 23),
                            TextXAlignment = Enum.TextXAlignment.Right
                        })

                        status.TextColor3 = statusValue == "Priority"
                            and Color3.fromRGB(235, 65, 70)
                            or statusValue == "Friendly"
                            and Color3.fromRGB(90, 220, 110)
                            or Theme.Text

                        rows[player.UserId] = {
                            Frame = row,
                            Status = status
                        }

                        task.spawn(function()
                            local ok, image = pcall(function()
                                return Players:GetUserThumbnailAsync(
                                    player.UserId,
                                    Enum.ThumbnailType.HeadShot,
                                    Enum.ThumbnailSize.Size48x48
                                )
                            end)

                            if ok and avatar.Parent then
                                avatar.Image = image
                            end
                        end)

                        connect(row.MouseButton1Click, function()
                            if player == Players.LocalPlayer then
                                return
                            end

                            selected = player

                            for _, playerRow in pairs(rows) do
                                local indicator = playerRow.Frame:FindFirstChild("SelectionIndicator")

                                if indicator then
                                    indicator.Visible = playerRow.Frame == row
                                end
                            end

                            statusDropdown:Set(statuses[player.UserId] or "Neutral", true)
                        end)
                    end
                end

                connect(Players.PlayerAdded, refresh)

                connect(Players.PlayerRemoving, function(player)
                    if selected == player then
                        selected = nil
                    end

                    task.defer(refresh)
                end)

                refresh()

                return {
                    Refresh = refresh,
                    GetSelected = function()
                        return selected
                    end,
                    GetStatus = function(_, player)
                        return statuses[player.UserId] or "Neutral"
                    end
                }
            end

            return section
        end

        if not self.Current then
            self:SelectTab(tab)
        end

        return tab
    end

    connect(UIS.InputBegan, function(input, processed)
        if processed or UIS:GetFocusedTextBox() then
            return
        end

        if input.KeyCode == Library.MenuKey then
            window:SetOpen(not window.IsOpen)
        end
    end)

    Library.Window = window
    return window
end

function Library:Exit()
    if self.Unloaded then
        return
    end

    self.Unloaded = true

    for _, connection in ipairs(self.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(self.Connections)

    if self.Gui then
        self.Gui:Destroy()
    end

    if self.PopupGui then
        self.PopupGui:Destroy()
    end

    if self.BackdropGui then
        self.BackdropGui:Destroy()
    end

    if self.SnowGui then
        self.SnowGui:Destroy()
    end

    if self.BlurEffect then
        self.BlurEffect:Destroy()
    end

    if env.DopamineLibrary == self then
        env.DopamineLibrary = nil
    end
end

-- Backdrop / snow / blur: optional ambience drawn behind the window. Each is
-- only active while the menu is open so it never interferes with gameplay.
local BackdropGui
local SnowGui
local SnowFlakes = {}

local function menuIsOpen()
    return Library.Window ~= nil and Library.Window.IsOpen == true
end

function Library:SetBackdrop(enabled)
    self.BackdropEnabled = enabled == true

    if self.BackdropEnabled and not BackdropGui then
        BackdropGui = new("ScreenGui", {
            Name = "DopamineBackdrop",
            DisplayOrder = 999,
            IgnoreGuiInset = true,
            ResetOnSpawn = false
        }, guiParent())

        self.BackdropGui = BackdropGui

        self.BackdropFrame = new("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 0.4,
            BorderSizePixel = 0,
            Visible = false
        }, BackdropGui)
    end

    if self.BackdropFrame then
        self.BackdropFrame.Visible = self.BackdropEnabled and menuIsOpen()
    end
end

function Library:SetSnow(enabled)
    self.SnowEnabled = enabled == true

    if self.SnowEnabled and not SnowGui then
        SnowGui = new("ScreenGui", {
            Name = "DopamineSnow",
            DisplayOrder = 999,
            IgnoreGuiInset = true,
            ResetOnSpawn = false,
            Enabled = false
        }, guiParent())

        self.SnowGui = SnowGui

        for _ = 1, 70 do
            local size = 1 + math.random() * 3
            local flake = new("Frame", {
                Size = UDim2.fromOffset(size, size),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BackgroundTransparency = 0.15 + math.random() * 0.25,
                BorderSizePixel = 0,
                Visible = true
            }, SnowGui)

            table.insert(SnowFlakes, {
                Frame = flake,
                X = math.random(),
                Y = math.random(),
                Speed = 0.08 + math.random() * 0.14,
                Phase = math.random() * math.pi * 2
            })
        end
    end

    if SnowGui then
        SnowGui.Enabled = self.SnowEnabled and menuIsOpen()
    end
end

function Library:SetBlur(amount)
    amount = math.clamp(tonumber(amount) or 0, 0, 24)
    self.BlurAmount = amount

    if amount > 0 and not BlurEffect then
        pcall(function()
            BlurEffect = Instance.new("BlurEffect")
            BlurEffect.Size = 0
            BlurEffect.Parent = game:GetService("Lighting")
        end)
        self.BlurEffect = BlurEffect
    end

    if BlurEffect then
        BlurEffect.Size = menuIsOpen() and amount or 0
    end
end

-- Keep the ambience in sync with the menu open state and animate the snow.
connect(RunService.RenderStepped, function(delta)
    if Library.Unloaded then
        return
    end

    local open = menuIsOpen()

    if Library.BackdropFrame then
        Library.BackdropFrame.Visible = Library.BackdropEnabled and open
    end

    if SnowGui then
        local shouldRun = Library.SnowEnabled and open
        SnowGui.Enabled = shouldRun

        if shouldRun then
            local now = os.clock()

            for _, flake in ipairs(SnowFlakes) do
                flake.Y = flake.Y + flake.Speed * delta

                if flake.Y > 1 then
                    flake.Y = 0
                    flake.X = math.random()
                end

                local sway = math.sin(now * 2 + flake.Phase) * 0.02
                flake.Frame.Position = UDim2.fromScale(flake.X + sway, flake.Y)
            end
        end
    end

    if BlurEffect then
        BlurEffect.Size = open and Library.BlurAmount or 0
    end
end)

env.DopamineLibrary = Library

-- Default font: try to load the bundled Tahoma pixel font; fall back to the
-- engine default if the executor cannot host custom assets.
task.spawn(function()
    local ok, err = Library:SetFont("Tahoma 8px")

    if not ok and not Library.Unloaded then
        warn("[Dopamine] Tahoma 8px: " .. tostring(err))
    end
end)

-- Re-apply the saved default theme, if one was set with SetDefaultTheme.
do
    local defaultTheme = Library:GetDefaultTheme()

    if defaultTheme then
        Library:LoadTheme(defaultTheme)
    end
end

return Library
