local function surface(parent, height)
    local outer = new("TextButton", {
        Size = UDim2.new(1, 0, 0, height or 22),
        BackgroundColor3 = Theme.Border,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
        ClipsDescendants = true
    }, parent)

    bindTheme(outer, "BackgroundColor3", "Border")

    local face = frame(outer, {
        Position = UDim2.fromOffset(1, 1),
        Size = UDim2.new(1, -2, 1, -2),
        BackgroundColor3 = Color3.new(1, 1, 1)
    })

    local shade = gradient(face, Theme.ElementTop, Theme.ElementBottom)

    local highlight = frame(face, {
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = Theme.Inline,
        BackgroundTransparency = 0.2
    })

    bindTheme(highlight, "BackgroundColor3", "Inline")

    local bottom = frame(face, {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.fromScale(0, 1),
