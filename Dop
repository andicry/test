-- Re-apply the current font to every text descendant of a tree. Used as a
-- safety net when a popup opens so its text always matches the active font
-- (e.g. the keybind mode popup), even if it was built before SetFont ran.
local function applyFont(parent)
    if not parent then
        return
    end

    for _, object in ipairs(parent:GetDescendants()) do
        if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
            Library.FontObjects[object] = true

            if Library.FontFace then
                object.FontFace = Library.FontFace
            else
                object.Font = Library.Font
            end
        end
    end
end

local function popup(anchor, width, height)
    local outer, inner, topLine = panel(PopupRoot, {
        Size = UDim2.fromOffset(width, 0),
        BackgroundColor3 = Theme.Border,
        ClipsDescendants = true,
        Visible = false
    })

    local object = {
        Frame = outer,
        Inner = inner,
        TopLine = topLine,
        Anchor = anchor,
        Width = width,
        Height = height,
        Open = false,
        Generation = 0
    }

    function object:Reposition()
        if not self.Anchor.Parent then
            self:SetOpen(false)
            return
        end

        local pos = self.Anchor.AbsolutePosition
        local size = self.Anchor.AbsoluteSize
        local screen = PopupRoot.AbsoluteSize
        local inset = GuiService:GetGuiInset()
        local x = math.clamp(pos.X + inset.X, 0, math.max(screen.X - self.Width, 0))
        local y = pos.Y + inset.Y + size.Y + 4

        self.Frame.Position = UDim2.fromOffset(x, y)
    end

    function object:SetOpen(value)
        value = value == true
        self.Generation += 1
        local generation = self.Generation

        if value then
            if Library.OpenPopup and Library.OpenPopup ~= self and Library.OpenPopup ~= self.ParentPopup then
                local previous = Library.OpenPopup
                local previousParent = previous.ParentPopup

                previous:SetOpen(false)

                if previousParent and previousParent.Open and previousParent ~= self then
                    previousParent:SetOpen(false)
                end
            end

            Library.OpenPopup = self
            self.Open = true

            -- Cancel any close tweens still draining from a previous close so
            -- they cannot fight the visibility reset below.
            if self.CloseTweens then
                for _, animation in ipairs(self.CloseTweens) do
                    if animation then
                        pcall(function()
                            animation:Cancel()
                        end)
                    end
                end
                self.CloseTweens = nil
            end

            self.Frame.Visible = true
            self.Frame.BackgroundTransparency = 0
            self.Inner.BackgroundTransparency = 0
            if self.TopLine then
                self.TopLine.BackgroundTransparency = 0.5
            end
            applyFont(self.Frame)
            self:Reposition()
            self.Frame.Size = UDim2.fromOffset(self.Width, 0)

            tween(self.Frame, {
                Size = UDim2.fromOffset(self.Width, self.Height)
            }, 0.14)
        else
            self.Open = false

            if Library.OpenPopup == self then
                if self.ParentPopup and self.ParentPopup.Open then
                    Library.OpenPopup = self.ParentPopup
                else
                    Library.OpenPopup = nil
                end
            end

            -- Fade the chrome out as it collapses so the 1px border does not
            -- read as a thin line while the height drains to zero.
            self.CloseTweens = {}

            table.insert(self.CloseTweens, tween(self.Frame, {
                Size = UDim2.fromOffset(self.Width, 0),
                BackgroundTransparency = 1
            }, 0.12))
            table.insert(self.CloseTweens, tween(self.Inner, {
                BackgroundTransparency = 1
            }, 0.12))

            if self.TopLine then
                table.insert(self.CloseTweens, tween(self.TopLine, {
                    BackgroundTransparency = 1
                }, 0.12))
            end

            local animation = self.CloseTweens[1]

            task.spawn(function()
                if animation then
                    animation.Completed:Wait()
                end

                if self.Generation == generation and not self.Open and self.Frame.Parent then
                    self.Frame.Visible = false
                    self.Frame.BackgroundTransparency = 0
                    self.Inner.BackgroundTransparency = 0
                    if self.TopLine then
                        self.TopLine.BackgroundTransparency = 0.5
                    end
                    self.CloseTweens = nil
                end
            end)
        end
    end

    function object:Destroy()
        if Library.OpenPopup == self then
            Library.OpenPopup = nil
        end

        self.Frame:Destroy()
    end

    return object
end

connect(RunService.RenderStepped, function()
    if Library.OpenPopup and Library.OpenPopup.Open then
        Library.OpenPopup:Reposition()
    end
end)

connect(UIS.InputBegan, function(input)
    local active = Library.OpenPopup

    if active and isClick(input) then
        local position = input.Position

        if not pointerOver(active.Frame, position) and not pointerOver(active.Anchor, position) then
            local parent = active.ParentPopup
            active:SetOpen(false)

            if parent and parent.Open and not pointerOver(parent.Frame, position) and not pointerOver(parent.Anchor, position) then
                parent:SetOpen(false)
            end
        end
    end
end)

