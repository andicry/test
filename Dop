                connect(buttonObject.MouseButton1Click, function()
                    menu.Width = math.max(buttonObject.AbsoluteSize.X, 1)
                    menu.Height = math.min(math.max(#items, 1) * 19 + 12, 120)
                    menu:SetOpen(not menu.Open)
                end)

                local function set(values, silent)
                    if type(values) ~= "table" then
                        return
                    end

                    table.clear(selected)

                    for _, item in ipairs(values) do
                        if table.find(items, item) then
                            selected[item] = true
                        end
                    end

                    update(silent)
                end

                registerFlag(flag, getValues(), function(values)
                    set(values)
                end)

                update(true)

                -- Keep selected items highlighted in the current Accent.
                bindThemeCallback(root, function()
                    update(true)
                end)

                return {
                    Instance = root,
                    Set = function(_, values, silent)
                        set(values, silent)
                    end,
                    Get = function()
                        return getValues()
                    end
                }
            end

            function section:Slider(config)
                config = config or {}

                local minimum = tonumber(config.Min) or 0
                local maximum = tonumber(config.Max) or 100
                local step = tonumber(config.Step) or 1
                local value = tonumber(config.Default) or minimum
                local flag = config.Flag
                local sliding = false

                assert(maximum > minimum and step > 0, "Invalid slider range")

                local root = frame(sectionBody, {
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundTransparency = 1
                })

                order(root)

                local caption = text(root, config.Name or "Slider", {
                    Size = UDim2.new(1, config.Cog and -18 or 0, 0, 15)
                })

                if config.Cog then cogSettings(root, caption, nil, { top = true }) end

                local bar = new("TextButton", {
                    Position = UDim2.fromOffset(0, 20),
                    Size = UDim2.new(1, 0, 0, 9),
                    BackgroundColor3 = Theme.Border,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = ""
                }, root)

                bindTheme(bar, "BackgroundColor3", "Border")

                local fill = frame(bar, {
                    Position = UDim2.fromOffset(1, 1),
                    Size = UDim2.new(0, 0, 1, -2),
                    BackgroundColor3 = Theme.Accent
                })

                bindTheme(fill, "BackgroundColor3", "Accent")

                local valueText = text(bar, "", {
                    Size = UDim2.fromScale(1, 1),
                    TextXAlignment = Enum.TextXAlignment.Center,
                    ZIndex = 2
                })

                local function set(nextValue, silent)
                    nextValue = tonumber(nextValue)

                    if not nextValue then
                        return
                    end

                    value = math.clamp(
                        minimum + math.floor((nextValue - minimum) / step + 0.5) * step,
                        minimum,
                        maximum
                    )

                    value = tonumber(string.format("%.6f", value))

                    if flag then
                        Library.Flags[flag] = value
                    end

                    fill.Size = UDim2.new((value - minimum) / (maximum - minimum), -2, 1, -2)
                    valueText.Text = tostring(value) .. tostring(config.Suffix or "")

                    if not silent then
                        call(config.Callback, value)
                    end
                end

                local function update(input)
                    local fraction = math.clamp(
                        (input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1),
                        0,
                        1
                    )

                    set(minimum + fraction * (maximum - minimum))
                end

                connect(bar.InputBegan, function(input)
                    if isClick(input) then
                        sliding = true
                        update(input)
                    end
                end)

                connect(UIS.InputChanged, function(input)
                    if sliding and isMove(input) then
                        update(input)
                    end
                end)

                connect(UIS.InputEnded, function(input)
                    if isClick(input) then
                        sliding = false
                    end
                end)

                registerFlag(flag, value, function(nextValue)
                    set(nextValue)
                end)

                set(value, true)

                return {
                    Set = function(_, nextValue, silent)
                        set(nextValue, silent)
                    end,
                    Get = function()
                        return value
                    end
                }
            end

            function section:RangeSlider(config)
                config = config or {}

                local minimum = tonumber(config.Min) or 0
                local maximum = tonumber(config.Max) or 100
                local step = tonumber(config.Step) or 1
                local low = tonumber(config.DefaultLow) or minimum
                local high = tonumber(config.DefaultHigh) or maximum
                local flag = config.Flag
                local dragging

                assert(maximum > minimum and step > 0, "Invalid range slider")

                local root = frame(sectionBody, {
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundTransparency = 1
                })

                order(root)

                text(root, config.Name or "Range Slider", {
                    Size = UDim2.new(1, 0, 0, 15)
                })

                local bar = new("TextButton", {
                    Position = UDim2.fromOffset(0, 20),
                    Size = UDim2.new(1, 0, 0, 9),
                    BackgroundColor3 = Theme.Border,
                    BorderSizePixel = 0,
                    AutoButtonColor = false,
                    Text = ""
                }, root)

                local fill = frame(bar, {
                    Position = UDim2.fromOffset(0, 1),
                    Size = UDim2.new(1, 0, 1, -2),
                    BackgroundColor3 = Theme.Accent
                })

                bindTheme(fill, "BackgroundColor3", "Accent")

                local valueText = text(bar, "", {
                    Size = UDim2.fromScale(1, 1),
                    TextXAlignment = Enum.TextXAlignment.Center,
                    ZIndex = 2
                })

                local function rounded(value)
                    return tonumber(string.format(
                        "%.6f",
                        math.clamp(
                            minimum + math.floor((value - minimum) / step + 0.5) * step,
                            minimum,
                            maximum
                        )
                    ))
                end

                local function set(a, b, silent)
                    a = tonumber(a)
                    b = tonumber(b)

                    if not a or not b then
                        return
                    end

                    low = rounded(math.min(a, b))
                    high = rounded(math.max(a, b))

                    if flag then
                        Library.Flags[flag] = { low, high }
                    end

                    local first = (low - minimum) / (maximum - minimum)
                    local last = (high - minimum) / (maximum - minimum)

                    fill.Position = UDim2.new(first, 0, 0, 1)
                    fill.Size = UDim2.new(last - first, 0, 1, -2)
                    valueText.Text = tostring(low) .. "-" .. tostring(high) .. tostring(config.Suffix or "")

                    if not silent then
                        call(config.Callback, low, high)
                    end
                end

                local function valueAt(input)
                    local fraction = math.clamp(
                        (input.Position.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1),
                        0,
                        1
                    )

                    return minimum + fraction * (maximum - minimum)
                end

                local function update(input)
                    local nextValue = valueAt(input)

                    if dragging == "low" then
                        set(math.min(nextValue, high), high)
                    elseif dragging == "high" then
                        set(low, math.max(nextValue, low))
                    end
                end

                connect(bar.InputBegan, function(input)
                    if isClick(input) then
                        local nextValue = valueAt(input)
                        dragging = math.abs(nextValue - low) <= math.abs(nextValue - high) and "low" or "high"
                        update(input)
                    end
                end)

                connect(UIS.InputChanged, function(input)
                    if dragging and isMove(input) then
                        update(input)
                    end
                end)

                connect(UIS.InputEnded, function(input)
                    if isClick(input) then
                        dragging = nil
                    end
                end)

                registerFlag(flag, { low, high }, function(value)
                    if type(value) == "table" then
                        set(value[1], value[2])
                    end
                end)

                set(low, high, true)

                return {
                    Set = function(_, a, b, silent)
                        set(a, b, silent)
                    end,
                    Get = function()
                        return low, high
                    end
                }
            end

