    Position = UDim2.fromOffset(-10000, 0),
    Size = UDim2.fromOffset(320, 120),
    BackgroundTransparency = 1,
    Visible = true
})

local notificationOrder = 0
local notificationQueue = {}
Library.NotificationsDisabled = false

local function resolveTextAlign(value)
    if type(value) == "string" then
        value = value:lower()

        if value == "left" then
            return Enum.TextXAlignment.Left
        elseif value == "right" then
            return Enum.TextXAlignment.Right
        end
    elseif value == Enum.TextXAlignment.Left or value == Enum.TextXAlignment.Right then
        return value
    end

    return Enum.TextXAlignment.Center
end

local function escapeRichText(value)
    local result = tostring(value)

    result = result:gsub("&", "&amp;")
    result = result:gsub("<", "&lt;")
    result = result:gsub(">", "&gt;")

    return result
end

local function buildRichText(segments)
    if type(segments) == "string" then
        return segments
    end

    if type(segments) ~= "table" then
        return tostring(segments)
    end

    local parts = {}

    for _, segment in ipairs(segments) do
        local content = segment.Text or segment[1] or ""
        local color = segment.Color or segment[2]

        if color and color.R then
            local r = math.floor(color.R * 255 + 0.5)
            local g = math.floor(color.G * 255 + 0.5)
            local b = math.floor(color.B * 255 + 0.5)

            table.insert(parts, string.format('<font color="#%02X%02X%02X">%s</font>', r, g, b, escapeRichText(content)))
        else
            table.insert(parts, escapeRichText(content))
        end
    end

    return table.concat(parts)
end

function Library:Notify(message, duration, options)
    if self.Unloaded or self.NotificationsDisabled then
        return
    end

    notificationOrder += 1

    local align = Enum.TextXAlignment.Center
    local body = message

    if type(message) == "table" then
        if message.Align ~= nil then
            align = resolveTextAlign(message.Align)
        end

        if message.Duration ~= nil and duration == nil then
            duration = message.Duration
        end

        if message.Segments ~= nil then
            body = buildRichText(message.Segments)
        elseif message.Text ~= nil then
            if message.Color ~= nil then
                body = buildRichText({ { Text = message.Text, Color = message.Color } })
            else
                body = message.Text
            end
        else
            body = buildRichText(message)
        end
    end

    if type(options) == "table" then
        if options.Align ~= nil then
            align = resolveTextAlign(options.Align)
        end

        if options.Duration ~= nil and duration == nil then
            duration = options.Duration
        end
    elseif type(options) == "string" then
        align = resolveTextAlign(options)
    end

    local wrapper = frame(NotificationSizing, {
        AutomaticSize = Enum.AutomaticSize.XY,
        BackgroundTransparency = 1,
        ClipsDescendants = false,
        LayoutOrder = notificationOrder
    })

    table.insert(notificationQueue, wrapper)

    while #notificationQueue > 5 do
        local oldest = table.remove(notificationQueue, 1)

        if oldest and oldest.Parent then
            oldest:Destroy()
        end
    end

    local outer = frame(wrapper, {
        BackgroundColor3 = Theme.Border,
        AutomaticSize = Enum.AutomaticSize.XY
    })

    bindTheme(outer, "BackgroundColor3", "Border")

    new("UIPadding", {
        PaddingTop = UDim.new(0, 1),
        PaddingBottom = UDim.new(0, 1),
        PaddingLeft = UDim.new(0, 1),
        PaddingRight = UDim.new(0, 1)
    }, outer)

    local inner = frame(outer, {
        BackgroundColor3 = Theme.Background,
        AutomaticSize = Enum.AutomaticSize.XY
    })

    bindTheme(inner, "BackgroundColor3", "Background")

    new("UIPadding", {
        PaddingTop = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 9),
        PaddingRight = UDim.new(0, 9)
    }, inner)

    local lineSide = align == Enum.TextXAlignment.Right

    local accentLine = frame(outer, {
        AnchorPoint = Vector2.new(lineSide and 1 or 0, 0),
        Position = UDim2.new(lineSide and 1 or 0, 0, 0, 0),
        Size = UDim2.new(0, 1, 1, 0),
        BackgroundColor3 = Theme.Accent,
        ZIndex = 2
    })

    bindTheme(accentLine, "BackgroundColor3", "Accent")

    local caption = text(inner, body, {
        AutomaticSize = Enum.AutomaticSize.XY,
        RichText = true,
        TextWrapped = true,
        TextXAlignment = align,
        TextYAlignment = Enum.TextYAlignment.Center
    })

    new("UISizeConstraint", {
        MaxSize = Vector2.new(240, math.huge)
    }, caption)

    task.defer(function()
        for _ = 1, 6 do
            task.wait()
            if outer.AbsoluteSize.Y > 0 then
                break
            end
        end

        if not wrapper.Parent then
            return
        end

        local width = math.max(outer.AbsoluteSize.X, 1)
        local height = math.max(outer.AbsoluteSize.Y, 1)

        wrapper.AutomaticSize = Enum.AutomaticSize.None
        wrapper.Size = UDim2.fromOffset(width, 0)
        wrapper.ClipsDescendants = true
        wrapper.Parent = NotificationHolder

        tween(wrapper, {
            Size = UDim2.fromOffset(width, height)
        }, 0.16)

        task.delay(duration or 3, function()
            if not wrapper.Parent then
                return
            end

            accentLine.Visible = false

            local animation = tween(wrapper, {
                Size = UDim2.fromOffset(width, 0)
            }, 0.15)

            if animation then
                animation.Completed:Wait()
            end

            if wrapper.Parent then
                local index = table.find(notificationQueue, wrapper)

                if index then
                    table.remove(notificationQueue, index)
                end

                wrapper:Destroy()
            end
        end)
    end)
end

