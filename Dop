local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(Library.Connections, connection)
    return connection
end

local function call(callback, ...)
    if type(callback) ~= "function" then
        return
    end

    local args = table.pack(...)

    task.spawn(function()
        local ok, err = pcall(function()
            callback(table.unpack(args, 1, args.n))
        end)

        if not ok then
            warn("[Dopamine] " .. tostring(err))
        end
    end)
end

-- Molto icon provider (https://molto.pages.dev). Loaded lazily and used only
-- for the per-element cog icon; degrades to no icon if the fetch fails. Molto's
-- functions may be exposed as regular functions or as methods, so each call is
-- tried both ways (dot first, then colon) and the first that does not error wins.
local MoltoIcons

local function callBoth(tableRef, key, ...)
    if type(tableRef[key]) ~= "function" then
        return false
    end

    if pcall(tableRef[key], ...) then
        return true
    end

    return pcall(tableRef[key], tableRef, ...)
end

local function getIcons()
    if MoltoIcons ~= nil then
        return MoltoIcons or nil
    end

    local ok, result = pcall(function()
        local src = game:HttpGet("https://molto.pages.dev/source.lua")
        local fn = loadstring(src)
        return fn and fn()
    end)

    if ok and type(result) == "table" and result.SetIcon then
        callBoth(result, "SetProvider", "fluent")
        callBoth(result, "PreloadAsync", { "settings-32-filled" })
        MoltoIcons = result
        return result
    end

    MoltoIcons = false
    return nil
end

-- Apply a Molto icon to a GuiObject. Returns true on success, false if the
-- provider is unavailable so the caller can fall back gracefully.
local function setIcon(object, name, size)
    local icons = getIcons()

    if not icons then
        return false
    end

    if size then
        object.Size = UDim2.fromOffset(size, size)
    end

    if callBoth(icons, "SetIcon", object, name) then
        return true
    end

    callBoth(icons, "PreloadAsync", { name })
    return callBoth(icons, "SetIcon", object, name)
end

-- Per-element keybinds created from the cog settings panel. Each entry is
-- { Key, Mode, Activate, State }. The input handlers below dispatch presses to
-- the matching entry based on its mode (Toggle / Hold / Always).
Library.ElementKeybinds = {}

connect(UIS.InputBegan, function(input, processed)
    if Library.CapturingElementKey or processed or UIS:GetFocusedTextBox() then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    for _, entry in ipairs(Library.ElementKeybinds) do
        if entry.Key == input.KeyCode and entry.Key ~= Enum.KeyCode.Unknown then
            if entry.Mode == "Toggle" then
                entry.State = not entry.State
                call(entry.Activate, entry.State)
            elseif entry.Mode == "Hold" then
                entry.State = true
                call(entry.Activate, true)
            elseif entry.Mode == "Always" then
                call(entry.Activate, true, entry.Key, entry.Mode)
            end
        end
    end
end)

connect(UIS.InputEnded, function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    for _, entry in ipairs(Library.ElementKeybinds) do
        if entry.Key == input.KeyCode and entry.Mode == "Hold" and entry.State then
            entry.State = false
            call(entry.Activate, false)
        end
    end
end)

local function new(class, properties, parent)
    local object = Instance.new(class)

    for key, value in pairs(properties or {}) do
        if key ~= "Parent" then
            object[key] = value
        end
    end

    if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
        Library.FontObjects[object] = true

        if Library.FontFace then
            object.FontFace = Library.FontFace
        else
            object.Font = Library.Font
        end
    end

    object.Parent = parent or (properties and properties.Parent)
    return object
end

local function bindTheme(object, property, key)
    table.insert(Library.ThemeBindings, {
        Object = object,
        Property = property,
        Key = key
    })

    object[property] = Theme[key]
    return object
end

-- Derived theme binding: a function that recomputes a value that depends on a
-- Theme key (for example a toggle's active gradient, which is a ColorSequence
-- built from Theme.Accent rather than a direct Theme key). `anchor` is any
-- instance owned by the component so the callback is pruned when it is destroyed.
local function bindThemeCallback(anchor, callback)
    table.insert(Library.ThemeCallbacks, {
        Anchor = anchor,
        Fn = callback
    })

    pcall(callback)
    return callback
end

local function updateTheme()
    for index = #Library.ThemeBindings, 1, -1 do
        local binding = Library.ThemeBindings[index]

        if not binding.Object.Parent then
            table.remove(Library.ThemeBindings, index)
        else
            pcall(function()
                binding.Object[binding.Property] = Theme[binding.Key]
            end)
        end
    end

    for index = #Library.ThemeCallbacks, 1, -1 do
        local entry = Library.ThemeCallbacks[index]

        if entry.Anchor and not entry.Anchor.Parent then
            table.remove(Library.ThemeCallbacks, index)
        else
            pcall(entry.Fn)
        end
    end

    if Library.RefreshTheme then
        Library:RefreshTheme()
    end
end

function Library:SetTheme(key, color)
    if Theme[key] == nil or typeof(color) ~= "Color3" then
        return false
    end

    Theme[key] = color
    updateTheme()
    return true
end

local function tween(object, properties, duration)
    local ok, result = pcall(function()
        local animation = TweenService:Create(
            object,
            TweenInfo.new(
                duration or 0.14,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            properties
        )

        animation:Play()
        return animation
    end)

    return ok and result or nil
end

local function frame(parent, properties)
    properties = properties or {}
    properties.BorderSizePixel = 0
    return new("Frame", properties, parent)
end

local function text(parent, value, properties)
    properties = properties or {}
    properties.BackgroundTransparency = 1
    properties.Text = tostring(value or "")
    properties.TextSize = properties.TextSize or 12
    properties.TextColor3 = properties.TextColor3 or Theme.Text
    properties.TextStrokeColor3 = Color3.new(0, 0, 0)
    properties.TextStrokeTransparency = properties.TextStrokeTransparency or 0.3
    properties.TextXAlignment = properties.TextXAlignment or Enum.TextXAlignment.Left
    properties.TextYAlignment = properties.TextYAlignment or Enum.TextYAlignment.Center
    properties.TextTruncate = properties.TextTruncate or Enum.TextTruncate.AtEnd

    local object = new("TextLabel", properties, parent)
    bindTheme(object, "TextColor3", "Text")
    return object
end

local function border(parent, colorKey)
    local stroke = new("UIStroke", {
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Thickness = 1,
        Color = Theme[colorKey or "Border"]
    }, parent)

    bindTheme(stroke, "Color", colorKey or "Border")
    return stroke
end

local function gradient(parent, top, bottom)
    return new("UIGradient", {
        Rotation = 90,
        Color = ColorSequence.new(top, bottom)
    }, parent)
end

local function isClick(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

local function pointerOver(object, position)
    if not object or not object.Parent or not object.Visible then
        return false
    end

    local pos = object.AbsolutePosition
    local size = object.AbsoluteSize

    return position.X >= pos.X
        and position.Y >= pos.Y
        and position.X <= pos.X + size.X
        and position.Y <= pos.Y + size.Y
end

local function draggable(handle, target)
    local dragging = false
    local startInput
    local startPosition

    connect(handle.InputBegan, function(input)
        if isClick(input) then
            dragging = true
            startInput = input.Position
            startPosition = target.Position
        end
    end)

    connect(UIS.InputChanged, function(input)
        if dragging and isMove(input) then
            local delta = input.Position - startInput

            target.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end)

    connect(UIS.InputEnded, function(input)
        if isClick(input) then
            dragging = false
        end
    end)
end

local function folders()
    if not isfolder or not makefolder then
        return false, "Filesystem APIs unavailable"
    end

    return pcall(function()
        if not isfolder("Dopamine") then
            makefolder("Dopamine")
        end

        if not isfolder("Dopamine/fonts") then
            makefolder("Dopamine/fonts")
        end

        if not isfolder("Dopamine/configs") then
            makefolder("Dopamine/configs")
        end

        if not isfolder("Dopamine/assets") then
            makefolder("Dopamine/assets")
        end

        if not isfolder("Dopamine/themes") then
            makefolder("Dopamine/themes")
        end
    end)
end

-- Resolve a background source to an Image property Roblox can actually render.
-- Roblox ImageLabels cannot load arbitrary external URLs directly, so http(s)
-- URLs are downloaded once via HttpGet, written to the workspace and registered
-- with getcustomasset. Asset ids and rbxasset:// strings pass through unchanged.
local BackgroundCache = {}

local function resolveAsset(source)
    if source == nil then
        return nil
    end

    if type(source) == "number" then
        return "rbxassetid://" .. source
    end

    if type(source) ~= "string" then
        return nil
    end

    if source:match("^rbxassetid://") or source:match("^rbxasset://") then
        return source
    end

    if tonumber(source) then
        return "rbxassetid://" .. source
    end

    if not source:match("^https?://") then
        return nil
    end

    if BackgroundCache[source] then
        return BackgroundCache[source]
    end

    if not isfile or not writefile or not getcustomasset then
        return nil
    end

    local ok, result = pcall(function()
        local folderOk, folderError = folders()
        assert(folderOk, tostring(folderError))

        local ext = source:match("%.([%w]+)[?#]?[^/]*$") or "png"
        if not ext:match("^[%w]+$") then
            ext = "png"
        end
        local hash = source:gsub("%W", "")
        hash = hash:sub(1, 40)
        local path = "Dopamine/assets/bg_" .. hash .. "." .. ext

        if not isfile(path) then
            local data = game:HttpGet(source)
            assert(type(data) == "string" and #data > 256, "Invalid image download")
            writefile(path, data)
        end

        local asset = getcustomasset(path)
        assert(asset and asset ~= "", "Asset registration failed")
        return asset
    end)

    if ok and result then
        BackgroundCache[source] = result
        return result
    end

    return nil
end

local function cleanName(value)
    local name = tostring(value or "")
    name = name:gsub("^%s+", ""):gsub("%s+$", "")
    name = name:gsub("[^%w_%- ]", ""):sub(1, 48)

    return name ~= "" and name or nil
end

function Library:GetFontNames()
    local result = {}

    for _, entry in ipairs(self.Fonts) do
        table.insert(result, entry.Name)
    end

    return result
end

function Library:SetFont(name)
    local entry

    for _, item in ipairs(self.Fonts) do
        if item.Name == name then
            entry = item
            break
        end
    end

    if not entry then
        return false, "Unknown font"
    end

    local face

    if entry.File then
        face = self.LoadedFonts[name]

        if not face then
            if not isfile or not writefile or not getcustomasset then
                return false, "Custom asset APIs unavailable"
            end

            local ok, result = pcall(function()
                local folderOk, folderError = folders()
                assert(folderOk, tostring(folderError))

                local path = "Dopamine/fonts/" .. entry.File
                local descriptorPath = path .. ".font"

                if not isfile(path) then
                    local encoded = entry.File:gsub(" ", "%%20")
                    local url = "https://github.com/i77lhm/storage/raw/refs/heads/main/fonts/" .. encoded
                    local data = game:HttpGet(url)

                    assert(type(data) == "string" and #data > 1024, "Invalid font download")
                    writefile(path, data)
                end

                local asset = getcustomasset(path)
                assert(asset and asset ~= "", "Font registration failed")

                local descriptor = HttpService:JSONEncode({
                    name = entry.Name,
                    faces = {
                        {
                            name = "Regular",
                            weight = 400,
                            style = "normal",
                            assetId = asset
                        }
                    }
                })

                if isfile(descriptorPath) and delfile then
                    delfile(descriptorPath)
                end

                writefile(descriptorPath, descriptor)

                return Font.new(
                    getcustomasset(descriptorPath),
                    Enum.FontWeight.Regular,
                    Enum.FontStyle.Normal
                )
            end)

            if not ok then
                return false, tostring(result)
            end

            face = result
            self.LoadedFonts[name] = face
        end
    end

    if self.Unloaded then
        return false, "Library unloaded"
    end

    self.FontFace = face
    self.FontName = name

    for object in pairs(self.FontObjects) do
        local ok = pcall(function()
            if face then
                object.FontFace = face
            else
                object.Font = self.Font
            end
        end)

        if not ok then
            self.FontObjects[object] = nil
        end
    end

    return true
end

local function registerFlag(flag, default, setter)
    if not flag then
        return
    end

    Library.Defaults[flag] = default
    Library.Setters[flag] = setter
end

function Library:GetConfig()
    local ok, result = pcall(function()
        return HttpService:JSONEncode(self.Flags)
    end)

    return ok and result or nil, ok and nil or tostring(result)
end

function Library:LoadConfig(data)
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(data)
    end)

    if not ok or type(decoded) ~= "table" then
        return false, "Invalid config"
    end

    local errors = {}

    for flag, value in pairs(decoded) do
        local setter = self.Setters[flag]

        if setter then
            local success, err = pcall(setter, value)

            if not success then
                table.insert(errors, tostring(flag) .. ": " .. tostring(err))
            end
        end
    end

    return #errors == 0, #errors > 0 and table.concat(errors, "; ") or nil
end

function Library:SaveConfig(name)
    name = cleanName(name)

    if not name then
        return false, "Enter a config name"
    end

    if not writefile then
        return false, "writefile unavailable"
    end

    local ok, err = folders()

    if not ok then
        return false, tostring(err)
    end

    local data, encodeError = self:GetConfig()

    if not data then
        return false, encodeError
    end

    local success, result = pcall(writefile, "Dopamine/configs/" .. name .. ".json", data)
    return success, success and nil or tostring(result)
end

function Library:LoadConfigFile(name)
    name = cleanName(name)

    if not name then
        return false, "Select a config"
    end

    if not isfile or not readfile then
        return false, "File APIs unavailable"
    end

    local path = "Dopamine/configs/" .. name .. ".json"

    if not isfile(path) then
        return false, "Config not found"
    end

    local ok, result = pcall(readfile, path)

    if not ok then
        return false, tostring(result)
    end

    return self:LoadConfig(result)
end

function Library:DeleteConfig(name)
    name = cleanName(name)

    if not name or not isfile or not delfile then
        return false, "Config or file API unavailable"
    end

    local path = "Dopamine/configs/" .. name .. ".json"

    if not isfile(path) then
        return false, "Config not found"
    end

    local ok, err = pcall(delfile, path)
    return ok, ok and nil or tostring(err)
end

function Library:GetConfigs()
    if not listfiles then
        return {}
    end

    local ok = folders()

    if not ok then
        return {}
    end

    local success, files = pcall(listfiles, "Dopamine/configs")

    if not success then
        return {}
    end

    local result = {}

    for _, path in ipairs(files) do
        local name = tostring(path):match("([^/\\]+)%.json$")

        if name then
            table.insert(result, name)
        end
    end

    table.sort(result)
    return result
end

function Library:SetAutoload(name)
