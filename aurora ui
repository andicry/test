            Library.BlurEffect.Size = Library.BlurSize;
        end

        Library:RefreshWeatherEffect()
        Library:RefreshCustomCursor()
        Library:RefreshLogo()
    end

    if Library.IsMobile then
        -- Every mobile button gets its own holder parented straight to the ScreenGui,
        -- so dragging one never moves the others. Holders are auto-placed left to
        -- right from the top-left corner and wrap once they run out of room.
        local ButtonPadding = 14;
        local ButtonHeight = 56;
        local NextX, NextY = 12, 12;
        local RowHeight = 0;

        local function GetViewport()
            return workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720);
        end;

        local function ClampToViewport(Width, Height, X, Y)
            local Viewport = GetViewport();

            return math.clamp(X, 0, math.max(0, Viewport.X - Width)),
                math.clamp(Y, 0, math.max(0, Viewport.Y - Height));
        end;

        local function CreateMobileButton(Text, Width, Callback)
            local ButtonWidth = Width + 44;
            local Viewport = GetViewport();

            if NextX > 12 and NextX + ButtonWidth > Viewport.X - 12 then
                NextX = 12;
                NextY = NextY + RowHeight + ButtonPadding;
                RowHeight = 0;
            end;

            local PlaceX, PlaceY = ClampToViewport(ButtonWidth, ButtonHeight, NextX, NextY);

            NextX = NextX + ButtonWidth + ButtonPadding;
            RowHeight = math.max(RowHeight, ButtonHeight);

            local Holder = Library:Create('Frame', {
                BackgroundTransparency = 1;
                BorderSizePixel = 0;
                Position = UDim2.fromOffset(PlaceX, PlaceY);
                Size = UDim2.fromOffset(ButtonWidth, ButtonHeight);
                ZIndex = 100;
                Parent = ScreenGui;
            });

            local Button = Library:Create('TextButton', {
                AutoButtonColor = false;
                BackgroundColor3 = Library.MainColor;
                BorderColor3 = Library.OutlineColor;
                Size = UDim2.fromScale(1, 1);
                Text = Text;
                TextColor3 = Library.FontColor;
                TextSize = 17;
                Font = Library.Font;
                ZIndex = 102;
                Parent = Holder;
            });

            Library:AddToRegistry(Button, {
                BackgroundColor3 = 'MainColor';
                BorderColor3 = 'OutlineColor';
                TextColor3 = 'FontColor';
            }, true);

            Library:CreateGlow(Button, {
                Color = Library.AccentColor;
                Transparency = 0.35;
                Size = 24;
                ZIndex = 100;
            });

            local PressPosition = nil;
            local StartPosition = nil;
            local Dragging = false;
            local Moved = false;
            local ActiveInput = nil;
            local IgnoreMouseUntil = 0;

            local function MoveTo(Input)
                local X, Y = Library:GetInputPosition(Input);
                local Delta = Vector2.new(X, Y) - PressPosition;

                if Delta.Magnitude >= 5 then
                    Moved = true;
                end;

                local TargetX, TargetY = ClampToViewport(
                    Holder.AbsoluteSize.X,
                    Holder.AbsoluteSize.Y,
                    StartPosition.X.Offset + Delta.X,
                    StartPosition.Y.Offset + Delta.Y
                );

                Holder.Position = UDim2.new(
                    StartPosition.X.Scale,
                    TargetX,
                    StartPosition.Y.Scale,
                    TargetY
                );
            end;

            Button.InputBegan:Connect(function(Input)
                if not Library:IsPrimaryInput(Input) then
                    return;
                end;

                if Input.UserInputType == Enum.UserInputType.MouseButton1 and os.clock() < IgnoreMouseUntil then
                    return;
                end;

                local X, Y = Library:GetInputPosition(Input);
                PressPosition = Vector2.new(X, Y);
                StartPosition = Holder.Position;
                Dragging = true;
                Moved = false;
                ActiveInput = Input;

                -- Release is tracked on the input object itself so a drag that ends
                -- off the button still resets cleanly.
                local StateConnection;
                StateConnection = Input:GetPropertyChangedSignal('UserInputState'):Connect(function()
                    if Input.UserInputState ~= Enum.UserInputState.End
                        and Input.UserInputState ~= Enum.UserInputState.Cancel then
                        return;
                    end;

                    StateConnection:Disconnect();

                    if ActiveInput ~= Input then
                        return;
                    end;

                    local Ended = Input.UserInputState == Enum.UserInputState.End;

                    Dragging = false;
                    ActiveInput = nil;

                    if Input.UserInputType == Enum.UserInputType.Touch then
                        IgnoreMouseUntil = os.clock() + 0.5;
                    end;

                    if Ended and not Moved and Library:IsMouseOverFrame(Holder, Input) then
                        Callback(Button);
                    end;
                end);
            end);

            Button.InputChanged:Connect(function(Input)
                if not Dragging then
                    return;
                end;

                if Input.UserInputType == Enum.UserInputType.MouseMovement then
                    MoveTo(Input);
                elseif Input.UserInputType == Enum.UserInputType.Touch and Input == ActiveInput then
                    MoveTo(Input);
                end;
            end);

            Library:GiveSignal(InputService.InputChanged:Connect(function(Input)
                if not Dragging or not ActiveInput or ActiveInput.UserInputType ~= Enum.UserInputType.Touch
                    or Input ~= ActiveInput then
                    return;
                end;

                MoveTo(Input);
            end));

            table.insert(Library.MobileButtons, {
                Button = Button;
                Holder = Holder;
            });

            return Button;
        end;

        CreateMobileButton('Toggle UI', 76, function()
            Library:Toggle();
        end);

        CreateMobileButton('Lock', 58, function(Button)
            local Locked = not Outer:GetAttribute('AuroraDragLocked');
            Outer:SetAttribute('AuroraDragLocked', Locked);
            Button.Text = Locked and 'Unlock' or 'Lock';
        end);

        function Library:CreateMobileButton(Text, Width, Callback)
            return CreateMobileButton(Text, Width, Callback);
        end;

        -- A rotation can leave a button parked past the new edge, so every holder is
        -- pulled back inside the viewport whenever it changes.
        local Camera = workspace.CurrentCamera;

        if Camera then
            Library:GiveSignal(Camera:GetPropertyChangedSignal('ViewportSize'):Connect(function()
                for _, Record in next, Library.MobileButtons do
                    local Holder = Record.Holder;

                    if Holder and Holder.Parent then
                        local Position = Holder.Position;
                        local TargetX, TargetY = ClampToViewport(
                            Holder.AbsoluteSize.X,
                            Holder.AbsoluteSize.Y,
                            Position.X.Offset,
                            Position.Y.Offset
                        );

                        Holder.Position = UDim2.new(Position.X.Scale, TargetX, Position.Y.Scale, TargetY);
                    end;
                end;
            end));
        end;
    end

    Library:GiveSignal(InputService.InputBegan:Connect(function(Input, Processed)
        if Library:IsTyping() then
            return;
        end;

        if type(Library.ToggleKeybind) == 'table' and Library.ToggleKeybind.Type == 'KeyPicker' then
            if Input.UserInputType == Enum.UserInputType.Keyboard and Input.KeyCode.Name == Library.ToggleKeybind.Value then
                task.spawn(Library.Toggle)
            end
        elseif Input.KeyCode == Enum.KeyCode.RightControl or (Input.KeyCode == Enum.KeyCode.RightShift and (not Processed)) then
            task.spawn(Library.Toggle)
        end
    end))

    if Config.AutoShow then task.spawn(Library.Toggle) end

    Window.Holder = Outer;

    return Window;
end;

