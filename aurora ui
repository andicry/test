function Library:MakeDraggable(Instance, Cutoff, DragHandle)
    Instance.Active = true;
    DragHandle = DragHandle or Instance;
    DragHandle.Active = true;

    local DragPreview = Library:Create('Frame', {
        AnchorPoint = Instance.AnchorPoint;
        BackgroundColor3 = Library.AccentColor;
        BackgroundTransparency = 0.82;
        BorderColor3 = Library.AccentColor;
        BorderSizePixel = 1;
        Position = Instance.Position;
        Size = Instance.Size;
        Visible = false;
        ZIndex = 1000;
        Parent = ScreenGui;
    });

    Library:AddToRegistry(DragPreview, {
        BackgroundColor3 = 'AccentColor';
        BorderColor3 = 'AccentColor';
    }, true);

    local Dragging = false;
    local DragInput = nil;
    local ObjectOffset = nil;
    local InputChangedConnection = nil;
    local StateConnection = nil;

    local function StopDragging()
        if not Dragging then
            return;
        end;

        Dragging = false;
        DragInput = nil;

        if InputChangedConnection then
            InputChangedConnection:Disconnect();
            InputChangedConnection = nil;
        end;

        if StateConnection then
            StateConnection:Disconnect();
            StateConnection = nil;
        end;

        if DragPreview.Parent then
            Instance.Position = DragPreview.Position;
            DragPreview.Visible = false;
        end;
    end;

    DragHandle.InputBegan:Connect(function(Input)
        if Instance:GetAttribute('AuroraDragLocked') or not Library:IsPrimaryInput(Input) then
            return;
        end;

        if Library.IsMobile and not Library.CanDrag then
            return;
        end;

        local StartX, StartY = Library:GetInputPosition(Input);
        ObjectOffset = Vector2.new(
            StartX - Instance.AbsolutePosition.X,
            StartY - Instance.AbsolutePosition.Y
        );

        if ObjectOffset.Y > (Cutoff or 40) then
            return;
        end;

        for Frame in next, Library.OpenedFrames do
            Frame.Visible = false;
            Library.OpenedFrames[Frame] = nil;
        end;

        DragPreview.Size = Instance.Size;
        DragPreview.Position = Instance.Position;
        DragPreview.AnchorPoint = Instance.AnchorPoint;
        DragPreview.Visible = true;

        Dragging = true;
        DragInput = Input;

        StateConnection = Input:GetPropertyChangedSignal('UserInputState'):Connect(function()
            if Input.UserInputState == Enum.UserInputState.End
                or Input.UserInputState == Enum.UserInputState.Cancel then
                StopDragging();
            end;
        end);

        InputChangedConnection = InputService.InputChanged:Connect(function(ChangedInput)
            if not Dragging or not DragPreview.Parent then
                return;
            end;

            local IsMouseMove = DragInput.UserInputType == Enum.UserInputType.MouseButton1
                and ChangedInput.UserInputType == Enum.UserInputType.MouseMovement;
            local IsTouchMove = DragInput.UserInputType == Enum.UserInputType.Touch
                and ChangedInput.UserInputType == Enum.UserInputType.Touch
                and ChangedInput == DragInput;

            if not IsMouseMove and not IsTouchMove then
                return;
            end;

            local X, Y = Library:GetInputPosition(ChangedInput);
            DragPreview.Position = UDim2.new(
                0,
                X - ObjectOffset.X + Instance.AbsoluteSize.X * Instance.AnchorPoint.X,
                0,
                Y - ObjectOffset.Y + Instance.AbsoluteSize.Y * Instance.AnchorPoint.Y
            );
        end);
    end);
end;

function Library:AddToolTip(InfoStr, HoverInstance)
    -- Tooltips follow the mouse cursor, which does not exist on touch: MouseEnter
    -- still fires from a tap and would strand the tooltip at a stale position.
    if Library.IsMobile then
        return;
    end;

    local X, Y = Library:GetTextBounds(InfoStr, Library.Font, 14);
    local Tooltip = Library:Create('Frame', {
        BackgroundColor3 = Library.MainColor,
        BorderColor3 = Library.OutlineColor,

        Size = UDim2.fromOffset(X + 5, Y + 4),
        ZIndex = 100,
        Parent = Library.ScreenGui,

        Visible = false,
    })

    local Label = Library:CreateLabel({
        Position = UDim2.fromOffset(3, 1),
        Size = UDim2.fromOffset(X, Y);
        TextSize = 11;
        Text = InfoStr,
        TextColor3 = Library.FontColor,
        TextXAlignment = Enum.TextXAlignment.Left;
        ZIndex = Tooltip.ZIndex + 1,

        Parent = Tooltip;
    });

    Library:AddToRegistry(Tooltip, {
        BackgroundColor3 = 'MainColor';
        BorderColor3 = 'OutlineColor';
    });

    Library:AddToRegistry(Label, {
        TextColor3 = 'FontColor',
    });

    local IsHovering = false

    HoverInstance.MouseEnter:Connect(function()
        if Library:MouseIsOverOpenedFrame() then
            return
        end

        IsHovering = true

        Tooltip.Position = UDim2.fromOffset(Mouse.X + 15, Mouse.Y + 12)
        Tooltip.Visible = true

        while IsHovering do
            RunService.Heartbeat:Wait()
            Tooltip.Position = UDim2.fromOffset(Mouse.X + 15, Mouse.Y + 12)
        end
    end)

    HoverInstance.MouseLeave:Connect(function()
        IsHovering = false
        Tooltip.Visible = false
    end)
end

function Library:OnHighlight(HighlightInstance, Instance, Properties, PropertiesDefault)
    HighlightInstance.MouseEnter:Connect(function()
        local Reg = Library.RegistryMap[Instance];

        for Property, ColorIdx in next, Properties do
            Instance[Property] = Library[ColorIdx] or ColorIdx;

            if Reg and Reg.Properties[Property] then
                Reg.Properties[Property] = ColorIdx;
            end;
        end;
    end)

    HighlightInstance.MouseLeave:Connect(function()
        local Reg = Library.RegistryMap[Instance];

        for Property, ColorIdx in next, PropertiesDefault do
            Instance[Property] = Library[ColorIdx] or ColorIdx;

            if Reg and Reg.Properties[Property] then
                Reg.Properties[Property] = ColorIdx;
            end;
        end;
    end)
end;

function Library:GetPointerPosition(Input)
    if Library.IsMobile and Input and Input.Position then
        return Input.Position.X, Input.Position.Y;
    end;

    return Mouse.X, Mouse.Y;
end;

--// Every opened list, picker and mode select is parented to the ScreenGui rather than to the
--// window, so hiding the window on its own leaves them floating over the game. Where the owner
--// handed over a closer it is stored as the OpenedFrames value, so state like suspended dragging
--// or a captured search box unwinds instead of the frame just going invisible.
function Library:CloseOpenedFrames()
    for Frame, Closer in next, Library.OpenedFrames do
        Library.OpenedFrames[Frame] = nil;

        if type(Closer) == 'function' then
            pcall(Closer);
        else
            Frame.Visible = false;
        end;
    end;
end;

function Library:MouseIsOverOpenedFrame(Input)
    local PointerX, PointerY = Library:GetPointerPosition(Input);

    for Frame, _ in next, Library.OpenedFrames do
        local AbsPos, AbsSize = Frame.AbsolutePosition, Frame.AbsoluteSize;

        if PointerX >= AbsPos.X and PointerX <= AbsPos.X + AbsSize.X
            and PointerY >= AbsPos.Y and PointerY <= AbsPos.Y + AbsSize.Y then

            return true;
        end;
    end;
end;

function Library:IsMouseOverFrame(Frame, Input)
    local PointerX, PointerY = Library:GetPointerPosition(Input);
    local AbsPos, AbsSize = Frame.AbsolutePosition, Frame.AbsoluteSize;

    if PointerX >= AbsPos.X and PointerX <= AbsPos.X + AbsSize.X
        and PointerY >= AbsPos.Y and PointerY <= AbsPos.Y + AbsSize.Y then

        return true;
    end;
end;

function Library:SetAncestorScrollingEnabled(Instance, Bool)
    local Node = Instance;

    while Node and Node ~= ScreenGui do
        if Node:IsA('ScrollingFrame') then
            Node.ScrollingEnabled = Bool;
        end;

        Node = Node.Parent;
    end;
end;

function Library:SuspendDragging()
    if Library.IsMobile then
        Library.CanDrag = false;
    end;
end;

function Library:ResumeDragging()
    if Library.IsMobile then
        Library.CanDrag = true;
    end;
end;

-- Scrolling a tab side must not also drag the window; hold dragging off for a
-- short window after the last CanvasPosition change.
function Library:NotifyScrolling()
    if not Library.IsMobile then
        return;
    end;

    local Token = tick();
    Library.ScrollToken = Token;
    Library.CanDrag = false;

    task.delay(0.15, function()
        if Library.ScrollToken == Token then
            Library.CanDrag = true;
        end;
    end);
end;

function Library:UpdateDependencyBoxes()
    for _, Depbox in next, Library.DependencyBoxes do
        Depbox:Update();
    end;
end;

function Library:MapValue(Value, MinA, MaxA, MinB, MaxB)
    return (1 - ((Value - MinA) / (MaxA - MinA))) * MinB + ((Value - MinA) / (MaxA - MinA)) * MaxB;
end;

function Library:GetTextBounds(Text, Font, Size, Resolution)
    local ScaleX = Library.FontScaleX;
    local ScaleY = Library.FontScaleY;
    local Frame = Resolution or Vector2.new(1920, 1080);

    --// The wrap width is in real-font pixels, so it has to come back to Arial pixels before
    --// the Arial measurement wraps on it, or a wider face would be measured as wrapping late.
    if ScaleX > 0 and ScaleX ~= 1 then
        Frame = Vector2.new(Frame.X / ScaleX, Frame.Y);
    end;

    local Bounds = TextService:GetTextSize(Text, Size, Font or Library.Font, Frame)
    return Bounds.X * ScaleX, Bounds.Y * ScaleY
end;

function Library:GetDarkerColor(Color)
    local H, S, V = Color3.toHSV(Color);
    return Color3.fromHSV(H, S, V / 1.5);
end;
Library.AccentColorDark = Library:GetDarkerColor(Library.AccentColor);


