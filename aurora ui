--// Rotating centre logo. The ScreenGui is on Global ZIndexBehavior and the window is centred
--// and opaque, so anything drawn under it at dead centre is invisible no matter how large it is;
--// the emblem therefore sits above the window chrome (which tops out at 204) but below the drag
--// preview at 1000 and the cursor. LogoTransparency is what keeps the menu readable through it.
--// The png is cached on disk because the cdn link is signed and the signature eventually expires.
local LOGO_URL = 'https://cdn.discordapp.com/attachments/1511840014089322647/1544386922623795220/5599fab38719bac72db84e9bd699307b.png?ex=6a9851e7&is=6a970067&hm=faaae230dd52f7725a849f9f11cbc93a2ff1c6cfd5a7b034e63b7ca38de7e34e&';
local LOGO_FILE = 'Aurora/logo.png';

local PNG_MAGIC = string.char(137, 80, 78, 71, 13, 10, 26, 10);

--// LogoDirect holds anything the engine resolves on its own -- an asset id, rbxassetid://,
--// rbxthumb:// -- and skips the disk cache entirely. LogoSource is the http link to download when
--// there is no direct image; SetLogoImage is what moves either off the shipped default.
local LogoSource = LOGO_URL;
local LogoDirect = nil;
local LogoAsset = nil;
local LogoTried = false;

local function IsPng(Data)
    return type(Data) == 'string' and #Data > 256 and Data:sub(1, 8) == PNG_MAGIC;
end

local function GetLogoAsset()
    if LogoDirect then
        return LogoDirect;
    end;

    if LogoAsset or LogoTried then
        return LogoAsset;
    end;

    --// One attempt per session; a dead link must not re-download on every menu open.
    LogoTried = true;

    if not (isfile and writefile and getcustomasset) then
        return nil;
    end;

    --// An expired signature answers with an error page, not an image, so the bytes are checked
    --// before they are trusted. Without this a single bad fetch gets written to disk and the logo
    --// stays broken for every later session even once the link is fixed.
    local Cached = false;

    if isfile(LOGO_FILE) then
        if readfile then
            local ReadOk, Existing = pcall(readfile, LOGO_FILE);

            Cached = ReadOk and IsPng(Existing);

            if (not Cached) and delfile then
                pcall(delfile, LOGO_FILE);
            end;
        else
            Cached = true;
        end;
    end;

    if not Cached then
        if not (isfolder and makefolder) then
            return nil;
        end;

        if not isfolder(FONT_ROOT) then
            makefolder(FONT_ROOT);
        end;

        local Ok, Data = pcall(game.HttpGet, game, LogoSource);

        if not (Ok and IsPng(Data)) then
            return nil;
        end;

        writefile(LOGO_FILE, Data);
    end;

    local AssetOk, Asset = pcall(getcustomasset, LOGO_FILE);

    if AssetOk then
        LogoAsset = Asset;
    end;

    return LogoAsset;
end

--// Shared by the close path and by the hold-time fade, so neither one leaves a dead entry
--// behind in Library.Signals when the menu is opened and closed repeatedly.
local function DestroyLogo()
    local Connection = Library._LogoConnection;

    if Connection then
        Connection:Disconnect();
        Library._LogoConnection = nil;

        for Idx, Signal in next, Library.Signals do
            if Signal == Connection then
                table.remove(Library.Signals, Idx);
                break;
            end;
        end;
    end;

    if Library._Logo then
        pcall(function() Library._Logo:Destroy(); end);
        Library._Logo = nil;
    end;
end

function Library:RefreshLogo()
    if not Library.LogoEnabled or not Library.IsOpen then
        DestroyLogo();

        return;
    end;

    if Library._LogoConnection then
        return;
    end;

    local Asset = GetLogoAsset();

    if not Asset then
        return;
    end;

    local Logo = Library:Create('ImageLabel', {
        AnchorPoint = Vector2.new(0.5, 0.5);
        BackgroundTransparency = 1;
        Image = Asset;
        ImageTransparency = 1;
        Position = UDim2.fromScale(0.5, 0.5);
        Size = UDim2.fromOffset(Library.LogoSize, Library.LogoSize);
        ZIndex = 950;
        Parent = ScreenGui;
    });

    Library._Logo = Logo;

    local Elapsed = 0;

    Library._LogoConnection = RenderStepped:Connect(function(Delta)
        if not Library.LogoEnabled or not Library.IsOpen or not ScreenGui.Parent then
            return;
        end;

        Elapsed = Elapsed + Delta;

        --// Not a flat spin. Scaling the width by the cosine of the turn angle narrows the emblem
        --// away to nothing as it comes edge-on and then opens it back out, which is the gif-style
        --// flip. Degrees per second off the real frame delta, so it turns at the same rate at 30 and
        --// at 300 fps.
        local Flip = math.abs(math.cos(math.rad(Elapsed * Library.LogoSpeed)));

        Logo.Size = UDim2.fromOffset(Library.LogoSize * Flip, Library.LogoSize);

        local Alpha = math.clamp(Elapsed / 0.35, 0, 1);

        --// LogoHoldTime 0 keeps it up for as long as the menu is open; anything higher turns it
        --// into a splash that fades back out once it has had its spin.
        if Library.LogoHoldTime > 0 and Elapsed > Library.LogoHoldTime then
            Alpha = math.clamp(1 - (Elapsed - Library.LogoHoldTime) / 0.45, 0, 1);
        end;

        if Alpha <= 0 then
            DestroyLogo();

            return;
        end;

        Logo.ImageTransparency = 1 - (Alpha * (1 - Library.LogoTransparency));
    end);

    table.insert(Library.Signals, Library._LogoConnection);
end;

function Library:SetLogoEnabled(Bool)
    Library.LogoEnabled = not not Bool;
    Library:RefreshLogo();
end;

--// Accepts a bare asset id, rbxassetid://123, any other rbx* url, a direct http(s) image link, or
--// the name of a file already sitting in the executor's workspace folder. An empty value puts the
--// shipped emblem back.
function Library:SetLogoImage(Value)
    LogoDirect = nil;
    LogoAsset = nil;
    LogoTried = false;

    --// Dropped on every call rather than only when a link is given: the cache is keyed by file name
    --// alone, so a download left over from a previous link would be served in place of whatever was
    --// just asked for -- including when the field is cleared back to the shipped emblem.
    if isfile and delfile and isfile(LOGO_FILE) then
        pcall(delfile, LOGO_FILE);
    end;

    if type(Value) == 'number' then
        Value = string.format('%d', Value);
    end;

    Value = type(Value) == 'string' and Value:match('^%s*(.-)%s*$') or '';

    local Id = Value:match('^(%d+)$') or Value:match('^rbxassetid://(%d+)$');

    if Id then
        LogoDirect = 'rbxassetid://' .. Id;
    elseif Value:match('^rbx') then
        LogoDirect = Value;
    elseif Value:match('^https?://') then
        --// The engine will not load an arbitrary host, so a link still goes through the download path.
        LogoSource = Value;
    elseif Value == '' then
        LogoSource = LOGO_URL;
    elseif getcustomasset then
        local Ok, Asset = pcall(getcustomasset, Value);

        if Ok then
            LogoDirect = Asset;
        end;
    end;

    --// Rebuilt rather than repainted, so a swap while the menu is open restarts the flip from a
    --// known angle instead of dropping the new image in halfway through the old one's turn.
    DestroyLogo();
    Library:RefreshLogo();
end;

--// Warmed in the background so the first menu open never has to sit through the download, and
--// so a menu that auto-shows before the png lands still picks it up.
task.spawn(function()
    if GetLogoAsset() then
        pcall(Library.RefreshLogo, Library);
    end;
end);

