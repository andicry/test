function Library:CreateWindow(...)
    local Arguments = { ... }
    local Config = { AnchorPoint = Vector2.zero }

    if type(...) == 'table' then
        Config = ...;
    else
        Config.Title = Arguments[1]
        Config.AutoShow = Arguments[2] or false;
    end

    if type(Config.Title) ~= 'string' then Config.Title = 'No title' end
    if type(Config.TabPadding) ~= 'number' then Config.TabPadding = 0 end
    local AutoPosition = typeof(Config.Position) ~= 'UDim2';
    if AutoPosition then Config.Position = UDim2.fromOffset(175, 50) end
    local MobileAutoSize = false;
    if typeof(Config.Size) ~= 'UDim2' then
        if Library.IsMobile then
            local Viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720);
            Config.Size = UDim2.fromOffset(
                math.clamp(math.floor(Viewport.X * 0.82), 360, 650),
                math.clamp(math.floor(Viewport.Y * 0.78), 280, 450)
            );
            MobileAutoSize = true;
        else
            Config.Size = UDim2.fromOffset(800, 585);
        end;
    end

    -- The desktop default corner would leave a phone-sized window hanging off the
    -- bottom right, so a window that was not given a position is centred instead.
    if Library.IsMobile and AutoPosition then
        Config.Center = true;
    end;

    if Config.Center then
        Config.AnchorPoint = Vector2.new(0.5, 0.5)
        Config.Position = UDim2.fromScale(0.5, 0.5)
    end

    local Window = {
        Tabs = {};
    };

    local Outer = Library:Create('Frame', {
        AnchorPoint = Config.AnchorPoint,
        BackgroundColor3 = Color3.new(0, 0, 0);
        BorderSizePixel = 0;
        Position = Config.Position,
        Size = Config.Size,
        Visible = false;
        ZIndex = 1;
        Parent = ScreenGui;
    });

    local ResizeHandle = Library:Create('Frame', {
        AnchorPoint = Vector2.new(1, 1);
        BackgroundTransparency = 1;
        BorderSizePixel = 0;
        Position = UDim2.new(1, 0, 1, 0);
        Size = Library.IsMobile and UDim2.fromOffset(32, 32) or UDim2.fromOffset(18, 18);
        ZIndex = 10;
        Parent = Outer;
    });

    ResizeHandle.Active = true;
    ResizeHandle.InputBegan:Connect(function(Input)
        if not Library:IsPrimaryInput(Input) then
            return;
        end;

        local StartX, StartY = Library:GetInputPosition(Input);
        local StartSize = Outer.AbsoluteSize;

        -- The desktop floor of 450x300 is wider than some phone screens, so on mobile the
        -- limits are pulled in to whatever the viewport can actually show and the window
        -- is also stopped from growing past the edge, where the handle is unreachable.
        local MinWidth, MinHeight = 450, 300;
        local MaxWidth, MaxHeight = math.huge, math.huge;

        if Library.IsMobile then
            local Viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720);
            MinWidth = math.min(MinWidth, math.max(280, Viewport.X - 20));
            MinHeight = math.min(MinHeight, math.max(200, Viewport.Y - 20));
            MaxWidth = math.max(MinWidth, Viewport.X);
            MaxHeight = math.max(MinHeight, Viewport.Y);
        end;

        local Resizing = true;
        local InputChangedConnection;
        local RenderConnection;
        local StateConnection;
        local LatestX = StartX;
        local LatestY = StartY;
        local LastWidth = StartSize.X;
        local LastHeight = StartSize.Y;
        local LastUpdate = 0;
        local ResizePreview = Library:Create('Frame', {
            AnchorPoint = Outer.AnchorPoint;
            BackgroundTransparency = 1;
            BorderColor3 = Library.AccentColor;
            BorderSizePixel = 1;
            Position = Outer.Position;
            Size = Outer.Size;
            ZIndex = 200;
            Parent = ScreenGui;
        });

        local function ApplyResize(Force)
            local Now = os.clock();
            if not Force and Now - LastUpdate < 1 / 30 then
                return;
            end;

            local NewWidth = math.clamp(StartSize.X + (LatestX - StartX), MinWidth, MaxWidth);
            local NewHeight = math.clamp(StartSize.Y + (LatestY - StartY), MinHeight, MaxHeight);
            if not Force and math.abs(NewWidth - LastWidth) < 2 and math.abs(NewHeight - LastHeight) < 2 then
                return;
            end;

            LastUpdate = Now;
            LastWidth = NewWidth;
            LastHeight = NewHeight;
            if Force then
                Outer.Size = UDim2.fromOffset(NewWidth, NewHeight);
            elseif ResizePreview then
                ResizePreview.Size = UDim2.fromOffset(NewWidth, NewHeight);
            end;
        end;

        StateConnection = Input:GetPropertyChangedSignal('UserInputState'):Connect(function()
            local Ended = Input.UserInputState == Enum.UserInputState.End;

            -- A touch can also end as Cancel, which used to leave the preview frame
            -- behind and the handler wired up forever.
            if Ended or Input.UserInputState == Enum.UserInputState.Cancel then
                Resizing = false;

                if Ended then
                    ApplyResize(true);
                end;

                if InputChangedConnection then
                    InputChangedConnection:Disconnect();
                end;
                if RenderConnection then
                    RenderConnection:Disconnect();
                end;
                if ResizePreview then
                    ResizePreview:Destroy();
                    ResizePreview = nil;
                end;
                StateConnection:Disconnect();
            end;
        end);

        InputChangedConnection = InputService.InputChanged:Connect(function(ChangedInput)
            if not Resizing then
                return;
            end;

            if ChangedInput.UserInputType == Enum.UserInputType.MouseMovement then
                LatestX, LatestY = Library:GetInputPosition(ChangedInput);
            elseif ChangedInput.UserInputType == Enum.UserInputType.Touch and ChangedInput == Input then
                LatestX, LatestY = Library:GetInputPosition(ChangedInput);
            end;
        end);

        RenderConnection = RenderStepped:Connect(function()
            if Resizing then
                ApplyResize(false);
            end;
        end);
    end);


