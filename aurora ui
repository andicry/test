    local Parts = {};
    local Items = Library.WatermarkItems or {};

    if Items.Title then
        table.insert(Parts, Library.WatermarkTitle or 'Aurora');
    end;

    if Items.User then
        table.insert(Parts, LocalPlayer and LocalPlayer.Name or 'Unknown');
    end;

    if Items.FPS then
        table.insert(Parts, string.format('%d FPS', math.floor(Library.WatermarkFPS + 0.5)));
    end;

    if Items.Ms then
        table.insert(Parts, string.format('%d ms', math.floor(Library.WatermarkPing + 0.5)));
    end;

    if Items.Date then
        table.insert(Parts, os.date('%d/%m/%Y'));
    end;

    if Items.Time then
        table.insert(Parts, os.date('%H:%M:%S'));
    end;

    if #Parts == 0 then
        table.insert(Parts, Library.WatermarkTitle or 'Aurora');
    end;

    return table.concat(Parts, ' | ');
end;

