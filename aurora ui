function Library:RefreshWeatherEffect()
    local Enabled = Library.IsOpen and Library.WeatherEffect ~= 'Off' and Library.WeatherAmount > 0;

    if Library.WeatherLayer then
        Library.WeatherLayer.Visible = Enabled;
    end;

    if not Enabled then
        Library:ClearWeatherParticles();
        return;
    end;

    local TargetCount = math.clamp(math.floor(Library.WeatherAmount), 0, 120);

    while #Library.WeatherParticles > TargetCount do
        local Particle = table.remove(Library.WeatherParticles);
        if Particle and Particle.Instance then
            Particle.Instance:Destroy();
        end;
    end;

    while #Library.WeatherParticles < TargetCount do
        local IsRain = Library.WeatherEffect == 'Rain';
        local Instance = Library:Create('Frame', {
            AnchorPoint = Vector2.new(0.5, 0.5);
            BackgroundColor3 = IsRain and Color3.fromRGB(120, 170, 255) or Color3.fromRGB(255, 255, 255);
            BorderSizePixel = 0;
            Size = IsRain and UDim2.fromOffset(2, 14) or UDim2.fromOffset(4, 4);
            Rotation = 0;
            ZIndex = 0;
            Parent = Library.WeatherLayer;
        });

        Library.WeatherParticles[#Library.WeatherParticles + 1] = {
            Instance = Instance;
            X = math.random();
            Y = -math.random();
            Speed = IsRain and (0.9 + math.random() * 1.1) or (0.12 + math.random() * 0.22);
            Drift = IsRain and 0 or ((math.random() - 0.5) * 0.03);
        };
    end;

    for _, Particle in next, Library.WeatherParticles do
        local IsRain = Library.WeatherEffect == 'Rain';
        Particle.Instance.BackgroundColor3 = IsRain and Color3.fromRGB(120, 170, 255) or Color3.fromRGB(255, 255, 255);
        Particle.Instance.Size = IsRain and UDim2.fromOffset(2, 14) or UDim2.fromOffset(4, 4);
        Particle.Instance.Rotation = 0;
        if IsRain then
            Particle.Speed = math.max(Particle.Speed, 0.9);
            Particle.Drift = 0;
        else
            Particle.Speed = math.min(Particle.Speed, 0.34);
        end;
    end;
end;

