        function KeyPicker:Update()
            if Info.NoUI then
                return;
            end;

            local State = KeyPicker:GetState();

            ContainerLabel.Text = string.format('[%s] %s (%s)', KeyDisplay(KeyPicker.Value), LabelText, KeyPicker.Mode or 'Toggle');

            ContainerLabel.Visible = true;
            ContainerLabel.TextColor3 = State and Library.AccentColor or Library.FontColor;

            Library.RegistryMap[ContainerLabel].Properties.TextColor3 = State and 'AccentColor' or 'FontColor';

            local YSize = 0
            local XSize = 0

            for _, Label in next, Library.KeybindContainer:GetChildren() do
                if Label:IsA('TextLabel') and Label.Visible then
                    YSize = YSize + 18;
                    if (Label.TextBounds.X > XSize) then
                        XSize = Label.TextBounds.X
                    end
                end;
            end;

            Library.KeybindFrame.Size = UDim2.new(0, math.max(XSize + 10, 210), 0, YSize + 23)
        end;

        function KeyPicker:GetState()
            if KeyPicker.Mode == 'Always' then
                return true;
            elseif KeyPicker.Mode == 'Hold' then
                if KeyPicker.Value == 'None' then
                    return false;
                end

                local Key = KeyPicker.Value;

                if Key == 'MB1' or Key == 'MB2' or Key == 'MB3' then
                    return Key == 'MB1' and InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
                        or Key == 'MB2' and InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
                        or Key == 'MB3' and InputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton3);
                else
                    return InputService:IsKeyDown(Enum.KeyCode[KeyPicker.Value]);
                end;
            else
                return KeyPicker.Toggled;
            end;
        end;

        function KeyPicker:SetValue(Data)
            local Key, Mode = Data[1], Data[2];
            DisplayLabel.Text = KeyDisplay(Key);
            KeyPicker.Value = Key;
            ModeButtons[Mode]:Select();
            KeyPicker:Update();
        end;

        function KeyPicker:OnClick(Callback)
            KeyPicker.Clicked = Callback
        end

        function KeyPicker:OnChanged(Callback)
            KeyPicker.Changed = Callback
            Callback(KeyPicker.Value)
        end

        if ParentObj.Addons then
            KeyPicker.PickOuter = PickOuter
            table.insert(ParentObj.Addons, KeyPicker)
        end

        function KeyPicker:DoClick()
            if ParentObj.Type == 'Toggle' and KeyPicker.SyncToggleState then
                ParentObj:SetValue(not ParentObj.Value)
            end

            Library:SafeCallback(KeyPicker.Callback, KeyPicker.Toggled)
            Library:SafeCallback(KeyPicker.Clicked, KeyPicker.Toggled)
        end

        local Picking = false;

        PickOuter.InputBegan:Connect(function(Input)
            -- On touch there is no key to rebind to, and the next tap anywhere would be
            -- captured as a nil key and wipe the bind, so touch never enters rebind mode.
            if Library:IsPrimaryInput(Input)
                and not (Library.IsMobile and Input.UserInputType == Enum.UserInputType.Touch)
                and not Library:MouseIsOverOpenedFrame(Input) then

                Picking = true;

                DisplayLabel.Text = '';

                local Break;
                local Text = '';

                task.spawn(function()
                    while (not Break) do
                        if Text == '...' then
                            Text = '';
                        end;

                        Text = Text .. '.';
                        DisplayLabel.Text = Text;

                        wait(0.4);
                    end;
                end);

                wait(0.2);

                local Event;
                Event = InputService.InputBegan:Connect(function(Input)
                    local Key;

                    if Input.UserInputType == Enum.UserInputType.Keyboard then
                        Key = Input.KeyCode.Name;
                    elseif Input.UserInputType == Enum.UserInputType.MouseButton1 then
                        Key = 'MB1';
                    elseif Input.UserInputType == Enum.UserInputType.MouseButton2 then
                        Key = 'MB2';
                    elseif Input.UserInputType == Enum.UserInputType.MouseButton3 then
                        Key = 'MB3';
                    end;

                    Break = true;
                    Picking = false;

                    DisplayLabel.Text = KeyDisplay(Key);
                    KeyPicker.Value = Key;

                    Library:SafeCallback(KeyPicker.ChangedCallback, Input.KeyCode or Input.UserInputType)
                    Library:SafeCallback(KeyPicker.Changed, Input.KeyCode or Input.UserInputType)

                    Library:AttemptSave();

                    Event:Disconnect();
                end);
            elseif Input.UserInputType == Enum.UserInputType.MouseButton2 and not Library:MouseIsOverOpenedFrame(Input) then
                SetModeSelectVisible(true);
            end;
        end);

        -- Touch has no right click, so a stationary long press opens the mode menu.
        if Library.IsMobile then
            PickOuter.InputBegan:Connect(function(Input)
                if Input.UserInputType ~= Enum.UserInputType.Touch then
                    return;
                end;

                if Library:MouseIsOverOpenedFrame(Input) then
                    return;
                end;

                local StartX, StartY = Library:GetInputPosition(Input);
                local Held = true;

                local Ended;
                Ended = Input:GetPropertyChangedSignal('UserInputState'):Connect(function()
                    if Input.UserInputState == Enum.UserInputState.End
                        or Input.UserInputState == Enum.UserInputState.Cancel then

                        Held = false;
                        Ended:Disconnect();
                    end;
                end);

                task.delay(0.3, function()
                    if Ended.Connected then
                        Ended:Disconnect();
                    end;

                    if (not Held) or Picking or ModeSelectOuter.Visible then
                        return;
                    end;

                    local NowX, NowY = Library:GetInputPosition(Input);

                    if math.abs(NowX - StartX) > 6 or math.abs(NowY - StartY) > 6 then
                        return;
                    end;

                    SetModeSelectVisible(true);
                end);
            end);
        end;

        Library:GiveSignal(InputService.InputBegan:Connect(function(Input)
            if Library:IsTyping() then
                return;
            end;

            if (not Picking) then
                if KeyPicker.Mode == 'Toggle' then
                    local Key = KeyPicker.Value;

                    if Key == 'MB1' or Key == 'MB2' or Key == 'MB3' then
                        if Key == 'MB1' and Input.UserInputType == Enum.UserInputType.MouseButton1
                        or Key == 'MB2' and Input.UserInputType == Enum.UserInputType.MouseButton2
                        or Key == 'MB3' and Input.UserInputType == Enum.UserInputType.MouseButton3 then
                            KeyPicker.Toggled = not KeyPicker.Toggled
                            KeyPicker:DoClick()
                        end;
                    elseif Input.UserInputType == Enum.UserInputType.Keyboard then
                    if Input.KeyCode.Name == Key then
                            KeyPicker.Toggled = not KeyPicker.Toggled;
                            KeyPicker:DoClick()
                        end;
                    end;
                end;

                KeyPicker:Update();
            end;

            if Library:IsPrimaryInput(Input) then
                local AbsPos, AbsSize = ModeSelectOuter.AbsolutePosition, ModeSelectOuter.AbsoluteSize;
                local PointerX, PointerY = Library:GetPointerPosition(Input);

                if PointerX < AbsPos.X or PointerX > AbsPos.X + AbsSize.X
                    or PointerY < (AbsPos.Y - 20 - 1) or PointerY > AbsPos.Y + AbsSize.Y then

                    SetModeSelectVisible(false);
                end;
            end;
        end))

        Library:GiveSignal(InputService.InputEnded:Connect(function(Input)
            if (not Picking) then
                KeyPicker:Update();
            end;
        end))

        KeyPicker:Update();

        Options[Idx] = KeyPicker;

        return self;
    end;

    BaseAddons.__index = Funcs;
    BaseAddons.__namecall = function(Table, Key, ...)
        return Funcs[Key](...);
    end;
end;

local BaseGroupbox = {};

--// The stored role name stays 'Priority' -- it is compared by name in the aim paths and written to
--// configs by UserId, so only the caption on screen changes. A status with no entry here (the page
--// list's 'LocalPlayer' pseudo-status) falls straight through.
Library.PriorityLabels = {
    Priority = 'Number One Focus';
};

function Library:GetPriorityLabel(Status)
    return Library.PriorityLabels[Status] or Status;
end;

function Library:GetPriorityFromLabel(Label)
    for Status, Caption in next, Library.PriorityLabels do
        if Caption == Label then
            return Status;
        end;
    end;

    return Label;
end;

function Library:SetPlayerPriority(Player, Priority)
    local PlayerObject = typeof(Player) == 'Instance' and Player or Players:FindFirstChild(tostring(Player));
    local Key = PlayerObject and tostring(PlayerObject.UserId) or tostring(Player);
    local Valid = Priority == 'Neutral' or Priority == 'Friendly' or Priority == 'Enemy' or Priority == 'Priority';

    if not Valid then
        Priority = 'Neutral';
    end;

    Library.PlayerPriorities[Key] = Priority;
    if PlayerObject then
        Library.PlayerPriorities[PlayerObject.Name] = Priority;
    end;

    if Library.RefreshChatLogColors then
        Library:RefreshChatLogColors();
    end;

    return Priority;
end;

function Library:GetPlayerPriority(Player)
    local PlayerObject = typeof(Player) == 'Instance' and Player or Players:FindFirstChild(tostring(Player));
    if PlayerObject then
        return Library.PlayerPriorities[tostring(PlayerObject.UserId)]
            or Library.PlayerPriorities[PlayerObject.Name]
            or 'Neutral';
    end;

    return Library.PlayerPriorities[tostring(Player)] or 'Neutral';
end;

function Library:GetPlayerTargetWeight(Player)
    local Status = Library:GetPlayerPriority(Player);
    if Status == 'Priority' then
        return 1000000;
    elseif Status == 'Enemy' then
        return 1000;
    elseif Status == 'Friendly' then
        return -math.huge;
    end;
    return 0;
end;

function Library:SelectPriorityTarget(Candidates, ScoreCallback)
    local BestTarget = nil;
    local BestScore = -math.huge;

    for _, Player in ipairs(Candidates or {}) do
        local Weight = Library:GetPlayerTargetWeight(Player);
        if Weight > -math.huge then
            local BaseScore = ScoreCallback and ScoreCallback(Player) or 0;
            local Score = Weight + BaseScore;
            if Score > BestScore then
                BestScore = Score;
                BestTarget = Player;
            end;
        end;
    end;

    return BestTarget;
end;

getgenv().AuroraPlayerPriorities = Library.PlayerPriorities;
getgenv().AuroraGetPlayerPriority = function(Player)
    return Library:GetPlayerPriority(Player);
end;
getgenv().AuroraSelectPriorityTarget = function(Candidates, ScoreCallback)
    return Library:SelectPriorityTarget(Candidates, ScoreCallback);
end;

