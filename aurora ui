        Parent = Container;
        Zoom = 1.9;
        Distance = 127;
        State = 'Walking';
    });

    if not Controller then
        Preview:Destroy();
        return nil;
    end;

    Controller.ExternalZoom = true;

    local ZoomSurface = Library:Create('TextButton', {
        Active = true;
        AutoButtonColor = false;
        BackgroundTransparency = 1;
        BorderSizePixel = 0;
        Size = UDim2.new(1, 0, 1, 0);
        Text = '';
        ZIndex = 200;
        Parent = Container;
    });

    local ZoomTouches = {};
    local PinchDistance = nil;
    local PinchZoom = nil;
    local LastWheelTime = 0;

    local function ApplyPreviewZoom(Value)
        if type(Controller.SetZoom) == 'function' then
            Controller:SetZoom(Value, true);
        end;
    end;

    local function GetTwoZoomTouches()
        local FirstPosition;
        local SecondPosition;
        for _, Position in next, ZoomTouches do
            if not FirstPosition then
                FirstPosition = Position;
            else
                SecondPosition = Position;
                break;
            end;
        end;
        return FirstPosition, SecondPosition;
    end;

    local function HandlePreviewWheel(Input)
        local Now = os.clock();
        if Now - LastWheelTime < 0.01 then
            return;
        end;
        LastWheelTime = Now;
        ApplyPreviewZoom((Controller.Zoom or 1.9) - Input.Position.Z * 0.15);
    end;

    ZoomSurface.InputChanged:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseWheel then
            HandlePreviewWheel(Input);
        end;
    end);

    ZoomSurface.InputBegan:Connect(function(Input)
        if Input.UserInputType ~= Enum.UserInputType.Touch then
            return;
        end;
        ZoomTouches[Input] = Vector2.new(Input.Position.X, Input.Position.Y);
        local FirstPosition, SecondPosition = GetTwoZoomTouches();
        if FirstPosition and SecondPosition then
            PinchDistance = (SecondPosition - FirstPosition).Magnitude;
            PinchZoom = Controller.Zoom or 1.9;
        end;
    end);

    Library:GiveSignal(InputService.InputChanged:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseWheel then
            local MousePosition = InputService:GetMouseLocation();
            local Position = ZoomSurface.AbsolutePosition;
            local Size = ZoomSurface.AbsoluteSize;
            if MousePosition.X >= Position.X
                and MousePosition.X <= Position.X + Size.X
                and MousePosition.Y >= Position.Y
                and MousePosition.Y <= Position.Y + Size.Y then
                HandlePreviewWheel(Input);
            end;
            return;
        end;
        if Input.UserInputType ~= Enum.UserInputType.Touch or not ZoomTouches[Input] then
            return;
        end;
        ZoomTouches[Input] = Vector2.new(Input.Position.X, Input.Position.Y);
        local FirstPosition, SecondPosition = GetTwoZoomTouches();
        if FirstPosition and SecondPosition then
            local Distance = (SecondPosition - FirstPosition).Magnitude;
            if not PinchDistance or not PinchZoom then
                PinchDistance = Distance;
                PinchZoom = Controller.Zoom or 1.9;
            elseif Distance > 1 then
                ApplyPreviewZoom(PinchZoom * PinchDistance / Distance);
            end;
        end;
    end));

    Library:GiveSignal(InputService.InputEnded:Connect(function(Input)
        if ZoomTouches[Input] then
            ZoomTouches[Input] = nil;
            PinchDistance = nil;
            PinchZoom = nil;
        end;
    end));

    local PreviewMoved = false;

    Preview.InputBegan:Connect(function(Input)
        if not Library:IsPrimaryInput(Input) then
            return;
        end;
        local _, PointerY = Library:GetInputPosition(Input);
        if PointerY - Preview.AbsolutePosition.Y <= 24 then
            PreviewMoved = true;
        end;
    end);

    Library:MakeDraggable(Preview, 24);

    local function UpdatePosition()
        if not Preview.Parent then
            return;
        end;
        if PreviewMoved then
            return;
        end;
        local WindowPosition = Window.Holder.AbsolutePosition;
        local WindowSize = Window.Holder.AbsoluteSize;
        local ViewportSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080);
        local Gap = 12;
        local Width = Preview.AbsoluteSize.X;
        local X;

        if WindowPosition.X >= Width + Gap then
            X = WindowPosition.X - Width - Gap;
        else
            X = WindowPosition.X + WindowSize.X + Gap;
        end;

        X = math.clamp(X, 6, math.max(6, ViewportSize.X - Width - 6));
        local TargetY = math.max(6, WindowPosition.Y);
        Preview.Position = UDim2.fromOffset(X, TargetY);
        task.defer(function()
            if not Preview.Parent or not Window.Holder.Parent then
                return;
            end;
            local PositionError = Window.Holder.AbsolutePosition.Y - Preview.AbsolutePosition.Y;
            if math.abs(PositionError) > 0.01 then
                Preview.Position = UDim2.fromOffset(Preview.Position.X.Offset, Preview.Position.Y.Offset + PositionError);
            end;
        end);
    end;

    Library:GiveSignal(Window.Holder:GetPropertyChangedSignal('AbsolutePosition'):Connect(UpdatePosition));
    Library:GiveSignal(Window.Holder:GetPropertyChangedSignal('AbsoluteSize'):Connect(UpdatePosition));
    Library:GiveSignal(RenderStepped:Connect(function()
        local Visible = Library.ESPPreviewEnabled and Library.IsOpen;
        Preview.Visible = Visible;
        Controller:SetVisible(Visible);
    end));
    task.defer(UpdatePosition);

    function Library:RefreshESPPreview()
        if Library.ESPPreviewController then
            Library.ESPPreviewController:Refresh();
        end;
    end;

    Library.ESPPreview = Preview;
    Library.ESPPreviewController = Controller;
    Library.ESPPreviewViewport = Controller.Root;
    return Preview;
end;
