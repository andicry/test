                    Library.SelectedPriorityPlayer = nil;
                end;
                Row.Button:Destroy();
                PlayerList.Rows[Player] = nil;
                UpdateSelection();
            end;

            local function RefreshPlayers()
                local Present = {};
                for _, Player in ipairs(Players:GetPlayers()) do
                    Present[Player] = true;
                    CreatePlayer(Player);
                end;
                for Player in next, PlayerList.Rows do
                    if not Present[Player] then
