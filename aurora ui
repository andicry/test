function Library:AddChatLogMessage(Player, Message)
    if not Library.ChatLogContainer or type(Message) ~= 'string' or Message == '' then
        return;
    end;

    local DisplayName = Player and Player.DisplayName or 'Unknown';
    local Username = Player and Player.Name or 'Unknown';
    local Prefix = DisplayName == Username and Username or string.format('%s (@%s)', DisplayName, Username);
    local Text = string.format('[%s] %s: %s', os.date('%H:%M'), Prefix, Message);
    local Width = math.max(120, Library.ChatLogContainer.AbsoluteSize.X - 14);
    local Bounds = TextService:GetTextSize(Text, 11, Library.Font, Vector2.new(Width, 1000));

    local Label = Library:CreateLabel({
        Size = UDim2.new(1, -10, 0, math.max(15, Bounds.Y + 2));
        Text = Text;
        TextColor3 = Library:GetChatLogColor(Player);
        TextSize = 11;
        TextWrapped = true;
        TextXAlignment = Enum.TextXAlignment.Left;
        TextYAlignment = Enum.TextYAlignment.Top;
        ZIndex = 162;
        Parent = Library.ChatLogContainer;
    }, true);

    Library:RemoveFromRegistry(Label);
    Library:AddToRegistry(Label, {
        TextColor3 = function()
            return Library:GetChatLogColor(Player);
        end;
    }, true);

    table.insert(Library.ChatLogRows, {
        Label = Label;
        Player = Player;
    });

    while #Library.ChatLogRows > 100 do
        local Row = table.remove(Library.ChatLogRows, 1);
        Library:RemoveFromRegistry(Row.Label);
        Row.Label:Destroy();
    end;

    task.defer(function()
        if not Library.ChatLogContainer or not Library.ChatLogContainer.Parent then
            return;
        end;
        local Height = Library.ChatLogLayout.AbsoluteContentSize.Y + 8;
        Library.ChatLogContainer.CanvasSize = UDim2.fromOffset(0, Height);
        Library.ChatLogContainer.CanvasPosition = Vector2.new(0, math.max(0, Height - Library.ChatLogContainer.AbsoluteSize.Y));
    end);
end;

